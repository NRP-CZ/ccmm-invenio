    skos:broadMatch datacite-metadata-schema:studyregistration ;
    skos:broader nma-resourcetypes:publication-report ;
    skos:definition "A work that reports on the results of a research study to evaluate interventions or exposures on biomedical or health-related outcomes. The two main types of clinical studies are interventional studies (clinical trials) and observational studies. While most clinical studies concern humans, this publication type may be used for clinical veterinary articles meeting the requisites for humans. [Source: https://www.ncbi.nlm.nih.gov/mesh/2009830]"@en ;
    skos:editorialNote "Published"@en ;
    skos:exactMatch coar-resource-type:c_7877 ;
    skos:inScheme nma-resourcetypes: ;
    skos:notation "c_7877"^^nma-vocabularies:invenioid ;
    skos:prefLabel "clinical study"@en ;
    skos:relatedMatch fabio-docs:d4e2502 .


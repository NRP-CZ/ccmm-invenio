    skos:broadMatch datacite-v4.4:Software ;
    skos:broader nma-resourcetypes:software ;
    skos:definition "Software that is used to generate, process or analyse results that you intend to appear in a publication (either in a journal, conference paper, monograph, book or thesis). Research software can be anything from a few lines of code written by yourself, to a professionally developed software package. [Source: https://datashare.ed.ac.uk/handle/10283/785]"@en ;
    skos:editorialNote "Published"@en ;
    skos:exactMatch coar-resource-type:c_c950 ;

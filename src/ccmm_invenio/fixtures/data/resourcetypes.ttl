    skos:broadMatch schema:MediaObject ;
    skos:definition "A resource primarily intended to be heard. Examples include a music playback file format, an audio compact disc, and recorded speech or sounds. [Source: http://dublincore.org/documents/dcmi-terms/#dcmitype-Sound]"@en ;
    skos:editorialNote "Published"@en ;
    skos:exactMatch coar-resource-type:c_18cc ;

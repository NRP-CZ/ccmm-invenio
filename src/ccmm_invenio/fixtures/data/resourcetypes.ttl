    skos:topConceptOf nma-resourcetypes: .

nma-resourcetypes:c_2cd9 a skos:Concept ;
    skos:broader nma-resourcetypes:c_18cf ;
    skos:definition "A popular interest periodical usually containing articles on a variety of topics, written by various authors in a nonscholarly style or a trade publication, unlike a consumer publication, covers a specific topic for people who work in that particular field or industry. [Source: Adapted from https://www.thebalance.com/what-is-a-trade-publication-exactly-2316039 and http://www.abc-clio.com/ODLIS/odlis_m.aspx]"@en ;
    skos:editorialNote "Published"@en ;
    skos:exactMatch coar-resource-type:c_2cd9,
        fabio-docs:d4e3843 ;
    skos:inScheme nma-resourcetypes: ;
    skos:notation "c_2cd9"^^nma-vocabularies:invenioid ;
    skos:prefLabel "magazine"@en .

nma-resourcetypes:c_2fe3 a skos:Concept ;
    skos:broader nma-resourcetypes:c_18cf ;
    skos:definition "A non-peer reviewed periodical, usually published daily or weekly, consisting primarily of editorials and news items concerning current or recent events and matters of public interest. [Source: https://sparontologies.github.io/fabio/current/fabio.html#d4e4291]"@en ;
    skos:editorialNote "Published"@en ;
    skos:exactMatch coar-resource-type:c_2fe3,
        fabio-docs:d4e4291 ;
    skos:inScheme nma-resourcetypes: ;
    skos:notation "c_2fe3"^^nma-vocabularies:invenioid ;
    skos:prefLabel "newspaper"@en .


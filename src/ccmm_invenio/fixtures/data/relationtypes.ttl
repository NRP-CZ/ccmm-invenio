@prefix ccmm-relationtype: <https://vocabs.ccmm.cz/registry/codelist/RelationType/> .
@prefix datacite-relationtype: <https://w3id.org/tib/datacite/vocab/relationType/> .
@prefix europa-language: <http://publications.europa.eu/resource/authority/language/> .
@prefix europa-ontology: <http://publications.europa.eu/ontology/> .
@prefix europa-web: <https://op.europa.eu/en/web/> .
@prefix nma: <https://nma.eosc.cz/vocabularies/> .
@prefix nma-relationtypes: <https://nma.eosc.cz/vocabularies/relationtypes/> .
@prefix nma-vocabularies: <https://nma.eosc.cz/vocabularies/vocabularies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix props: <https://nma.eosc.cz/vocabularies/vocabularies/invenioprops> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tags: <https://nma.eosc.cz/vocabularies/vocabularies/inveniotags> .

europa-ontology:euvoc a owl:Ontology ;
    rdfs:label "EU Vocabularies ontology (euvoc)"@en ;
    rdfs:comment "Ontology of the EU Publications Office; its terms are used as skos:notation datatypes to distinguish language code schemes (e.g. ISO_639_1, ISO_639_3, XML_LNG)."@en ;
    rdfs:seeAlso europa-web:eu-vocabularies .

europa-language: a skos:ConceptScheme ;
    rdfs:label "EU Publications Office language authority"@en ;
    rdfs:comment "EU Publications Office language authority table; identifiers are ISO 639-3 codes."@en ;
    rdfs:seeAlso europa-web:eu-vocabularies .

nma: a owl:Ontology ;
    rdfs:label "NMA vocabularies"@en ;
    rdfs:comment "Namespace of the NMA vocabularies; each sub-path is one vocabulary (e.g. languages)."@en .

nma-vocabularies:invenioid a rdfs:Datatype ;
    rdfs:label "NMA internal vocabulary id"@en ;
    rdfs:comment "Marks skos:notation literals carrying the internal NMA vocabulary id, used for round-tripping vocabulary data; not intended for external compatibility."@en .

props: a owl:Ontology ;
    rdfs:label "NMA vocabulary properties"@en ;
    rdfs:comment "Namespace of internal vocabulary properties and datatypes used for round-tripping vocabulary data; not intended for external compatibility."@en .

props:alpha_2 a rdf:Property ;
    rdfs:label "ISO 639-1 code"@en ;
    rdfs:comment "Two-letter ISO 639-1 code of a language, when it has one."@en .

props:csl a rdf:Property ;
    rdfs:label "csl"@en ;
    rdfs:comment "Citation Style Language (CSL) type of a resource type."@en .

props:datacite a rdf:Property ;
    rdfs:label "DataCite relationType name"@en ;
    rdfs:comment "Name of the DataCite relationType (e.g. IsCitedBy) a relation type concept stands for."@en .

props:datacite_general a rdf:Property ;
    rdfs:label "datacite_general"@en ;
    rdfs:comment "DataCite resourceTypeGeneral of a resource type."@en .

props:datacite_type a rdf:Property ;
    rdfs:label "datacite_type"@en ;
    rdfs:comment "DataCite resource type name, when the general one is further specified."@en .

props:eurepo a rdf:Property ;
    rdfs:label "eurepo"@en ;
    rdfs:comment "eu-repo semantics identifier of a resource type."@en .

props:marc a rdf:Property ;
    rdfs:label "MARC 21 relator code"@en ;
    rdfs:comment "Three-letter MARC 21 relator code (e.g. prc) of a role concept."@en .

props:marc21_subtype a rdf:Property ;
    rdfs:label "marc21_subtype"@en ;
    rdfs:comment "MARC 21 bibliographic level of a resource type."@en .

props:marc21_type a rdf:Property ;
    rdfs:label "marc21_type"@en ;
    rdfs:comment "MARC 21 type of record of a resource type."@en .

props:openaire_resourceType a rdf:Property ;
    rdfs:label "openaire_resourceType"@en ;
    rdfs:comment "OpenAIRE resource type code of a resource type."@en .

props:openaire_type a rdf:Property ;
    rdfs:label "openaire_type"@en ;
    rdfs:comment "OpenAIRE type name of a resource type."@en .

props:schema.org a rdf:Property ;
    rdfs:label "schema.org"@en ;
    rdfs:comment "schema.org type a resource type maps to."@en .

props:subtype a rdf:Property ;
    rdfs:label "subtype"@en ;
    rdfs:comment "InvenioRDM resource subtype id; empty for top-level types."@en .

props:type a rdf:Property ;
    rdfs:label "type"@en ;
    rdfs:comment "InvenioRDM resource type id a resource type belongs to."@en .

props:xml_lang a rdf:Property ;
    rdfs:label "xml:lang code"@en ;
    rdfs:comment "Language tag suitable for an xml:lang attribute: the ISO 639-1 code when available, the ISO 639-3 code otherwise."@en .

tags: a rdf:Property ;
    rdfs:label "vocabulary tags"@en ;
    rdfs:comment "Links a vocabulary concept to its tag values (e.g. the scope and type of a language); internal use."@en .

nma-relationtypes:cites a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:Cites.jsonld ;
    skos:definition "indicates that A includes B in a citation"@en ;
    skos:exactMatch ccmm-relationtype:Cites,
        datacite-relationtype:Cites ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"ISBN\" relationType=\"Cites\">0761964312</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "cites"^^nma-vocabularies:invenioid ;
    skos:prefLabel "cituje (co)"@cs,
        "cites"@en ;
    skos:scopeNote "Recommended for discovery."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "Cites" ;
    props:openaire "Cites" ;
    props:zenodo "cites" .

nma-relationtypes:collects a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:Collects.jsonld ;
    skos:definition "Indicates A collects B"@en ;
    skos:exactMatch ccmm-relationtype:Collects,
        datacite-relationtype:Collects ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"Collects\">10.5072/data</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "collects"^^nma-vocabularies:invenioid ;
    skos:prefLabel "sbírá"@cs,
        "collects"@en ;
    skos:scopeNote "May indicate relationship between an instrument and a dataset it collected/observed."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "Collects" .

nma-relationtypes:compiles a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:Compiles.jsonld ;
    skos:definition "indicates B is the result of a compile or creation event using A"@en ;
    skos:exactMatch ccmm-relationtype:Compiles,
        datacite-relationtype:Compiles ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"URN\" relationType=\"Compiles\">urn:nbn:de:bsz:21-opus-963</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "compiles"^^nma-vocabularies:invenioid ;
    skos:prefLabel "kompiluje (co)"@cs,
        "compiles"@en ;
    skos:scopeNote "May be used for software and text; a compiler can be a computer program or a person."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "Compiles" ;
    props:openaire "Compiles" ;
    props:zenodo "compiles" .

nma-relationtypes:continues a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:Continues.jsonld ;
    skos:definition "indicates A is a continuation of the work B"@en ;
    skos:exactMatch ccmm-relationtype:Continues,
        datacite-relationtype:Continues ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"URN\" relationType=\"Continues\">urn:nbn:de:bsz:21-opus-4966</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "continues"^^nma-vocabularies:invenioid ;
    skos:prefLabel "pokračuje (čím)"@cs,
        "continues"@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "Continues" ;
    props:openaire "Continues" ;
    props:zenodo "continues" .

nma-relationtypes:describes a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:Describes.jsonld ;
    skos:definition "indicates A describes B"@en ;
    skos:exactMatch ccmm-relationtype:Describes,
        datacite-relationtype:Describes ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"Describes\">10.6084/m9.figshare.c.3288407</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "describes"^^nma-vocabularies:invenioid ;
    skos:prefLabel "popisuje (co)"@cs,
        "describes"@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "Describes" ;
    props:zenodo "describes" .

nma-relationtypes:documents a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:Documents.jsonld ;
    skos:definition "indicates A is documentation about/explaining B"@en ;
    skos:exactMatch ccmm-relationtype:Documents,
        datacite-relationtype:Documents ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"Documents\">10.1234/7836</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "documents"^^nma-vocabularies:invenioid ;
    skos:prefLabel "dokumentuje (co)"@cs,
        "documents"@en ;
    skos:scopeNote "May be used for software documentation."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "Documents" ;
    props:openaire "Documents" ;
    props:zenodo "documents" .

nma-relationtypes:hasmetadata a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:HasMetadata.jsonld ;
    skos:definition "indicates resource A has additional metadata B"@en ;
    skos:exactMatch ccmm-relationtype:HasMetadata,
        datacite-relationtype:HasMetadata ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"HasMetadata\" relatedMetadataScheme=\"DDI-L\" schemeURI=\"http://www.ddialliance.org/Specification/DDI-Lifecycle/3.1/XMLSchema/instance.xsd\">10.1234/567890</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "hasmetadata"^^nma-vocabularies:invenioid ;
    skos:prefLabel "má metadata"@cs,
        "has metadata"@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "HasMetadata" ;
    props:openaire "HasMetadata" ;
    props:zenodo "hasmetadata" .

nma-relationtypes:haspart a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:HasPart.jsonld ;
    skos:definition "indicates A includes the part B"@en ;
    skos:exactMatch ccmm-relationtype:HasPart,
        datacite-relationtype:HasPart ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"URL\" relationType=\"HasPart\">https://zenodo.org/record/16564/files/dune-stuff-LSSC_15.zip</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "haspart"^^nma-vocabularies:invenioid ;
    skos:prefLabel "má část/i"@cs,
        "has part"@en ;
    skos:scopeNote "Recommended for discovery. Primarily applied to container-contained relationships. May be used for individual software modules; code repository-to-version should use IsVersionOf/HasVersion."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "HasPart" ;
    props:openaire "HasPart" ;
    props:zenodo "haspart" .

nma-relationtypes:hastranslation a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:HasTranslation.jsonld ;
    skos:definition "indicates A has a translation B"@en ;
    skos:exactMatch ccmm-relationtype:HasTranslation,
        datacite-relationtype:HasTranslation ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"HasTranslation\">10.21384/g01j-jm06</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "hastranslation"^^nma-vocabularies:invenioid ;
    skos:prefLabel "má překlad"@cs,
        "has translation"@en ;
    skos:scopeNote "When a resource is shared in one language and later translated, use HasTranslation to link original to translation. If released simultaneously in multiple languages, connect in both directions."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "HasTranslation" .

nma-relationtypes:hasversion a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:HasVersion.jsonld ;
    skos:definition "indicates A has a version B"@en ;
    skos:exactMatch ccmm-relationtype:HasVersion,
        datacite-relationtype:HasVersion ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"HasVersion\">10.5281/ZENODO.832053</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "hasversion"^^nma-vocabularies:invenioid ;
    skos:prefLabel "má verzi"@cs,
        "has version"@en ;
    skos:scopeNote "The registered resource such as a software package or code repository has a versioned instance (A has instance B). May relate an un-versioned code repository to a specific software version."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "HasVersion" ;
    props:zenodo "hasversion" .

nma-relationtypes:iscitedby a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsCitedBy.jsonld ;
    skos:definition "indicates that B includes A in a citation"@en ;
    skos:exactMatch ccmm-relationtype:IsCitedBy,
        datacite-relationtype:IsCitedBy ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsCitedBy\">10.4232/10.ASEAS-5.2-1</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "iscitedby"^^nma-vocabularies:invenioid ;
    skos:prefLabel "je citován (čím)"@cs,
        "is cited by"@en ;
    skos:scopeNote "Recommended for discovery."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "IsCitedBy" ;
    props:openaire "IsCitedBy" ;
    props:zenodo "iscitedby" .

nma-relationtypes:iscollectedby a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsCollectedBy.jsonld ;
    skos:definition "Indicates A is collected by B"@en ;
    skos:exactMatch ccmm-relationtype:IsCollectedBy,
        datacite-relationtype:IsCollectedBy ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsCollectedBy\">10.5072/instrument</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "iscollectedby"^^nma-vocabularies:invenioid ;
    skos:prefLabel "je sbírán (čím)"@cs,
        "is collected by"@en ;
    skos:scopeNote "May indicate relationship between a dataset and an instrument used to collect/measure/observe data."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "IsCollectedBy" .

nma-relationtypes:iscompiledby a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsCompiledBy.jsonld ;
    skos:definition "indicates B is used to compile or create A"@en ;
    skos:exactMatch ccmm-relationtype:IsCompiledBy,
        datacite-relationtype:IsCompiledBy ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"URL\" relationType=\"IsCompiledBy\">http://d-nb.info/gnd/4513749-3</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "iscompiledby"^^nma-vocabularies:invenioid ;
    skos:prefLabel "kompilován (čím)"@cs,
        "is compiled by"@en ;
    skos:scopeNote "May indicate a traditional text compilation, or the compiler program used to generate executable software."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "IsCompiledBy" ;
    props:openaire "isCompiledBy" ;
    props:zenodo "iscompiledby" .

nma-relationtypes:iscontinuedby a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsContinuedBy.jsonld ;
    skos:definition "indicates A is continued by the work B"@en ;
    skos:exactMatch ccmm-relationtype:IsContinuedBy,
        datacite-relationtype:IsContinuedBy ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"URN\" relationType=\"IsContinuedBy\">urn:nbn:de:bsz:21-opus-4967</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "iscontinuedby"^^nma-vocabularies:invenioid ;
    skos:prefLabel "je pokračováním (čeho)"@cs,
        "is continued by"@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "IsContinuedBy" ;
    props:openaire "IsContinuedBy" ;
    props:zenodo "iscontinuedby" .

nma-relationtypes:isderivedfrom a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsDerivedFrom.jsonld ;
    skos:definition "indicates B is a source upon which A is based"@en ;
    skos:exactMatch ccmm-relationtype:IsDerivedFrom,
        datacite-relationtype:IsDerivedFrom ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsDerivedFrom\">10.6078/M7DZ067C</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "isderivedfrom"^^nma-vocabularies:invenioid ;
    skos:prefLabel "je odvozen od (čeho)"@cs,
        "is derived from"@en ;
    skos:scopeNote "Use for a resource that is a derivative of an original resource. Example context: dataset derived from a larger dataset and manipulated."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "IsDerivedFrom" ;
    props:openaire "IsDerivedFrom" ;
    props:zenodo "isderivedfrom" .

nma-relationtypes:isdescribedby a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsDescribedBy.jsonld ;
    skos:definition "indicates A is described by B"@en ;
    skos:exactMatch ccmm-relationtype:IsDescribedBy,
        datacite-relationtype:IsDescribedBy ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsDescribedBy\">10.1038/sdata.2016.123</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "isdescribedby"^^nma-vocabularies:invenioid ;
    skos:prefLabel "je popsán (čím)"@cs,
        "is described by"@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "IsDescribedBy" ;
    props:zenodo "isdescribedby" .

nma-relationtypes:isdocumentedby a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsDocumentedBy.jsonld ;
    skos:definition "indicates B is documentation about/explaining A"@en ;
    skos:exactMatch ccmm-relationtype:IsDocumentedBy,
        datacite-relationtype:IsDocumentedBy ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"URL\" relationType=\"IsDocumentedBy\">http://tobias-lib.uni-tuebingen.de/volltexte/2000/96/</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "isdocumentedby"^^nma-vocabularies:invenioid ;
    skos:prefLabel "je zdokumentován (čím)"@cs,
        "is documented by"@en ;
    skos:scopeNote "May be used for software documentation."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "IsDocumentedBy" ;
    props:openaire "IsDocumentedBy" ;
    props:zenodo "isdocumentedby" .

nma-relationtypes:isidenticalto a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsIdenticalTo.jsonld ;
    skos:definition "indicates that A is identical to B, for use when there is a need to register two separate instances of the same resource"@en ;
    skos:exactMatch ccmm-relationtype:IsIdenticalTo,
        datacite-relationtype:IsIdenticalTo ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"URL\" relationType=\"IsIdenticalTo\">http://oac.cdlib.org/findaid/ark:/13030/c8r78fzq</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "isidenticalto"^^nma-vocabularies:invenioid ;
    skos:prefLabel "je identický s"@cs,
        "is identical to"@en ;
    skos:scopeNote "Use when the same resource is saved in another location (e.g., another institution)."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "IsIdenticalTo" ;
    props:openaire "IsIdenticalTo" ;
    props:zenodo "isidenticalto" .

nma-relationtypes:ismetadatafor a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsMetadataFor.jsonld ;
    skos:definition "indicates additional metadata A for a resource B"@en ;
    skos:exactMatch ccmm-relationtype:IsMetadataFor,
        datacite-relationtype:IsMetadataFor ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsMetadataFor\" relatedMetadataScheme=\"DDI-L\" schemeURI=\"http://www.ddialliance.org/Specification/DDI-Lifecycle/3.1/XMLSchema/instance.xsd\">10.1234/567891</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "ismetadatafor"^^nma-vocabularies:invenioid ;
    skos:prefLabel "je metadaty pro"@cs,
        "is metadata for"@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "IsMetadataFor" ;
    props:openaire "IsMetadataFor" ;
    props:zenodo "ismetadatafor" .

nma-relationtypes:isnewversionof a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsNewVersionOf.jsonld ;
    skos:definition "indicates A is a new edition of B, where the new edition has been modified or updated"@en ;
    skos:exactMatch ccmm-relationtype:IsNewVersionOf,
        datacite-relationtype:IsNewVersionOf ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsNewVersionOf\">10.5438/0005</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "isnewversionof"^^nma-vocabularies:invenioid ;
    skos:prefLabel "je novou verzí (čeho)"@cs,
        "is new version of"@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "IsNewVersionOf" ;
    props:openaire "IsNewVersionOf" ;
    props:zenodo "isnewversionof" .

nma-relationtypes:isobsoletedby a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsObsoletedBy.jsonld ;
    skos:definition "Indicates A is replaced by B"@en ;
    skos:exactMatch ccmm-relationtype:IsObsoletedBy,
        datacite-relationtype:IsObsoletedBy ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsObsoletedBy\">10.5438/0005</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "isobsoletedby"^^nma-vocabularies:invenioid ;
    skos:prefLabel "je nahrazen (čím)"@cs,
        "is obsoleted by"@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "IsObsoletedBy" ;
    props:zenodo "isobsoletedby" .

nma-relationtypes:isoriginalformof a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsOriginalFormOf.jsonld ;
    skos:definition "indicates A is the original form of B"@en ;
    skos:exactMatch ccmm-relationtype:IsOriginalFormOf,
        datacite-relationtype:IsOriginalFormOf ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsOriginalFormOf\">10.1234/9035</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "isoriginalformof"^^nma-vocabularies:invenioid ;
    skos:prefLabel "je původní variantou (čeho)"@cs,
        "is original form of"@en ;
    skos:scopeNote "May be used for different software operating systems or compiler formats."@en ;
    skos:topConceptOf nma-relationtypes: ;
    props:datacite "IsOriginalFormOf" ;
    props:openaire "IsOriginalFormOf" ;
    props:zenodo "isoriginalformof" .

nma-relationtypes:ispartof a skos:Concept ;
    rdfs:seeAlso datacite-relationtype:IsPartOf.jsonld ;
    skos:definition "indicates A is a portion of B; may be used for elements of a series"@en ;
    skos:exactMatch ccmm-relationtype:IsPartOf,
        datacite-relationtype:IsPartOf ;
    skos:example "<relatedIdentifier relatedIdentifierType=\"DOI\" relationType=\"IsPartOf\">10.5281/zenodo.754312</relatedIdentifier>" ;
    skos:inScheme nma-relationtypes: ;
    skos:notation "ispartof"^^nma-vocabularies:invenioid ;
    skos:prefLabel "je součástí"@cs,
        "is part of"@en ;

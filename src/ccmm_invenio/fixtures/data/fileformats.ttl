@prefix dce: <http://purl.org/dc/elements/1.1/> .
@prefix europa-authority: <http://publications.europa.eu/resource/authority/> .
@prefix europa-file-type: <http://publications.europa.eu/resource/authority/file-type/> .
@prefix europa-language: <http://publications.europa.eu/resource/authority/language/> .
@prefix europa-ontology: <http://publications.europa.eu/ontology/> .
@prefix europa-ontology-authority: <http://publications.europa.eu/ontology/authority/> .
@prefix europa-web: <https://op.europa.eu/en/web/> .
@prefix euvoc: <http://publications.europa.eu/ontology/euvoc#> .
@prefix nma: <https://nma.eosc.cz/vocabularies/> .
@prefix nma-fileformats: <https://nma.eosc.cz/vocabularies/fileformats/> .
@prefix nma-vocabularies: <https://nma.eosc.cz/vocabularies/vocabularies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix props: <https://nma.eosc.cz/vocabularies/vocabularies/invenioprops> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tags: <https://nma.eosc.cz/vocabularies/vocabularies/inveniotags> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

europa-ontology:euvoc a owl:Ontology ;
    rdfs:label "EU Vocabularies ontology (euvoc)"@en ;
    rdfs:comment "Ontology of the EU Publications Office; its terms are used as skos:notation datatypes to distinguish language code schemes (e.g. ISO_639_1, ISO_639_3, XML_LNG)."@en ;
    rdfs:seeAlso europa-web:eu-vocabularies .

europa-language: a skos:ConceptScheme ;
    rdfs:label "EU Publications Office language authority"@en ;
    rdfs:comment "EU Publications Office language authority table; identifiers are ISO 639-3 codes."@en ;
    rdfs:seeAlso europa-web:eu-vocabularies .

nma: a owl:Ontology ;
    rdfs:label "NMA vocabularies"@en ;
    rdfs:comment "Namespace of the NMA vocabularies; each sub-path is one vocabulary (e.g. languages)."@en .

nma-vocabularies:invenioid a rdfs:Datatype ;
    rdfs:label "NMA internal vocabulary id"@en ;
    rdfs:comment "Marks skos:notation literals carrying the internal NMA vocabulary id, used for round-tripping vocabulary data; not intended for external compatibility."@en .

props: a owl:Ontology ;
    rdfs:label "NMA vocabulary properties"@en ;
    rdfs:comment "Namespace of internal vocabulary properties and datatypes used for round-tripping vocabulary data; not intended for external compatibility."@en .

props:alpha_2 a rdf:Property ;
    rdfs:label "ISO 639-1 code"@en ;
    rdfs:comment "Two-letter ISO 639-1 code of a language, when it has one."@en .

props:csl a rdf:Property ;
    rdfs:label "csl"@en ;
    rdfs:comment "Citation Style Language (CSL) type of a resource type."@en .

props:datacite a rdf:Property ;
    rdfs:label "DataCite relationType name"@en ;
    rdfs:comment "Name of the DataCite relationType (e.g. IsCitedBy) a relation type concept stands for."@en .

props:datacite_general a rdf:Property ;
    rdfs:label "datacite_general"@en ;
    rdfs:comment "DataCite resourceTypeGeneral of a resource type."@en .

props:datacite_type a rdf:Property ;
    rdfs:label "datacite_type"@en ;
    rdfs:comment "DataCite resource type name, when the general one is further specified."@en .

props:eurepo a rdf:Property ;
    rdfs:label "eurepo"@en ;
    rdfs:comment "eu-repo semantics identifier of a resource type."@en .

props:marc a rdf:Property ;
    rdfs:label "MARC 21 relator code"@en ;
    rdfs:comment "Three-letter MARC 21 relator code (e.g. prc) of a role concept."@en .

props:marc21_subtype a rdf:Property ;
    rdfs:label "marc21_subtype"@en ;
    rdfs:comment "MARC 21 bibliographic level of a resource type."@en .

props:marc21_type a rdf:Property ;
    rdfs:label "marc21_type"@en ;
    rdfs:comment "MARC 21 type of record of a resource type."@en .

props:openaire_resourceType a rdf:Property ;
    rdfs:label "openaire_resourceType"@en ;
    rdfs:comment "OpenAIRE resource type code of a resource type."@en .

props:openaire_type a rdf:Property ;
    rdfs:label "openaire_type"@en ;
    rdfs:comment "OpenAIRE type name of a resource type."@en .

props:schema.org a rdf:Property ;
    rdfs:label "schema.org"@en ;
    rdfs:comment "schema.org type a resource type maps to."@en .

props:subtype a rdf:Property ;
    rdfs:label "subtype"@en ;
    rdfs:comment "InvenioRDM resource subtype id; empty for top-level types."@en .

props:type a rdf:Property ;
    rdfs:label "type"@en ;
    rdfs:comment "InvenioRDM resource type id a resource type belongs to."@en .

props:xml_lang a rdf:Property ;
    rdfs:label "xml:lang code"@en ;
    rdfs:comment "Language tag suitable for an xml:lang attribute: the ISO 639-1 code when available, the ISO 639-3 code otherwise."@en .

tags: a rdf:Property ;
    rdfs:label "vocabulary tags"@en ;
    rdfs:comment "Links a vocabulary concept to its tag values (e.g. the scope and type of a language); internal use."@en .

nma-fileformats:7z a skos:Concept ;
    europa-ontology-authority:authority-code "7Z" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "7Z" ;
    europa-ontology-authority:start.use "2000-01-01" ;
    europa-authority:op-code "7Z" ;
    dce:identifier "7Z" ;
    skos:altLabel "7-Zip compressed file"@en ;
    skos:definition "7z is a compressed archive file format that supports several different data compression, encryption and pre-processing algorithms."@en ;
    skos:exactMatch europa-file-type:7Z ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".7z"^^euvoc:FILE_EXT,
        "application/x-7z-compressed"^^euvoc:IANA_MT,
        "7z"^^nma-vocabularies:invenioid ;
    skos:prefLabel "7z"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:aab a skos:Concept ;
    europa-ontology-authority:authority-code "AAB" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "AAB" ;
    europa-ontology-authority:start.use "2021-08-01" ;
    europa-authority:op-code "AAB" ;
    dce:identifier "AAB" ;
    skos:altLabel "Android App Bundle"@en ;
    skos:definition "An Android App Bundle (AAB) is a package file format used by the Android operating system. It includes an app’s compiled code and resources, and defers APK generation and signing to Google Play."@en ;
    skos:exactMatch europa-file-type:AAB ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".aab"^^euvoc:FILE_EXT,
        "application/x-authorware-bin"^^euvoc:IANA_MT,
        "aab"^^nma-vocabularies:invenioid ;
    skos:prefLabel "AAB"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:aac a skos:Concept ;
    europa-ontology-authority:authority-code "AAC" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "AAC" ;
    europa-ontology-authority:start.use "1997-01-01" ;
    europa-authority:op-code "AAC" ;
    dce:identifier "AAC" ;
    skos:altLabel "Advanced Audio Coding"@en ;
    skos:definition "Advanced Audio Coding (AAC) is an audio coding standard for lossy digital audio compression. Designed to be the successor of the MP3 format, AAC generally achieves higher sound quality than MP3 at the same bit rate."@en ;
    skos:exactMatch europa-file-type:AAC ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".aac"^^euvoc:FILE_EXT,
        ".adts"^^euvoc:FILE_EXT,
        ".ass"^^euvoc:FILE_EXT,
        ".loas"^^euvoc:FILE_EXT,
        "audio/aac"^^euvoc:IANA_MT,
        "aac"^^nma-vocabularies:invenioid ;
    skos:prefLabel "AAC"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:akn4eu a skos:Concept ;
    europa-ontology-authority:authority-code "AKN4EU" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "AKN4EU" ;
    europa-ontology-authority:start.use "2019-06-20" ;
    euvoc:order 3400 ;
    europa-authority:op-code "AKN4EU" ;
    dce:identifier "AKN4EU" ;
    skos:altLabel "Akoma Ntoso file"@en ;
    skos:definition "AKN4EU file is an Akoma Ntoso XML file conforming to the AKN4EU (Akoma Ntoso for European Union) specifications. One or more AKN4EU files can be part of an AKN4EU ZIP file. A special AKN4EU file called ‘main.xml’ is the entry point of an AKN4EU ZIP file."@en ;
    skos:exactMatch europa-file-type:AKN4EU ;
    skos:inScheme nma-fileformats: ;
    skos:notation "akn4eu"^^euvoc:CELLAR_MANIFT,
        "application/xml;type=akn4eu"^^euvoc:CELLAR_MT,
        ".akn"^^euvoc:FILE_EXT,
        ".xml"^^euvoc:FILE_EXT,
        "application/xml"^^euvoc:IANA_MT,
        "akn4eu"^^nma-vocabularies:invenioid ;
    skos:prefLabel "AKN4EU file"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:akn4eu_leg a skos:Concept ;
    europa-ontology-authority:authority-code "AKN4EU_LEG" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "AKN4EU_LEG" ;
    europa-ontology-authority:start.use "2024-09-25" ;
    europa-authority:op-code "AKN4EU_LEG" ;
    dce:identifier "AKN4EU_LEG" ;
    skos:altLabel "Akoma Ntoso ZIP archive"@en ;
    skos:definition "ZIP archive containing an AKN4EU manifestation of a document in one linguistic variant issued in the legal decision-making process; it must contain at least an AKN4EU file starting with the prefix ‘main-’, which constitutes the entry point, and may contain other associated files and subfolders"@en ;
    skos:exactMatch europa-file-type:AKN4EU_LEG ;
    skos:inScheme nma-fileformats: ;
    skos:notation "akn4eu"^^euvoc:CELLAR_MANIFT,
        "application/xml;type=akn4eu-main"^^euvoc:CELLAR_MT,
        ".leg"^^euvoc:FILE_EXT,
        "application/zip"^^euvoc:IANA_MT,
        "akn4eu_leg"^^nma-vocabularies:invenioid ;
    skos:prefLabel "AKN4EU LEG"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:akn4eu_zip a skos:Concept ;
    europa-ontology-authority:authority-code "AKN4EU_ZIP" ;
    europa-ontology-authority:deprecated "true" ;
    europa-ontology-authority:end.use "2019-06-20" ;
    europa-ontology-authority:op-code "AKN4EU_ZIP" ;
    europa-ontology-authority:start.use "2019-06-20" ;
    europa-authority:op-code "AKN4EU_ZIP" ;
    dce:identifier "AKN4EU_ZIP" ;
    owl:deprecated true ;
    skos:altLabel "Akoma Ntoso ZIP archive"@en ;
    skos:definition "retired concept; replaced by AKN4EU_LEG"@en ;
    skos:exactMatch europa-file-type:AKN4EU_ZIP ;
    skos:inScheme nma-fileformats: ;
    skos:notation "akn4eu_zip"^^nma-vocabularies:invenioid ;
    skos:prefLabel "AKN4EU ZIP"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:apk a skos:Concept ;
    europa-ontology-authority:authority-code "APK" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "APK" ;
    europa-ontology-authority:start.use "2008-09-23" ;
    europa-authority:op-code "APK" ;
    dce:identifier "APK" ;
    skos:altLabel "Android Package"@en ;
    skos:definition "Android Package (APK) is the package file format used by the Android operating system for distribution and installation of mobile apps, mobile games and middleware."@en ;
    skos:exactMatch europa-file-type:APK ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".apk"^^euvoc:FILE_EXT,
        ".xapk"^^euvoc:FILE_EXT,
        "application/vnd.android.package-archive"^^euvoc:IANA_MT,
        "apk"^^nma-vocabularies:invenioid ;
    skos:prefLabel "APK"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:appx a skos:Concept ;
    europa-ontology-authority:authority-code "APPX" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "APPX" ;
    europa-ontology-authority:start.use "2012-10-26" ;
    europa-authority:op-code "APPX" ;
    dce:identifier "APPX" ;
    skos:altLabel "Microsoft AppX application package"@en ;
    skos:definition "AppX is a file format used to distribute and install apps on Windows 8.x and 10, Windows Phone 8.1, Windows 10 Mobile, Xbox One, Hololens and Windows 10 IoT Core."@en ;
    skos:exactMatch europa-file-type:APPX ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".appx"^^euvoc:FILE_EXT,
        ".appxbundle"^^euvoc:FILE_EXT,
        "application/octet-stream"^^euvoc:IANA_MT,
        "appx"^^nma-vocabularies:invenioid ;
    skos:prefLabel "AppX"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:arc a skos:Concept ;
    europa-ontology-authority:authority-code "ARC" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "ARC" ;
    europa-ontology-authority:start.use "1996-05-12" ;
    europa-authority:op-code "ARC" ;
    dce:identifier "ARC" ;
    skos:altLabel "Internet Archive ARC file format"@en ;
    skos:definition "ARC is the archive file format of Internet Archive. ARC files are large aggregate files."@en ;
    skos:exactMatch europa-file-type:ARC ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".arc"^^euvoc:FILE_EXT,
        "application/octet-stream"^^euvoc:IANA_MT,
        "arc"^^nma-vocabularies:invenioid ;
    skos:prefLabel "ARC"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:arc_gz a skos:Concept ;
    europa-ontology-authority:authority-code "ARC_GZ" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "ARC_GZ" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    europa-authority:op-code "ARC_GZ" ;
    dce:identifier "ARC_GZ" ;
    skos:altLabel "Compressed Internet Archive ARC file format"@en ;
    skos:definition "ARC is the archive file format of Internet Archive. ARC files are large aggregate files. ARC GZ is ARC compressed by GZIP."@en ;
    skos:exactMatch europa-file-type:ARC_GZ ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".arc.gz"^^euvoc:FILE_EXT,
        "application/gzip"^^euvoc:IANA_MT,
        "arc_gz"^^nma-vocabularies:invenioid ;
    skos:prefLabel "ARC GZ"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:arcinfo_cov a skos:Concept ;
    europa-ontology-authority:authority-code "ARCINFO_COV" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "ARCINFO_COV" ;
    europa-ontology-authority:start.use "1982-01-01" ;
    europa-authority:op-code "ARCINFO_COV" ;
    dce:identifier "ARCINFO_COV" ;
    skos:altLabel "ESRI ArcInfo Coverage"@en ;
    skos:definition "An ESRI ArcInfo coverage is a georelational data model that stores vector data – it contains both the spatial (location) and attribute (descriptive) data for geographic features. Coverages use a set of feature classes to represent geographic features. Each feature class stores a set of points, lines (arcs), polygons, or annotation (text). Coverages can have topology, which determines the relationships between features. A coverage is stored as a directory within which each feature class is stored as a set of files."@en ;
    skos:exactMatch europa-file-type:ARCINFO_COV ;
    skos:inScheme nma-fileformats: ;
    skos:notation "multipart/mixed"^^euvoc:IANA_MT,
        "arcinfo_cov"^^nma-vocabularies:invenioid ;
    skos:prefLabel "ArcInfo coverage"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:arff a skos:Concept ;
    europa-ontology-authority:authority-code "ARFF" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "ARFF" ;
    europa-ontology-authority:start.use "2022-01-28" ;
    europa-authority:op-code "ARFF" ;
    dce:identifier "ARFF" ;
    skos:altLabel "Attribute-Relation File Format"@en ;
    skos:definition "ASCII text file that describes a list of instances sharing a set of attributes"@en ;
    skos:exactMatch europa-file-type:ARFF ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".arff"^^euvoc:FILE_EXT,
        "text/plain"^^euvoc:IANA_MT,
        "arff"^^nma-vocabularies:invenioid ;
    skos:prefLabel "ARFF"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:arj a skos:Concept ;
    europa-ontology-authority:authority-code "ARJ" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "ARJ" ;
    europa-ontology-authority:start.use "1990-01-01" ;
    europa-authority:op-code "ARJ" ;
    dce:identifier "ARJ" ;
    skos:altLabel "ARJ archive"@en ;
    skos:definition "Compressed archive file produced by ARJ software. ARJ (Archived by Robert Jung) is a software tool designed by Robert K. Jung for creating high-efficiency compressed file archives."@en ;
    skos:exactMatch europa-file-type:ARJ ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".arj"^^euvoc:FILE_EXT,
        "application/x-arj"^^euvoc:IANA_MT,
        "arj"^^nma-vocabularies:invenioid ;
    skos:prefLabel "ARJ"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:arrow_file a skos:Concept ;
    europa-ontology-authority:authority-code "ARROW_FILE" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "ARROW_FILE" ;
    europa-ontology-authority:start.use "2016-10-10" ;
    europa-authority:op-code "ARROW_FILE" ;
    dce:identifier "ARROW_FILE" ;
    skos:altLabel "Apache Arrow file"@en ;
    skos:definition "Apache columnar format that includes a language-agnostic in-memory data structure specification, metadata serialisation, and a protocol for serialisation and generic data transport; file (random access) format is used for serialising a fixed number of record batches"@en ;
    skos:exactMatch europa-file-type:ARROW_FILE ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".arrow"^^euvoc:FILE_EXT,
        "application/vnd.apache.arrow.file"^^euvoc:IANA_MT,
        "arrow_file"^^nma-vocabularies:invenioid ;
    skos:prefLabel "Arrow file"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:arrow_stream a skos:Concept ;
    europa-ontology-authority:authority-code "ARROW_STREAM" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "ARROW_STREAM" ;
    europa-ontology-authority:start.use "2016-10-10" ;
    europa-authority:op-code "ARROW_STREAM" ;
    dce:identifier "ARROW_STREAM" ;
    skos:altLabel "Apache Arrow stream"@en ;
    skos:definition "Apache columnar format that includes a language-agnostic in-memory data structure specification, metadata serialisation, and a protocol for serialisation and generic data transport; streaming format is used for sending an arbitrary length sequence of record batches"@en ;
    skos:exactMatch europa-file-type:ARROW_STREAM ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".arrows"^^euvoc:FILE_EXT,
        "application/vnd.apache.arrow.stream"^^euvoc:IANA_MT,
        "arrow_stream"^^nma-vocabularies:invenioid ;
    skos:prefLabel "Arrow stream"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:atom a skos:Concept ;
    europa-ontology-authority:authority-code "ATOM" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "ATOM" ;
    europa-ontology-authority:start.use "2005-12-01" ;
    europa-authority:op-code "ATOM" ;
    dce:identifier "ATOM" ;
    skos:altLabel "Atom Syndication Format"@en ;
    skos:definition "The Atom Feed or Atom Syndication Format is an XML language used for web feeds. Web feeds allow software programs to check for updates published on a website."@en ;
    skos:exactMatch europa-file-type:ATOM ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".atom"^^euvoc:FILE_EXT,
        ".xml"^^euvoc:FILE_EXT,
        "application/atom+xml"^^euvoc:IANA_MT,
        "atom"^^nma-vocabularies:invenioid ;
    skos:prefLabel "Atom Feed"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:azw a skos:Concept ;
    europa-ontology-authority:authority-code "AZW" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "AZW" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 2400 ;
    europa-authority:op-code "AZW" ;
    dce:identifier "AZW" ;
    skos:altLabel "Amazon Kindle eBook format"@en ;
    skos:definition "AZW Kindle File Format is a proprietary e-book file format created by Amazon.com that can be downloaded and read on devices like smartphones, tablets, computers or e-readers that have Amazon's Kindle application."@en ;
    skos:exactMatch europa-file-type:AZW ;
    skos:inScheme nma-fileformats: ;
    skos:notation "amz"^^euvoc:CELLAR_MANIFT,
        "application/vnd.amazon.ebook"^^euvoc:CELLAR_MT,
        ".azw"^^euvoc:FILE_EXT,
        "application/vnd.amazon.ebook"^^euvoc:IANA_MT,
        "azw"^^nma-vocabularies:invenioid ;
    skos:prefLabel "Amazon Kindle eBook"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:bin a skos:Concept ;
    europa-ontology-authority:authority-code "BIN" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "BIN" ;
    europa-ontology-authority:start.use "1996-11-01" ;
    europa-authority:op-code "BIN" ;
    dce:identifier "BIN" ;
    skos:definition "A binary file is a computer file that is not a text file."@en ;
    skos:exactMatch europa-file-type:BIN ;
    skos:inScheme nma-fileformats: ;
    skos:notation "application/octet-stream"^^euvoc:CELLAR_MT,
        ".bin"^^euvoc:FILE_EXT,
        "application/octet-stream"^^euvoc:IANA_MT,
        "bin"^^nma-vocabularies:invenioid ;
    skos:prefLabel "Binary Data"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:bits a skos:Concept ;
    europa-ontology-authority:authority-code "BITS" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "BITS" ;
    europa-ontology-authority:start.use "2012-08-22" ;
    europa-authority:op-code "BITS" ;
    dce:identifier "BITS" ;
    skos:altLabel "Book Interchange Tag Suite"@en ;
    skos:definition "BITS – Book Interchange Tag Suite – is the ‘book version’ of Journal Article Tag Suite (JATS); an XML format used to describe books published online. BITS provides a common XML format in which publishers and archivists can describe textual and graphical content elements. In order to facilitate the reusability, BITS makes a tag set adequate for supporting interchange, archiving, format-conversion and publishing."@en ;
    skos:exactMatch europa-file-type:BITS ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".xml"^^euvoc:FILE_EXT,
        "application/xml"^^euvoc:IANA_MT,
        "bits"^^nma-vocabularies:invenioid ;
    skos:prefLabel "BITS XML"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:bmp a skos:Concept ;
    europa-ontology-authority:authority-code "BMP" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "BMP" ;
    europa-ontology-authority:start.use "1996-04-01" ;
    europa-authority:op-code "BMP" ;
    dce:identifier "BMP" ;
    skos:definition "The bitmap image (BMP) or device independent bitmap (DIB) is a raster graphics image file format used to store bitmap digital images, independently of the display device."@en ;
    skos:exactMatch europa-file-type:BMP ;
    skos:inScheme nma-fileformats: ;
    skos:notation "image/bmp"^^euvoc:CELLAR_MT,
        ".bm"^^euvoc:FILE_EXT,
        ".bmp"^^euvoc:FILE_EXT,
        ".dib"^^euvoc:FILE_EXT,
        "image/x-ms-bmp"^^euvoc:IANA_MT,
        "bmp"^^nma-vocabularies:invenioid ;
    skos:prefLabel "Bitmap Image File"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:bwf a skos:Concept ;
    europa-ontology-authority:authority-code "BWF" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "BWF" ;
    europa-ontology-authority:start.use "2001-07-01" ;
    europa-authority:op-code "BWF" ;
    dce:identifier "BWF" ;
    skos:altLabel "Broadcast Wave File"@en ;
    skos:definition "BWF – Broadcast Wave Format – is an extension of the Microsoft WAV audio format and is the recording format of most file-based non-linear digital recorders used for motion picture, radio and television production. The purpose of this file format is the addition of metadata to facilitate the seamless exchange of sound data between different computer platforms and applications."@en ;
    skos:exactMatch europa-file-type:BWF ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".bwf"^^euvoc:FILE_EXT,
        ".wav"^^euvoc:FILE_EXT,
        "audio/vnd.wave"^^euvoc:IANA_MT,
        "bwf"^^nma-vocabularies:invenioid ;
    skos:prefLabel "BWF"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:bzip2 a skos:Concept ;
    europa-ontology-authority:authority-code "BZIP2" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "BZIP2" ;
    europa-ontology-authority:start.use "1996-07-18" ;
    europa-authority:op-code "BZIP2" ;
    dce:identifier "BZIP2" ;
    skos:altLabel "bzip2 compressed file"@en ;
    skos:definition "An open source, patent- and royalty-free compression format. The compression algorithm is a Burrows-Wheeler transform followed by a move-to-front transform and finally Huffman coding."@en ;
    skos:exactMatch europa-file-type:BZIP2 ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".bz2"^^euvoc:FILE_EXT,
        "application/x-bzip2"^^euvoc:IANA_MT,
        "bzip2"^^nma-vocabularies:invenioid ;
    skos:prefLabel "bzip2"@en ;
    skos:topConceptOf nma-fileformats: .


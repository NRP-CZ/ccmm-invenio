    europa-ontology-authority:start.use "1999-01-01" ;
    europa-authority:op-code "WAR" ;
    dce:identifier "WAR" ;
    skos:altLabel "Web Archive"@en ;
    skos:definition "A WAR file is used to distribute a collection of JAR-files, JavaServer Pages, Java Servlets, Java classes, XML files, tag libraries, static web pages and other resources that together constitute a web application."@en ;

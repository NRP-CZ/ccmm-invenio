    dce:identifier "XHTML_SIMPL" ;
    skos:altLabel "Extensible Hypertext Markup Language, simplified"@en ;
    skos:definition "XHTML is HTML written as XML. Its simplified version is used for storage in the Publications Office."@en ;
    skos:exactMatch europa-file-type:XHTML_SIMPL ;
    skos:inScheme nma-fileformats: ;
    skos:notation "xhtml_simplified"^^euvoc:CELLAR_MANIFT,
        "application/xhtml+xml;type=simplified"^^euvoc:CELLAR_MT,
        ".htm"^^euvoc:FILE_EXT,
        ".html"^^euvoc:FILE_EXT,
        ".xht"^^euvoc:FILE_EXT,
        ".xhtml"^^euvoc:FILE_EXT,
        "application/xhtml+xml"^^euvoc:IANA_MT,
        "xhtml_simpl"^^nma-vocabularies:invenioid ;

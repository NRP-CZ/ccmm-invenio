    europa-ontology-authority:authority-code "RDF_N_TRIPLES" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "RDF_N_TRIPLES" ;
    europa-ontology-authority:start.use "2008-02-17" ;
    euvoc:order 1180 ;
    europa-authority:op-code "RDF_N_TRIPLES" ;
    dce:identifier "RDF_N_TRIPLES" ;
    skos:altLabel "Resource Description Framework N-Triples"@en ;
    skos:definition "RDF N-Triples is a line-based, plain text format for encoding an RDF graph; a concrete syntax for RDF, an easy to parse line-based subset of Turtle."@en ;
    skos:exactMatch europa-file-type:RDF_N_TRIPLES ;
    skos:inScheme nma-fileformats: ;
    skos:notation "rdf_n_triples"^^euvoc:CELLAR_MANIFT,
        "application/n-triples"^^euvoc:CELLAR_MT,

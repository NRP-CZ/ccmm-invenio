    europa-authority:op-code "RDFA" ;
    dce:identifier "RDFA" ;
    skos:altLabel "Resource Description Framework in Attributes"@en ;
    skos:definition "RDFa is a technique that provides a set of markup attributes to augment the visual information on the Web with machine-readable hints."@en ;
    skos:exactMatch europa-file-type:RDFA ;
    skos:inScheme nma-fileformats: ;

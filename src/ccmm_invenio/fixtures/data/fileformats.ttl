    dce:identifier "WAV" ;
    skos:altLabel "Waveform Audio File"@en ;
    skos:definition "Waveform Audio File (WAV) is a format is used for storing uncompressed digital audio files. It is the default audio format for Windows but it is supported by most operating systems."@en ;
    skos:exactMatch europa-file-type:WAV ;
    skos:inScheme nma-fileformats: ;

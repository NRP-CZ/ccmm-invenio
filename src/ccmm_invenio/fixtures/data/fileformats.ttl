        "rdf_xml"^^nma-vocabularies:invenioid ;
    skos:prefLabel "RDF XML"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:rdfa a skos:Concept ;
    europa-ontology-authority:authority-code "RDFA" ;
    europa-ontology-authority:deprecated "false" ;

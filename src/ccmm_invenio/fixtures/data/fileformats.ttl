        "text/css"^^euvoc:IANA_MT,
        "css"^^nma-vocabularies:invenioid ;
    skos:prefLabel "CSS"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:csv a skos:Concept ;

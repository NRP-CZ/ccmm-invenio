        ".tiff"^^euvoc:FILE_EXT,
        "image/tiff-fx"^^euvoc:IANA_MT,
        "tiff_fx"^^nma-vocabularies:invenioid ;
    skos:prefLabel "TIFF FX"@en ;
    skos:topConceptOf nma-fileformats: .


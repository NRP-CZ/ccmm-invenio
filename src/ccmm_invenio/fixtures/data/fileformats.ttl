    skos:topConceptOf nma-fileformats: .

nma-fileformats:xlsb a skos:Concept ;
    europa-ontology-authority:authority-code "XLSB" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "XLSB" ;
    europa-ontology-authority:start.use "2007-01-30" ;
    europa-authority:op-code "XLSB" ;
    dce:identifier "XLSB" ;
    skos:altLabel "Excel Binary Workbook"@en ;
    skos:definition "A file with the XLSB file extension is an Excel Binary Workbook file. They store information in binary format instead of XML like with most other Excel files (like XLSX). Since XLSB files are binary, they can be read from and written to much faster, making them extremely useful for very large spreadsheets."@en ;
    skos:exactMatch europa-file-type:XLSB ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".xlsb"^^euvoc:FILE_EXT,
        "application/vnd.ms-excel.sheet.binary.macroEnabled.12"^^euvoc:IANA_MT,
        "xlsb"^^nma-vocabularies:invenioid ;
    skos:prefLabel "XLSB"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:xlsm a skos:Concept ;
    europa-ontology-authority:authority-code "XLSM" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "XLSM" ;
    europa-ontology-authority:start.use "2007-01-30" ;
    europa-authority:op-code "XLSM" ;
    dce:identifier "XLSM" ;
    skos:altLabel "Excel Macro-enabled Workbook"@en ;
    skos:definition "An Excel Macro-enabled Workbook contains worksheets of cells arranged by rows and columns as well as embedded macros programmed in the Visual Basic for Applications (VBA) language. XLSM files are saved in the Open XML format introduced in Microsoft Office 2007. XLSM files are XLSX files, but with macros enabled."@en ;
    skos:exactMatch europa-file-type:XLSM ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".xlsm"^^euvoc:FILE_EXT,
        "application/vnd.ms-excel.sheet.macroEnabled.12"^^euvoc:IANA_MT,
        "xlsm"^^nma-vocabularies:invenioid ;
    skos:prefLabel "XLSM"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:xlsx a skos:Concept ;
    europa-ontology-authority:authority-code "XLSX" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "XLSX" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 500 ;
    europa-authority:op-code "XLSX" ;
    dce:identifier "XLSX" ;
    skos:altLabel "Office Open XML Workbook"@en ;
    skos:definition "XLSX is the default file format for Excel 2007 and later workbook used for Microsoft Excel spreadsheet which features calculation, graphing tools, pivot tables and a macro programming language. XLSX is in reality a ZIP compressed archive with a directory structure of XML text documents."@en ;
    skos:exactMatch europa-file-type:XLSX ;
    skos:inScheme nma-fileformats: ;
    skos:notation "xlsx"^^euvoc:CELLAR_MANIFT,
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"^^euvoc:CELLAR_MT,
        ".xlsx"^^euvoc:FILE_EXT,
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"^^euvoc:IANA_MT,
        "xlsx"^^nma-vocabularies:invenioid ;
    skos:prefLabel "Excel XLSX"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:xml a skos:Concept ;
    europa-ontology-authority:authority-code "XML" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "XML" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 50 ;
    europa-authority:op-code "XML" ;
    dce:identifier "XML" ;
    skos:altLabel "Extensible Markup Language"@en ;
    skos:definition "XML – Extensible Markup Language – is a markup language that defines a set of rules for encoding documents in a format that is both human-readable and machine-readable. The design goals of XML emphasize simplicity, generality and usability across the Internet."@en ;
    skos:exactMatch europa-file-type:XML ;
    skos:inScheme nma-fileformats: ;
    skos:notation "xml"^^euvoc:CELLAR_MANIFT,
        "application/xml"^^euvoc:CELLAR_MT,
        ".xml"^^euvoc:FILE_EXT,
        "application/xml"^^euvoc:IANA_MT,
        "xml"^^nma-vocabularies:invenioid ;
    skos:prefLabel "XML"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:xslfo a skos:Concept ;
    europa-ontology-authority:authority-code "XSLFO" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "XSLFO" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    europa-authority:op-code "XSLFO" ;
    dce:identifier "XSLFO" ;
    skos:altLabel "Extensible Stylesheet Language – Formatting Objects"@en ;
    skos:definition "XSL-FO – XSL Formatting Objects – is a markup language for XML document formatting that is most often used to generate PDF files. XSL-FO is part of XSL (Extensible Stylesheet Language), a set of W3C technologies designed for the transformation and formatting of XML data."@en ;
    skos:exactMatch europa-file-type:XSLFO ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".fo"^^euvoc:FILE_EXT,
        "application/xml"^^euvoc:IANA_MT,
        "xslfo"^^nma-vocabularies:invenioid ;
    skos:prefLabel "XSL-FO"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:xslt a skos:Concept ;
    europa-ontology-authority:authority-code "XSLT" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "XSLT" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 400 ;
    europa-authority:op-code "XSLT" ;
    dce:identifier "XSLT" ;
    skos:altLabel "Extensible Stylesheet Language Transformations"@en ;
    skos:definition "XSLT – Extensible Stylesheet Language Transformations – is a language for transforming XML documents into other XML documents or other formats such as HTML for web pages, plain text or XSL Formatting Objects, which may subsequently be converted to other formats, such as PDF, PostScript and PNG."@en ;
    skos:exactMatch europa-file-type:XSLT ;
    skos:historyNote "{op_comment_eng_private} XSLT : OP-code is not \"XSLT_XML\" because the serialisation is always XML and it is not likely to become another language."@en ;
    skos:inScheme nma-fileformats: ;
    skos:notation "xslt"^^euvoc:CELLAR_MANIFT,
        "application/xslt+xml"^^euvoc:CELLAR_MT,
        ".xsl"^^euvoc:FILE_EXT,
        ".xslt"^^euvoc:FILE_EXT,
        "application/xslt+xml"^^euvoc:IANA_MT,
        "xslt"^^nma-vocabularies:invenioid ;
    skos:prefLabel "XSLT"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:xyz a skos:Concept ;
    europa-ontology-authority:authority-code "XYZ" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "XYZ" ;
    europa-ontology-authority:start.use "2010-10-10" ;
    europa-authority:op-code "XYZ" ;
    dce:identifier "XYZ" ;
    skos:definition "The XYZ file format is a chemical file format. There is no formal standard and several variations exist, but a typical XYZ format specifies the molecule geometry by giving the number of atoms with Cartesian coordinates that will be read on the first line, a comment on the second, and the lines of atomic coordinates in the following lines."@en ;
    skos:exactMatch europa-file-type:XYZ ;
    skos:inScheme nma-fileformats: ;
    skos:notation "chemical/x-pdb"^^euvoc:CELLAR_MT,
        ".xyz"^^euvoc:FILE_EXT,
        "chemical/x-xyz"^^euvoc:IANA_MT,
        "xyz"^^nma-vocabularies:invenioid ;
    skos:prefLabel "XYZ Chemical File"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:xz a skos:Concept ;
    europa-ontology-authority:authority-code "XZ" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "XZ" ;
    europa-ontology-authority:start.use "2010-10-23" ;
    europa-authority:op-code "XZ" ;
    dce:identifier "XZ" ;
    skos:altLabel "xz compressed file"@en ;
    skos:definition "Compressed file produced using XZ Utils (free software command-line lossless data compressors, including LZMA and xz)."@en ;
    skos:exactMatch europa-file-type:XZ ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".xz"^^euvoc:FILE_EXT,
        "application/x-xz"^^euvoc:IANA_MT,
        "xz"^^nma-vocabularies:invenioid ;
    skos:prefLabel "xz"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:yaml a skos:Concept ;
    europa-ontology-authority:authority-code "YAML" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "YAML" ;
    europa-ontology-authority:start.use "2001-05-11" ;
    europa-authority:op-code "YAML" ;
    dce:identifier "YAML" ;
    skos:altLabel "YAML Ain't Markup Language"@en ;
    skos:definition "YAML is a human-friendly, cross language, Unicode based data serialization language designed around the common native data types of dynamic programming languages. It is broadly useful for programming needs ranging from configuration files to internet messaging to object persistence to data auditing and visualization."@en ;
    skos:exactMatch europa-file-type:YAML ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".yaml"^^euvoc:FILE_EXT,
        ".yml"^^euvoc:FILE_EXT,
        "application/yaml"^^euvoc:IANA_MT,
        "yaml"^^nma-vocabularies:invenioid ;
    skos:prefLabel "YAML"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:z a skos:Concept ;
    europa-ontology-authority:authority-code "Z" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "Z" ;
    europa-ontology-authority:start.use "1985-02-01" ;
    europa-authority:op-code "Z" ;
    dce:identifier "Z" ;
    skos:altLabel "Unix compressed file"@en ;
    skos:definition "Compressed file produced by Unix shell compression program based on the LZW (Lempel-Ziv-Welch) compression algorithm."@en ;
    skos:exactMatch europa-file-type:Z ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".Z"^^euvoc:FILE_EXT,
        "application/x-compress"^^euvoc:IANA_MT,
        "z"^^nma-vocabularies:invenioid ;
    skos:prefLabel "Z"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:zip a skos:Concept ;
    europa-ontology-authority:authority-code "ZIP" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "ZIP" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 300 ;
    europa-authority:op-code "ZIP" ;
    dce:identifier "ZIP" ;
    skos:definition "ZIP is an archive file format that supports lossless data compression. A ZIP file may contain one or more files or directories that may have been compressed."@en ;
    skos:exactMatch europa-file-type:ZIP ;
    skos:inScheme nma-fileformats: ;
    skos:notation "zip"^^euvoc:CELLAR_MANIFT,
        "application/zip"^^euvoc:CELLAR_MT,
        ".zip"^^euvoc:FILE_EXT,
        "application/zip"^^euvoc:IANA_MT,
        "zip"^^nma-vocabularies:invenioid ;
    skos:prefLabel "ZIP"@en ;
    skos:topConceptOf nma-fileformats: .


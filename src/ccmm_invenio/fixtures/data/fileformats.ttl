    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 2300 ;
    europa-authority:op-code "PDF" ;
    dce:identifier "PDF" ;
    skos:altLabel "Portable Document Format"@en ;
    skos:definition "PDF – Portable Document Format – is a file format developed to present documents, including text formatting and images, in a manner independent of application software, hardware and operating systems. Based on the PostScript language, each PDF file encapsulates a complete description of a fixed-layout flat document, including the text, fonts, vector graphics, raster images and other information needed to display it. PDF was standardized as an open format and does not require any royalties for its implementation."@en ;
    skos:exactMatch europa-file-type:PDF ;
    skos:historyNote "ISO 32000-1"@en ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pdf"^^euvoc:CELLAR_MANIFT,
        "application/pdf;type=pdf1x"^^euvoc:CELLAR_MT,
        ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdf"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdf1x a skos:Concept ;
    europa-ontology-authority:authority-code "PDF1X" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDF1X" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 2800 ;
    europa-authority:op-code "PDF1X" ;
    dce:identifier "PDF1X" ;
    skos:altLabel "PDF printing format extension"@en ;
    skos:definition "PDF1X is a PDF specification used mainly for high quality color printing."@en ;
    skos:exactMatch europa-file-type:PDF1X ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pdf1x"^^euvoc:CELLAR_MANIFT,
        "application/pdf"^^euvoc:CELLAR_MT,
        "application/pdf;type=pdf1x"^^euvoc:CELLAR_MT,
        ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdf1x"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF1X"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfa1a a skos:Concept ;
    europa-ontology-authority:authority-code "PDFA1A" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFA1A" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 2700 ;
    europa-authority:op-code "PDFA1A" ;
    dce:identifier "PDFA1A" ;
    skos:altLabel "PDF archiving format, Level A conformance"@en ;
    skos:definition "PDF/A-1 is the Part 1 of the PDF standard and specifies two levels of conformance for PDF files. PDF/A-1a – Level A (accessible) conformance was intended to increase the accessibility of conforming files for physically impaired users by allowing assistive software, such as screen readers, to more precisely extract and interpret a file's contents."@en ;
    skos:exactMatch europa-file-type:PDFA1A ;
    skos:historyNote "ISO 19005-1"@en,
        "PDF/A-1 is based on the PDF Reference Version 1.4 from Adobe Systems Inc. implemented in Adobe Acrobat 5 and latest versions. PDF/A-1 is also called \"web optimised\"."@en ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pdfa1a"^^euvoc:CELLAR_MANIFT,
        "application/pdf;type=pdfa1a"^^euvoc:CELLAR_MT,
        ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfa1a"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/A-1a"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfa1b a skos:Concept ;
    europa-ontology-authority:authority-code "PDFA1B" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFA1B" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 2600 ;
    europa-authority:op-code "PDFA1B" ;
    dce:identifier "PDFA1B" ;
    skos:altLabel "PDF archiving format, Level B conformance"@en ;
    skos:definition "PDF/A-1 is the Part 1 of the PDF standard and specifies two levels of conformance for PDF files. Level B (basic) conformance requires only that standards necessary for the reliable reproduction of a document's visual appearance be followed."@en ;
    skos:exactMatch europa-file-type:PDFA1B ;
    skos:historyNote "ISO 19005-1"@en,
        "PDF/A-1 is based on the PDF Reference Version 1.4 from Adobe Systems Inc. implemented in Adobe Acrobat 5 and latest versions. PDF/A-1 is also called \"web optimised\"."@en ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pdfa1b"^^euvoc:CELLAR_MANIFT,
        "application/pdf;type=pdfa1b"^^euvoc:CELLAR_MT,
        ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfa1b"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/A-1b"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfa2a a skos:Concept ;
    europa-ontology-authority:authority-code "PDFA2A" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFA2A" ;
    europa-ontology-authority:start.use "2011-07-01" ;
    euvoc:order 2480 ;
    europa-authority:op-code "PDFA2A" ;
    dce:identifier "PDFA2A" ;
    skos:definition "PDF/A-2 is the Part 2 of the PDF standard and specifies three levels of conformance for PDF files. PDF/A-2a corresponds to conformance level a in PDF/A-1 (accessible)."@en ;
    skos:exactMatch europa-file-type:PDFA2A ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pdfa2a"^^euvoc:CELLAR_MANIFT,
        "application/pdf;type=pdfa2a"^^euvoc:CELLAR_MT,
        ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfa2a"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/A-2a"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfa2b a skos:Concept ;
    europa-ontology-authority:authority-code "PDFA2B" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFA2B" ;
    europa-ontology-authority:start.use "2011-07-01" ;
    euvoc:order 2460 ;
    europa-authority:op-code "PDFA2B" ;
    dce:identifier "PDFA2B" ;
    skos:definition "PDF/A-2 is the Part 2 of the PDF standard and specifies three levels of conformance for PDF files. PDF/A-2b corresponds to conformance level a in PDF/A-2 (basic)."@en ;
    skos:exactMatch europa-file-type:PDFA2B ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pdfa2b"^^euvoc:CELLAR_MANIFT,
        "application/pdf;type=pdfa2b"^^euvoc:CELLAR_MT,
        ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfa2b"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/A-2b"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfa3 a skos:Concept ;
    europa-ontology-authority:authority-code "PDFA3" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFA3" ;
    europa-ontology-authority:start.use "2012-10-15" ;
    euvoc:order 2440 ;
    europa-authority:op-code "PDFA3" ;
    dce:identifier "PDFA3" ;
    skos:definition "ISO-standardised version of the Portable Document Format specialized for use in the archiving and long-term preservation of electronic documents; PDF/A-3 is the Part 3 of the standard which differs from PDF/A-2 in only one regard – it allows embedding of arbitrary file formats (such as XML, CSV, CAD, word-processing documents, spreadsheet documents and others) into PDF/A conforming documents"@en ;
    skos:exactMatch europa-file-type:PDFA3 ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pdfa3"^^euvoc:CELLAR_MANIFT,
        "application/pdf;type=pdfa3"^^euvoc:CELLAR_MT,
        ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfa3"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/A-3"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfa3a a skos:Concept ;
    europa-ontology-authority:authority-code "PDFA3A" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFA3A" ;
    europa-ontology-authority:start.use "2012-10-15" ;
    europa-authority:op-code "PDFA3A" ;
    dce:identifier "PDFA3A" ;
    skos:definition "PDF/A-3 subtype ensuring both accessibility and structure preservation, similar to PDF/A-2a"@en ;
    skos:exactMatch europa-file-type:PDFA3A ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfa3a"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/A-3a"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfa3b a skos:Concept ;
    europa-ontology-authority:authority-code "PDFA3B" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFA3B" ;
    europa-ontology-authority:start.use "2012-10-15" ;
    europa-authority:op-code "PDFA3B" ;
    dce:identifier "PDFA3B" ;
    skos:definition "PDF/A-3 subtype that guarantees visual fidelity without regard for structure"@en ;
    skos:exactMatch europa-file-type:PDFA3B ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfa3b"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/A-3b"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfa3u a skos:Concept ;
    europa-ontology-authority:authority-code "PDFA3U" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFA3U" ;
    europa-ontology-authority:start.use "2012-10-15" ;
    europa-authority:op-code "PDFA3U" ;
    dce:identifier "PDFA3U" ;
    skos:definition "PDF/A-3 subtype that supports Unicode, ensuring that non-Latin text is correctly represented"@en ;
    skos:exactMatch europa-file-type:PDFA3U ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfa3u"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/A-3u"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfua a skos:Concept ;
    europa-ontology-authority:authority-code "PDFUA" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFUA" ;
    europa-ontology-authority:start.use "2012-07-15" ;
    euvoc:order 2250 ;
    europa-authority:op-code "PDFUA" ;
    dce:identifier "PDFUA" ;
    skos:altLabel "PDF/Universal Accessibility"@en ;
    skos:definition "PDF/UA (PDF/Universal Accessibility), formally ISO 14289, is an International Organization for Standardization (ISO) standard for accessible PDF technology. A technical specification intended for developers implementing PDF writing and processing software, PDF/UA provides definitive terms and requirements for accessibility in PDF documents and applications. For those equipped with appropriate software, conformance with PDF/UA ensures accessibility for people with disabilities who use assistive technology such as screen readers, screen magnifiers, joysticks and other technologies to navigate and read electronic content."@en ;
    skos:exactMatch europa-file-type:PDFUA ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pdfua"^^euvoc:CELLAR_MANIFT,
        "application/pdf;type=pdfua"^^euvoc:CELLAR_MT,
        ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfua"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/UA"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfx a skos:Concept ;
    europa-ontology-authority:authority-code "PDFX" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFX" ;
    europa-ontology-authority:start.use "2001-12-01" ;
    euvoc:order 2500 ;
    europa-authority:op-code "PDFX" ;
    dce:identifier "PDFX" ;
    skos:altLabel "PDF printing format, Blind eXchange"@en ;
    skos:definition "PDF/X is a subset of the PDF standard. The purpose of PDF/X is to facilitate graphics exchange, and it therefore has a series of printing related requirements which do not apply to standard PDF files."@en ;
    skos:exactMatch europa-file-type:PDFX ;
    skos:historyNote "ISO 15930"@en,
        "PDF/X is also called \"print optimised\"."@en ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pdfx"^^euvoc:CELLAR_MANIFT,
        "application/pdf;type=pdfx"^^euvoc:CELLAR_MT,
        ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfx"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/X"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfx1a a skos:Concept ;
    europa-ontology-authority:authority-code "PDFX1A" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFX1A" ;
    europa-ontology-authority:start.use "2001-12-01" ;
    euvoc:order 2430 ;
    europa-authority:op-code "PDFX1A" ;
    dce:identifier "PDFX1A" ;
    skos:definition "PDF/X-1a is a PDF specification which completes exchange using CMYK data and spots colour printing data."@en ;
    skos:exactMatch europa-file-type:PDFX1A ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pdfx1a"^^euvoc:CELLAR_MANIFT,
        "application/pdf;type=pdfx1a"^^euvoc:CELLAR_MT,
        ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfx1a"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/X-1a"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfx2a a skos:Concept ;
    europa-ontology-authority:authority-code "PDFX2A" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFX2A" ;
    europa-ontology-authority:start.use "2003-12-01" ;
    euvoc:order 2420 ;
    europa-authority:op-code "PDFX2A" ;
    dce:identifier "PDFX2A" ;
    skos:definition "PDF/X-2a is a PDF specification in which colour-managed, CMYK and spot colour data are supported in any combination."@en ;
    skos:exactMatch europa-file-type:PDFX2A ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pdfx2a"^^euvoc:CELLAR_MANIFT,
        "application/pdf;type=pdfx2a"^^euvoc:CELLAR_MT,
        ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfx2a"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/X-2a"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pdfx4 a skos:Concept ;
    europa-ontology-authority:authority-code "PDFX4" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PDFX4" ;
    europa-ontology-authority:start.use "2008-03-01" ;
    euvoc:order 2410 ;
    europa-authority:op-code "PDFX4" ;
    dce:identifier "PDFX4" ;
    skos:definition "PDF/X-4 is a PDF specification in which colour-managed, CMYK, gray, RGB or spot colour data are supported, as are PDF transparency and optional content."@en ;
    skos:exactMatch europa-file-type:PDFX4 ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pdfx4"^^euvoc:CELLAR_MANIFT,
        "application/pdf;type=pdfx4"^^euvoc:CELLAR_MT,
        ".pdf"^^euvoc:FILE_EXT,
        "application/pdf"^^euvoc:IANA_MT,
        "pdfx4"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PDF/X-4"@en ;
    skos:topConceptOf nma-fileformats: .


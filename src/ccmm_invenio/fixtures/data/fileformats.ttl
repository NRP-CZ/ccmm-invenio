nma-fileformats:xliff a skos:Concept ;
    europa-ontology-authority:authority-code "XLIFF" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "XLIFF" ;
    europa-ontology-authority:start.use "2001-05-30" ;
    europa-authority:op-code "XLIFF" ;
    dce:identifier "XLIFF" ;
    skos:altLabel "XML Localisation Interchange File Format"@en ;
    skos:definition "XLIFF is the XML Localisation Interchange File Format designed by a group of multilingual content publishers, software providers, localization service providers, localization tools providers and researchers. It is intended to give any multilingual content owner a single interchange file format that can be understood by any localization provider, using any conformant localization tool. While the primary focus is on being a lossless interchange format, usage of XLIFF as a processing format is neither encouraged nor discouraged or prohibited."@en ;
    skos:exactMatch europa-file-type:XLIFF ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".xlf"^^euvoc:FILE_EXT,
        "application/xliff+xml"^^euvoc:IANA_MT,
        "xliff"^^nma-vocabularies:invenioid ;
    skos:prefLabel "XLIFF"@en ;
    skos:topConceptOf nma-fileformats: .


    europa-ontology-authority:authority-code "JSON" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "JSON" ;
    europa-ontology-authority:start.use "2006-07-01" ;
    europa-authority:op-code "JSON" ;
    dce:identifier "JSON" ;
    skos:altLabel "JavaScript Object Notation"@en ;
    skos:definition "JSON is an open-standard file format that uses human-readable text to transmit data objects consisting of attribute–value pairs and array data types (or any other serializable value). It is a very common data format used for asynchronous browser/server communication."@en ;
    skos:exactMatch europa-file-type:JSON ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".json"^^euvoc:FILE_EXT,
        "application/json"^^euvoc:IANA_MT,
        "json"^^nma-vocabularies:invenioid ;
    skos:prefLabel "JSON"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:json_ld a skos:Concept ;
    europa-ontology-authority:authority-code "JSON_LD" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "JSON_LD" ;
    europa-ontology-authority:start.use "2011-12-27" ;
    europa-authority:op-code "JSON_LD" ;
    dce:identifier "JSON_LD" ;
    skos:altLabel "JavaScript Object Notation for Linked Data"@en ;
    skos:definition "JSON-LD is a JSON-based format to serialize Linked Data. It is primarily intended to be a way to use Linked Data in Web-based programming environments, to build interoperable Web services, and to store Linked Data in JSON-based storage engines."@en ;
    skos:exactMatch europa-file-type:JSON_LD ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".jsonld"^^euvoc:FILE_EXT,
        "application/ld+json"^^euvoc:IANA_MT,
        "json_ld"^^nma-vocabularies:invenioid ;
    skos:prefLabel "JSON-LD"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:kml a skos:Concept ;
    europa-ontology-authority:authority-code "KML" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "KML" ;
    europa-ontology-authority:start.use "2013-09-18" ;
    europa-authority:op-code "KML" ;
    dce:identifier "KML" ;
    skos:altLabel "Keyhole Markup Language"@en ;
    skos:definition "KML – Keyhole Markup Language – is an XML notation for expressing geographic annotation and visualization within Internet-based, two-dimensional maps and three-dimensional Earth browsers. KML was developed for use with Google Earth and became an international standard."@en ;
    skos:exactMatch europa-file-type:KML ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".kml"^^euvoc:FILE_EXT,
        "application/vnd.google-earth.kml+xml"^^euvoc:IANA_MT,
        "kml"^^nma-vocabularies:invenioid ;
    skos:prefLabel "KML"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:kmz a skos:Concept ;
    europa-ontology-authority:authority-code "KMZ" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "KMZ" ;
    europa-ontology-authority:start.use "2013-11-27" ;
    europa-authority:op-code "KMZ" ;
    dce:identifier "KMZ" ;
    skos:altLabel "Keyhole Markup Language, Zipped"@en ;
    skos:definition "A KMZ file consists of a main KML file and zero or more supporting files that are packaged using a Zip utility into one unit, called an archive. The KMZ file can then be stored and emailed as a single entity. A NetworkLink can fetch a KMZ file from a web server. When the KMZ file is unzipped, the main .kml file and its supporting files are separated into their original formats and directory structure, with their original filenames and extensions. In addition to being an archive format, the Zip format is also compressed, so an archive can include only a single large KML file. Depending on the content of the KML file, this process typically results in 10:1 compression. Your 10 Kbyte KML file can be served with a 1 Kbyte KMZ file."@en ;
    skos:exactMatch europa-file-type:KMZ ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".kmz"^^euvoc:FILE_EXT,
        "application/vnd.google-earth.kmz"^^euvoc:IANA_MT,
        "kmz"^^nma-vocabularies:invenioid ;
    skos:prefLabel "KMZ"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:las a skos:Concept ;
    europa-ontology-authority:authority-code "LAS" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "LAS" ;
    europa-ontology-authority:start.use "2003-05-09" ;
    europa-authority:op-code "LAS" ;
    dce:identifier "LAS" ;
    skos:definition "LAS – LASer file format – is the media type which shall be used for a public file format for the interchange of 3-dimensional point cloud data data between data users."@en ;
    skos:exactMatch europa-file-type:LAS ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".las"^^euvoc:FILE_EXT,

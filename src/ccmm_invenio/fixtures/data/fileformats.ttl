nma-fileformats:png a skos:Concept ;
    europa-ontology-authority:authority-code "PNG" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PNG" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 100 ;
    europa-authority:op-code "PNG" ;
    dce:identifier "PNG" ;
    skos:altLabel "Portable Network Graphics"@en ;
    skos:definition "PNG – Portable Network Graphics – is a raster graphics file format that supports lossless data compression. PNG was created as an improved, non-patented replacement for Graphics Interchange Format (GIF), and is the most widely used lossless image compression format on the Internet."@en ;
    skos:exactMatch europa-file-type:PNG ;
    skos:inScheme nma-fileformats: ;
    skos:notation "png"^^euvoc:CELLAR_MANIFT,
        "image/png"^^euvoc:CELLAR_MT,
        ".png"^^euvoc:FILE_EXT,
        "image/png"^^euvoc:IANA_MT,
        "png"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PNG"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pps a skos:Concept ;
    europa-ontology-authority:authority-code "PPS" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PPS" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    europa-authority:op-code "PPS" ;
    dce:identifier "PPS" ;
    skos:altLabel "Microsoft PowerPoint Slide Show"@en ;
    skos:definition "PPS – PowerPoint 97–2003 binary slide show – is a binary filaname extension of Microsoft PowerPoint presentation program. PowerPoint was originally designed to provide visuals for group presentations within business organizations, but has come to be very widely used in many other communication situations, both in business and beyond."@en ;
    skos:exactMatch europa-file-type:PPS ;
    skos:inScheme nma-fileformats: ;
    skos:notation "application/vnd.ms-powerpoint"^^euvoc:CELLAR_MT,
        ".pps"^^euvoc:FILE_EXT,
        "application/vnd.ms-powerpoint"^^euvoc:IANA_MT,
        "pps"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PowerPoint Slide Show"@en ;
    skos:topConceptOf nma-fileformats: .


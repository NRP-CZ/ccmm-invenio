    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "TMX" ;
    europa-ontology-authority:start.use "1997-11-25" ;
    europa-authority:op-code "TMX" ;
    dce:identifier "TMX" ;
    skos:altLabel "Translation Memory eXchange"@en ;
    skos:definition "TMX – Translation Memory eXchange – is an XML specification for the exchange of translation memory data between computer-aided translation and localization tools with little or no loss of critical data."@en ;
    skos:exactMatch europa-file-type:TMX ;
    skos:inScheme nma-fileformats: ;
    skos:notation "application/xml"^^euvoc:CELLAR_MT,
        ".xml"^^euvoc:FILE_EXT,
        "application/xml"^^euvoc:IANA_MT,

        "application/n-triples"^^euvoc:IANA_MT,
        "rdf_n_triples"^^nma-vocabularies:invenioid ;
    skos:prefLabel "RDF N-Triples"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:rdf_thrift a skos:Concept ;
    europa-ontology-authority:authority-code "RDF_THRIFT" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "RDF_THRIFT" ;
    europa-ontology-authority:start.use "2014-01-01" ;
    europa-authority:op-code "RDF_THRIFT" ;
    dce:identifier "RDF_THRIFT" ;
    skos:altLabel "RDF Binary Thrift"@en ;
    skos:definition "RDF Binary using Apache Thrift (‘RDF Thrift’) is a binary format for RDF and RDF-related data. Binary formats are faster to process – they do not incur the parsing costs of text-base formats. RDF Thrift defines basic encoding for RDF terms, then builds data formats for RDF graphs, RDF datasets and for SPARQL result sets. This gives a basis for high-performance linked data systems."@en ;
    skos:exactMatch europa-file-type:RDF_THRIFT ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".rt"^^euvoc:FILE_EXT,
        ".trdf"^^euvoc:FILE_EXT,
        "application/rdf+thrift"^^euvoc:IANA_MT,
        "rdf_thrift"^^nma-vocabularies:invenioid ;
    skos:prefLabel "RDF Thrift"@en ;
    skos:topConceptOf nma-fileformats: .


    europa-authority:op-code "GEOTIFF" ;
    dce:identifier "GEOTIFF" ;
    skos:altLabel "OGC GeoTIFF"@en ;
    skos:definition "GeoTIFF is a public domain metadata standard which allows georeferencing information to be embedded within a TIFF file. The potential additional information includes map projection, coordinate systems, ellipsoids, datums, and everything else necessary to establish the exact spatial reference for the file."@en ;
    skos:exactMatch europa-file-type:GEOTIFF ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".tiff"^^euvoc:FILE_EXT,
        "image/tiff"^^euvoc:IANA_MT,

    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "JS" ;
    europa-ontology-authority:start.use "1995-12-04" ;
    euvoc:order 60 ;
    europa-authority:op-code "JS" ;
    dce:identifier "JS" ;
    skos:definition "JavaScript is a high-level, interpreted programming language. It is a language which is also characterized as dynamic, weakly typed, prototype-based and multi-paradigm."@en ;

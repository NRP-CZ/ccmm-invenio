    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 600 ;
    europa-authority:op-code "XLS" ;
    dce:identifier "XLS" ;
    skos:altLabel "Microsof Excel Workbook"@en ;
    skos:definition "XLS is a proprietary binary file format used for Microsoft Excel spreadsheet which features calculation, graphing tools, pivot tables and a macro programming language."@en ;

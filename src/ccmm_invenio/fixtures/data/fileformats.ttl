nma-fileformats:jpeg a skos:Concept ;
    europa-ontology-authority:authority-code "JPEG" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "JPEG" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 1700 ;
    europa-authority:op-code "JPEG" ;
    dce:identifier "JPEG" ;
    skos:definition "JPEG – Joint Photographic Experts Group – is a commonly used method of lossy compression for digital images, particularly for those images produced by digital photography. The degree of compression can be adjusted, allowing a selectable tradeoff between storage size and image quality."@en ;
    skos:exactMatch europa-file-type:JPEG ;
    skos:inScheme nma-fileformats: ;
    skos:notation "jepg"^^euvoc:CELLAR_MANIFT,
        "image/jpeg"^^euvoc:CELLAR_MT,
        ".jpeg"^^euvoc:FILE_EXT,
        ".jpg"^^euvoc:FILE_EXT,
        "image/jpeg"^^euvoc:IANA_MT,

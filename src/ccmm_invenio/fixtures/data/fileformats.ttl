    europa-ontology-authority:op-code "WORLD" ;
    europa-ontology-authority:start.use "2001-03-26" ;
    europa-authority:op-code "WORLD" ;
    dce:identifier "WORLD" ;
    skos:definition "A world file is a plain text computer data file used by geographic information systems (GIS) to georeference raster map images. The file extension usually depends on the format of the associated image, e.g. .jgw for JPEG (2000) or .tfw for TIFF."@en ;
    skos:exactMatch europa-file-type:WORLD ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".jgw"^^euvoc:FILE_EXT,
        ".tfw"^^euvoc:FILE_EXT,
        "application/x-worldfile"^^euvoc:IANA_MT,
        "world"^^nma-vocabularies:invenioid ;
    skos:prefLabel "World file"@en ;
    skos:topConceptOf nma-fileformats: .


    dce:identifier "GTFS" ;
    skos:altLabel "General Transit Feed Specification"@en ;
    skos:definition "The General Transit Feed Specification (GTFS) is a data specification that allows public transit agencies to publish their transit data in a format that can be consumed by a wide variety of software applications. GTFS is split into a schedule component that contains schedule, fare, and geographic transit information and a real-time component that contains arrival predictions, vehicle positions and service advisories."@en ;
    skos:exactMatch europa-file-type:GTFS ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".zip"^^euvoc:FILE_EXT,
        "application/zip"^^euvoc:IANA_MT,
        "gtfs"^^nma-vocabularies:invenioid ;
    skos:prefLabel "GTFS"@en ;
    skos:topConceptOf nma-fileformats: .


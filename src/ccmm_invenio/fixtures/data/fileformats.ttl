    skos:altLabel "Journal Article Tag Suite"@en ;
    skos:definition "JATS – Journal Article Tag Suite – is an XML format used to describe scientific literature published online. It is a technical standard developed by the National Information Standards Organization (NISO)."@en ;
    skos:exactMatch europa-file-type:JATS ;

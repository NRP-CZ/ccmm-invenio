        "text/javascript"^^euvoc:CELLAR_MT,
        ".js"^^euvoc:FILE_EXT,
        "application/javascript"^^euvoc:IANA_MT,
        "text/javascript"^^euvoc:IANA_MT,
        "js"^^nma-vocabularies:invenioid ;
    skos:prefLabel "JavaScript"@en ;

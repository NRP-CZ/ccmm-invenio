    europa-ontology-authority:start.use "2013-05-21" ;
    euvoc:order 90 ;
    europa-authority:op-code "CSV" ;
    dce:identifier "CSV" ;
    skos:altLabel "Comma-Separated Values"@en ;
    skos:definition "CSV – comma-separated values – files store tabular data (numbers and text) in plain text. Each line of the file is a data record. Each record consists of one or more fields, separated by commas."@en ;
    skos:exactMatch europa-file-type:CSV ;
    skos:inScheme nma-fileformats: ;

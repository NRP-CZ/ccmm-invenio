    europa-ontology-authority:start.use "2012-09-01" ;
    europa-authority:op-code "ISO_ZIP" ;
    dce:identifier "ISO_ZIP" ;
    skos:altLabel "Zipped ISO Disc Image file"@en ;
    skos:definition "ZIP archive containing an ISO disc image file."@en ;

        "text/csv"^^euvoc:CELLAR_MT,
        ".csv"^^euvoc:FILE_EXT,
        "text/csv"^^euvoc:IANA_MT,
        "csv"^^nma-vocabularies:invenioid ;
    skos:prefLabel "CSV"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:dapk a skos:Concept ;
    europa-ontology-authority:authority-code "DAPK" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DAPK" ;
    europa-ontology-authority:start.use "2022-04-06" ;
    europa-authority:op-code "DAPK" ;
    dce:identifier "DAPK" ;
    skos:altLabel "Android Package (Daydream)"@en ;
    skos:definition "An Android Package (APK) with special features used by the Android operating system for the distribution and installation of Daydream mobile apps."@en ;
    skos:exactMatch europa-file-type:DAPK ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".apk"^^euvoc:FILE_EXT,
        ".xapk"^^euvoc:FILE_EXT,
        "application/vnd.android.package-archive"^^euvoc:IANA_MT,
        "dapk"^^nma-vocabularies:invenioid ;
    skos:prefLabel "DAPK"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:dbf a skos:Concept ;
    europa-ontology-authority:authority-code "DBF" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DBF" ;
    europa-ontology-authority:start.use "2013-09-18" ;
    europa-authority:op-code "DBF" ;
    dce:identifier "DBF" ;
    skos:altLabel "dBase File"@en ;
    skos:definition "DBF – dBase database file – is supported by a number of database products. dBase was one of the first database management systems for microcomputers."@en ;
    skos:exactMatch europa-file-type:DBF ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".dbf"^^euvoc:FILE_EXT,
        "application/x-dbase"^^euvoc:IANA_MT,
        "dbf"^^nma-vocabularies:invenioid ;
    skos:prefLabel "DBF"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:dcr a skos:Concept ;
    europa-ontology-authority:authority-code "DCR" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DCR" ;
    europa-ontology-authority:start.use "1988-01-01" ;
    europa-authority:op-code "DCR" ;
    dce:identifier "DCR" ;
    skos:definition "DCR is a file type for Adobe Shockwave Media files. DCR files are used to create games and other highly interactive content."@en ;
    skos:exactMatch europa-file-type:DCR ;
    skos:inScheme nma-fileformats: ;
    skos:notation "application/x-director"^^euvoc:CELLAR_MT,
        ".dcr"^^euvoc:FILE_EXT,
        "application/x-director"^^euvoc:IANA_MT,
        "dcr"^^nma-vocabularies:invenioid ;
    skos:prefLabel "DCR File"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:deb a skos:Concept ;
    europa-ontology-authority:authority-code "DEB" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DEB" ;
    europa-ontology-authority:start.use "1994-04-01" ;
    europa-authority:op-code "DEB" ;
    dce:identifier "DEB" ;
    skos:altLabel "Debian package"@en ;
    skos:definition "Debian package is a standard Unix ar archive that includes two tar archives. One archive holds the control information and another contains the installable data."@en ;
    skos:exactMatch europa-file-type:DEB ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".deb"^^euvoc:FILE_EXT,
        "application/vnd.debian.binary-package"^^euvoc:IANA_MT,
        "deb"^^nma-vocabularies:invenioid ;
    skos:prefLabel "deb"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:dgn a skos:Concept ;
    europa-ontology-authority:authority-code "DGN" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DGN" ;
    europa-ontology-authority:start.use "2000-01-01" ;
    europa-authority:op-code "DGN" ;
    dce:identifier "DGN" ;
    skos:altLabel "DGN file"@en ;
    skos:definition "A DGN file is a 2D/3D drawing created by various construction CAD software, such as MicroStation and Intergraph Interactive Graphics Design System. It may be saved in one of two formats, either the Intergraph Standard File Format (ISFF) or the newer V8 DGN standard. DGN files are typically used to save designs for construction projects for highways, bridges, and buildings."@en ;
    skos:exactMatch europa-file-type:DGN ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".dgn"^^euvoc:FILE_EXT,
        "application/octet-stream"^^euvoc:IANA_MT,
        "dgn"^^nma-vocabularies:invenioid ;
    skos:prefLabel "DGN"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:dmg a skos:Concept ;
    europa-ontology-authority:authority-code "DMG" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DMG" ;
    europa-ontology-authority:start.use "2001-01-01" ;
    europa-authority:op-code "DMG" ;
    dce:identifier "DMG" ;
    skos:altLabel "Apple Disk Image"@en ;
    skos:definition "Apple Disk Image is a disk image format commonly used by the macOS operating system."@en ;
    skos:exactMatch europa-file-type:DMG ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".dmg"^^euvoc:FILE_EXT,
        "application/x-apple-diskimage"^^euvoc:IANA_MT,
        "dmg"^^nma-vocabularies:invenioid ;
    skos:prefLabel "DMG"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:dmp a skos:Concept ;
    europa-ontology-authority:authority-code "DMP" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DMP" ;
    europa-ontology-authority:start.use "2004-01-01" ;
    europa-authority:op-code "DMP" ;
    dce:identifier "DMP" ;
    skos:definition "DMP is the media type which shall be used for Oracle dumps. This media type is incomplete as it lacks a reference to the specification of the format."@en ;
    skos:exactMatch europa-file-type:DMP ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".dmp"^^euvoc:FILE_EXT,
        "application/x-oracledump"^^euvoc:IANA_MT,
        "dmp"^^nma-vocabularies:invenioid ;
    skos:prefLabel "Oracle Dump"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:doc a skos:Concept ;
    europa-ontology-authority:authority-code "DOC" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DOC" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 2900 ;
    europa-authority:op-code "DOC" ;
    dce:identifier "DOC" ;
    skos:altLabel "Microsoft Word"@en ;
    skos:definition "DOC is a proprietary binary Word document format used by Microsoft Word word processor."@en ;
    skos:exactMatch europa-file-type:DOC ;
    skos:historyNote "In IMMC exchange context, DOC means releases from Word 97 and upwards."@en ;
    skos:inScheme nma-fileformats: ;
    skos:notation "doc"^^euvoc:CELLAR_MANIFT,
        "application/msword"^^euvoc:CELLAR_MT,
        ".doc"^^euvoc:FILE_EXT,
        "application/msword"^^euvoc:IANA_MT,
        "doc"^^nma-vocabularies:invenioid ;
    skos:prefLabel "Word DOC"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:docx a skos:Concept ;
    europa-ontology-authority:authority-code "DOCX" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DOCX" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 2200 ;
    europa-authority:op-code "DOCX" ;
    dce:identifier "DOCX" ;
    skos:altLabel "Office Open XML Document"@en ;
    skos:definition "DOCX is an Office Open XML international standard for Office documents. It is used by Microsoft Word and by a growing number of applications from other vendors in word processing programs."@en ;
    skos:exactMatch europa-file-type:DOCX ;
    skos:inScheme nma-fileformats: ;
    skos:notation "docx"^^euvoc:CELLAR_MANIFT,
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"^^euvoc:CELLAR_MT,
        ".docx"^^euvoc:FILE_EXT,
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document"^^euvoc:IANA_MT,
        "docx"^^nma-vocabularies:invenioid ;
    skos:prefLabel "Word DOCX"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:dtd_sgml a skos:Concept ;
    europa-ontology-authority:authority-code "DTD_SGML" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DTD_SGML" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    europa-authority:op-code "DTD_SGML" ;
    dce:identifier "DTD_SGML" ;
    skos:altLabel "SGML Document Type Definition (DTD)"@en ;
    skos:definition "SGML – Standard Generalized Markup Language – is a standard for defining generalized markup languages for documents. DTD – document type definition – is a set of markup declarations that define a document type for an SGML-family markup language (SGML, XML, HTML). It defines the legal building blocks of an XML document, the document structure with a list of legal elements and attributes."@en ;
    skos:exactMatch europa-file-type:DTD_SGML ;
    skos:inScheme nma-fileformats: ;
    skos:notation "application/sgml-dtd"^^euvoc:CELLAR_MT,
        ".dtd"^^euvoc:FILE_EXT,
        "application/sgml"^^euvoc:IANA_MT,
        "dtd_sgml"^^nma-vocabularies:invenioid ;
    skos:prefLabel "SGML DTD"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:dtd_xml a skos:Concept ;
    europa-ontology-authority:authority-code "DTD_XML" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DTD_XML" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    europa-authority:op-code "DTD_XML" ;
    dce:identifier "DTD_XML" ;
    skos:altLabel "XML Document Type Definition (DTD)"@en ;
    skos:definition "XML – Extensible Markup Language – is a markup language that defines a set of rules for encoding documents in a format that is both human-readable and machine-readable. DTD – document type definition – is a set of markup declarations that define a document type for an SGML-family markup language (SGML, XML, HTML). It defines the legal building blocks of an XML document, the document structure with a list of legal elements and attributes. XML uses a subset of SGML DTD."@en ;
    skos:exactMatch europa-file-type:DTD_XML ;
    skos:inScheme nma-fileformats: ;
    skos:notation "application/xml-dtd"^^euvoc:CELLAR_MT,
        ".dtd"^^euvoc:FILE_EXT,
        "application/xml-dtd"^^euvoc:IANA_MT,
        "dtd_xml"^^nma-vocabularies:invenioid ;
    skos:prefLabel "XML DTD"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:dwca a skos:Concept ;
    europa-ontology-authority:authority-code "DWCA" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DWCA" ;
    europa-ontology-authority:start.use "2009-10-08" ;
    europa-authority:op-code "DWCA" ;
    dce:identifier "DWCA" ;
    skos:altLabel "Darwin Core Archive"@en ;
    skos:definition "biodiversity informatics data standard that makes use of the Darwin Core terms to produce a single, self contained dataset for sharing species-level (taxonomic), species-occurrence data, and sampling-event data; an archive is a set of text files, in standard comma- or tab-delimited format, with a simple descriptor file (called meta.xml) to inform others how the files are organized"@en ;
    skos:exactMatch europa-file-type:DWCA ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".tar.gz"^^euvoc:FILE_EXT,
        ".zip"^^euvoc:FILE_EXT,
        "application/gzip"^^euvoc:IANA_MT,
        "application/zip"^^euvoc:IANA_MT,
        "dwca"^^nma-vocabularies:invenioid ;
    skos:prefLabel "DwC-A"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:dwg a skos:Concept ;
    europa-ontology-authority:authority-code "DWG" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DWG" ;
    europa-ontology-authority:start.use "1982-01-01" ;
    europa-authority:op-code "DWG" ;
    dce:identifier "DWG" ;
    skos:altLabel "DWG file"@en ;
    skos:definition "A DWG file is a 2D or 3D drawing created with Autodesk AutoCAD, a professional CAD program. It contains vector image data and metadata that AutoCAD and other CAD applications use to load a drawing. DWG files are related to .DXF files, which are ASCII versions of DWG files."@en ;
    skos:exactMatch europa-file-type:DWG ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".dwg"^^euvoc:FILE_EXT,
        "application/dwg"^^euvoc:IANA_MT,
        "image/vnd.dwg"^^euvoc:IANA_MT,
        "dwg"^^nma-vocabularies:invenioid ;
    skos:prefLabel "DWG"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:dxf a skos:Concept ;
    europa-ontology-authority:authority-code "DXF" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "DXF" ;
    europa-ontology-authority:start.use "1982-01-01" ;
    europa-authority:op-code "DXF" ;
    dce:identifier "DXF" ;
    skos:altLabel "Drawing Interchange Format"@en ;
    skos:definition "A DXF file is a data file saved in a format developed by Autodesk and used for CAD (computer-aided design) vector image files, such as AutoCAD documents. DXF files are similar to .DWG files, but are more compatible with other programs since they are ASCII (text) based."@en ;
    skos:exactMatch europa-file-type:DXF ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".dxf"^^euvoc:FILE_EXT,
        "image/vnd.dxf"^^euvoc:IANA_MT,
        "dxf"^^nma-vocabularies:invenioid ;
    skos:prefLabel "DXF"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:e00 a skos:Concept ;
    europa-ontology-authority:authority-code "E00" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "E00" ;
    europa-ontology-authority:start.use "2013-09-18" ;
    europa-authority:op-code "E00" ;
    dce:identifier "E00" ;
    skos:altLabel "ESRI Arc/Info interchange file"@en ;
    skos:definition "E00 is an ArcInfo interchange file format. ArcInfo is a full-featured geographic information system produced by Esri."@en ;
    skos:exactMatch europa-file-type:E00 ;
    skos:historyNote "Also kown as \"Arc/Info Coverage Export File\""@en ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".e00"^^euvoc:FILE_EXT,
        "application/x-e00"^^euvoc:IANA_MT,
        "e00"^^nma-vocabularies:invenioid ;
    skos:prefLabel "E00"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:ear a skos:Concept ;
    europa-ontology-authority:authority-code "EAR" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "EAR" ;
    europa-ontology-authority:start.use "2006-05-11" ;
    europa-authority:op-code "EAR" ;
    dce:identifier "EAR" ;
    skos:altLabel "Enterprise Application Archive"@en ;
    skos:definition "EAR (Enterprise Application aRchive) is a file format used by Java EE for packaging one or more modules into a single archive."@en ;
    skos:exactMatch europa-file-type:EAR ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".ear"^^euvoc:FILE_EXT,
        "application/java-archive"^^euvoc:IANA_MT,
        "ear"^^nma-vocabularies:invenioid ;
    skos:prefLabel "EAR"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:ecw a skos:Concept ;
    europa-ontology-authority:authority-code "ECW" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "ECW" ;
    europa-ontology-authority:start.use "1998-01-01" ;
    europa-authority:op-code "ECW" ;
    dce:identifier "ECW" ;
    skos:altLabel "Enhanced Compressed Wavelet"@en ;

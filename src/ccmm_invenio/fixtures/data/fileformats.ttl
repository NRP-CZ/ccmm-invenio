    europa-ontology-authority:start.use "2004-05-13" ;
    europa-authority:op-code "RDF_TRIX" ;
    dce:identifier "RDF_TRIX" ;
    skos:altLabel "Triples in XML"@en ;
    skos:definition "TriX (Triples in XML) is a serialization format for RDF (Resource Description Framework) graphs. It is an XML format for serializing Named Graphs and RDF Datasets which offers a compact and readable alternative to the XML-based RDF/XML syntax."@en ;
    skos:exactMatch europa-file-type:RDF_TRIX ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".trix"^^euvoc:FILE_EXT,
        ".xml"^^euvoc:FILE_EXT,
        "application/xml"^^euvoc:IANA_MT,
        "rdf_trix"^^nma-vocabularies:invenioid ;
    skos:prefLabel "RDF TriX"@en ;
    skos:topConceptOf nma-fileformats: .


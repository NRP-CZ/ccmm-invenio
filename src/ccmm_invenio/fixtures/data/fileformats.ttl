    europa-ontology-authority:op-code "RDF_TRIG" ;
    europa-ontology-authority:start.use "2013-04-09" ;
    europa-authority:op-code "RDF_TRIG" ;
    dce:identifier "RDF_TRIG" ;
    skos:altLabel "Resource Description Framework TriG"@en ;
    skos:definition "TriG allows an RDF dataset to be completely written in a compact and natural text form, with abbreviations for common usage patterns and datatypes. TriG is an extension of the Turtle format."@en ;
    skos:exactMatch europa-file-type:RDF_TRIG ;
    skos:inScheme nma-fileformats: ;
    skos:notation ".trig"^^euvoc:FILE_EXT,
        "application/trig"^^euvoc:IANA_MT,
        "rdf_trig"^^nma-vocabularies:invenioid ;
    skos:prefLabel "RDF TriG"@en ;
    skos:topConceptOf nma-fileformats: .


    europa-ontology-authority:authority-code "PPSX" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PPSX" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 1500 ;
    europa-authority:op-code "PPSX" ;
    dce:identifier "PPSX" ;
    skos:altLabel "PowerPoint Open XML Slide Show"@en ;
    skos:definition "PPSX – PowerPoint 2007 XML slide show – is an XML filename extension of Microsoft PowerPoint presentation program. PowerPoint was originally designed to provide visuals for group presentations within business organizations, but has come to be very widely used in many other communication situations, both in business and beyond."@en ;
    skos:exactMatch europa-file-type:PPSX ;
    skos:inScheme nma-fileformats: ;
    skos:notation "ppsx"^^euvoc:CELLAR_MANIFT,
        "application/vnd.openxmlformats-officedocument.presentationml.slideshow"^^euvoc:CELLAR_MT,
        ".ppsx"^^euvoc:FILE_EXT,
        "application/vnd.openxmlformats-officedocument.presentationml.slideshow"^^euvoc:IANA_MT,
        "ppsx"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PowerPoint PPSX"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:ppt a skos:Concept ;
    europa-ontology-authority:authority-code "PPT" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PPT" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 1400 ;
    europa-authority:op-code "PPT" ;
    dce:identifier "PPT" ;
    skos:altLabel "Microsoft PowerPoint Presentation"@en ;
    skos:definition "PPT is a binary media type of Microsoft PowerPoint presentation program. PowerPoint was originally designed to provide visuals for group presentations within business organizations, but has come to be very widely used in many other communication situations, both in business and beyond."@en ;
    skos:exactMatch europa-file-type:PPT ;
    skos:historyNote "In IMMC exchange context, PPT means releases from PowerPoint 97 and upwards."@en ;
    skos:inScheme nma-fileformats: ;
    skos:notation "ppt"^^euvoc:CELLAR_MANIFT,
        "application/vnd.ms-powerpoint"^^euvoc:CELLAR_MT,
        ".ppt"^^euvoc:FILE_EXT,
        "application/vnd.ms-powerpoint"^^euvoc:IANA_MT,
        "ppt"^^nma-vocabularies:invenioid ;
    skos:prefLabel "PowerPoint PPT"@en ;
    skos:topConceptOf nma-fileformats: .

nma-fileformats:pptx a skos:Concept ;
    europa-ontology-authority:authority-code "PPTX" ;
    europa-ontology-authority:deprecated "false" ;
    europa-ontology-authority:op-code "PPTX" ;
    europa-ontology-authority:start.use "2012-09-01" ;
    euvoc:order 1300 ;
    europa-authority:op-code "PPTX" ;
    dce:identifier "PPTX" ;
    skos:altLabel "Office Open XML Presentation"@en ;
    skos:definition "PPTX – PowerPoint 2007 XML presentation – is an XML filename extension of Office Open XML version of Microsoft PowerPoint presentation program. PowerPoint was originally designed to provide visuals for group presentations within business organizations, but has come to be very widely used in many other communication situations, both in business and beyond."@en ;
    skos:exactMatch europa-file-type:PPTX ;
    skos:inScheme nma-fileformats: ;
    skos:notation "pptx"^^euvoc:CELLAR_MANIFT,
        "application/vnd.openxmlformats-officedocument.presentationml.presentation"^^euvoc:CELLAR_MT,

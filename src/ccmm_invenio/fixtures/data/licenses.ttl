nma-licenses:cc0-1.0 a skos:Concept ;
    skos:broader nma-licenses:cc ;
    skos:definition "CC0 waives copyright interest in a work you've created and dedicates it to the world-wide public domain. Use CC0 to opt out of copyright entirely and ensure your work has the widest reach."@en ;

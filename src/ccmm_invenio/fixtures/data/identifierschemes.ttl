nma-identifierschemes: skos:hasTopConcept nma-identifierschemes:ads,
        nma-identifierschemes:ares,
        nma-identifierschemes:ark,
        nma-identifierschemes:arxiv,
        nma-identifierschemes:crossreffunderid,

<https://nma.eosc.cz/vocabularies/languages/sot> ccmm_props:ISO_639_1 "st"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "sot"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "sot"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "sot"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "st"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "sesotų"@lt, "Sesotho"@st; skos:definition "Southern Sotho is a Bantu language. It is one of the official languages of South Africa."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SOT>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "южен сото"@bg, "jižní sotština"@cs, "syd-sotho"@da, "Sesotho"@de, "νότια σότο"@el, "Southern Sotho"@en, "sotho meridional"@es, "suuto keel"@et, "eteläsotho"@fi, "sotho du sud"@fr, "Sútúis an Deiscirt"@ga, "južni soto"@hr, "déli szotó"@hu, "sotho del Sud"@it, "pietų sotų"@lt, "dienvidsotu valoda"@lv, "Sotho tan-Nofsinhar"@mt, "Southern Sotho"@nl, "sotho"@pl, "soto meridional"@pt, "sesotho"@ro, "južná sothčina"@sk, "južni sotho"@sl, "sydsotho"@sv, "південна сото"@uk .

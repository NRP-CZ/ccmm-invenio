<http://publications.europa.eu/resource/authority/language/KHM> ccmm_props:ISO_639_1 "km"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "khm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "khm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "khm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "km"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Kambodschanisch"@de, "Khmer-Sprache"@de, "khmer"@km, "ភាសាខ្មែរ"@km; skos:definition "Khmer, or Cambodian, is the second most widely spoken Austroasiatic language (after Vietnamese). It is the language of the Khmer people and the official language of Cambodia.Khmer is primarily an analytic, isolating language which is not tonal.The Khmer language is written with an abugida ‘Khmer script’."@en, "Le khmer est une langue appartenant au groupe des langues môn-khmères de la famille des langues austro-asiatiques. Langue des populations khmères, il est principalement parlé au Cambodge et dans les régions limitrophes de Thaïlande par les Khmers Surin (du Nord) et au Viêt Nam par les Khmers Krom, ce qui s’explique par l’histoire de ces pays.C’est une langue non tonale, contrairement au vietnamien, l’autre grande langue môn-khmère.Le système d’écriture du khmer est alphasyllabique."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "кхмерски"@bg, "khmerština"@cs, "khmer"@da, "Khmer"@de, "χμερ"@el, "Khmer"@en, "jemer"@es, "khmeeri keel"@et, "khmer"@fi, "khmer"@fr, "Khmer"@ga, "khmerski"@hr, "khmeršćina"@hsb, "khmer"@hu, "kambódíska"@is, "khmer"@it, "khmerų kalba"@lt, "khmeru valoda"@lv, "кмерски"@mk, "Khmer"@mt, "Khmer"@nl, "khmer"@no, "khmerski"@pl, "khmer"@pt, "khmeră"@ro, "кхмерский"@ru, "khmerski"@sh, "kmerčina"@sk, "kmerščina"@sl, "кхмерски"@sr, "khmer"@sv, "khmerce"@tr, "кхмерська мова"@uk .

<https://nma.eosc.cz/vocabularies/languages/syy> ccmm_props:ISO_639_3 "syy"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "syy"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Al-Sayyid Bedouin Sign Language"@syy; skos:definition "Al-Sayyid Bedouin Sign Language is a village sign language used by the al-Sayyid Bedouin tribe in Israel. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SYY>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "ал-сайидски бедуински жестомимичен език"@bg, "as-sajjidský beduínský znakový jazyk"@cs, "Al-Sayyid-beduin-tegnsprog"@da, "Al-Sayyid-Beduinen-Gebärdensprache"@de, "νοηματική γλώσσα των βεδουίνων Al-Sayyid"@el, "Al-Sayyid Bedouin Sign Language"@en, "lengua de signos de los beduinos Al‑Sayyid"@es, "Al-Sayyidi beduiinide viipekeel"@et, "al-Sayyid-beduiinien viittomakieli"@fi, "langue des signes bédouine d’Al-Sayyid"@fr, "Teanga Chomharthaíochta Bheidiúnach Al-Sayyid"@ga, "znakovni jezik plemena Al-Sayyid Bedouin"@hr, "al-sayyidi beduin jelnyelv"@hu, "lingua dei segni beduina di Al-Sayyid"@it, "Saido beduinų gestų kalba"@lt, "Al Saīdas beduīnu zīmju valoda"@lv, "Lingwa tas-Sinjali Bedwina ta’ Al-Sayyid"@mt, "Al-Sayyid Bedouin-gebarentaal"@nl, "beduiński język migowy Al.-Sayyid"@pl, "língua gestual dos beduínos de Al-Sayyid"@pt, "limbajul prin semne al beduinilor din al-Sayyid"@ro, "as-sajjidský beduínsky posunkový jazyk"@sk, "Al-Sayyid beduinski znakovni jezik"@sl, "Al-Sayyid-beduin-teckenspråk"@sv .

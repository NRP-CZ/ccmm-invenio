<https://nma.eosc.cz/vocabularies/languages/wln> ccmm_props:ISO_639_1 "wa"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "wln"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "wln"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "wln"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "wa"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "walon"@wa; skos:definition "Walloon is a Romance language, a langue d’oïl dialect indigenous to the greater part of Wallonia, the French-speaking south part of Belgium.Numerous associations are working to keep the language alive. On a government level, Walloon is officially recognised as a regional indigenous language."@en, "Le wallon est une langue romane, une langue d’oïl autochtone dans la plus grande partie de la Wallonie, la partie sud de Belgique parlant français.De nombreuses associations travaillent à garder la langue vivante. Au niveau du gouvernement, le wallon est officiellement reconnu comme une langue autochtone régionale."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/WLN>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "валонски"@bg, "valonština"@cs, "vallonsk"@da, "Wallonisch"@de, "βαλλονικά"@el, "Walloon"@en, "valón"@es, "vallooni keel"@et, "valloni"@fi, "wallon"@fr, "Vallúinis"@ga, "valonski"@hr, "vallon"@hu, "vallone"@it, "valonų kalba"@lt, "valoņu valoda"@lv, "Wallonja"@mt, "Waals"@nl, "vallonsk"@no, "waloński"@pl, "valão"@pt, "valonă"@ro, "валлонский язык"@ru, "valónčina"@sk, "valonščina"@sl, "vallonska"@sv, "valonca"@tr, "валлонська мова"@uk .

<https://nma.eosc.cz/vocabularies/languages/hbs> ccmm_props:ISO_639_1 "sh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_3 "hbs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "bosniaque-croate-serbe"@fr, "serbo-croate-bosniaque"@fr; skos:definition "Serbo-Croatian, also called Serbo-Croat, Serbo-Croat-Bosnian (SCB), or Bosnian-Croatian-Serbian (BCS), is a South Slavic language and the primary language of Serbia, Croatia, Bosnia and Herzegovina, and Montenegro. It is a pluricentric language with four mutually intelligible standard varieties. The term Serbo-Croatian was widely used in former Yougoslavia.To write Serbo-Croatian, Cyrillic and Latin scripts were equally used and easily interchangeable."@en, "Le serbo-croate, aussi appelé «serbo-croate-bosniaque» (SCB) ou «bosniaque-croate-serbe» (BCS), est une langue slave du Sud et la principale langue de la Serbie, de la Croatie, de la Bosnie-Herzégovine et du Monténégro. C’est une langue pluricentrique avec quatre variantes standards mutuellement intelligibles. Le terme «serbo-croate» a été largement utilisé dans l’ex-Yougoslavie.Pour écrire en serbo-croate, les alphabets latin et cyrillique sont indifféremment utilisés et facilement interchangeables."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/HBS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "сърбохърватски"@bg, "srbochorvatština"@cs, "serbokroatisk"@da, "Serbokroatisch"@de, "σερβοκροατικά"@el, "Serbo-Croatian"@en, "serbocroata"@es, "serbia-horvaadi keel"@et, "serbokroaatti"@fi, "serbo-croate"@fr, "Seirbea-Chróitis"@ga, "srpskohrvatski"@hr, "serbiskochorwatšćina"@hsb, "szerbhorvát"@hu, "serbo-croato"@it, "serbų-kroatų kalba"@lt, "serbu-horvātu valoda"@lv, "Serbo-kroat"@mt, "Servo-Kroatisch"@nl, "serbokroatisk"@no, "serbo-chorwacki"@pl, "servo-croata"@pt, "sârbocroată"@ro, "сербскохорватский"@ru, "srpskohrvatski"@sh, "srbochorvátčina"@sk, "srbohrvaščina"@sl, "српскохрватски"@sr, "serbokroatiska"@sv, "sırp-Hırvatça"@tr, "сербохорватська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/hbu> ccmm_props:ISO_639_3 "hbu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hbu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Habu"@hbu; skos:exactMatch <http://publications.europa.eu/resource/authority/language/HBU>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "habu"@hbu .
<https://nma.eosc.cz/vocabularies/languages/hca> ccmm_props:ISO_639_3 "hca"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hca"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Andaman Hindi"@en, "Andaman Hindi"@hca, "अण्डमान क्रियोल हिन्दी"@hca; skos:definition "Andaman Creole Hindi is a trade language of the Andaman Islands, spoken as a native language especially in Port Blair and villages to the south. It is described as a creolization of Hindustani, Bengali, and Malayalam."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/HCA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "андамански креолски хинди"@bg, "andamanská kreolská hindština"@cs, "andamansk hindikreolsk"@da, "Andamanen-Kreol-Hindi"@de, "κρεολική της χιντι των νησιών Άνταμαν"@el, "Andaman Creole Hindi"@en, "hindi criollo andamanés"@es, "andamani kreooli hindi"@et, "hindiin perustuva andamaanienkreoli"@fi, "hindi créole des îles Andaman"@fr, "Criól Hiondúise Andaman"@ga, "andamanski kreolski hindi"@hr, "andamán-szigeteki kreol hindi"@hu, "hindi creolo delle Andamane"@it, "andamanų kreolų hindi"@lt, "andamanu kreoliskā hindi valoda"@lv, "Ħindi Kreol tal-Gżejjer Andaman"@mt, "Andamanees creools Hindi"@nl, "hindi andamańskie"@pl, "crioulo hindi das ilhas Andamão"@pt, "hindi creolă andamaneză"@ro, "андаманский креольский хинди"@ru, "andamanská kreolská hindčina"@sk, "andamanska kreolska hindijščina"@sl, "andamanesisk kreol-hindi"@sv, "андаманский креольский хинди"@uk .

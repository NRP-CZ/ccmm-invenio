<http://publications.europa.eu/resource/authority/language/NDC> ccmm_props:ISO_639_3 "ndc"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ndc"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Chindau"@en, "Chindau"@ndc, "Ndau"@ndc, "Ndzawu"@ndc; skos:definition "Ndau is a Bantu language spoken by 1 400 000 people in central Mozambique and southeastern Zimbabwe. Ndau is part of a continuum with other neighboring varieties of the Shona group and has often been included as a Shona dialect. The 2013 Constitution of Zimbabwe accorded Ndau status as an official language."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "език ндау"@bg, "jazyk ndau"@cs, "ndau"@da, "Ndau"@de, "ντάου"@el, "Ndau"@en, "ndau"@es, "ndau"@et, "ndau"@fi, "ndau"@fr, "N-dabhais"@ga, "ndau"@hr, "ndau"@hu, "ndau"@it, "ndau"@lt, "ndau"@lv, "Ndaw"@mt, "Ndau"@nl, "ndau"@pl, "xindau"@pt, "ndau"@ro, "ndau"@sk, "ndauščina"@sl, "ndau"@sv .

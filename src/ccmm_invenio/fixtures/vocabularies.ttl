<https://nma.eosc.cz/vocabularies/languages/zlm> ccmm_props:ISO_639_3 "zlm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "zlm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Central Malay"@en, "non-standard Malay"@en, "Bahasa Melayu"@zlm; skos:definition "Malay is a major language of the Austronesian family. Malay (zlm) refers to local Malay dialects that differ substantially from Standard Malay. Therefore Malay (zlm) is a non-standard dialect cluster spoken in Malesia and Sumatra. Glottolog defines zlm as a Central Malay dialect cluster, covering such dialects as Riau Malay, Johor Malay, Melaka Malay and Kuala Lumpur Malay."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ZLM>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "малайская мова"@be, "малайски"@bg, "malajski jezik"@bs, "malai"@ca, "malajština"@cs, "malajisk"@da, "Malaiisch"@de, "μαλαισιανά"@el, "Malay"@en, "malayo"@es, "malai keel"@et, "malaiji"@fi, "malais"@fr, "Malaeis"@ga, "malajski"@hr, "malajšćina"@hsb, "maláj"@hu, "malasíska"@is, "malese"@it, "malajų bendroji kalba"@lt, "malajiešu valoda"@lv, "малајски"@mk, "Malażjan"@mt, "Maleis"@nl, "malayisk"@no, "malajski"@pl, "malaio"@pt, "malaeză"@ro, "малайский"@ru, "malajski"@sh, "malajčina"@sk, "malajščina"@sl, "малајски"@sr, "malajiska"@sv, "malayca"@tr, "малайська мова"@uk .

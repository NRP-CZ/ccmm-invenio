<https://nma.eosc.cz/vocabularies/languages/xnu> ccmm_props:ISO_639_3 "xnu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xnu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Munjan"@en, "Moondjan"@xnu; skos:definition "Nunukul (Nununkul, Nunugal, Nunagal, misspelled \"Nukunul\"), or Munjan (Moonjan, Meanjin), is an extinct Pama-Nyungan language of Queensland in Australia. The people it is spoken by are called the Nunukul, but the language is called Moondjan."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XNU>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Nunukul"@en .

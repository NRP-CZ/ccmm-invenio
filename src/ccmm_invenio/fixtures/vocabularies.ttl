<https://nma.eosc.cz/vocabularies/languages/lsl> ccmm_props:ISO_639_3 "lsl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lsl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Latvian Sign Language"@lsl; skos:definition "Latvian Sign Language is a sign language used in Latvia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/LSL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "латвийски жестомимичен език"@bg, "lotyšský znakový jazyk"@cs, "lettisk tegnsprog"@da, "Lettische Gebärdensprache"@de, "λετονική νοηματική γλώσσα"@el, "Latvian Sign Language"@en, "lengua de signos letona"@es, "läti viipekeel"@et, "latvialainen vittomakieli"@fi, "langue des signes lettone"@fr, "Teanga Chomharthaíochta Laitvia"@ga, "latvijski znakovni jezik"@hr, "lett jelnyelv"@hu, "lingua dei segni lettone"@it, "latvių gestų kalba"@lt, "latviešu zīmju valoda"@lv, "Lingwa tas-Sinjali Latvjana"@mt, "Letse Gebarentaal"@nl, "łotewski język migowy"@pl, "língua gestual letã"@pt, "limbajul prin semne din Letonia"@ro, "lotyšský posunkový jazyk"@sk, "latvijski znakovni jezik"@sl, "lettiskt teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/lsm> ccmm_props:ISO_639_3 "lsm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lsm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Saamia"@lsm; skos:exactMatch <http://publications.europa.eu/resource/authority/language/LSM>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "saamia"@lsm .
<https://nma.eosc.cz/vocabularies/languages/lsn> ccmm_props:ISO_639_3 "lsn"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lsn"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "藏语手语"@lsn; skos:definition "Tibetan Sign Language is the recently established deaf sign language of Tibet. It is the first recognized sign language for a minority in China. The Tibetan Sign Language Project was set up under the supervision of Handicap International in 2001 to create a standardized language, based primarily on the existing sign language of Lhasa, as a replacement for the regional sign languages of Tibet."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/LSN>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Tibetan Sign Language"@en .
<https://nma.eosc.cz/vocabularies/languages/lso> ccmm_props:ISO_639_3 "lso"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lso"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Laos Sign Language"@lso; skos:definition "Laos Sign Language is a sign language used in Laos. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/LSO>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Лаос"@bg, "laoský znakový jazyk"@cs, "laotisk tegnsprog"@da, "Laotische Gebärdensprache"@de, "νοηματική γλώσσα Λάος"@el, "Laotian Sign Language"@en, "lengua de signos de Laos"@es, "laose viipekeel"@et, "laosilainen viittomakieli"@fi, "langue des signes laotienne"@fr, "Teanga Chomharthaíochta Laos"@ga, "laoski znakovni jezik"@hr, "laoszi jelnyelv"@hu, "lingua dei segni del Laos"@it, "laosiečių gestų kalba"@lt, "laosiešu zīmju valoda"@lv, "Lingwa tas-Sinjali tal-Laos"@mt, "Laotiaanse Gebarentaal"@nl, "laotański język migowy"@pl, "língua gestual laociana"@pt, "limbajul prin semne din Laos"@ro, "laoský posunkový jazyk"@sk, "laoški znakovni jezik"@sl, "laotiskt teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/lsp> ccmm_props:ISO_639_3 "lsp"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lsp"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Panamanian Sign Language"@lsp; skos:definition "Panamanian Sign Language is a sign language used in Panama. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/LSP>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Панама"@bg, "panamský znakový jazyk"@cs, "panamansk tegnsprog"@da, "Panamaische Gebärdensprache"@de, "παναμεζική νοηματική γλώσσα"@el, "Panamanian Sign Language"@en, "lengua de signos panameña"@es, "panama viipekeel"@et, "panamalainen viittomakieli"@fi, "langue des signes panaméenne"@fr, "Teanga Chomharthaíochta Phanama"@ga, "panamski znakovni jezik"@hr, "panamai jelnyelv"@hu, "lingua dei segni di Panama"@it, "panamiečių gestų kalba"@lt, "panamiešu zīmju valoda"@lv, "Lingwa tas-Sinjali tal-Panama"@mt, "Panamese Gebarentaal"@nl, "panamski język migowy"@pl, "língua gestual panamense"@pt, "limbajul prin semne din Panama"@ro, "panamský posunkový jazyk"@sk, "panamski znakovni jezik"@sl, "panamanskt teckenspråk"@sv .

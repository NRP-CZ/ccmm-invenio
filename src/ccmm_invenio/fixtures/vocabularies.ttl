<https://nma.eosc.cz/vocabularies/languages/xms> ccmm_props:ISO_639_3 "xms"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xms"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Moroccan Sign Language"@xms; skos:definition "Moroccan Sign Language is a sign language used in Morocco. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XMS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "марокански жестомимичен език"@bg, "marocký znakový jazyk"@cs, "marokkansk tegnsprog"@da, "Marokkanische Gebärdensprache"@de, "μαροκινή νοηματική γλώσσα"@el, "Moroccan Sign Language"@en, "lengua de signos marroquí"@es, "maroko viipekeel"@et, "marokkolainen viittomakieli"@fi, "langue des signes marocaine"@fr, "Teanga Chomharthaíochta Mharacó"@ga, "marokanski znakovni jezik"@hr, "marokkói jelnyelv"@hu, "lingua dei segni marocchina"@it, "marokiečių gestų kalba"@lt, "marokāņu zīmju valoda"@lv, "Lingwa tas-Sinjali Marokkina"@mt, "Marokkaanse Gebarentaal"@nl, "marokański język migowy"@pl, "língua gestual marroquina"@pt, "limbajul prin semne din Maroc"@ro, "марокканский жестовый язык"@ru, "marocký posunkový jazyk"@sk, "maroški znakovni jezik"@sl, "marockanskt teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/xmt> ccmm_props:ISO_639_3 "xmt"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xmt"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Matbat"@xmt; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XMT>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "matbat"@xmt .
<https://nma.eosc.cz/vocabularies/languages/xmu> ccmm_props:ISO_639_3 "xmu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xmu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Kamu"@xmu; skos:definition "Kamu is an extinct Australian Aboriginal language formerly spoken by the Kamu people along the Daly River in the Northern Territory. It is often grouped with Matngala in the small Eastern Daly group, unrelated to the larger Australian Aboriginal language families."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XMU>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Kamu"@en .

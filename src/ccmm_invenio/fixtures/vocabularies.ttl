<https://nma.eosc.cz/vocabularies/languages/nno> ccmm_props:ISO_639_1 "nn"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "nno"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "nno"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "nno"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nn"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "νορβηγική νίνορσκ"@el, "New Norwegian"@en, "norjan nynorsk"@fi, "nynorsk"@hr, "nynorsk"@nn; skos:definition "Nynorsk is one of the two official written standards of the Norwegian language, the other being Bokmål. The name Nynorsk was introduced in 1929. After a series of reforms, it is still the written standard closer to Landsmål, Ivar Aasen's standard Norwegian language, whereas Bokmål is closer to Riksmål and Danish. Between 10 and 15 percent of Norwegians (primarily in the west around the city of Bergen) have Nynorsk as their official language form."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/NNO>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "норвежки съвременен"@bg, "norština (nynorsk)"@cs, "nynorsk"@da, "Nynorsk"@de, "νεονορβηγικά"@el, "Norwegian Nynorsk"@en, "nynorsk"@es, "uusnorra keel"@et, "uusnorja"@fi, "norvégien nynorsk"@fr, "Nua-Ioruais"@ga, "novonorveški"@hr, "norvég nynorsk"@hu, "norvegese nynorsk"@it, "norvegų niunoškas"@lt, "jaunnorvēģu valoda"@lv, "Nynorsk Norveġiż"@mt, "Norwegian Nynorsk"@nl, "norsk nynorsk"@no, "norweski nynorsk"@pl, "neonorueguês"@pt, "norvegiană nynorsk"@ro, "nórčina (nynorsk)"@sk, "novonorveščina"@sl, "norska (nynorska)"@sv, "норвезька нюнорська мова"@uk .

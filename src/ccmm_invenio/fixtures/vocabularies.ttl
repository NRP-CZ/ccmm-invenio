<https://nma.eosc.cz/vocabularies/languages/pol> ccmm_props:ISO_639_1 "pl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "pol"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "pol"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "pol"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "pl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:definition "Polish is the eastern member of the Lechitic branch of the West Slavic languages. It is spoken primarily in Poland.Polish is the second most widely spoken Slavic language, after Russian."@en, "Le polonais fait partie de la branche léchitique des langues slaves de l’Ouest. Il est parlé principalement en Pologne. Le polonais est la deuxième langue slave la plus utilisée après le russe."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/POL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "полски"@bg, "polština"@cs, "polsk"@da, "Polnisch"@de, "πολωνικά"@el, "Polish"@en, "polaco"@es, "poola keel"@et, "puola"@fi, "polonais"@fr, "Polainnis"@ga, "poljski"@hr, "pólšćina"@hsb, "lengyel"@hu, "pólska"@is, "polacco"@it, "lenkų kalba"@lt, "poļu valoda"@lv, "полски"@mk, "Pollakk"@mt, "Pools"@nl, "polsk"@no, "polski"@pl, "polaco"@pt, "polonă"@ro, "польский"@ru, "poljski"@sh, "poľština"@sk, "poljščina"@sl, "пољски"@sr, "polska"@sv, "lehçe"@tr, "польська мова"@uk .

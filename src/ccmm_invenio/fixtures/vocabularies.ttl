<https://nma.eosc.cz/vocabularies/languages/cre> ccmm_props:ISO_639_1 "cr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "cre"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "cre"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "cre"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Cree"@cr; skos:definition "Cree macrolanguage, also known as Cree–Montagnais–Naskapi, is a dialect continuum of Algonquian languages spoken by approximately 86 475 people across Canada in 2021, from the Northwest Territories to Alberta to Labrador. If considered one language, it is the aboriginal language with the highest number of speakers in Canada. The only region where Cree has any official status is in the Northwest Territories, alongside eight other aboriginal languages."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CRE>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "кри"@bg, "kríjština"@cs, "cree"@da, "Cree"@de, "κρι"@el, "Cree"@en, "cri"@es, "krii keel"@et, "cree"@fi, "cri"@fr, "Craís"@ga, "kri"@hr, "krí"@hu, "cree"@it, "krijų"@lt, "krī valoda"@lv, "Kri"@mt, "Cree"@nl, "kri"@pl, "cri"@pt, "cree"@ro, "kríština"@sk, "krijščina"@sl, "cree"@sv .
<https://nma.eosc.cz/vocabularies/languages/crf> ccmm_props:ISO_639_3 "crf"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "crf"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Caramanta"@crf; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CRF>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "caramanta"@crf .
<https://nma.eosc.cz/vocabularies/languages/crg> ccmm_props:ISO_639_3 "crg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "crg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Michif"@crg; skos:definition "Michif is one of the languages of the Métis people of Canada and the United States, who are the descendants of First Nations (mainly Cree, Nakota, and Ojibwe) and fur trade workers of white ancestry (mainly French). It belongs to the Cree macrofamily of languages, which is the most populous Canadian indigenous language. On a broader level, Cree–Montagnais–Naskapi continuum belongs to the Algonquian sub-branch in the Algic language family."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CRG>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Michif"@en .
<https://nma.eosc.cz/vocabularies/languages/crh> ccmm_props:ISO_639_2B "crh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "crh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "crh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "crh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Crimean Tatar"@crh; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CRH>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "crimean Tatar"@crh .
<https://nma.eosc.cz/vocabularies/languages/cri> ccmm_props:ISO_639_3 "cri"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cri"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Sãotomense"@cri; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CRI>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "sãotomense"@cri .
<https://nma.eosc.cz/vocabularies/languages/crj> ccmm_props:ISO_639_3 "crj"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "crj"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Iyiniw-Ayamiwin"@crj, "Iyiyiw-Ayamiwin"@en; skos:definition "Southern East Cree is spoken in Canada on the east coast of lower James Bay, and inland southeastward from James Bay. It belongs to a dialect continuum of Algonquian languages also known as Cree–Montagnais–Naskapi languages."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CRJ>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Southern East Cree"@en .
<https://nma.eosc.cz/vocabularies/languages/crk> ccmm_props:ISO_639_3 "crk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "crk"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "nēhiyawēwin"@crk; skos:definition "Plains Cree (endonym: nēhiyawēwin; alternatively: paskwâwinîmowin ‘language of the prairie people’) belongs to the Cree macrofamily of languages, which is the most populous Canadian indigenous language. Out of the 116 500 speakers of the Cree language, the Plains Cree dialect is spoken by about 34 000 people primarily in Saskatchewan and Alberta but also in Manitoba and Montana. Plains Cree is considered a dialect of the Cree language that is distinct from the Montagnais language or a dialect of the Montagnais language. Together, Cree–Montagnais–Naskapi continuum belongs to the Algonquian sub-branch in the Algic language family."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CRK>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Plains Cree"@en .
<https://nma.eosc.cz/vocabularies/languages/crl> ccmm_props:ISO_639_3 "crl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "crl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Iyiyiw-Ayimiwin"@crl; skos:definition "Northern East Cree is spoken in Canada on the east coast of lower Hudson Bay. It belongs to a dialect continuum of Algonquian languages also known as Cree–Montagnais–Naskapi languages."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CRL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Northern East Cree"@en .
<https://nma.eosc.cz/vocabularies/languages/crm> ccmm_props:ISO_639_3 "crm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "crm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Ililîmowin"@crm; skos:definition "Moose Cree is a variety of the Cree macrolanguage spoken mainly in Moose Factory, Ontario. Like other Cree varieties, Moose Cree is classified under the Algonquian branch of the Algic language family. The term Moose Cree is derived either from the toponym Môsoniy, meaning 'Moose Island' or Môso-sîpiy, meaning 'Moose River'. The former is the historical name for the summering grounds of the speakers of this dialect, but has been appropriated by the modern municipality of Moosonee, leaving the island with the official English name of Moose Factory."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CRM>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Moose Cree"@en .

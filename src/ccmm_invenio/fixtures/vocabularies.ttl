<http://publications.europa.eu/resource/authority/language/MRE> ccmm_props:ISO_639_3 "mre"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mre"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Martha’s Vineyard Sign Language"@mre; skos:definition "Martha’s Vineyard Sign Language is a sign language used on the island of Martha’s Vineyard, in the United States. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език на Мартас Винярд"@bg, "martha’svineyardský znakový jazyk"@cs, "Martha’s Vineyard-tegnsprog"@da, "Martha’s Vineyards Gebärdensprache"@de, "νοηματική γλώσσα του Martha’s Vineyard"@el, "Martha’s Vineyard Sign Language"@en, "lengua de signos de Martha’s Vineyard"@es, "Martha’s Vineyardi saare viipekeel"@et, "martha’svineyardilainen viittomakieli"@fi, "langue des signes de Martha’s Vineyard"@fr, "Teanga Chomhartha Martha’s Vineyard"@ga, "znakovni jezik otoka Martha’s Vineyard"@hr, "Martha’s Vineyard-i jelnyelv"@hu, "lingua dei segni di Martha’s Vineyard"@it, "Martos Vynuogyno gestų kalba"@lt, "Martas Vainjardas salas zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Martha’s Vineyard"@mt, "Martha’s Vineyard-gebarentaal"@nl, "język migowy Martha’s Vineyard"@pl, "língua gestual de Martha’s Vineyard"@pt, "limbajul prin semne din Insula Martha’s Vineyard"@ro, "posunkový jazyk z Martha’s Viineyard"@sk, "znakovni jezik, ki ga uporabljajo na otoku Martha’s Vineyard"@sl, "Martha’s Vineyard-teckenspråk"@sv .

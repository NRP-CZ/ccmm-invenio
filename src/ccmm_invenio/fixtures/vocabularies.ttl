<http://publications.europa.eu/resource/authority/language/ESO> ccmm_props:ISO_639_3 "eso"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "eso"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Estonian Sign Language"@eso; skos:definition "Estonian Sign Language is a sign language used in Estonia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "естонски жестомимичен език"@bg, "estonský znakový jazyk"@cs, "estisk tegnsprog"@da, "Estnische Gebärdensprache"@de, "εσθονική νοηματική γλώσσα"@el, "Estonian Sign Language"@en, "lengua de signos estonia"@es, "eesti viipekeel"@et, "virolainen viittomakieli"@fi, "langue des signes estonienne"@fr, "Teanga Chomharthaíochta na hEastóine"@ga, "estonski znakovni jezik"@hr, "észt jelnyelv"@hu, "lingua dei segni estone"@it, "estų gestų kalba"@lt, "igauņu zīmju valoda"@lv, "Lingwa tas-Sinjali Estonjana"@mt, "Estse Gebarentaal"@nl, "estoński język migowy"@pl, "língua gestual estónia"@pt, "limbajul prin semne din Estonia"@ro, "эстонский жестовый язык"@ru, "estónsky posunkový jazyk"@sk, "estonski znakovni jezik"@sl, "estniskt teckenspråk"@sv .

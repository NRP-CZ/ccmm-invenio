<https://nma.eosc.cz/vocabularies/languages/gbw> ccmm_props:ISO_639_3 "gbw"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "gbw"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Kabi Kabi"@en, "Gabi-Gabi"@gbw; skos:definition "Gabi-Gabi is an endangered Australian Aboriginal language traditionally spoken by the Gabi-Gabi people in south-east Queensland. Gabi-Gabi is closely related to Batjala (xby). Both belong to the Waka-Kabic sub-group within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/GBW>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Gabi-Gabi"@en .

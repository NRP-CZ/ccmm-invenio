<http://publications.europa.eu/resource/authority/language/ZMK> ccmm_props:ISO_639_3 "zmk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "zmk"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Mandandanyi"@zmk; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "mandandanyi"@zmk .
<http://publications.europa.eu/resource/authority/language/ZML> ccmm_props:ISO_639_3 "zml"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "zml"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Matngala"@zml; skos:definition "Matngala is an extinct Australian Aboriginal language formerly spoken by the Matngala people in the middle and lower reaches of the Daly River in the Northern Territory. It is often grouped with Kama in the small Eastern Daly group, unrelated to the larger Australian Aboriginal language families."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Matngala"@en .
<http://publications.europa.eu/resource/authority/language/ZMM> ccmm_props:ISO_639_3 "zmm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "zmm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Marimanindji"@zmm; skos:definition "Marramaninyshi is an endangered Australian Aboriginal language spoken by Marramaninyshi in the central Daly River area of the Northern Territory. It is closely related to the Marithielic languages and a part of the small Western Daly group, unrelated to the larger Australian Aboriginal language families."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Marramaninyshi"@en .

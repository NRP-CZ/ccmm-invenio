<http://publications.europa.eu/resource/authority/language/CJY> ccmm_props:ISO_639_3 "cjy"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cjy"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Jìnyǔ"@cjy, "晋语"@cjy; skos:definition "Jinyu is a group of Chinese linguistic varieties spoken in northern China, including most of Shanxi province, much of central Inner Mongolia, and adjoining areas in Hebei, Henan, and Shaanxi provinces. The status of Jin is disputed among linguists; some prefer to include it within Mandarin, but others set it apart as a closely related but separate sister group."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "дзиню китайски"@bg, "šansiské dialekty čínštiny"@cs, "Jinyu-kinesisk"@da, "Jinyu-Chinesisch"@de, "Κινεζικά Τζίνγιου"@el, "Jinyu Chinese"@en, "chino jinyu"@es, "Jinyu hiina"@et, "jin-kiina"@fi, "chinois jinyu"@fr, "Sínis Jinyu"@ga, "jinyu kineski"@hr, "csinjü kínai"@hu, "cinese jinyu"@it, "Dzinio kinų"@lt, "Jiņjui ķīniešu valoda"@lv, "Ċiniż Jinyu"@mt, "Jin"@nl, "chiński jin"@pl, "chinês jin"@pt, "chineză Jinyu"@ro, "ťin jü čínština"@sk, "jinyu kitajščina"@sl, "jinkinesiska"@sv .

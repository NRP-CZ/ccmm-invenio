<https://nma.eosc.cz/vocabularies/languages/cjy> ccmm_props:ISO_639_3 "cjy"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cjy"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Jìnyǔ"@cjy, "晋语"@cjy; skos:definition "Jinyu is a group of Chinese linguistic varieties spoken in northern China, including most of Shanxi province, much of central Inner Mongolia, and adjoining areas in Hebei, Henan, and Shaanxi provinces. The status of Jin is disputed among linguists; some prefer to include it within Mandarin, but others set it apart as a closely related but separate sister group."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CJY>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "дзиню китайски"@bg, "šansiské dialekty čínštiny"@cs, "Jinyu-kinesisk"@da, "Jinyu-Chinesisch"@de, "Κινεζικά Τζίνγιου"@el, "Jinyu Chinese"@en, "chino jinyu"@es, "Jinyu hiina"@et, "jin-kiina"@fi, "chinois jinyu"@fr, "Sínis Jinyu"@ga, "jinyu kineski"@hr, "csinjü kínai"@hu, "cinese jinyu"@it, "Dzinio kinų"@lt, "Jiņjui ķīniešu valoda"@lv, "Ċiniż Jinyu"@mt, "Jin"@nl, "chiński jin"@pl, "chinês jin"@pt, "chineză Jinyu"@ro, "ťin jü čínština"@sk, "jinyu kitajščina"@sl, "jinkinesiska"@sv .
<https://nma.eosc.cz/vocabularies/languages/cka> ccmm_props:ISO_639_3 "cka"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cka"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Khumi Awa Chin"@cka; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CKA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Khumi Awa Chin"@en .
<https://nma.eosc.cz/vocabularies/languages/ckb> ccmm_props:ISO_639_3 "ckb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ckb"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "سۆرانی"@ckb, "کوردیی ناوەندی"@ckb, "Sorani"@en, "sorani"@et; skos:definition "Central Kurdish (Sorani) is a Kurdish dialect spoken in Iraq, mainly in Iraqi Kurdistan, as well as the Kurdistan Province of western Iran. The language is written in an adapted form of the Kurdo-Arabic alphabet. The language is part of the Kurdish group within the northwestern branch of the Indo-Iranian languages."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CKB>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "централнокюрдски"@bg, "centrální kurdština"@cs, "centralkurdisk"@da, "Zentralkurdisch"@de, "κεντρική κουρδική"@el, "Central Kurdish"@en, "kurdo central"@es, "keskkurdi keel"@et, "sorani"@fi, "kurde central"@fr, "Coirdis Láir"@ga, "srednjokurdski"@hr, "szoráni"@hu, "soranî"@it, "vidurio kurdų"@lt, "sorani"@lv, "Kurd Ċentrali"@mt, "Centraal-Koerdisch"@nl, "sorani"@pl, "curdo central"@pt, "kurdă centrală"@ro, "centrálna kurdčina"@sk, "osrednja kurdščina"@sl, "centralkurdiska"@sv, "центральна курдська мова"@uk .

<https://nma.eosc.cz/vocabularies/languages/xby> ccmm_props:ISO_639_3 "xby"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xby"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Batyala"@en, "Butchulla"@en, "Batjala"@xby; skos:definition "Batjala is an endangered Australian Aboriginal language traditionally spoken by the Butchulla people in K'gari (Fraser Island) of Queensland. Batjala is closely related to Gabi-Gabi (gbw). Both belong to the Waka-Kabic sub-group within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XBY>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Batjala"@en .

<http://publications.europa.eu/resource/authority/language/PES> ccmm_props:ISO_639_3 "pes"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "pes"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "западен фарси"@bg, "západní fársí"@cs, "vestlig farsi"@da, "westliches Farsi"@de, "Δυτικά φαρσί"@el, "Western Farsi"@en, "farsi occidental"@es, "läänefarsi"@et, "länsipersia"@fi, "farsi occidental"@fr, "Fairsis an Iarthair"@ga, "zapadnoperzijski"@hr, "nyugati fárszi"@hu, "farsi occidentale"@it, "vakarų persų"@lt, "rietumfarsi valoda"@lv, "Farsi tal-Punent"@mt, "Westelijk Farsi"@nl, "Fârsi-ye Irâni"@pes, "فارسی ایرانی"@pes, "zachodni perski"@pl, "persa ocidental"@pt, "farsi occidentală"@ro, "západné fársí"@sk, "zahodni farsi"@sl, "västlig persiska"@sv; skos:definition "Iranian Persian or Western Farsi is an Indo-European language, more specifically an Indo-Iranian language and the variety of the Persian language spoken in Iran. It is written using a modified variant of the Arabic alphabet."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "ирански персийски"@bg, "íránská perština"@cs, "iransk persisk"@da, "iranisches Persisch"@de, "Ιρανικά περσικά"@el, "Iranian Persian"@en, "persa iraní"@es, "Iraani pärsia"@et, "iraninpersia"@fi, "persan iranien"@fr, "Peirsis Iaránach"@ga, "iranski perzijski"@hr, "iráni perzsa"@hu, "persiano iraniano"@it, "Irano persų"@lt, "Irānas persiešu valoda"@lv, "Persjan Iranjan"@mt, "Iraans Perzisch"@nl, "irański perski"@pl, "persa iraniano"@pt, "limba iraniană/persană"@ro, "iránska perzština"@sk, "iranska perzijščina"@sl, "iransk persiska"@sv .

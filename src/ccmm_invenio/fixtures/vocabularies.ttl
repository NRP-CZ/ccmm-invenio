<http://publications.europa.eu/resource/authority/language/OCH> ccmm_props:ISO_639_3 "och"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "och"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Archaic Chinese"@en, "Shànggǔ hànyǔ"@och, "上古汉语"@och; skos:definition "Old Chinese, also called Archaic Chinese in older works, is the oldest attested stage of Chinese, and the ancestor of all modern varieties of Chinese. The earliest examples of Chinese are divinatory inscriptions on oracle bones from around 1250 BC, in the Late Shang period. Bronze inscriptions became plentiful during the following Zhou dynasty. The latter part of the Zhou period saw a flowering of literature, including classical works such as the Analects, the Mencius, and the Zuo Zhuan."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "старокитайски"@bg, "stará čínština"@cs, "oldkinesisk"@da, "Altchinesisch"@de, "Παλαιά κινεζικά"@el, "Old Chinese"@en, "chino antiguo"@es, "vanahiina"@et, "muinaiskiina"@fi, "chinois ancien"@fr, "Sean-Sínis"@ga, "starokineski"@hr, "ókínai"@hu, "cinese antico"@it, "senoji kinų"@lt, "senķīniešu valoda"@lv, "Ċiniż antik"@mt, "Oudchinees"@nl, "starochiński"@pl, "chinês arcaico"@pt, "chineză veche"@ro, "stará čínština"@sk, "stara kitajščina"@sl, "fornkinesiska"@sv .
<http://publications.europa.eu/resource/authority/language/OCI> ccmm_props:ISO_639_1 "oc"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "oci"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "oci"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "oci"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "oc"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "okszitán"@hu, "lenga d’òc"@oc, "occitan"@oc; skos:definition "Occitan is the generic name for Romance idioms which are native mainly to southern France. There are polemics about the unity of the language, as some think that Occitan is a macrolanguage. There is no single written standard language called ‘Occitan’, and Occitan has no official status in France, home to most of Occitania."@en, "L’occitan est le nom générique pour les idiomes romans originaires principalement du sud de la France. Il y a polémique sur l’unité de la langue, certains pensant que l’occitan est une macrolangue. Il n’y a pas de langue écrite standard intitulée «occitan», et l’occitan n’a pas de statut officiel en France, qui abrite la majeure partie de l’Occitanie."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "окситан"@bg, "okcitánština"@cs, "occitansk"@da, "Okzitanisch"@de, "οξιτανικά"@el, "Occitan"@en, "occitano"@es, "oksitaani keel"@et, "oksitaani"@fi, "occitan"@fr, "Ocsatáinis"@ga, "oksitanski"@hr, "okcitanščina"@hsb, "okcitán"@hu, "okkitanska"@is, "occitano"@it, "oksitanų kalba"@lt, "oksitāņu valoda"@lv, "oкситански"@mk, "Oċċitan"@mt, "Occitaans"@nl, "oksitansk"@no, "oksytański"@pl, "occitano"@pt, "occitană"@ro, "окситанский язык"@ru, "oksitanski"@sh, "okcitánčina"@sk, "okcitanščina"@sl, "окситански"@sr, "occitanska"@sv, "oksitanca"@tr, "окситанська мова"@uk .

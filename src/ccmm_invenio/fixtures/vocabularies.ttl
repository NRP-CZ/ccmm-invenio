<https://nma.eosc.cz/vocabularies/languages/ssp> ccmm_props:ISO_639_3 "ssp"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ssp"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Spanish Sign Language"@ssp; skos:definition "Spanish Sign Language is a sign language used in Spain. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SSP>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "испански жестомимичен език"@bg, "španělský znakový jazyk"@cs, "spansk tegnsprog"@da, "Spanische Gebärdensprache"@de, "ισπανική νοηματική γλώσσα"@el, "Spanish Sign Language"@en, "lengua de signos española"@es, "hispaania viipekeel"@et, "espanjalainen viittomakieli"@fi, "langue des signes espagnole"@fr, "Teanga Chomharthaíochta na Spáinne"@ga, "španjolski znakovni jezik"@hr, "spanyol jelnyelv"@hu, "lingua dei segni spagnola"@it, "ispanų gestų kalba"@lt, "spāņu zīmju valoda"@lv, "Lingwa tas-Sinjali Spanjola"@mt, "Spaanse Gebarentaal"@nl, "hiszpański język migowy"@pl, "língua gestual espanhola"@pt, "limbajul prin semne din Spania"@ro, "španielsky posunkový jazyk"@sk, "španski znakovni jezik"@sl, "spanskt teckenspråk"@sv, "іспанська мова жестів"@uk .

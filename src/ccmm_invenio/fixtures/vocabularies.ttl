<http://publications.europa.eu/resource/authority/language/COR> ccmm_props:ISO_639_1 "kw"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "cor"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "cor"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "cor"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "kw"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Kernowek"@kw; skos:definition "Cornish is a south-western Brittonic Celtic language spoken in Cornwall.Since 2000 the language has undergone a revival. It is a recognised regional language of the United Kingdom, protected under the European Charter for Regional or Minority Languages."@en, "Le cornique est une langue celtique insulaire du groupe brittonique, parlée en Cornouailles (au Royaume-Uni).Il est reconnu par le Royaume-Uni comme langue régionale de l’Écosse, selon la charte européenne des langues régionales ou minoritaires."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "корнуолски"@bg, "kornština"@cs, "kornisk"@da, "Kornisch"@de, "κορνουαλικά"@el, "Cornish"@en, "córnico"@es, "korni keel"@et, "korni"@fi, "cornique"@fr, "Choirnis"@ga, "kornijski"@hr, "korni"@hu, "kornbreska"@is, "cornico"@it, "kornų kalba"@lt, "korniešu valoda"@lv, "корнски"@mk, "Korniku"@mt, "Cornisch"@nl, "kornisk"@no, "kornijski"@pl, "córnico"@pt, "cornică"@ro, "корнский"@ru, "kornijski"@sh, "kornčina"@sk, "kornijščina"@sl, "корнишки"@sr, "korniska"@sv, "kernevekçe"@tr, "корнська мова"@uk .
<http://publications.europa.eu/resource/authority/language/COS> ccmm_props:ISO_639_1 "co"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "cos"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "cos"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "cos"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "co"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "corsu"@co; skos:definition "Corsican is an Italo-Dalmatian Romance language, a member of the South Central group of the dialects of Italy, spoken and written on the islands of Corsica (France) and northern Sardinia (Italy). Unesco classifies Corsican as a definitely endangered language."@en, "Le corse est une langue italo-dalmate romane, membre du groupe centre-sud des dialectes de l’Italie, parlée et écrite sur l’île de Corse (France) et au nord de la Sardaigne (Italie).L’Unesco classe le corse comme une langue définitivement en voie de disparition."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "корсикански"@bg, "korsičtina"@cs, "korsikansk"@da, "Korsisch"@de, "κορσικανικά"@el, "Corsican"@en, "corso"@es, "korsika keel"@et, "korsika"@fi, "corse"@fr, "Corsisis"@ga, "korzički"@hr, "korzikai"@hu, "korsika"@is, "corso"@it, "korsikiečių kalba"@lt, "korsikāņu valoda"@lv, "корсикански"@mk, "Korsiku"@mt, "Corsicaans"@nl, "korsikansk"@no, "korsykański"@pl, "corso"@pt, "corsică"@ro, "корсиканский"@ru, "korzički"@sh, "korzičtina"@sk, "korziščina"@sl, "korsiska"@sv, "korsikaca"@tr, "корсиканська мова"@uk .

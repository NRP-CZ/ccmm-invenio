<https://nma.eosc.cz/vocabularies/languages/fry> ccmm_props:ISO_639_1 "fy"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "fry"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "fry"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "fry"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fy"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Frysk"@fy, "rietumfrīzu valoda"@lv; skos:definition "Frisian belongs, together with English, to the North Sea subgroup of the West Germanic languages. It is spoken by Frisian ethnic groups, who live mainly in the northern part of the Netherlands.There are three varieties of Frisian: West Frisian, Saterland Frisian, and North Frisian."@en, "Le frison appartient, avec l’anglais, au sous-groupe de la mer du Nord des langues germaniques de l’Ouest. Il est parlé par des groupes ethniques de la Frise, qui vivent principalement dans la partie nord des Pays-Bas.Il est réparti en trois variantes: le frison occidental, le frison oriental et le frison septentrional."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/FRY>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "фризийски"@bg, "fríština"@cs, "frisisk"@da, "Friesisch"@de, "φριζικά"@el, "Frisian"@en, "frisón"@es, "friisi keel"@et, "friisi"@fi, "frison"@fr, "Frisisis"@ga, "frizijski"@hr, "frizijščina"@hsb, "fríz"@hu, "frísneska"@is, "frisone"@it, "fryzų kalba"@lt, "frīzu valoda"@lv, "фризски"@mk, "Friġju"@mt, "Fries"@nl, "frisisk"@no, "fryzyjski"@pl, "frísio"@pt, "frizonă"@ro, "фризский"@ru, "frízština"@sk, "frizijščina"@sl, "frisiska"@sv, "frizce"@tr, "фризька мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/fse> ccmm_props:ISO_639_3 "fse"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fse"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Finnish Sign Language"@fse; skos:definition "Finnish Sign Language is a sign language used in Finland. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/FSE>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "фински жестомимичен език"@bg, "finský znakový jazyk"@cs, "finsk tegnsprog"@da, "Finnische Gebärdensprache"@de, "φινλανδική νοηματική γλώσσα"@el, "Finnish Sign Language"@en, "lengua de signos finesa"@es, "soome viipekeel"@et, "suomalainen viittomakieli"@fi, "langue des signes finnoise"@fr, "Teanga Chomharthaíochta na Fionlainne"@ga, "finski znakovni jezik"@hr, "finn jelnyelv"@hu, "lingua dei segni finlandese"@it, "suomių gestų kalba"@lt, "somu zīmju valoda"@lv, "Lingwa tas-Sinjali Finlandiża"@mt, "Finse Gebarentaal"@nl, "finsk tegnspråk"@no, "fiński język migowy"@pl, "língua gestual finlandesa"@pt, "limbajul prin semne din Finlanda"@ro, "fínsky posunkový jazyk"@sk, "finski znakovni jezik"@sl, "finskt teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/fsl> ccmm_props:ISO_639_3 "fsl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fsl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "French Sign Language"@fsl; skos:definition "French Sign Language is a sign language used in France and French-speaking parts of Switzerland. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/FSL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "френски жестомимичен език"@bg, "francouzský znakový jazyk"@cs, "fransk tegnsprog"@da, "Französische Gebärdensprache"@de, "γαλλική νοηματική γλώσσα"@el, "French Sign Language"@en, "lengua de signos francesa"@es, "prantsuse viipekeel"@et, "ranskalainen viittomakieli"@fi, "langue des signes française"@fr, "Teanga Chomharthaíochta na Fraince"@ga, "francuski znakovni jezik"@hr, "francia jelnyelv"@hu, "franskt táknmál"@is, "lingua dei segni francese"@it, "prancūzų gestų kalba"@lt, "franču zīmju valoda"@lv, "Lingwa tas-Sinjali Franċiża"@mt, "Franse Gebarentaal"@nl, "fransk tegnspråk"@no, "francuski język migowy"@pl, "língua gestual francesa"@pt, "limbajul francez al semnelor"@ro, "французский жестовый язык"@ru, "francúzsky posunkový jazyk"@sk, "francoski znakovni jezik"@sl, "franskt teckenspråk"@sv, "fransızca işaret dili"@tr, "французька мова жестів"@uk .
<https://nma.eosc.cz/vocabularies/languages/fss> ccmm_props:ISO_639_3 "fss"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fss"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Finland-Swedish Sign Language"@fss; skos:definition "Finland-Swedish Sign Language is a sign language used in Swedish community in Finland. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/FSS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "финско-шведски жестомимичен език"@bg, "finskošvédský znakový jazyk"@cs, "finsk-svensk tegnsprog"@da, "Finnland – schwedische Gebärdensprache"@de, "φινλανδοσουηδική νοηματική γλώσσα"@el, "Finland-Swedish Sign Language"@en, "lengua de signos sueco-finlandesa"@es, "soome rootsi viipekeel"@et, "suomenruotsalainen viittomakieli"@fi, "langue des signes finno-suédoise"@fr, "Teanga Chomharthaíochta Shualainnis na Fionlainne"@ga, "finsko-švedski znakovni jezik"@hr, "finnországi svéd jelnyelv"@hu, "lingua dei segni finlandese-svedese"@it, "Suomijos švedų gestų kalba"@lt, "Somijas zviedru zīmju valoda"@lv, "Lingwa tas-Sinjali Finlandiża - Żvediża"@mt, "Finland-Zweedse Gebarentaal"@nl, "fińsko-szwedzki język migowy"@pl, "língua gestual sueca da Finlândia"@pt, "limbajul prin semne suedez-finlandez"@ro, "fínsko-švédsky posunkový jazyk"@sk, "znakovni jezik švedsko govoreče skupnosti na Finskem"@sl, "Finlandssvenskt teckenspråk"@sv .

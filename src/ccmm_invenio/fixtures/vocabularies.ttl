<https://nma.eosc.cz/vocabularies/languages/gus> ccmm_props:ISO_639_3 "gus"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "gus"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Guinean Sign Language"@gus; skos:definition "Guinean Sign Language is a sign language used in Guinea. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/GUS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Гвинея"@bg, "guinejský znakový jazyk"@cs, "guineansk tegnsprog"@da, "Guineische Gebärdensprache"@de, "γουιανική νοηματική γλώσσα"@el, "Guinean Sign Language"@en, "lengua de signos guineana"@es, "guinea viipekeel"@et, "guinealainen viittomakieli"@fi, "langue des signes guinéenne"@fr, "Teanga Chomharthaíochta na Guine"@ga, "gvinejski znakovni jezik"@hr, "guineai jelnyelv"@hu, "lingua dei segni della Guinea"@it, "gvinėjiečių gestų kalba"@lt, "Gvinejas zīmju valoda"@lv, "Lingwa tas-Sinjali tal-Guinea"@mt, "Guinese Gebarentaal"@nl, "gwinejski język migowy"@pl, "língua gestual da Guiné-Conacri"@pt, "limbajul prin semne din Guineea"@ro, "guinejský posunkový jazyk"@sk, "gvinejski znakovni jezik"@sl, "guineanskt teckenspråk"@sv .

<http://publications.europa.eu/resource/authority/language/OSD> ccmm_props:ISO_639_3 "osd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "osd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Digor"@en, "Digor Ossetian"@en, "digoron ævzag"@osd, "дигорон ӕвзаг"@osd; skos:definition "Digor Ossetic (often simply referred to as Digor) is the less commonly spoken variety of the two Ossetic languages, with the other being Iron Ossetic. Digor is spoken in the western regions of the Republic of North Ossetia and in neighbouring Kabardino-Balkaria. Both Ossetic languages, along with Yaghnobi and the extinct Sogdian, are part of the Eastern Iranian subgroup within the Indo-European language family. Digor Ossetic uses the Cyrillic script."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "дигорски осетински"@bg, "digorská osetština"@cs, "digorossetisk"@da, "digorisches Ossetisch"@de, "ντίγκορ οσετικά"@el, "Digor Ossetic"@en, "osético digor"@es, "digoriosseedi keel"@et, "digorosseetti"@fi, "ossète Digor"@fr, "Oiséitis Dhíogórach"@ga, "digorski osetski"@hr, "digor oszét"@hu, "osseto digor"@it, "osetinų digorų"@lt, "osetīnu valoda (digoru)"@lv, "Ossetiku, varjetà Digor"@mt, "Digor-Ossetisch"@nl, "digorski (zachodnioosetyjski)"@pl, "osseto digoriano"@pt, "osetină digor"@ro, "digorská osetčina"@sk, "digor osetščina"@sl, "digorossetiska"@sv .

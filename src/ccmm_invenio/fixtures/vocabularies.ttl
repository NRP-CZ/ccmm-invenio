<https://nma.eosc.cz/vocabularies/languages/nsr> ccmm_props:ISO_639_3 "nsr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nsr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Maritime Sign Language"@nsr; skos:definition "Maritime Sign Language is a sign language used in Canada’s Atlantic provinces. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/NSR>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "морски жестомимичен език"@bg, "námořní znakový jazyk"@cs, "maritimsk tegnsprog"@da, "Maritime Gebärdensprache"@de, "νοηματική γλώσσα των επαρχιών Μάριταϊμ"@el, "Maritime Sign Language"@en, "lengua de signos marítima"@es, "Maritime viipekeel"@et, "maritime-viittomakieli"@fi, "langue des signes maritime"@fr, "Teanga Chomharthaíochta Mhuirí"@ga, "znakovni jezik kanadske atlantske obale"@hr, "tengeri jelnyelv"@hu, "lingua dei segni marittima"@it, "jūrų gestų kalba"@lt, "Piejūras zīmju valoda"@lv, "Lingwa tas-Sinjali Marittima"@mt, "Maritieme Gebarentaal"@nl, "morski język migowy"@pl, "língua gestual das províncias marítimas canadianas"@pt, "limbajul prin semne maritim"@ro, "приморский жестовый язык"@ru, "posunkový jazyk Maritime"@sk, "pomorski znakovni jezik"@sl, "maritimt teckenspråk"@sv .

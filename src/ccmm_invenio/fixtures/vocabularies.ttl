<http://publications.europa.eu/resource/authority/language/LVA> ccmm_props:ISO_639_3 "lva"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lva"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Maku'a"@lva; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "maku'a"@lva .
<http://publications.europa.eu/resource/authority/language/LVI> ccmm_props:ISO_639_3 "lvi"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lvi"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Swoeng"@en, "səlwəŋ"@lvi; skos:definition "Lavi (Swoeng) is a Mon–Khmer language spoken in Sekong Province, Laos. Lavi falls under the Bahnaric sub-branch of the Austroasiatic language family. Within the West Bahnaric branch, it is the most divergent language. Like many Austroasiatic languages, Lavi is characterised by prefixation and non-existent suffixation in its clause structure and large vowel inventories."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Lavi"@en .
<http://publications.europa.eu/resource/authority/language/LVK> ccmm_props:ISO_639_3 "lvk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lvk"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Lavukaleve"@lvk; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "lavukaleve"@lvk .
<http://publications.europa.eu/resource/authority/language/LVL> ccmm_props:ISO_639_3 "lvl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lvl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Lori"@en, "Lwel"@lvl; skos:definition "Lwel is a Bantu language spoken in the Democratic Republic of the Congo. Together with Ngwii, Nzadi, and Ding, it belongs to the West-Coastal Bantu group, which is classified within the Volta-Congo primary branch. Like other Bantu languages, Lwel has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Lwel"@en .

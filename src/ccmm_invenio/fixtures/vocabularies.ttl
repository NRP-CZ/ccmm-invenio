<https://nma.eosc.cz/vocabularies/languages/ykh> ccmm_props:ISO_639_3 "ykh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ykh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Хамниган Монгол"@ykh, "ᠬᠠᠮᠨᠢᠭᠠᠨ"@ykh; skos:definition "Khamnigan Mongol is a Mongolic language spoken by the Hamnigan people east of Lake Baikal. It is the most conservative Mongolic language, little different from Middle Mongolian."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/YKH>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "хамнигански монголски език"@bg, "chamniganská mongolština"@cs, "khamniganmongolsk"@da, "Khamniganisches Mongolisch"@de, "Χαμνιγκάν Μογγολικά"@el, "Khamnigan Mongol"@en, "mongol jamnigan"@es, "hamnigani murre"@et, "hamnigani"@fi, "mongol Khamnigan"@fr, "Mongóilis Khamnigan"@ga, "hamniganski mongolski jezik"@hr, "hamnigán"@hu, "mongolo khamnigan"@it, "chamniganų kalba"@lt, "hamniganu valoda"@lv, "Mongoljan Khamnigan"@mt, "Khamnigan Mongools"@nl, "mongolski chamnigański"@pl, "mongólico evenque"@pt, "mongolă khamnigană"@ro, "chamniganská mongolčina"@sk, "hamniganska mongolščina"@sl, "khamnigansk mongoliska"@sv .

<https://nma.eosc.cz/vocabularies/languages/djm> ccmm_props:ISO_639_3 "djm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "djm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Jamsay Dogon"@djm; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DJM>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "jamsay Dogon"@djm .
<https://nma.eosc.cz/vocabularies/languages/djn> ccmm_props:ISO_639_3 "djn"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "djn"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Jawoyn"@djn, "Djauan"@en, "Kumertuo"@en; skos:definition "Jawoyn, or Djauan, also known as Kumertuo, is a moribund Gunwinyguan language spoken only by elders in Arnhem Land, Australia. Jawoyn is not related to the Pama-Nyungan language family that spans the majority of Australia. However, it is related to the extinct Warrayic languages."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DJN>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Jawoyn"@en .
<https://nma.eosc.cz/vocabularies/languages/djo> ccmm_props:ISO_639_3 "djo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "djo"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Jangkang"@djo; skos:definition "Jangkang is a Malayo-Polynesian language spoken in Kalimantan, the Indonesian part of Borneo. The Malayo-Polynesian languages are a subgroup of the Austronesian languages encompassing approximately 390 million speakers. All major Austronesian languages belong to the Malayo-Polynesian subgroup. Together with closely related Ribun (rir), Semandang (sdq), Sanggau (scg) and Kembayan (xem) languages, Jangkang belongs to the Southern Land Dayak sub-branch. Austronesian languages often possess phoneme inventories smaller than the world average. Two salient morphological characteristics are a system of affixation and reduplication to form new words."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DJO>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Jangkang"@en .

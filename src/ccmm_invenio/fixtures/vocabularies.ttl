<http://publications.europa.eu/resource/authority/language/NCS> ccmm_props:ISO_639_3 "ncs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ncs"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nicaraguan Sign Language"@ncs; skos:definition "Nicaraguan Sign Language is a sign language used in Nicaragua. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Никарагуа"@bg, "nikaragujský znakový jazyk"@cs, "nicaraguansk tegnsprog"@da, "Nicaraguanische Gebärdensprache"@de, "νικαραγουανή νοηματική γλώσσα"@el, "Nicaraguan Sign Language"@en, "lengua de signos nicaragüense"@es, "nicaragua viipekeel"@et, "nicaragualainen viittomakieli"@fi, "langue des signes nicaraguayenne"@fr, "Teanga Chomharthaíochta Nicearagua"@ga, "nikaragvanski znakovni jezik"@hr, "nicaraguai jelnyelv"@hu, "lingua dei segni del Nicaragua"@it, "nikaragviečių gestų kalba"@lt, "Nikaragvas zīmju valoda"@lv, "Lingwa tas-Sinjali tan-Nikaragwa"@mt, "Nicaraguaanse Gebarentaal"@nl, "nicaraguansk tegnspråk"@no, "nikaraguański język migowy"@pl, "língua gestual nicaraguense"@pt, "limbajul prin semne din Nicaragua"@ro, "никарагуанский жестовый язык"@ru, "nikaragujský posunkový jazyk"@sk, "nikaragovski znakovni jezik"@sl, "никарагвански знаковни језик"@sr, "nicaraguanskt teckenspråk"@sv, "nikaragua işaret dili"@tr .

<http://publications.europa.eu/resource/authority/language/CNP> ccmm_props:ISO_639_3 "cnp"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cnp"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Guìběi"@en, "Northern Pinghua"@en, "桂北平话"@en; skos:definition "Northern Ping is a member of a pair of Sinitic languages spoken mainly in Guilin in northern Guangxi and in Hunan. Pinghua is a trade language, and many of its speakers are genetically distinct from most other Han Chinese."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "северен пин китайски"@bg, "severopchingské dialekty čínštiny"@cs, "nordlig Ping-kinesisk"@da, "nördliches Pinghua-Chinesisch"@de, "Κινεζικά βόρεια Πινγκ"@el, "Northern Ping Chinese"@en, "chino ping del norte"@es, "põhja pinghua hiina"@et, "pohjoispinghuaninkiina"@fi, "chinois ping du Nord"@fr, "Sínis Ping an Tuaiscirt"@ga, "sjeverni ping kineski"@hr, "északi ping kínai"@hu, "cinese pinghua settentrionale"@it, "šiaurės pinghua kinų"@lt, "ziemeļpin ķīniešu valoda"@lv, "Ċiniż Ping tat-Tramuntana"@mt, "Noordelijk Pinghua"@nl, "chiński północny ping"@pl, "chinês ping setentrional"@pt, "chineză Ping nordică"@ro, "severná pinq čínština"@sk, "severna ping kitajščina"@sl, "nordlig pinghuakinesiska"@sv .

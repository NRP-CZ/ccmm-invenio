<https://nma.eosc.cz/vocabularies/languages/luh> ccmm_props:ISO_639_3 "luh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "luh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Luichew Min"@luh, "Léizhōuhuà"@luh, "雷州话"@luh; skos:definition "Leizhou Chinese is a branch of Min Chinese spoken in Leizhou city, Xuwen County, Mazhang District, most parts of Suixi County and also spoken inside of the linguistically diverse Xiashan District."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/LUH>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "лейджоуски китайски"@bg, "lejčouská čínština"@cs, "Leizhoukinesisk"@da, "Leizhou Min"@de, "Κινεζικά Λεϊτσόου"@el, "Leizhou Chinese"@en, "Chino de Leizhou"@es, "Leizhou hiina keel"@et, "leizhou-kiina"@fi, "chinois de Leizhou"@fr, "Sínis Léiseóach"@ga, "laičouski kineski"@hr, "lejcsou kínai"@hu, "Cinese di Leizhou"@it, "Leidžou kinų"@lt, "Leidžou ķīniešu"@lv, "Ċiniż ta’ Leizhou"@mt, "Leizhouhua"@nl, "chiński leizhou"@pl, "chinês de Leizhou"@pt, "chineză din Leizhou"@ro, "lej-čouská čínština"@sk, "Leizhou kitajščina"@sl, "Leizhoukinesiska"@sv .

<https://nma.eosc.cz/vocabularies/languages/ssr> ccmm_props:ISO_639_3 "ssr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ssr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Swiss-French Sign Language"@ssr; skos:definition "Swiss-French Sign Language is a sign language used in Switzerland by the French-speaking community. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SSR>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "швейцарски френски жестомимичен език"@bg, "švýcarsko-francouzský znakový jazyk"@cs, "schweizisk-fransk tegnsprog"@da, "Westschweizer Gebärdensprache"@de, "ελβετογαλλική νοηματική γλώσσα"@el, "Swiss-French Sign Language"@en, "lengua de signos franco-suiza"@es, "šveitsi-prantsuse viipekeel"@et, "sveitsinranskalainen viittomakieli"@fi, "langue des signes suisse romande"@fr, "Teanga Chomharthaíochta Fhraincis na hEilvéise"@ga, "švicarsko-francuski znakovni jezik"@hr, "svájci francia jelnyelv"@hu, "lingua dei segni svizzero-francese"@it, "Šveicarijos prancūzų gestų kalba"@lt, "Šveices franču zīmju valoda"@lv, "Lingwa tas-Sinjali Żvizzera - Franċiża"@mt, "Zwitsers-Franse Gebarentaal"@nl, "szwajcarsko-francuski język migowy"@pl, "língua gestual francesa da Suíça"@pt, "limbajul prin semne din Elveția francofonă"@ro, "švajčiarsko-francúzsky posunkový jazyk"@sk, "znakovni jezik francosko govoreče skupnosti v Švici"@sl, "schweizerfranskt teckenspråk"@sv .

<http://publications.europa.eu/resource/authority/language/SDL> ccmm_props:ISO_639_3 "sdl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sdl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Saudi Arabian Sign Language"@sdl; skos:definition "Saudi Arabian Sign Language is a sign language used in Saudi Arabia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език на Саудитска Арабия"@bg, "saúdskoarabský znakový jazyk"@cs, "saudi-arabisk tegnsprog"@da, "Saudi-Arabische Gebärdensprache"@de, "νοηματική γλώσσα της Σαουδικής Αραβίας"@el, "Saudi Arabian Sign Language"@en, "lengua de signos saudí"@es, "saudi araabia viipekeel"@et, "saudiarabialainen viittomakieli"@fi, "langue des signes saoudienne"@fr, "Teanga Chomharthaíochta na hAraibe Sádaí"@ga, "saudijskoarabijski znakovni jezik"@hr, "szaúd-arábiai jelnyelv"@hu, "lingua dei segni saudita"@it, "Saudo Arabijos gestų kalba"@lt, "Saūda Arābijas zīmju valoda"@lv, "Lingwa tas-Sinjali tal-Arabja Sawdija"@mt, "Saudi-Arabische Gebarentaal"@nl, "język migowy Arabii Saudyjskiej"@pl, "língua gestual da Arábia Saudita"@pt, "limbajul prin semne din Arabia Saudită"@ro, "saudskoarabský posunkový jazyk"@sk, "znakovni jezik Saudove Arabije"@sl, "saudiarabiskt teckenspråk"@sv .

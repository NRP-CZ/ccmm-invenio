<http://publications.europa.eu/resource/authority/language/PEO> ccmm_props:ISO_639_2B "peo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "peo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "peo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "peo"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "ariya"@peo; skos:definition "Old Persian, the language of the Achaemenid Empire, is one of two directly attested Old Iranian languages (the other being Avestan) and is the ancestor of Middle Persian (the language of the Sasanian Empire)."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "староперсийски (около 600 – 400 пр. Хр.)"@bg, "stará perština (asi 600–400 př. n. l.)"@cs, "oldpersisk (ca. 600-400 f.Kr.)"@da, "Altpersisch (ca. 600-400 v.Chr.)"@de, "Παλαιά περσικά (περίπου 600-400 π.Χ.)"@el, "Old Persian (ca. 600-400 B.C.)"@en, "persa antiguo (hacia 600-400 a. C.)"@es, "vanapärsia (u 600–400 e.m.a)"@et, "muinaispersia (n. 600-400 eaa)"@fi, "persan ancien (600 - 400 avant JC)"@fr, "Sean-Pheirsis (thart ar 600-400 RCh.)"@ga, "staroperzijski (približno 600 – 400. pr. Kr.)"@hr, "óperzsa (i.e. 600–400)"@hu, "persiano antico (circa 600-400 a.C.)"@it, "senoji persų (apie 600–400 m. pr. Kr.)"@lt, "senpersiešu valoda (aptuveni 600.–400. g. p.m.ē.)"@lv, "Persjan antik (madwar 600–400 QK)"@mt, "Oudperzisch (ca. 600-400 v.Chr.)"@nl, "staroperski (ok. 600-400 r. p.n.e.)"@pl, "persa arcaico (cerca de 600 a 400 a.C.)"@pt, "persană veche (cca. 600-400 B.C.)"@ro, "staroperzština (približne 600 – 400 pred n. l.)"@sk, "stara perzijščina (približno 600–400 pr. Kr.)"@sl, "fornpersiska (ca 600–400 f.Kr.)"@sv .

<http://publications.europa.eu/resource/authority/language/CKB> ccmm_props:ISO_639_3 "ckb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ckb"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "سۆرانی"@ckb, "کوردیی ناوەندی"@ckb, "Sorani"@en, "sorani"@et; skos:definition "Central Kurdish (Sorani) is a Kurdish dialect spoken in Iraq, mainly in Iraqi Kurdistan, as well as the Kurdistan Province of western Iran. The language is written in an adapted form of the Kurdo-Arabic alphabet. The language is part of the Kurdish group within the northwestern branch of the Indo-Iranian languages."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "централнокюрдски"@bg, "centrální kurdština"@cs, "centralkurdisk"@da, "Zentralkurdisch"@de, "κεντρική κουρδική"@el, "Central Kurdish"@en, "kurdo central"@es, "keskkurdi keel"@et, "sorani"@fi, "kurde central"@fr, "Coirdis Láir"@ga, "srednjokurdski"@hr, "szoráni"@hu, "soranî"@it, "vidurio kurdų"@lt, "sorani"@lv, "Kurd Ċentrali"@mt, "Centraal-Koerdisch"@nl, "sorani"@pl, "curdo central"@pt, "kurdă centrală"@ro, "centrálna kurdčina"@sk, "osrednja kurdščina"@sl, "centralkurdiska"@sv, "центральна курдська мова"@uk .

<http://publications.europa.eu/resource/authority/language/TGW> ccmm_props:ISO_639_3 "tgw"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "tgw"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Tagwana Senoufo"@tgw; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "tagwana Senoufo"@tgw .
<http://publications.europa.eu/resource/authority/language/TGX> ccmm_props:ISO_639_3 "tgx"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "tgx"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Tagish"@tgx; skos:definition "Tagish is an extinct Athabaskan language spoken by the Tagish or Carcross-Tagish, a First Nations people that historically lived in the Northwest Territories and Yukon in Canada. The Tagish people refer to themselves as /ta:gizi dene/, literally \"Tagish people\", where /ta:gizi/ is a place name meaning ‘it (spring ice) is breaking up’. Several linguists classify Tagish as a dialect of the same language as Kaska and Tahltan. Tagish belongs to the Athabaskan-Eyak-Tlingit language family. Edward Sapir originally constructed the term Na-Dene to refer to a combined family of Athabaskan, Tlingit, and Haida (the existence of the Eyak language was not known to him at the time). However, Haida is now generally considered a language isolate."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Tagish"@en .
<http://publications.europa.eu/resource/authority/language/TGY> ccmm_props:ISO_639_3 "tgy"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "tgy"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Togoyo"@tgy; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "togoyo"@tgy .
<http://publications.europa.eu/resource/authority/language/TGZ> ccmm_props:ISO_639_3 "tgz"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "tgz"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Takalak"@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Tagalaka"@en .
<http://publications.europa.eu/resource/authority/language/THA> ccmm_props:ISO_639_1 "th"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "tha"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "tha"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "tha"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "th"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "phasa thai"@th, "ภาษาไทย"@th; skos:definition "Thai, or more precisely Siamese or Central Thai, is a member of the Tai group of the Tai–Kadai language family. It is a tonal and analytic language. Thai also has a complex orthography and relational markers. Thai is mutually intelligible with Lao.The Thais adopted and modified the Khmer script to create their own writing system. It is an abugida script."@en, "Le thaï ou siamois ou Thai-An est une langue du groupe taï de la famille des langues taï-kadaï.Le thaï utilise un alphasyllabaire particulier (alphabet thaï) dérivé de l’alphabet khmer issu de l’alphabet pâli, adapté pour pouvoir transcrire le système tonal de la langue."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "таи"@bg, "thajština"@cs, "thai"@da, "Thailändisch"@de, "ταϊλανδικά"@el, "Thai"@en, "tailandés"@es, "tai keel"@et, "thai"@fi, "thaï"@fr, "Téalainnis"@ga, "tajski"@hr, "thajšćina"@hsb, "thai"@hu, "taílenska"@is, "thai"@it, "tajų kalba"@lt, "taizemiešu valoda"@lv, "Tajlandiż"@mt, "Thai"@nl, "thai"@no, "tajski"@pl, "tailandês"@pt, "thailandeză"@ro, "тайский"@ru, "tajlandski"@sh, "thajčina"@sk, "tajščina"@sl, "тајландски"@sr, "thai"@sv, "tayca"@tr, "тайська мова"@uk .
<http://publications.europa.eu/resource/authority/language/THC> ccmm_props:ISO_639_3 "thc"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "thc"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Tai Hang Tong"@thc; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Tai Hang Tong"@en .
<http://publications.europa.eu/resource/authority/language/THD> ccmm_props:ISO_639_3 "thd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "thd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Thayore"@en, "Kuuk Thayorre"@thd; skos:definition "Kuuk Thayorre, also known as Thayore, is a stable Pama-Nyungan language spoken in the settlement Pormpuraaw on the western part of the Cape York Peninsula in Queensland, Australia. It is thought to be related to the extinct Kuuk-Yak language. Kuuk Thayorre is classified within the Paman branch and more specifically within the Southwest Pama sub-branch. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Kuuk Thayorre"@en .

<http://publications.europa.eu/resource/authority/language/LAV> ccmm_props:ISO_639_1 "lv"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "lav"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "lav"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "lav"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lv"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "lette"@fr, "Letlands"@nl; skos:definition "Latvian is one of the two living members of the Baltic languages, the other being Lithuanian. It is the official language of Latvia.Latvian is more innovative, especially in morphology than Lithuanian."@en, "Le letton ou lette est l’un des deux membres vivants des langues baltes, l’autre étant le lituanien. C’est la langue officielle de la Lettonie.Le letton est plus novateur, en particulier dans la morphologie, que le lituanien."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "латвийски"@bg, "lotyština"@cs, "lettisk"@da, "Lettisch"@de, "λετονικά"@el, "Latvian"@en, "letón"@es, "läti keel"@et, "latvia"@fi, "letton"@fr, "Laitvis"@ga, "latvijski"@hr, "letišćina"@hsb, "lett"@hu, "lettneska"@is, "lettone"@it, "latvių kalba"@lt, "latviešu valoda"@lv, "латвиски"@mk, "Latvjan"@mt, "Lets"@nl, "latvisk"@no, "łotewski"@pl, "letão"@pt, "letonă"@ro, "латышский"@ru, "letonski"@sh, "lotyština"@sk, "latvijščina"@sl, "летонски"@sr, "lettiska"@sv, "letonca"@tr, "латиська мова"@uk .

<https://nma.eosc.cz/vocabularies/languages/xpc> ccmm_props:ISO_639_3 "xpc"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpc"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Pecheneg"@xpc; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XPC>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "pecheneg"@xpc .
<https://nma.eosc.cz/vocabularies/languages/xpd> ccmm_props:ISO_639_3 "xpd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Paredareme"@en, "Paredarerme"@xpd; skos:definition "Oyster Bay Tasmanian (also known as Paredarerme, Paytirami or Poredareme) is an Aboriginal language of Tasmania in the reconstruction of Claire Bowern. It was spoken along the central eastern coast of the island by the Oyster Bay tribe, and in the interior by the Big River tribe. Big River Tasmanian is attested in a list of 268 words collected by George Augustus Robinson. Coastal vocabularies include the Oyster Bay list of Robinson (357 words), and a second collected by Joseph Milligan of 1 040 words published in 1857 and 1859. The last is the longest vocabulary of any variety of Tasmanian."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XPD>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Oyster Bay Tasmanian"@en .
<https://nma.eosc.cz/vocabularies/languages/xpe> ccmm_props:ISO_639_3 "xpe"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpe"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Liberia Kpelle"@xpe; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XPE>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "liberia Kpelle"@xpe .
<https://nma.eosc.cz/vocabularies/languages/xpf> ccmm_props:ISO_639_3 "xpf"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpf"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nuenonne"@en, "Nuenonne"@xpf; skos:definition "Southeast Tasmanian, or Nuenonne, a name shared with Bruny Island Tasmanian, is an Aboriginal language or pair of languages of Tasmania in the reconstruction of Claire Bowern. It was spoken on the southeastern coast of Tasmania."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XPF>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Southeast Tasmanian"@en .
<https://nma.eosc.cz/vocabularies/languages/xpg> ccmm_props:ISO_639_3 "xpg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Phrygian"@xpg; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XPG>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "phrygian"@xpg .
<https://nma.eosc.cz/vocabularies/languages/xph> ccmm_props:ISO_639_3 "xph"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xph"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Tyerrenoterpanner"@en, "Tyerrenoterpanner"@xph; skos:definition "North Midland Tasmanian, or Tyerrernotepanner, was an Aboriginal language of northeastern Tasmania, along the Tamar River and inland of Ben Lomond and Great Oyster Bay. Tyerrernotepanner is attested in the 125 words of the Port Dalrymple vocabulary collected by J.-P. Gaimard in the Tamar River region."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XPH>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "North Midlands Tasmanian"@en .

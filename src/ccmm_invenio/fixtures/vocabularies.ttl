<https://nma.eosc.cz/vocabularies/languages/nmq> ccmm_props:ISO_639_3 "nmq"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nmq"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nanzwa"@en, "nanzva"@fr, "Chinambya"@nmq, "Nzanzwa"@nmq; skos:definition "Nambya is a Bantu language spoken by the Nambya people. It is spoken in northwestern Zimbabwe, particularly in the town of Hwange with a few speakers in northeastern Botswana. It is either classified as a dialect of Kalanga or as a closely related language. The Zimbabwean constitution recognises Nambya and Kalanga as separate indigenous languages. Nambya is one of Zimbabwe‘s 16 official languages."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/NMQ>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "език намбя"@bg, "nambijština"@cs, "nambya"@da, "Nambya"@de, "νάμπια"@el, "Nambya"@en, "nambya"@es, "nambya"@et, "nambya"@fi, "nambya"@fr, "nambya"@ga, "nambja"@hr, "nambya"@hu, "nambya"@it, "nambjų"@lt, "nambja"@lv, "Nambja"@mt, "Nambya"@nl, "nambya"@pl, "nâmbia"@pt, "nambya"@ro, "nambya"@sk, "nambja"@sl, "nambya"@sv .

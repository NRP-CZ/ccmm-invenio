<http://publications.europa.eu/resource/authority/language/HAA> ccmm_props:ISO_639_3 "haa"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "haa"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Hän"@haa; skos:definition "Hän (alternatively spelled as Haen) is a Northern Athabaskan language spoken by the Hän Hwëch'in (translated to people who live along the river, sometimes anglicized as Hankutchin). Hän is spoken and supported by the Hän nation across localized communities who have lived in what is today called the Upper Yukon region; the village of Eagle, Alaska, in the United States; the town of Dawson City, Yukon Territory, in Canada; as well as Fairbanks and Tanacross in Alaska. It is most closely related to Gwich'in and Upper Tanana. Edward Sapir originally constructed the term Na-Dene to refer to a combined family of Athabaskan, Tlingit, and Haida (the existence of the Eyak language was not known to him at the time). However, Haida is now generally considered a language isolate."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Hän"@en .
<http://publications.europa.eu/resource/authority/language/HAB> ccmm_props:ISO_639_3 "hab"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hab"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Hanoi Sign Language"@hab; skos:definition "Hanoi Sign Language is a sign language used in Hanoi city in Viet Nam. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Ханой"@bg, "hanojský znakový jazyk"@cs, "Hanoi tegnsprog"@da, "Hanoi-Gebärdensprache"@de, "νοηματική γλώσσα Ανόι"@el, "Hanoi Sign Language"@en, "lengua de signos de Hanoi"@es, "hanoi viipekeel"@et, "hanoilainen viittomakieli"@fi, "langue des signes de Hanoï"@fr, "Teanga Chomharthaíochta Hanáí"@ga, "hanojski znakovni jezik"@hr, "hanoi jelnyelv"@hu, "lingua dei segni di Hanoi"@it, "Hanojaus gestų kalba"@lt, "Hanojas zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Hanoi"@mt, "Gebarentaal van Hanoi"@nl, "język migowy Hanoi"@pl, "língua gestual de Hanói"@pt, "limbajul prin semne din Hanoi"@ro, "hanojský posunkový jazyk"@sk, "Hanoi znakovni jezik"@sl, "Hanoi-teckenspråk"@sv .
<http://publications.europa.eu/resource/authority/language/HAC> ccmm_props:ISO_639_3 "hac"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hac"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Goranî"@hac, "ھۆرامی"@hac, "ھەورامی"@hac; skos:definition "Gorani, also known by its main dialect Hawrami is a Northwestern Iranian language spoken by ethnic Kurds in northeastern Iraq and western Iran and which with Zaza constitute the Zaza–Gorani languages. Gorani is considered a Kurdish dialect by many researchers."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "горани"@bg, "guranština"@cs, "gurani"@da, "Gorani"@de, "Γκορανί"@el, "Gurani"@en, "Gurani"@es, "gurani"@et, "gurani"@fi, "gurani"@fr, "Gúráinis"@ga, "gurani"@hr, "guráni"@hu, "Gurani"@it, "guranių"@lt, "gurani"@lv, "Gurani"@mt, "Gurani"@nl, "gurani"@pl, "gurani"@pt, "gurani"@ro, "guránčina"@sk, "goranščina"@sl, "gorani"@sv .

<http://publications.europa.eu/resource/authority/language/SMA> ccmm_props:ISO_639_2B "sma"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "sma"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "sma"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sma"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "åarjelsaemien gïele"@sma; skos:definition "Southern Sami (åarjelsaemien gïele) is the southernmost Sami language, spoken in Norway and Sweden. It is an endangered language. Like Baltic-Finnic languages, Sami languages are a branch of the Uralic language family. The designated main municipality of Southern Sami in Norway is Snåasen Municipality. In Sweden, Sami is one of five recognised minority languages."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Southern Sami"@en, "lõunasaami keel"@et, "eteläsaame"@fi, "sørsamisk"@no, "южносаа́мский язы́к"@ru, "lullisámegiella"@se, "sydsamiska"@sv .

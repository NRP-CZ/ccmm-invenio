<https://nma.eosc.cz/vocabularies/languages/eng> ccmm_props:ISO_639_1 "en"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "eng"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "eng"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "eng"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "en"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:definition "English is a member of the West Germanic group of the Germanic languages. It is an official language of almost 60 sovereign states and is now a global lingua franca.It is the third-most-common native language in the world and it is widely learned as a second language."@en, "L’anglais est une langue appartenant au groupe occidental des langues germaniques. C’est la langue officielle de près de 60 États souverains. De nos jours, l’anglais est une lingua franca mondiale (langue véhiculaire).L’anglais est la troisième langue maternelle la plus parlée dans le monde et la langue la plus étudiée comme deuxième langue."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ENG>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "английски"@bg, "angličtina"@cs, "engelsk"@da, "Englisch"@de, "αγγλικά"@el, "English"@en, "inglés"@es, "inglise keel"@et, "englanti"@fi, "anglais"@fr, "Béarla"@ga, "engleski"@hr, "jendźelšćina"@hsb, "angol"@hu, "enska"@is, "inglese"@it, "anglų kalba"@lt, "angļu valoda"@lv, "англиски"@mk, "Ingliż"@mt, "Engels"@nl, "engelsk"@no, "angielski"@pl, "inglês"@pt, "engleză"@ro, "английский"@ru, "engleski"@sh, "angličtina"@sk, "angleščina"@sl, "енглески"@sr, "engelska"@sv, "ıngilizce"@tr, "англійська мова"@uk .

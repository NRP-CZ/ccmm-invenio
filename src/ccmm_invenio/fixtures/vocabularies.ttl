<https://nma.eosc.cz/vocabularies/languages/xrd> ccmm_props:ISO_639_3 "xrd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xrd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Gandangara"@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XRD>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Gundungurra"@en .

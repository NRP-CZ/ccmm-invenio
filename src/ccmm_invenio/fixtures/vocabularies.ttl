<https://nma.eosc.cz/vocabularies/languages/cds> ccmm_props:ISO_639_3 "cds"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cds"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Chadian Sign Language"@cds; skos:definition "Chadian Sign Language is a sign language used in Chad. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CDS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Чад"@bg, "čadský znakový jazyk"@cs, "tchadisk tegnsprog"@da, "Tschadische Gebärdensprache"@de, "νοηματική γλώσσα Τσαντ"@el, "Chadian Sign Language"@en, "lengua de signos del Chad"@es, "tšaadi viipekeel"@et, "tšadilainen viittomakieli"@fi, "langue des signes tchadienne"@fr, "Teanga Chomharthaíochta Shead"@ga, "čadski znakovni jezik"@hr, "csádi jelnyelv"@hu, "lingua dei segni del Ciad"@it, "čadiečių gestų kalba"@lt, "Čadas zīmju valoda"@lv, "Lingwa tas-Sinjali taċ-Chad"@mt, "Tsjadische Gebarentaal"@nl, "czadyjski język migowy"@pl, "língua gestual chadiana"@pt, "limbajul prin semne din Ciad"@ro, "čadský posunkový jazyk"@sk, "čadski znakovni jezik"@sl, "tchadiskt teckenspråk"@sv .

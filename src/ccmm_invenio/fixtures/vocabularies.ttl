<https://nma.eosc.cz/vocabularies/languages/cpx> ccmm_props:ISO_639_3 "cpx"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cpx"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Púxiānhuà"@cpx, "莆仙话"@cpx, "Xinghua"@en; skos:definition "Pu-Xian Min is a Chinese language that forms a branch of Min Chinese. Pu-Xian is a transitional variety of Coastal Min."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CPX>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "пусиен китайски"@bg, "pchusienský dialekt čínštiny"@cs, "Pu-Xian-kinesisk"@da, "Pu-Xian-Chinesisch"@de, "Κινεζικά Που-Ξιάν"@el, "Pu-Xian Chinese"@en, "chino puxian"@es, "Pu-Xiani hiina"@et, "puxianinkiina"@fi, "chinois puxian"@fr, "Sínis Pu-Xian"@ga, "pu-xian kineski"@hr, "puhszien kínai"@hu, "cinese puxian"@it, "Pusianio kinų"@lt, "Pusjaņ ķīniešu valoda"@lv, "Ċiniż Pu-Xian"@mt, "Puxian Min"@nl, "chiński puxian"@pl, "chinês de Putian"@pt, "chineză Pu-Xian"@ro, "pchu-sien čínština"@sk, "pu-xian kitajščina"@sl, "puxiankinesiska"@sv .

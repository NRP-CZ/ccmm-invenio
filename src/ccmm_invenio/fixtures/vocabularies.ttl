<https://nma.eosc.cz/vocabularies/languages/tza> ccmm_props:ISO_639_3 "tza"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "tza"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Tanzanian Sign Language"@tza; skos:definition "Tanzanian Sign Language is a sign language used in Tanzania. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/TZA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "танзанийски жестомимичен език"@bg, "tanzanský znakový jazyk"@cs, "tanzanisk tegnsprog"@da, "Tansanische Gebärdensprachen"@de, "τανζανιανή νοηματική γλώσσα"@el, "Tanzanian Sign Language"@en, "lengua de signos de Tanzanía"@es, "tansaania viipekeel"@et, "tansanialainen viittomakieli"@fi, "langue des signes tanzanienne"@fr, "Teanga Chomharthaíochta na Tansáine"@ga, "tanzanijski znakovni jezik"@hr, "tanzániai jelnyelv"@hu, "lingua dei segni tanzaniana"@it, "tanzaniečių gestų kalba"@lt, "tanzāniešu zīmju valoda"@lv, "Lingwa tas-Sinjali Tanżana"@mt, "Tanzaniaanse Gebarentaal"@nl, "tanzański język migowy"@pl, "língua gestual tanzaniana"@pt, "limbajul prin semne din Tanzania"@ro, "tanzánsky posunkový jazyk"@sk, "tanzanijski znakovni jezik"@sl, "tanzaniskt teckenspråk"@sv .

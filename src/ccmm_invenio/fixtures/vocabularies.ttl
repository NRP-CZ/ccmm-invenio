<https://nma.eosc.cz/vocabularies/languages/dyr> ccmm_props:ISO_639_3 "dyr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dyr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Dyarim"@dyr; skos:definition "Dyarim is an Afro-Asiatic language spoken in Nigeria. It belongs to the endangered Western Chadic sub-branch whose speakers are shifting to Hausa. One of its closest relatives is the Zeemic language group."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DYR>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "диарим"@bg, "dyarim"@cs, "dyarim"@da, "Dyarim"@de, "Ντιαρίμ"@el, "Dyarim"@en, "Dyarim"@es, "dyarim"@fi, "dyarim"@fr, "Diairimis"@ga, "djarim"@hr, "diarim"@hu, "Dyarim"@it, "djarimų"@lt, "djarimu"@lv, "Dyarim"@mt, "Dyarim"@nl, "diarim"@pl, "diarim"@pt, "dyarim"@ro, "dyarim"@sk, "djarimščina"@sl, "dyarim"@sv .
<https://nma.eosc.cz/vocabularies/languages/dyu> ccmm_props:ISO_639_2B "dyu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "dyu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "dyu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dyu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Dyula"@dyu; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DYU>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "dyula"@dyu .
<https://nma.eosc.cz/vocabularies/languages/dyy> ccmm_props:ISO_639_3 "dyy"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dyy"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Djabugay"@dyy, "Dyaabugay"@en; skos:definition "Yidiny is an endangered Australian Aboriginal language spoken in the northeast of Queensland by the Yidinji people. It is closely related to Djabugay, and both are sometimes placed in a separate Yidinyic branch of the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DYY>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Djabugay"@en .
<https://nma.eosc.cz/vocabularies/languages/dza> ccmm_props:ISO_639_3 "dza"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dza"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Tunzu"@dza; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DZA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "tunzu"@dza .
<https://nma.eosc.cz/vocabularies/languages/dzd> ccmm_props:ISO_639_3 "dzd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dzd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Daza"@dzd; skos:definition "Daza or (in Hausa) Dazawa is listed by Blench (2006) as a Chadic language within the Bole group, spoken in a few villages of Darazo LGA, Bauchi State, Nigeria. It was confirmed to exist in 2021. The language is nearly extinct with only elderly speakers speaking the language. Native speakers have shifted to Hausa."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DZD>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Daza"@en .
<https://nma.eosc.cz/vocabularies/languages/dze> ccmm_props:ISO_639_3 "dze"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dze"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Djiwarli"@dze, "Jiwarli"@en; skos:definition "Djiwarli, also known as Jiwarli, is a Mantharta language spoken in the Pilbara region of Western Australia. It is closely related to Thiin (iin). Together with other Mantharta languages it belongs to the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DZE>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Djiwarli"@en .
<https://nma.eosc.cz/vocabularies/languages/dzg> ccmm_props:ISO_639_3 "dzg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dzg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Daza"@dzg; skos:definition "Dazaga (also known as Daza) belongs to the Saharan primary branch of the putative Nilo-Saharan language family. It is spoken by the Daza people in northern Chad and eastern Niger. Within the Saharan branch – which also includes the Kanuri, Kanembu, and Tebu languages – Dazaga is classified as part of the Western Saharan subgroup. The constituent families of Nilo-Saharan are quite diverse. One characteristic feature is a tripartite singulative-collective-plurative number system."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DZG>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Dazaga"@en .

<http://publications.europa.eu/resource/authority/language/BUL> ccmm_props:ISO_639_1 "bg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "bul"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "bul"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "bul"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "bg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "bulgarski"@bg; skos:definition "Bulgarian is a member of the Southern subgroup of the Slavic languages, spoken mainly in Bulgaria.Modern Bulgarian has several striking differences from other Slavic languages. e.g. nouns are no longer declined; however, there is a definite article suffixed to the noun.Bulgarian is written with the Cyrillic alphabet."@en, "Le bulgare est une langue du sous-groupe sud des langues slaves. Il est parlé principalement en Bulgarie.Le bulgare a plusieurs caractéristiques qui le distinguent de toutes les autres langues slaves, par exemple l’absence de déclinaison ou l’existence d’un article défini suffixé au nom.Il est écrit avec l’alphabet cyrillique."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "български"@bg, "bulharština"@cs, "bulgarsk"@da, "Bulgarisch"@de, "βουλγαρικά"@el, "Bulgarian"@en, "búlgaro"@es, "bulgaaria keel"@et, "bulgaria"@fi, "bulgare"@fr, "Bulgáiris"@ga, "bugarski"@hr, "bołharšćina"@hsb, "bolgár"@hu, "búlgarska"@is, "bulgaro"@it, "bulgarų kalba"@lt, "bulgāru valoda"@lv, "бугарски"@mk, "Bulgaru"@mt, "Bulgaars"@nl, "bulgarsk"@no, "bułgarski"@pl, "búlgaro"@pt, "bulgară"@ro, "болгарский"@ru, "bugarski"@sh, "bulharčina"@sk, "bolgarščina"@sl, "бугарски"@sr, "bulgariska"@sv, "bulgarca"@tr, "болгарська мова"@uk .

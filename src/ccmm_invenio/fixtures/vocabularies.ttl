<https://nma.eosc.cz/vocabularies/languages/bod> ccmm_props:ISO_639_1 "bo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "tib"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "bod"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "bod"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "bo"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "bod-skad"@bo, "བོད་སྐད།"@bo; skos:definition "The Tibetic or Tibetan languages (Bodish) are a cluster of mutually unintelligible Tibeto-Burman languages spoken primarily by Tibetan peoples who live across a wide area of eastern Central Asia bordering the Indian subcontinent, including the Tibetan Plateau and the northern Indian subcontinent in Baltistan, Ladakh, Nepal, Sikkim, and Bhutan. The classical written form is a major regional literary language, particularly for its use in Buddhist literature.Most Tibetic languages are written in an Indic script, with a historically conservative orthography (see below) that helps unify the Tibetan-language area. However, some Ladakhi and Balti speakers write with the Urdu script."@en, "Le tibétain est une langue parlée par plusieurs millions de locuteurs dans l’ancien Tibet, c’est-à-dire la Région autonome du Tibet, les zones à population tibétaine du Qinghai (Amdo), du Gansu, du Sichuan et du Yunnan (Kham) en République populaire de Chine, et dans certaines régions des pays environnants, de l’Himalaya et de l’Asie centrale, comme le Ladakh et le Sikkim en Inde, le Baltistan pakistanais, le Bhoutan et le nord du Népal. Le tibétain est une langue appartenant à la famille des langues tibéto-birmanes. Il se subdivise en un grand nombre de dialectes.L’écriture Phagspa, alphasyllabaire, fut créée comme écriture unifiée pour toutes les langues de l’Empire mongol. Le lama Phagspa la dériva de son écriture natale, l’écriture tibétaine."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/BOD>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "тибетски"@bg, "tibetština"@cs, "tibetansk"@da, "Tibetisch"@de, "θιβετιανά"@el, "Tibetan"@en, "tibetano"@es, "tiibeti keel"@et, "tiibet"@fi, "tibétain"@fr, "Tibetanis"@ga, "tibetski"@hr, "tibeti"@hu, "tibetanska"@is, "tibetano"@it, "tibetiečių kalba"@lt, "tibetiešu valoda"@lv, "тибетски"@mk, "Tibetan"@mt, "Tibetaans"@nl, "tibetanske"@no, "tybetański"@pl, "tibetano"@pt, "tibetană"@ro, "тибетский"@ru, "tibetski"@sh, "tibetčina"@sk, "tibetanščina"@sl, "tibetanska"@sv, "tibetçe"@tr, "тибетська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/boe> ccmm_props:ISO_639_3 "boe"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "boe"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Mundabli"@boe; skos:exactMatch <http://publications.europa.eu/resource/authority/language/BOE>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "mundabli"@boe .
<https://nma.eosc.cz/vocabularies/languages/bof> ccmm_props:ISO_639_3 "bof"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "bof"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "bolon"@bof; skos:definition "Bolon is a Manding language of Burkina Faso. There are two dialects, White/Southern and Black/Northern; White Bolon is partially intelligible with Jula. Manding languages are a sub-branch of Mande languages that are part of the hypothetical Niger-Congo language family. However, as the Mande languages lack the noun-class morphology, linguists increasingly treat Mande and Atlantic–Congo as independent language families and reject the Niger-Congo hypothesis."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/BOF>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "болон"@bg, "bolon"@cs, "bolon"@da, "Bolon"@de, "Μπολόν"@el, "Bolon"@en, "Bolon"@es, "bolon"@fi, "bolon"@fr, "Bólónais"@ga, "bolon"@hr, "bolon"@hu, "Bolon"@it, "bolonų"@lt, "bolonu"@lv, "Bolon"@mt, "Bolon"@nl, "bolon"@pl, "bolom"@pt, "bolon"@ro, "bolon"@sk, "bolonščina"@sl, "bolon"@sv .
<https://nma.eosc.cz/vocabularies/languages/bog> ccmm_props:ISO_639_3 "bog"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "bog"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Bamako Sign Language"@bog; skos:definition "Bamako Sign Language is a sign language used in Bamako region in Mali. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/BOG>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Бамако"@bg, "bamacký znakový jazyk"@cs, "Bamako tegnsprog"@da, "Bamako-Gebärdensprache"@de, "νοηματική γλώσσα Μπαμακό"@el, "Bamako Sign Language"@en, "lengua de signos de Bamako"@es, "bamako viipekeel"@et, "bamakolainen viittomakieli"@fi, "langue des signes de Bamako"@fr, "Teanga Chomharthaíochta Bamako"@ga, "bamako znakovni jezik"@hr, "bamakói jelnyelv"@hu, "lingua dei segni di Bamako"@it, "Bamako gestų kalba"@lt, "Bamako zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Bamako"@mt, "Gebarentaal van Bamako"@nl, "język migowy Bamako"@pl, "língua gestual de Bamaco"@pt, "limbajul prin semne din Bamako"@ro, "малийский жестовый язык"@ru, "posunkový jazyk Bamako"@sk, "Bamako znakovni jezik"@sl, "Bamako-teckenspråk"@sv .

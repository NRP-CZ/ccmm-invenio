<https://nma.eosc.cz/vocabularies/languages/ukr> ccmm_props:ISO_639_1 "uk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "ukr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "ukr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "ukr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "uk"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "ukrainska mova"@uk; skos:definition "Ukrainian is one of the East Slavic languages and shares many grammatical and lexical features with other members of the branch, Russian and Belorusian. It is spoken mainly in Ukraine.Ukrainian is written with the Cyrillic alphabet."@en, "L’ukrainien fait partie des langues slaves et partage de nombreuses caractéristiques grammaticales et lexicales avec d’autres langues de cette branche, le russe et le biélorusse. Il est parlé principalement en Ukraine.L’ukrainien s’écrit avec l’alphabet cyrillique."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/UKR>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "украински"@bg, "ukrajinština"@cs, "ukrainsk"@da, "Ukrainisch"@de, "ουκρανικά"@el, "Ukrainian"@en, "ucraniano"@es, "ukraina keel"@et, "ukraina"@fi, "ukrainien"@fr, "Úcráinis"@ga, "ukrajinski"@hr, "ukrainšćina"@hsb, "ukrán"@hu, "úkraínska"@is, "ucraino"@it, "ukrainiečių kalba"@lt, "ukraiņu valoda"@lv, "украински"@mk, "Ukren"@mt, "Oekraïens"@nl, "ukrainsk"@no, "ukraiński"@pl, "ucraniano"@pt, "ucraineană"@ro, "украинский"@ru, "ukrajinski"@sh, "ukrajinčina"@sk, "ukrajinščina"@sl, "украјински"@sr, "ukrainska"@sv, "ukrayna"@tr, "українська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/uks> ccmm_props:ISO_639_3 "uks"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "uks"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Urubú-Kaapor Sign Language"@uks; skos:definition "Urubú-Kaapor Sign Language is a village sign language used by Ka’apor people in Brazilia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/UKS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език Урубу-Каапор"@bg, "caaporský znakový jazyk"@cs, "Urubú-Kaapor tegnsprog"@da, "Urubú-Kaapor-Gebärdensprache"@de, "νοηματική γλώσσα Ουρουμπού-Κααπόρ"@el, "Urubú-Kaapor Sign Language"@en, "lengua de signos de urubú-kaapor"@es, "urbu-kaapori viipekeel"@et, "ka’aporilainen viittomakieli"@fi, "langue des signes urubú-ka’apór"@fr, "Teanga Chomharthaíochta Urubú-Kaapor"@ga, "znakovni jezik naroda Kaapor"@hr, "Urubú-Kaapor jelnyelv"@hu, "lingua dei segni Urubú-Kaapor"@it, "Urubu-Kaapor gestų kalba"@lt, "kaporu zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Urubú-Kaapor"@mt, "Urubú-Kaapor Gebarentaal"@nl, "język migowy Urubú-Kaapor"@pl, "língua gestual caapor"@pt, "limbajul prin semne din Urubú-Kaapor"@ro, "posunkový jazyk Urubú-Kaapor"@sk, "Urubú-Kaapor znakovni jezik"@sl, "Urubú-Kaapor-teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/uku> ccmm_props:ISO_639_3 "uku"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "uku"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Ukue"@uku; skos:exactMatch <http://publications.europa.eu/resource/authority/language/UKU>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "ukue"@uku .
<https://nma.eosc.cz/vocabularies/languages/ukv> ccmm_props:ISO_639_3 "ukv"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ukv"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Kutuk na Kuku"@en, "Kuku"@ukv; skos:definition "Kuku, also called Kutuk na Kuku (Kuku language), is spoken in Southern Sudan and Northern Uganda. Together with Bari, it belongs to the Nuclear Barian group of the Eastern Nilotic branch of the Nilotic language family. Kuku was initially classified as a dialect of Bari."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/UKV>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Kuku"@en .
<https://nma.eosc.cz/vocabularies/languages/ukw> ccmm_props:ISO_639_3 "ukw"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ukw"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Ukwuani-Aboh-Ndoni"@ukw; skos:exactMatch <http://publications.europa.eu/resource/authority/language/UKW>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "ukwuani-Aboh-Ndoni"@ukw .
<https://nma.eosc.cz/vocabularies/languages/uky> ccmm_props:ISO_639_3 "uky"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "uky"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Kuuk-Yak"@uky; skos:definition "Kuuk-Yak, literally ‘snake language’, is an extinct Pama-Nyungan language formerly spoken on the Cape York Peninsula of Queensland in Australia. It is thought to be related to Kuuk Thayorre (thd). If so, it is classified within the Paman branch and more specifically within the Southwest Pama sub-branch. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/UKY>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Kuuk-Yak"@en .

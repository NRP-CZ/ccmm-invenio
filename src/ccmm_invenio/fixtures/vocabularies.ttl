<https://nma.eosc.cz/vocabularies/languages/jus> ccmm_props:ISO_639_3 "jus"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "jus"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Jumla Sign Language"@jus; skos:definition "Jumla Sign Language is a sign language used in Jumla village in Nepal. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/JUS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език на Джумла"@bg, "jumelský znakový jazyk"@cs, "Jumla-tegnsprog"@da, "Jumla-Gebärdensprache"@de, "νοηματική γλώσσα της Jumla"@el, "Jumla Sign Language"@en, "lengua de signos de Jumla"@es, "Jumla viipekeel"@et, "jumlalainen viittomakieli"@fi, "langue des signes de Jumla"@fr, "Teanga Chomharthaíochta Jumla"@ga, "jumlanski znakovni jezik"@hr, "jumlai jelnyelv"@hu, "lingua dei segni di Jumla"@it, "Džumlos gestų kalba"@lt, "jumlas zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Jumla"@mt, "Jumla-gebarentaal"@nl, "język migowy Jumla"@pl, "língua gestual de Júmela"@pt, "limbajul prin semne Jumla"@ro, "jumelský posunkový jazyk"@sk, "jumla znakovni jezik"@sl, "Jumla-teckenspråk"@sv .

<http://publications.europa.eu/resource/authority/language/ASW> ccmm_props:ISO_639_3 "asw"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "asw"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Australian Aborigines Sign Language"@asw; skos:definition "Australian Aborigines Sign Language is a sign language used in Australia by aborigines communities. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език на австралийските аборигени"@bg, "znakový jazyk Austrálců"@cs, "det australske oprindelige folks tegnsprog"@da, "Aborigines-Gebärdensprache"@de, "νοηματική γλώσσα των αυτοχθόνων της Αυστραλίας"@el, "Australian Aborigines Sign Language"@en, "lengua de signos de los aborígenes australianos"@es, "Austraalia aborigeenide viipekeel"@et, "Australian aboriginaalien viittomakieli"@fi, "langue des signes des aborigènes d’Australie"@fr, "Teanga Chomharthaíochta Bhundúchasaigh na hAstráile"@ga, "znakovni jezik australskih aboridžina"@hr, "ausztrál aboriginal jelnyelv"@hu, "lingua dei segni aborigena australiana"@it, "Australijos aborigenų gestų kalba"@lt, "Austrālijas aborigēnu zīmju valoda"@lv, "Lingwa tas-Sinjali tal-Aboriġini Awstraljani"@mt, "Australische aborigine-gebarentaal"@nl, "australijski aborygeński język migowy"@pl, "língua gestual aborígene da Austrália"@pt, "limbajul prin semne al aborigenilor australieni"@ro, "жестовые языки австралийских аборигенов"@ru, "austrálsky pôvodný posunkový jazyk"@sk, "znakovni jezik avstralskih staroselcev (Aboridžini)"@sl, "australiskt aboriginskt teckenspråk"@sv .

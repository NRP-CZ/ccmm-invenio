<https://nma.eosc.cz/vocabularies/languages/aka> ccmm_props:ISO_639_1 "ak"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "aka"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "aka"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "aka"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ak"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Ákán"@ak; skos:definition "Akan is an Atlantic-Congo language that belongs to the Central Tano group of the Volta-Congo languages. It is the principal native language of the Akan people of Ghana, spoken over much of the southern half of Ghana. It is also spoken in parts of Côte d’Ivoire. With the Atlantic slave trade, the language was introduced to the Caribbean and South America, notably in Suriname and in Jamaica. The Akan language and its dialects use the Adinkra Nkyea writing system. It is part of the hypothetical Niger-Congo language family."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/AKA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "акан"@bg, "akanština"@cs, "akan"@da, "Akan"@de, "ακάν"@el, "Akan"@en, "akan"@es, "akani"@et, "akan"@fi, "akan"@fr, "Acáinis"@ga, "akanski"@hr, "akan"@hu, "akan"@it, "akanų"@lt, "akanu valoda"@lv, "Akan"@mt, "Akan"@nl, "akan"@pl, "akan"@pt, "akan"@ro, "akančina"@sk, "akanščina"@sl, "akan"@sv, "аканська мова"@uk .

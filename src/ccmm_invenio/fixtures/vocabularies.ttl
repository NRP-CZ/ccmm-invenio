<https://nma.eosc.cz/vocabularies/languages/ukl> ccmm_props:ISO_639_3 "ukl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ukl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Ukrainian Sign Language"@ukl; skos:definition "Ukrainian Sign Language is a sign language used in Ukraine. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/UKL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "украински жестомимичен език"@bg, "ukrajinský znakový jazyk"@cs, "ukrainsk tegnsprog"@da, "Ukrainische Gebärdensprache"@de, "ουκρανική νοηματική γλώσσα"@el, "Ukrainian Sign Language"@en, "lengua de signos ucraniana"@es, "ukraina viipekeel"@et, "ukrainalainen viittomakieli"@fi, "langue des signes ukrainienne"@fr, "Teanga Chomharthaíochta na hÚcráine"@ga, "ukrajinski znakovni jezik"@hr, "ukrán jelnyelv"@hu, "lingua dei segni ucraina"@it, "ukrainiečių gestų kalba"@lt, "ukraiņu zīmju valoda"@lv, "Lingwa tas-Sinjali Ukrena"@mt, "Oekraïense Gebarentaal"@nl, "ukraiński język migowy"@pl, "língua gestual ucraniana"@pt, "limbajul prin semne din Ucraina"@ro, "ukrajinský posunkový jazyk"@sk, "ukrajinski znakovni jezik"@sl, "ukrainskt teckenspråk"@sv, "українська мова жестів"@uk .

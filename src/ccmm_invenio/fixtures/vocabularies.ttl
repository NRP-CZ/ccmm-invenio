<https://nma.eosc.cz/vocabularies/languages/umg> ccmm_props:ISO_639_3 "umg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "umg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Umbuygamu"@en, "Morrobalama"@umg; skos:definition "Morrobalama is an extinct Pama-Nyungan language once spoken in Princess Charlotte Bay in far-north Queensland in Australia. It belongs to the Paman branch and more specifically to the Lamalamic group of languages. It is closely related to Lamalama (lby). The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/UMG>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Morrobalama"@en .

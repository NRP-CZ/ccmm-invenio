<https://nma.eosc.cz/vocabularies/languages/kiu> ccmm_props:ISO_639_3 "kiu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "kiu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Northern Zazaki"@en, "Kirmanckî"@kiu, "کرمانجکی"@kiu; skos:definition "Kirmanjki (Kirmanckî) or Northern Zaza is an Indo-Iranian language spoken primarily in eastern Turkey. The language is a part of the Zaza–Gorani language group of the northwestern group of the Iranian branch."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/KIU>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "зазаки"@bg, "kirmaňdžkí"@cs, "kirmanjki"@da, "Kurmandschi"@de, "Κουρμαντζί"@el, "Kirmanjki"@en, "Kirmanjki"@es, "kõrmandžki"@et, "kirmanjki"@fi, "kirmanjki"@fr, "Círmeainscis"@ga, "kurmandži"@hr, "kirmancki"@hu, "Kirmanjki"@it, "kurmandžių"@lt, "kirmanjki"@lv, "Kirmanjki"@mt, "Kirmanjki"@nl, "kirmandżki"@pl, "kirmanjki"@pt, "kirmanjki"@ro, "kirmandžkí"@sk, "kirmandžki"@sl, "kirmanjki"@sv .

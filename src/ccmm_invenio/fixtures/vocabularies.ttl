<http://publications.europa.eu/resource/authority/language/XKI> ccmm_props:ISO_639_3 "xki"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xki"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Kenyan Sign Language"@xki; skos:definition "Kenyan Sign Language is a sign language used in Kenya. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Кения"@bg, "keňský znakový jazyk"@cs, "kenyansk tegnsprog"@da, "Kenianische Gebärdensprache"@de, "κενυατική νοηματική γλώσσα"@el, "Kenyan Sign Language"@en, "lengua de signos de Kenia"@es, "keenia viipekeel"@et, "kenialainen viittomakieli"@fi, "langue des signes kényane"@fr, "Teanga Chomharthaíochta na Céinia"@ga, "kenijski znakovni jezik"@hr, "kenyai jelnyelv"@hu, "lingua dei segni del Kenya"@it, "keniečių gestų kalba"@lt, "kenijiešu zīmju valoda"@lv, "Lingwa tas-Sinjali Kenjana"@mt, "Keniaanse Gebarentaal"@nl, "kenijski język migowy"@pl, "língua gestual queniana"@pt, "limbajul prin semne din Kenya"@ro, "kenský posunkový jazyk"@sk, "kenijski znakovni jezik"@sl, "kenyanskt teckenspråk"@sv .

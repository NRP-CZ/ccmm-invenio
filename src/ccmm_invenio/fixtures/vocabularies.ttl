<https://nma.eosc.cz/vocabularies/languages/vsi> ccmm_props:ISO_639_3 "vsi"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "vsi"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Moldova Sign Language"@vsi; skos:definition "Moldova Sign Language is a sign language used in Moldova. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/VSI>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "молдовски жестомимичен език"@bg, "moldavský znakový jazyk"@cs, "moldovisk tegnsprog"@da, "Moldauische Gebärdensprache"@de, "μολδαβική νοηματική γλώσσα"@el, "Moldovan Sign Language"@en, "lengua de signos moldava"@es, "moldova viipekeel"@et, "moldovalainen viittomakieli"@fi, "langue des signes moldave"@fr, "Teanga Chomharthaíochta na Moldóive"@ga, "moldovski znakovni jezik"@hr, "moldáv jelnyelv"@hu, "lingua dei segni moldava"@it, "moldavų gestų kalba"@lt, "moldāvu zīmju valoda"@lv, "Lingwa tas-Sinjali Moldovana"@mt, "Moldavische Gebarentaal"@nl, "mołdawski język migowy"@pl, "língua gestual da Moldávia"@pt, "limbajul prin semne din Republica Moldova"@ro, "moldavský posunkový jazyk"@sk, "moldavski znakovni jezik"@sl, "moldaviskt teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/vsl> ccmm_props:ISO_639_3 "vsl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "vsl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Venezuelan Sign Language"@vsl; skos:definition "Venezuelan Sign Language is a sign language used in Venezuela. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/VSL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Венесуела"@bg, "venezuelský znakový jazyk"@cs, "venezuelansk tegnsprog"@da, "Venezolanische Gebärdensprache"@de, "βενεζουελανική νοηματική γλώσσα"@el, "Venezuelan Sign Language"@en, "lengua de signos venezolana"@es, "venezuela viipekeel"@et, "venezuelalainen viittomakieli"@fi, "langue des signes vénézuélienne"@fr, "Teanga Chomharthaíochta Veiniséala"@ga, "venezuelski znakovni jezik"@hr, "venezuelai jelnyelv"@hu, "lingua dei segni venezuelana"@it, "venesueliečių gestų kalba"@lt, "venecuēliešu zīmju valoda"@lv, "Lingwa tas-Sinjali Veneżweljana"@mt, "Venezolaanse Gebarentaal"@nl, "wenezuelski język migowy"@pl, "língua gestual venezuelana"@pt, "limbajul prin semne din Venezuela"@ro, "венесуэльский жестовый язык"@ru, "venezuelský posunkový jazyk"@sk, "venezuelski znakovni jezik"@sl, "venezuelanskt teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/vsn> ccmm_props:ISO_639_3 "vsn"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "vsn"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Vedasaṃskṛtam"@vsn; skos:definition "Vedic Sanskrit is the most ancient known precursor to Sanskrit, a language in the Indo-Aryan subgroup of the Indo-European language family. It is attested in the Vedas and related literature compiled over the period of the mid-2nd to mid-1st millennium BCE."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/VSN>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "ведически санскрит"@bg, "védský sanskrt"@cs, "vedisk sanskrit"@da, "Vedisch"@de, "Βεδικά Σανσκριτικά"@el, "Vedic Sanskrit"@en, "sánscrito védico"@es, "veedade sanskrit"@et, "veda-sanskrit"@fi, "sanskrit védique"@fr, "Sanscrait Véideach"@ga, "vedski sanskrt"@hr, "védikus szanszkrit"@hu, "sanscrito vedico"@it, "vedų kalba"@lt, "vēdiskais sanskrits"@lv, "Sanskritu Vediku"@mt, "Vedisch Sanskriet"@nl, "sanskryt wedyjski"@pl, "sânscrito védico"@pt, "sanscrită vedică"@ro, "védsky sanskrit"@sk, "vedski sanskrt"@sl, "vedisk sanskrit"@sv .
<https://nma.eosc.cz/vocabularies/languages/vsv> ccmm_props:ISO_639_3 "vsv"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "vsv"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Valencian Sign Language"@vsv; skos:definition "Valencian Sign Language is a sign language used in the Valencian community, in Spain. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/VSV>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Валенсия"@bg, "valencijský znakový jazyk"@cs, "valenciansk tegnsprog"@da, "Valencianische Gebärdensprache"@de, "νοηματική γλώσσα Βαλένθιας"@el, "Valencian Sign Language"@en, "lengua de signos valenciana"@es, "valencia viipekeel"@et, "valencialainen viittomakieli"@fi, "langue des signes valencienne"@fr, "Teanga Chomharthaíochta Valencia"@ga, "valencijski znakovni jezik"@hr, "valenciai jelnyelv"@hu, "lingua dei segni valenciana"@it, "Valensijos gestų kalba"@lt, "Valensijas zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Valencia"@mt, "Gebarentaal van Valencia"@nl, "walenckii język migowy"@pl, "língua gestual valenciana"@pt, "limbajul prin semne din Valencia"@ro, "валенсийский жестовый язык"@ru, "valencijský posunkový jazyk"@sk, "znakovni jezik Valencije"@sl, "valencianskt teckenspråk"@sv .

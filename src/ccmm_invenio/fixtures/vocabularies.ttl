<http://publications.europa.eu/resource/authority/language/MFR> ccmm_props:ISO_639_3 "mfr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mfr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Marrithiyel"@mfr; skos:definition "Marrithiyel is an endangered Australian Aboriginal language spoken by the Marrithiyel people whose traditional territory lay south of Darwin from Litchfield National Park and extend to the Daly River in the Northern Territory. It belongs to the small family of Western Daly languages, and more specifically to its Marithielic sub-branch."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Marrithiyel"@en .
<http://publications.europa.eu/resource/authority/language/MFS> ccmm_props:ISO_639_3 "mfs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mfs"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Mexican Sign Language"@mfs; skos:definition "Mexican Sign Language is a sign language used in Mexico. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Мексико"@bg, "mexický znakový jazyk"@cs, "mexicansk tegnsprog"@da, "Mexikanische Gebärdensprache"@de, "μεξικανική νοηματική γλώσσα"@el, "Mexican Sign Language"@en, "lengua de signos mejicana"@es, "mehhiko viipekeel"@et, "meksikolainen viittomakieli"@fi, "langue des signes mexicaine"@fr, "Teanga Chomharthaíochta Mheicsiceo"@ga, "meksički znakovni jezik"@hr, "mexikói jelnyelv"@hu, "lingua dei segni messicana"@it, "meksikiečių gestų kalba"@lt, "meksikāņu zīmju valoda"@lv, "Lingwa tas-Sinjali Messikana"@mt, "Mexicaanse Gebarentaal"@nl, "meksykański język migowy"@pl, "língua gestual mexicana"@pt, "limbajul prin semne din Mexic"@ro, "mexický posunkový jazyk"@sk, "mehiški znakovni jezik"@sl, "mexikanskt teckenspråk"@sv .

<https://nma.eosc.cz/vocabularies/languages/xpu> ccmm_props:ISO_639_3 "xpu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Punic"@xpu; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XPU>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "punic"@xpu .
<https://nma.eosc.cz/vocabularies/languages/xpv> ccmm_props:ISO_639_3 "xpv"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpv"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Tommeginne"@en, "Tommeginne"@xpv; skos:definition "Northern Tasmanian, or Tommeginne, is an Aboriginal language of Tasmania in the reconstruction of Claire Bowern. Northern Tasmanian is attested from word lists collected on Flinders Island by Joseph Milligan and published in 1857 & 1859."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XPV>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Northern Tasmanian"@en .
<https://nma.eosc.cz/vocabularies/languages/xpw> ccmm_props:ISO_639_3 "xpw"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpw"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Peerapper"@en, "Peerapper"@xpw; skos:definition "Northwestern Tasmanian, or Peerapper, is an Aboriginal language of Tasmania in the reconstruction of Claire Bowern. It was spoken along the west coast of the island, from Macquarie Harbour north to Circular Head and Robbins Island. Northwestern Tasmanian is poorly attested from four word lists: The ‘west coast’ vocabularies of Charles Robinson and George Augustus Robinson, with 246 words combined; the Robbins Island list of George Augustus Robinson, with 162 words; and the Macquarie Harbour vocabularies of Allan Cunningham (222 words), collected in 1819."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XPW>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Northwestern Tasmanian"@en .
<https://nma.eosc.cz/vocabularies/languages/xpx> ccmm_props:ISO_639_3 "xpx"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpx"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Toogee"@en, "Toogee"@xpx; skos:definition "Southwestern Tasmanian, or Toogee, is a possible Aboriginal language of Tasmania. It is the most poorly attested known variety of Tasmanian, and it is not clear how distinct it was. It was apparently spoken along the west coast of the island, south of Macquarie Harbour. Southwestern Tasmanian is attested from a single word list, collected in Port Davey by George Augustus Robinson from the Ninenee Tribe of the Bathurst Harbour area. There are 131 words, but some of these may be from Southeastern Tasmanian languages."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XPX>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Southwestern Tasmanian"@en .
<https://nma.eosc.cz/vocabularies/languages/xpy> ccmm_props:ISO_639_3 "xpy"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpy"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Puyo"@xpy; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XPY>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "puyo"@xpy .
<https://nma.eosc.cz/vocabularies/languages/xpz> ccmm_props:ISO_639_3 "xpz"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpz"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nuenonne"@xpz; skos:definition "Bruny Island Tasmanian, or Nuenonne, a name shared with Southeast Tasmanian, is an Aboriginal language or pair of languages of Tasmania in the reconstruction of Claire Bowern. It was spoken on Bruny Island, off the southeastern coast of Tasmania, by the Bruny tribe. The last speaker of Bruny Island was likely Truganini, who is also widely accepted as the last full-blooded Tasmanian Aboriginal person."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XPZ>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Bruny Island Tasmanian"@en .
<https://nma.eosc.cz/vocabularies/languages/xqa> ccmm_props:ISO_639_3 "xqa"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xqa"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Karakhanid"@xqa; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XQA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "karakhanid"@xqa .

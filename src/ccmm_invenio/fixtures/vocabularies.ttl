<http://publications.europa.eu/resource/authority/language/NOB> ccmm_props:ISO_639_1 "nb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "nob"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "nob"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "nob"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nb"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "norjan bokmål"@fi, "bokmål"@hr, "bokmål"@nb; skos:definition "Bokmål is one of the two official written standards of the Norwegian language, the other being nynorsk. Bokmål is by far the most used written form of Norwegian today, as it is adopted by around 90% of the population in Norway. There is no countrywide standard or agreement on the pronunciation of Bokmål and the spoken dialects vary greatly."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "норвежки книжовен"@bg, "norština (bokmål)"@cs, "bokmål"@da, "Bokmål"@de, "νορβηγική μπούκμολ"@el, "Norwegian Bokmål"@en, "bokmål"@es, "norra bokmåli keel"@et, "kirjanorja"@fi, "norvégien bokmål"@fr, "Bocmál"@ga, "knjižni norveški"@hr, "norvég bokmål"@hu, "norvegese bokmål"@it, "norvegų bukmolas"@lt, "norvēģu bukmols"@lv, "Bokmål Norveġiż"@mt, "Norwegian Bokmål"@nl, "norsk bokmål"@no, "norweski bokmål"@pl, "dano-noruguês"@pt, "norvegiană bokmål"@ro, "nórčina (bokmål)"@sk, "knjižna norveščina"@sl, "norska (bokmål)"@sv, "букмол"@uk .

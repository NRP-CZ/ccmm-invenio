<https://nma.eosc.cz/vocabularies/languages/hif> ccmm_props:ISO_639_3 "hif"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hif"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Fijian Hindi"@en, "Fiji Baat"@hif, "फिजी बात"@hif; skos:definition "Fiji Hindi is an Indo-Aryan language. It is one of the official languages of Fiji. Fiji Hindi is written using both the Latin and Devanagari script."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/HIF>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "фиджийски хинди"@bg, "fidžijská hindština"@cs, "fijiansk hindi"@da, "Fidschi-Hindi"@de, "χίντι των Νήσων Φίτζι"@el, "Fiji Hindi"@en, "hindi fiyiano"@es, "Fidži hindi keel"@et, "fidžinhindi"@fi, "hindi fidjien"@fr, "Hiondúis Fhidsí"@ga, "fidžijski hindski"@hr, "fidzsi hindi"@hu, "hindi figiano"@it, "Fidžio hindi"@lt, "fidži hindi valoda"@lv, "Hindi ta’ Fiġi"@mt, "Fiji Hindi"@nl, "hindi fidżyjskie"@pl, "híndi de Fiji"@pt, "hindi din Fiji"@ro, "fidžijská hindčina"@sk, "fidžijska hindujščina"@sl, "fijiansk hindi"@sv, "фіджі хінді"@uk .

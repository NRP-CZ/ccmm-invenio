<https://nma.eosc.cz/vocabularies/languages/zsl> ccmm_props:ISO_639_3 "zsl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "zsl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Zambian Sign Language"@zsl; skos:definition "Zambian Sign Language is a sign language used in Zambia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ZSL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Замбия"@bg, "zambijský znakový jazyk"@cs, "zambisk tegnsprog"@da, "Sambische Gebärdensprache"@de, "ζαμπιανή νοηματική γλώσσα"@el, "Zambian Sign Language"@en, "lengua de signos de Zambia"@es, "sambia viipekeel"@et, "sambialainen viittomakieli"@fi, "langue des signes zambienne"@fr, "Teanga Chomharthaíochta na Saimbia"@ga, "zambijski znakovni jezik"@hr, "zambiai jelnyelv"@hu, "lingua dei segni dello Zambia"@it, "zambiečių gestų kalba"@lt, "Zambijas zīmju valoda"@lv, "Lingwa tas-Sinjali taż-Żambja"@mt, "Zambiaanse Gebarentaal"@nl, "zambijski język migowy"@pl, "língua gestual zambiana"@pt, "limbajul prin semne din Zambia"@ro, "zambijský posunkový jazyk"@sk, "zambijski znakovni jezik"@sl, "zambiskt teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/zsm> ccmm_props:ISO_639_3 "zsm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "zsm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "بهاس ملايو"@zlm, "Bahasa Melayu"@zsm, "Bahasa Melayu piawai"@zsm; skos:definition "Standard Malay is the official language of Malaysia and a standardised register of the Malacca dialect of Malay. It is a compulsory subject in primary and secondary school. The Malaysian name for the language is Bahasa Malaysia (literally ‘the language of Malaysia’). Standard Malay is normally written using a Latin alphabet called Rumi, though an Arabic alphabet called Jawi also exists. Malaysian is an Austronesian language that belongs to the Malayo-Polynesian branch. Austronesian languages often possess phoneme inventories smaller than the world average. Two salient morphological characteristics are a system of affixation and reduplication to form new words."@en, "Le malais ou malaisien (bahasa Malaysia, littéralement «langue de la Malaisie») est l’appellation officielle de la langue nationale de la Malaisie. Il exprime une volonté politique de fédérer les diverses communautés du pays grâce à une langue partagée par tous les citoyens. Le malaisien est une des formes du malais, appelé également «malais standard». Il est enseigné dans toutes les écoles du pays et sert d’outil de communication interethnique.Le malais moderne et l’indonésien s’écrivent avec l’alphabet latin, tandis que le malais classique utilise l’alphabet arabe."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ZSM>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "стандартен малайски"@bg, "standardní malajština"@cs, "standardmalajisk"@da, "Malaysisch"@de, "τυποποιημένα μαλαισιανά"@el, "Standard Malay"@en, "malayo estándar"@es, "malaisia keel"@et, "standardimalaiji"@fi, "malais standard"@fr, "Malaeis Chaighdeánach"@ga, "standardni malajski"@hr, "standard maláj"@hu, "malese standard"@it, "standartinė malajų k."@lt, "literārā malajiešu valoda"@lv, "Malaj Standard"@mt, "Standaardmaleis"@nl, "standardowy malajski"@pl, "malaio-padrão"@pt, "malaeză standard"@ro, "štandardná malajčina"@sk, "standardna malajščina"@sl, "standardmalajiska"@sv .

<https://nma.eosc.cz/vocabularies/languages/lsg> ccmm_props:ISO_639_3 "lsg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lsg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "langue des signes lyonnaise"@lsg; skos:definition "Lyons Sign Language is a sign language used in Lyon region in France. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/LSG>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от град Лион"@bg, "lyonský znakový jazyk"@cs, "lyons tegnsprog"@da, "Lyoner Gebärdensprache"@de, "νοηματική γλώσσα Λυόν"@el, "Lyons Sign Language"@en, "lengua de signos de Lyon"@es, "Lyoni viipekeel"@et, "lyonilainen viittomakieli"@fi, "langue des signes lyonnaise"@fr, "Teanga Chomharthaíochta Lyon"@ga, "lyonski znakovni jezik"@hr, "lyoni jelnyelv"@hu, "lingua dei segni della città di Lione"@it, "Lyonso gestų kalba"@lt, "Lionas zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Lyons"@mt, "Gebarentaal van Lyon"@nl, "lioński język migowy"@pl, "língua gestual lionesa"@pt, "limbajul prin semne din Lyons"@ro, "лионский жестовый язык"@ru, "lyonský posunkový jazyk"@sk, "znakovni jezik iz Lyonsa"@sl, "Lyon-teckenspråk"@sv .

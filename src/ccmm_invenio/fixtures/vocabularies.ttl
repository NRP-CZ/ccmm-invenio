<http://publications.europa.eu/resource/authority/language/ZEM> ccmm_props:ISO_639_3 "zem"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "zem"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "zaimanci"@hr, "Zeem"@zem; skos:definition "Zeem is an Afro-Asiatic language spoken in Nigeria. It belongs to the endangered Western Chadic sub-branch whose speakers are shifting to Hausa. Together with Tulai and Cha'ari, it forms the Nuclear Zeemic group."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "зеем"@bg, "zeem"@cs, "zeem"@da, "Zeem"@de, "Ζέεμ"@el, "Zeem"@en, "Zeem"@es, "zeem"@fi, "zeem"@fr, "Símis"@ga, "zeem"@hr, "zeem"@hu, "Zeem"@it, "zemų"@lt, "zīmu"@lv, "Zeem"@mt, "Zeem"@nl, "zeem"@pl, "zime"@pt, "zeem"@ro, "zeem"@sk, "zimščina"@sl, "zeem"@sv .

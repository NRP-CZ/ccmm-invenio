<http://publications.europa.eu/resource/authority/language/SAG> ccmm_props:ISO_639_1 "sg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "sag"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "sag"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "sag"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Sangho"@en, "yângâ tî sängö"@sg; skos:definition "Sango is a Ngbandi-based creole language. It is one of the official languages of the Central African Republic."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "санго"@bg, "sangština"@cs, "sango"@da, "Sango"@de, "σάνγκο"@el, "Sango"@en, "sango"@es, "sango keel"@et, "sango"@fi, "sango"@fr, "Sangóis"@ga, "sango"@hr, "szango"@hu, "sango"@it, "sangų kalba"@lt, "sangu valoda"@lv, "Sango"@mt, "Sango"@nl, "sango"@pl, "sango"@pt, "sango"@ro, "sango"@sk, "sango"@sl, "sango"@sv, "санго"@uk .

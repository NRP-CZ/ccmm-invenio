<https://nma.eosc.cz/vocabularies/languages/gle> ccmm_props:ISO_639_1 "ga"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "gle"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "gle"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "gle"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ga"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "gaélique"@fr, "gaélique irlandais"@fr; skos:definition "Irish, Irish Gaelic, or Gaelic (Gaeilge) belongs to the Gaelic branch of the Celtic family of languages, originating in Ireland and historically spoken by the Irish people.Irish is spoken as a first language by a small minority of Irish people, and as a second language by a rather larger group. Irish enjoys constitutional status as the national and first official language of the Republic of Ireland, and is an officially recognised minority language in Northern Ireland."@en, "L’irlandais, gaélique irlandais ou gaélique (Gaeilge) appartient à la branche gaélique de la famille des langues celtiques, originaires de l’Irlande et historiquement parlées par le peuple irlandais.L’irlandais est utilisé comme première langue par une minorité irlandaise et comme deuxième langue par un groupe beaucoup plus large. L’irlandais bénéficie d’un statut constitutionnel comme langue officielle nationale et première langue de la République d’Irlande, et est une langue minoritaire officiellement reconnue en Irlande du Nord."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/GLE>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "ирландски"@bg, "irština"@cs, "irsk"@da, "Irisch"@de, "ιρλανδικά"@el, "Irish"@en, "irlandés"@es, "iiri keel"@et, "iiri"@fi, "irlandais"@fr, "Gaeilge"@ga, "irski"@hr, "iršćina"@hsb, "ír"@hu, "írska"@is, "irlandese"@it, "airių kalba"@lt, "īru valoda"@lv, "ирски"@mk, "Irlandiż"@mt, "Iers"@nl, "irsk"@no, "irlandzki"@pl, "irlandês"@pt, "irlandeză"@ro, "ирландский"@ru, "irski"@sh, "írčina"@sk, "irščina"@sl, "ирски"@sr, "iriska"@sv, "ırlandaca"@tr, "ірландська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/glg> ccmm_props:ISO_639_1 "gl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "glg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "glg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "glg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "gl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "galego"@gl; skos:definition "Galician (galego) is an Indo-European language of the Western Ibero-Romance branch, closely related to Portuguese. It is spoken mainly in the autonomous region of Galicia, located in north-western Spain."@en, "Le galicien (galego) est une langue indo-européenne de la branche ibéro-romane occidentale, très proche du portugais. Il est principalement parlé dans la région autonome de Galice, située dans le nord-ouest de l’Espagne."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/GLG>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "галисийски"@bg, "galicijština"@cs, "galicisk"@da, "Galicisch"@de, "γαλικιανά"@el, "Galician"@en, "gallego"@es, "galeegi keel"@et, "galicia"@fi, "galicien"@fr, "Gailísis"@ga, "galicijski"@hr, "galščina"@hsb, "galíciai"@hu, "galiziano"@it, "galisų kalba"@lt, "galisiešu valoda"@lv, "галициски"@mk, "Galizjan"@mt, "Galicisch"@nl, "galisisk"@no, "galicyjski"@pl, "galego"@pt, "galiciană"@ro, "галисийский"@ru, "galicijski"@sh, "galícijčina"@sk, "galščina"@sl, "галицијски"@sr, "galiciska"@sv, "galiçyaca"@tr, "галісійська мова"@uk .

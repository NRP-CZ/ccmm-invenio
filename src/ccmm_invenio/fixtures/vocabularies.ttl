<https://nma.eosc.cz/vocabularies/languages/rki> ccmm_props:ISO_639_3 "rki"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rki"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Rakhine"@rki; skos:exactMatch <http://publications.europa.eu/resource/authority/language/RKI>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "rakhine"@rki .
<https://nma.eosc.cz/vocabularies/languages/rkm> ccmm_props:ISO_639_3 "rkm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rkm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "dafing"@hr, "dafing"@rkm, "marka"@rkm; skos:definition "Marka, also called Dafing, is a Manding language of West Africa, spoken in northwest Burkina Faso. Manding languages are a sub-branch of Mande languages that are part of the hypothetical Niger-Congo language family. However, as the Mande languages lack the noun-class morphology, linguists increasingly treat Mande and Atlantic–Congo as independent language families and reject the Niger-Congo hypothesis."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/RKM>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "марка"@bg, "marka"@cs, "marka"@da, "Marka"@de, "Μάρκα"@el, "Marka"@en, "Marka"@es, "marka"@fi, "marka"@fr, "Marcais"@ga, "marka"@hr, "marka"@hu, "Marka"@it, "markų"@lt, "marka"@lv, "Marka"@mt, "Marka"@nl, "marka"@pl, "marca"@pt, "marka"@ro, "marka"@sk, "markaščina"@sl, "marka"@sv .
<https://nma.eosc.cz/vocabularies/languages/rkt> ccmm_props:ISO_639_3 "rkt"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rkt"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Rangpuri"@rkt; skos:exactMatch <http://publications.europa.eu/resource/authority/language/RKT>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "rangpuri"@rkt .

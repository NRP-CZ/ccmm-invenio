<https://nma.eosc.cz/vocabularies/languages/xrg> ccmm_props:ISO_639_3 "xrg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xrg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Mineng"@en, "Mirnong"@en, "Minang"@xrg; skos:definition "Minang is an extinct Australian Aboriginal language formerly spoken in the south-western corner of Western Australia. It is classified in the Nyunga group within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XRG>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Minang"@en .

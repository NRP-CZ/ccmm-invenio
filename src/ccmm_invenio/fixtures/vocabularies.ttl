<http://publications.europa.eu/resource/authority/language/UND> ccmm_props:ISO_639_2B "und"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "und"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "und"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "und"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:definition "Undetermined is provided for those situations in which a language or languages must be indicated but the language cannot be identified."@en, "«Indéterminé»: pour les situations dans lesquelles une ou plusieurs langues doivent être signalées mais la langue ne peut pas être identifiée."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "неустановен език"@bg, "nezjistitelný"@cs, "ukendt"@da, "Unbekannt"@de, "απροσδιόριστη"@el, "Undetermined"@en, "sin determinar"@es, "täpsustamata"@et, "ei määritelty"@fi, "indéterminé"@fr, "Neamhchinntithe"@ga, "nije određen"@hr, "meghatározatlan"@hu, "indeterminato"@it, "neapibrėžta"@lt, "nav nosakāms"@lv, "Mhux determinata"@mt, "Onbepaald"@nl, "nieokreślona"@pl, "indeterminada"@pt, "nedeterminată"@ro, "neurčený"@sk, "nedoločljivo"@sl, "okänt"@sv .

<https://nma.eosc.cz/vocabularies/languages/ysl> ccmm_props:ISO_639_3 "ysl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ysl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Yugoslavian Sign Language"@ysl; skos:definition "Yugoslavian Sign Language is a sign language used in countries of the former Yougoslavia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/YSL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Югославия"@bg, "jugoslávský znakový jazyk"@cs, "jugoslavisk tegnsprog"@da, "Jugoslawische Gebärdensprache"@de, "γιουγκοσλαβική νοηματική γλώσσα"@el, "Yugoslavian Sign Language"@en, "lengua de signos yugoslava"@es, "jugoslaavia viipekeel"@et, "jugoslavialainen viittomakieli"@fi, "langue des signes yougoslave"@fr, "Teanga Chomharthaíochta na hIúgslaive"@ga, "jugoslavenski znakovni jezik"@hr, "jugoszláv jelnyelv"@hu, "lingua dei segni iugoslava"@it, "jugoslavų gestų kalba"@lt, "dienvidslāvu zīmju valoda"@lv, "Lingwa tas-Sinjali Jugoslava"@mt, "Joegoslavische Gebarentaal"@nl, "jugosławiański język migowy"@pl, "língua gestual jugoslava"@pt, "limbajul prin semne iugoslav"@ro, "juhoslovanský posunkový jazyk"@sk, "jugoslovanski znakovni jezik"@sl, "jugoslaviskt teckenspråk"@sv .

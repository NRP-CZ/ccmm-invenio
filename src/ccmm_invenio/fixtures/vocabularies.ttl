<http://publications.europa.eu/resource/authority/language/FAO> ccmm_props:ISO_639_1 "fo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "fao"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "fao"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "fao"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fo"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Φεροέζικα"@el, "føroyskt"@fo, "féroïen"@fr; skos:definition "Faroese is a North Germanic language spoken in the Faroe Islands.Faroese grammar is related and very similar to that of modern Icelandic and Old Norse."@en, "Le féroïen ou féringien est une langue germanique du Nord parlée dans les Îles Féroé.La grammaire des Îles Féroé est très proche de celles de l’islandais moderne et du vieux norrois."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "фарьорски"@bg, "faerština"@cs, "færøsk"@da, "Färöisch"@de, "φεροϊκά"@el, "Faroese"@en, "feroés"@es, "fääri keel"@et, "fääri"@fi, "féringien"@fr, "Faróis"@ga, "ferojski"@hr, "färöšćina"@hsb, "feröeri"@hu, "færeyska"@is, "faroese"@it, "farerų kalba"@lt, "fēru valoda"@lv, "фарски"@mk, "Faroeż"@mt, "Faeröers"@nl, "færøysk"@no, "farerski"@pl, "feroês"@pt, "feroeză"@ro, "фарерский"@ru, "farerski"@sh, "faerčina"@sk, "ferščina"@sl, "фарски"@sr, "färöiska"@sv, "faroe"@tr, "фарерська мова"@uk .
<http://publications.europa.eu/resource/authority/language/FAP> ccmm_props:ISO_639_3 "fap"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fap"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Palor"@fap; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "palor"@fap .

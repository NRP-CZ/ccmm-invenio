<https://nma.eosc.cz/vocabularies/languages/smo> ccmm_props:ISO_639_1 "sm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "smo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "smo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "smo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Gagana fa'a Sāmoa"@sm; skos:definition "Samoan is a Malayo-Polynesian language. It is one of the official languages of Samoa and American Samoa."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SMO>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "самоански"@bg, "samojština"@cs, "samoansk"@da, "Samoanisch"@de, "σαμοϊκή"@el, "Samoan"@en, "samoano"@es, "samoa keel"@et, "samoa"@fi, "samoan"@fr, "Samóis"@ga, "samoanski"@hr, "szamoai"@hu, "samoano"@it, "samojiečių"@lt, "samoāņu valoda"@lv, "Samoan"@mt, "Samoaans"@nl, "samoański"@pl, "samoano"@pt, "samoană"@ro, "samojčina"@sk, "samoanščina"@sl, "samoanska"@sv, "самоанська мова"@uk .

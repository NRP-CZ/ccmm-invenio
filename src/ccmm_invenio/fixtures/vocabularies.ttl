<http://publications.europa.eu/resource/authority/language/LBS> ccmm_props:ISO_639_3 "lbs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lbs"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Libyan Sign Language"@lbs; skos:definition "Libyan Sign Language is a sign language used in Libya. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "либийски жестомимичен език"@bg, "libyjský znakový jazyk"@cs, "libysk tegnsprog"@da, "Libysche Gebärdensprache"@de, "λιβυκή νοηματική γλώσσα"@el, "Libyan Sign Language"@en, "lengua de signos libia"@es, "liibüa viipekeel"@et, "libyalainen viittomakieli"@fi, "langue des signes libyenne"@fr, "Teanga Chomharthaíochta na Libia"@ga, "libijski znakovni jezik"@hr, "líbiai jelnyelv"@hu, "lingua dei segni libica"@it, "libių gestų kalba"@lt, "libāņu zīmju valoda"@lv, "Lingwa tas-Sinjali Libjana"@mt, "Libische Gebarentaal"@nl, "libijski język migowy"@pl, "língua gestual líbia"@pt, "limbajul prin semne din Libia"@ro, "líbyjský posunkový jazyk"@sk, "libijski znakovni jezik"@sl, "libyskt teckenspråk"@sv .

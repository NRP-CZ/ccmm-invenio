<https://nma.eosc.cz/vocabularies/languages/ltz> ccmm_props:ISO_639_1 "lb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "ltz"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "ltz"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "ltz"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lb"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "luxemburgsk"@da, "Lëtzebuergesch"@lb; skos:definition "Luxembourgish is a Germanic language which belongs to the West Moselle Franconian subgroup of German dialects. Luxembourgish is spoken mainly in the Grand Duchy of Luxembourg."@en, "Le luxembourgeois est une langue germanique qui appartient au sous-groupe du moyen francique de dialectes allemands. Le luxembourgeois est parlé principalement dans le Grand-Duché de Luxembourg."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/LTZ>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "люксембургски"@bg, "lucemburština"@cs, "luxembourgsk"@da, "Luxemburgisch"@de, "λουξεμβουργιανά"@el, "Luxembourgish"@en, "luxemburgués"@es, "letseburgi keel"@et, "luxemburg"@fi, "luxembourgeois"@fr, "Lucsambuirgis"@ga, "luksemburški"@hr, "luksemburščina"@hsb, "luxemburgi"@hu, "lúxemborgíska"@is, "lussemburghese"@it, "liuksemburgiečių kalba"@lt, "luksemburgiešu valoda"@lv, "луксембуршки"@mk, "Lussemburgiż"@mt, "Luxemburgs"@nl, "luxemburgsk"@no, "luksemburski"@pl, "luxemburguês"@pt, "luxemburgheză"@ro, "люксембургский"@ru, "luksemburški"@sh, "luxemburčina"@sk, "luksemburščina"@sl, "луксембуршки"@sr, "luxemburgska"@sv, "lüksemburgca"@tr, "люксембурзька мова"@uk .

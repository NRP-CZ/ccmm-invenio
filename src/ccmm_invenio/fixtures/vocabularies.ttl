<https://nma.eosc.cz/vocabularies/languages/tzm> ccmm_props:ISO_639_3 "tzm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "tzm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Atlasic"@en, "Tamaziɣt"@tzm, "أمازيغية الأطلس الأوسط"@tzm; skos:definition "Central Atlas Tamazight is a Berber language of the Afroasiatic language family spoken in the Atlas Mountains of Central Morocco as well as by smaller emigrant communities in France and elsewhere. It is one of the most-spoken Berber languages. It is officially written in the Tifinagh script for instruction in Moroccan schools while descriptive linguistic literature commonly uses the Latin alphabet, and the Arabic alphabet has also been used."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/TZM>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "централноатласки тамазигт"@bg, "středoatlaský tamazight"@cs, "tamazight (Atlasbjergene)"@da, "Zentralatlas-Tamazight"@de, "ταμαζίγτ (Tamazight) του Κεντρικού άτλαντα"@el, "Central Atlas Tamazight"@en, "tamazight del Atlas Central"@es, "Kesk-Atlase tamasikti keel"@et, "keskiatlaksentamazight"@fi, "tamazight de l’Atlas central"@fr, "Tamaisis Atlais Láir"@ga, "tamazightski (Srednji Atlas)"@hr, "közép-marokkói berber"@hu, "Atlante centrale tamazight"@it, "Vidurio Atlaso tamazigtų"@lt, "Centrālatlasa tamazigtu"@lv, "Tamazight tal-Atlas Ċentrali"@mt, "Centraal-Atlas-Tamazight"@nl, "tamazight (Atlas Środkowy)"@pl, "amazigue do Atlas Central"@pt, "Tamazigtă din Atlasul Central"@ro, "tamašek (Stredný Atlas)"@sk, "tamašek (Srednji Atlas)"@sl, "centralmarockansk tamazight"@sv, "мова центрального атласу тамазігт"@uk .

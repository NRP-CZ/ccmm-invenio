<http://publications.europa.eu/resource/authority/language/SMH> ccmm_props:ISO_639_3 "smh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "smh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Samei"@smh; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "samei"@smh .
<http://publications.europa.eu/resource/authority/language/SMI> ccmm_props:ISO_639_2B "smi"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "smi"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:XML_LNG "smi"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Sámegielat"@smi; skos:definition "The Sami languages, also rendered in English as Sámi and Saami, are a group of Uralic languages spoken by the indigenous Sami people of Northern Europe (in parts of northern Finland, Norway, Sweden, and the far northwest of Russia). There are, depending on the nature and terms of division, approximately nine living Sami languages, and much more if extinct varieties are included. The exonym Lappish is now often considered pejorative. The Sami languages form a dialect continuum in which the neighbouring languages are often intelligible to a fair degree, but two more widely separated varieties are not. There are, however, some sharp language boundaries, in particular between Northern Sami, Inari Sami and Skolt Sami whose traditional speech areas meet in Finland."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Sami languages"@en, "Saami keeled"@et, "Saamelaiskielet"@fi, "samisk"@no, "Саа́мские языки́"@ru, "samiska"@sv .
<http://publications.europa.eu/resource/authority/language/SMJ> ccmm_props:ISO_639_2B "smj"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "smj"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "smj"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "smj"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "julevsámegiella"@smj; skos:definition "Lule Sami (julevsámegiella) is one of the Sami languages. It was originally only spoken around the Lule River, in Sweden. During the 18th century some Sami migrated to Nordland in Norway, and their descendants still live in Norway, and speak Lule Sami. In Norway, in Hamarøy Municipality, Lule Sami is one of the official languages. Like Baltic-Finnic languages, Sami languages are a branch of the Uralic language family."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Lule Sami"@en, "lule saami keel"@et, "luulajansaame"@fi, "lulesamisk"@no, "луле-саамский язык"@ru, "julevsámegiella"@se, "lulesamiska"@sv .

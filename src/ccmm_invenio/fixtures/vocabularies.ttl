<https://nma.eosc.cz/vocabularies/languages/msd> ccmm_props:ISO_639_3 "msd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "msd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Yucatec Maya Sign Language"@msd; skos:definition "Yucatec Maya Sign Language is a sign language used in the Yucatan region, in Mexico, by Maya communities. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/MSD>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език Юкатек Майа"@bg, "yucatánský mayský znakový jazyk"@cs, "Yucatec maya tegnsprog"@da, "Maya-Gebärdensprache"@de, "νοηματική γλώσσα Γιουκατέκ Μάγια"@el, "Yucatec Maya Sign Language"@en, "lengua de signos maya de yucateca"@es, "maaja viipekeel"@et, "jukatekmayalainen viittomakieli"@fi, "langue des signes maya yucatèque"@fr, "Teanga Chomharthaíochta Yucatec Maya"@ga, "znakovni jezik naroda Yucatec"@hr, "jukatán maja jelnyelv"@hu, "lingua dei segni maya yucateca"@it, "jukatekų majų gestų kalba"@lt, "Jukatanas maiju zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Yucatec Maya"@mt, "Yucatec Maya Gebarentaal"@nl, "jukatańsk majańskii język migowy"@pl, "língua gestual iucatega"@pt, "limbajul prin semne al mayașilor Yucatec"@ro, "posunkový jazyk Yucatec Maya"@sk, "znakovni jezik Yucatec Maya"@sl, "yukatekiskt maya-teckenspråk"@sv .

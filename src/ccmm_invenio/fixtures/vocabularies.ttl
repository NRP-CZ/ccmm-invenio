<http://publications.europa.eu/resource/authority/language/SLF> ccmm_props:ISO_639_3 "slf"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "slf"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Swiss-Italian Sign Language"@slf; skos:definition "Swiss-Italian Sign Language is a sign language used in Switzerland by the Italian-speaking community. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "швейцарски италиански жестомимичен език"@bg, "švýcarsko-italský znakový jazyk"@cs, "schweizisk-italiensk tegnsprog"@da, "Tessiner Gebärdensprache"@de, "ελβετοϊταλική νοηματική γλώσσα"@el, "Swiss-Italian Sign Language"@en, "lengua de signos italo-suiza"@es, "šveitsi-itaalia viipekeel"@et, "sveitsinitalialainen viittomakieli"@fi, "langue des signes suisse italienne"@fr, "Teanga Chomharthaíochta Iodáilis na hEilvéise"@ga, "švicarsko-talijanski znakovni jezik"@hr, "svájci olasz jelnyelv"@hu, "lingua dei segni svizzero-italiana"@it, "Šveicarijos italų gestų kalba"@lt, "Šveices itāļu zīmju valoda"@lv, "Lingwa tas-Sinjali Żvizzera - Taljana"@mt, "Zwitsers-Italiaanse Gebarentaal"@nl, "szwajcarsko-włoski język migowy"@pl, "língua gestual italiana da Suíça"@pt, "limbajul prin semne din Elveția italofonă"@ro, "švajčiarsko-taliansky posunkový jazyk"@sk, "znakovni jezik italijansko govoreče skupnosti v Švici"@sl, "schweizeritalienskt teckenspråk"@sv .

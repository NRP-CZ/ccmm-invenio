<http://publications.europa.eu/resource/authority/language/ADS> ccmm_props:ISO_639_3 "ads"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ads"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Adamorobe Sign Language"@ads, "Adamorobe znakovni jezik"@hr; skos:definition "Adamorobe Sign Language is a sign language used in Adamorobe village in Ghana. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Адаморобе"@bg, "adamorobský znakový jazyk"@cs, "adamorobe tegnsprog"@da, "Adamorobe-Gebärdensprache"@de, "νοηματική γλώσσα Ανταμορόμπε"@el, "Adamorobe Sign Language"@en, "lengua de signos de Adamorobe"@es, "adamorobe viipekeel"@et, "adamorobelainen viittomakieli"@fi, "langue des signes d’Adamorobe"@fr, "Teanga Chomharthaíochta Adamorobe"@ga, "adamorobski znakovni jezik"@hr, "adamorobei jelnyelv"@hu, "adomoróbe-táknmál"@is, "lingua dei segni di Adamorobe"@it, "Adamorobo gestų kalba"@lt, "Adamorobes zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Adamorobe"@mt, "Gebarentaal van Adamorobe"@nl, "język migowy Adamarobe"@pl, "língua gestual de Adamorobe"@pt, "limbajul prin semne din Adamorobe"@ro, "posunkový jazyk dediny Adamorobe"@sk, "adamorobe znakovni jezik"@sl, "Adamorobe-teckenspråk"@sv .
<http://publications.europa.eu/resource/authority/language/ADT> ccmm_props:ISO_639_3 "adt"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "adt"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "yura"@adt; skos:definition "Adnyamathanha is a Pama-Nyungan language spoken in the northern Flinders Ranges in South Australia. The ethnonym Adnyamathanha was an alternative name for the Wailpi but the contemporary grouping often includes the Guyani, Jadliaura, Pilatapa, and sometimes the Barngarla peoples. The origin of the name is in the words ’adnya’ (’rock’) and ’matha’ (’group’). Adnyamathanha is classified within the Arandic-Thura-Yura primary branch of the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Adnyamathanha"@en .

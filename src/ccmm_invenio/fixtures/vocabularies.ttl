<http://publications.europa.eu/resource/authority/language/SCZ> ccmm_props:ISO_639_3 "scz"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "scz"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Shetland"@en, "Shetlandic"@en, "Shaetlan"@scz; skos:definition "Shaetlan, also known as Shetland or Shetlandic, is a mixed language spoken in Shetland, an archipelago to the north of mainland Scotland. It emerged through the prolonged and stable bilingualism of Norn (the language of the previous settlers) and Lowlands Scots (mainly the varieties from Fife and Lothian) brought to Shetland from the early 15th century onward. It has been recognised as a highly distinct variety for centuries, and is now officially acknowledged as a language by ISO. It is classified within the North Germanic group of the Scandinavian branch of Indo-European languages."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "шетландски"@bg, "shetlandština"@cs, "shetlandsk"@da, "Shaetlan"@de, "σετλανικά"@el, "Shaetlan"@en, "setelandés"@es, "šetlandi keel"@et, "shetlanti"@fi, "shetland"@fr, "Sealtainnis"@ga, "šetlandski"@hr, "shetlandi"@hu, "shetlandico"@it, "šetlandiečių"@lt, "šetlendiešu valoda"@lv, "Shaetlan"@mt, "Shaetlan"@nl, "szetlandzki"@pl, "shetlandês"@pt, "shetlandeză"@ro, "shetlandčina"@sk, "šetlandščina"@sl, "shetländska"@sv .
<http://publications.europa.eu/resource/authority/language/SDA> ccmm_props:ISO_639_3 "sda"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sda"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Toraja-Sa'dan"@sda; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "toraja-Sa'dan"@sda .
<http://publications.europa.eu/resource/authority/language/SDB> ccmm_props:ISO_639_3 "sdb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sdb"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Şebekî"@sdb, "شەبەکی"@sdb; skos:definition "Shabak is an Indo-Iranian language and belongs to the subgroup Zaza-Gorani of the Northwestern Iranian languages. The Shabaki language is spoken by the Shabak people in the Mosul region of northern Iraq. It is a subdialect of the Kurdish dialect Gorani alongside Hewrami, Sarli, and Bajalan. It also been influenced by Arabic, Turkish and Persian language."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "шабак"@bg, "šabačtina"@cs, "shabak"@da, "Schabaki"@de, "Σαμπάκι"@el, "Shabak"@en, "Shabak"@es, "shabak"@fi, "shabak"@fr, "Seabaicis"@ga, "šabaki"@hr, "sabak"@hu, "Shabak"@it, "šabakų"@lt, "šabaku"@lv, "Shabak"@mt, "Shabak"@nl, "szabak"@pl, "xabaque"@pt, "șabak"@ro, "šabakí"@sk, "šabaščina"@sl, "shabaki"@sv .
<http://publications.europa.eu/resource/authority/language/SDC> ccmm_props:ISO_639_3 "sdc"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sdc"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Sassarese Sardinian"@sdc; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "sassarese Sardinian"@sdc .

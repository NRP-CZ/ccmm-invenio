<https://nma.eosc.cz/vocabularies/languages/inl> ccmm_props:ISO_639_3 "inl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "inl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Indonesian Sign Language"@inl; skos:definition "Indonesian Sign Language is a sign language used in Indonesia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/INL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "индонезийски жестомимичен език"@bg, "indonéský znakový jazyk"@cs, "indonesisk tegnsprog"@da, "Indonesische Gebärdensprache"@de, "ινδονησιακή νοηματική γλώσσα"@el, "Indonesian Sign Language"@en, "lengua de signos indonesia"@es, "indoneesia viipekeel"@et, "indonesialainen viittomakieli"@fi, "langue des signes indonésienne"@fr, "Teanga Chomharthaíochta na hIndinéise"@ga, "indonezijski znakovni jezik"@hr, "indonéz jelnyelv"@hu, "lingua dei segni indonesiana"@it, "indoneziečių gestų kalba"@lt, "indonēziešu zīmju valoda"@lv, "Lingwa tas-Sinjali Indoneżjana"@mt, "Indonesische Gebarentaal"@nl, "indonezyjski język migowy"@pl, "língua gestual indonésia"@pt, "limbajul prin semne din Indonezia"@ro, "индонезийский жестовый язык"@ru, "indonézsky posunkový jazyk"@sk, "indonezijski znakovni jezik"@sl, "indonesiskt teckenspråk"@sv .

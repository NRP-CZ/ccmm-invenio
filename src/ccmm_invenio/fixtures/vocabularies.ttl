<https://nma.eosc.cz/vocabularies/languages/ces> ccmm_props:ISO_639_1 "cs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "cze"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "ces"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "ces"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cs"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:definition "Czech is a member of the Western subgroup of the Slavic languages, spoken mainly in the Czech Republic.Czech is a fusional language and one of the most highly inflected tongues in the world."@en, "Le tchèque est une langue du sous-groupe occidental des langues slaves, parlée principalement en République tchèque.Le tchèque est une des langues les plus flexionnelles dans le monde."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CES>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "чешки"@bg, "čeština"@cs, "tjekkisk"@da, "Tschechisch"@de, "τσεχικά"@el, "Czech"@en, "checo"@es, "tšehhi keel"@et, "tšekki"@fi, "tchèque"@fr, "Seicis"@ga, "češki"@hr, "čěšćina"@hsb, "cseh"@hu, "tékkneska"@is, "ceco"@it, "čekų kalba"@lt, "čehu valoda"@lv, "чешки"@mk, "Ċek"@mt, "Tsjechisch"@nl, "tsjekkisk"@no, "czeski"@pl, "checo"@pt, "cehă"@ro, "чешский"@ru, "češki"@sh, "čeština"@sk, "češčina"@sl, "чешки"@sr, "tjeckiska"@sv, "çekçe"@tr, "чеська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/cet> ccmm_props:ISO_639_3 "cet"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cet"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Centúúm"@cet; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CET>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "centúúm"@cet .
<https://nma.eosc.cz/vocabularies/languages/cey> ccmm_props:ISO_639_3 "cey"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cey"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Ekai"@cey, "Lawktu"@en, "Läoktü"@en; skos:definition "Ekai Chin, also known as Läoktü Chin, is a Tibeto-Burman language falling under the Kuki-Chin sub-branch of the Sino-Tibetan language family. The Ekai are the largest group along Dalet Stream in northern Ann Township, Rakhine State, Myanmar. Compared to Sinitic languages, Kuki-Chin languages are tonal but less so, and they are less isolating and more morphologically structured. They also tend to display areal features with neighbouring Austro-Asiatic languages."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CEY>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Ekai Chin"@en .

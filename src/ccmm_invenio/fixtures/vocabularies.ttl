<https://nma.eosc.cz/vocabularies/languages/hrv> ccmm_props:ISO_639_1 "hr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "hrv"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "hrv"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "hrv"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:definition "Croatian is the standardised variety of the Serbo-Croatian language used by Croats, principally in Croatia and in Bosnia and Herzegovina. Standard Croatian is based on the Shtokavian dialect of Serbo-Croatian.Croatian uses exclusively the Latin alphabet."@en, "Le croate est la variante standard de la langue serbo-croate utilisée par les Croates, principalement en Croatie et en Bosnie-Herzégovine. Sa norme est basée sur le dialecte chtokavien du serbo-croate.Le croate utilise exclusivement l’alphabet latin."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/HRV>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "хърватски"@bg, "chorvatština"@cs, "kroatisk"@da, "Kroatisch"@de, "κροατικά"@el, "Croatian"@en, "croata"@es, "horvaadi keel"@et, "kroatia"@fi, "croate"@fr, "Cróitis"@ga, "hrvatski"@hr, "chorwatšćina"@hsb, "horvát"@hu, "króatíska"@is, "croato"@it, "kroatų kalba"@lt, "horvātu valoda"@lv, "хрватски"@mk, "Kroat"@mt, "Kroatisch"@nl, "kroatisk"@no, "chorwacki"@pl, "croata"@pt, "croată"@ro, "хорватский"@ru, "hrvatski"@sh, "chorvátčina"@sk, "hrvaščina"@sl, "хрватски"@sr, "kroatiska"@sv, "hırvatça"@tr, "хорватська мова"@uk .

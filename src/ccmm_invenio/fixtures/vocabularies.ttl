<http://publications.europa.eu/resource/authority/language/BVL> ccmm_props:ISO_639_3 "bvl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "bvl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Bolivian Sign Language"@bvl; skos:definition "Bolivian Sign Language is a sign language used in Bolivia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "боливийски жестомимичен език"@bg, "bolivijský znakový jazyk"@cs, "boliviansk tegnsprog"@da, "Bolivianische Gebärdensprache"@de, "βολιβιανή νοηματική γλώσσα"@el, "Bolivian Sign Language"@en, "lengua de signos boliviana"@es, "boliivia viipekeel"@et, "bolivialainen viittomakieli"@fi, "langue des signes bolivienne"@fr, "Teanga Chomharthaíochta na Bolaive"@ga, "bolivijski znakovni jezik"@hr, "bolíviai jelnyelv"@hu, "lingua dei segni boliviana"@it, "bolivų gestų kalba"@lt, "bolīviešu zīmju valoda"@lv, "Lingwa tas-Sinjali Bolivjana"@mt, "Boliviaanse Gebarentaal"@nl, "boliviansk tegnspråk"@no, "boliwijski język migowy"@pl, "língua gestual boliviana"@pt, "limbajul prin semne din Bolivia"@ro, "bolívijský posunkový jazyk"@sk, "bolivijski znakovni jezik"@sl, "bolivianskt teckenspråk"@sv .

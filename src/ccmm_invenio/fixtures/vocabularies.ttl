<https://nma.eosc.cz/vocabularies/languages/roh> ccmm_props:ISO_639_1 "rm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "roh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "roh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "roh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "rétoromán"@hu, "rumantsch"@rm; skos:definition "Romansh is a group of Rhaeto-Romance dialects spoken predominantly in the south-eastern Swiss canton of Grisons.Romansh has a strong dialectal fragmentation. Almost every village has its own vernacular, and five different regional dialects own standardised written form."@en, "Le romanche fait partie du groupe de dialectes rhéto-romans parlés principalement dans le canton des Grisons (sud-est de la Suisse).Le romanche a une forte fragmentation dialectale. Presque chaque village a sa propre langue vernaculaire, et on dénombre cinq dialectes régionaux différents ayant chacun sa forme écrite standardisée."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ROH>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "романшки"@bg, "románština"@cs, "romantsch"@da, "Rumantsch"@de, "ρομανσικά"@el, "Romansh"@en, "romanche"@es, "romaani keel"@et, "retoromaani"@fi, "romanche"@fr, "Rómainis"@ga, "retoromanski"@hr, "romans"@hu, "romancio"@it, "romanų kalba"@lt, "romāņu valoda"@lv, "романш"@mk, "Rumanz"@mt, "Romaans"@nl, "retoromansk"@no, "romański"@pl, "romanche"@pt, "retoromană"@ro, "романшский"@ru, "retoromanski"@sh, "románčina"@sk, "romanščina"@sl, "романш"@sr, "romanska"@sv, "romanşça"@tr, "ретороманська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/rol> ccmm_props:ISO_639_3 "rol"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rol"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Romblomanon"@rol; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ROL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "romblomanon"@rol .
<https://nma.eosc.cz/vocabularies/languages/rom> ccmm_props:ISO_639_2B "rom"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "rom"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "rom"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rom"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Gipsy"@en, "Romany"@en, "roma"@hu, "romu valoda"@lv, "romani ćhib"@rom; skos:definition "Romani (also Romany or Gypsy) is a Balkanised neo-Indo-European language belonging to the Indo-Aryan branch. It is spoken principally in Europe by Romani people.The alphabets used in the different varieties of the Romany generally correspond to those countries where the corresponding Roma communities live. The alphabets of use are the Latin, the Cyrillic, the Arabic and the Greek alphabets."@en, "Le romani est une langue néo-indo-européenne balkanisée appartenant à la branche indo-aryenne. Il est parlé principalement en Europe par les Roms.Les alphabets utilisés dans les différentes variantes du romani correspondent généralement à ceux des pays où vivent les communautés roms concernées. Les alphabets utilisés sont le latin, le cyrillique, l’arabe et le grec."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ROM>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "ромски"@bg, "romština"@cs, "romani"@da, "Romani"@de, "ρομανί"@el, "Romani"@en, "romaní"@es, "roma keel"@et, "romani"@fi, "romani"@fr, "Romani"@ga, "romski"@hr, "romani"@hu, "romani"@is, "romaní"@it, "romų kalba"@lt, "čigānu valoda"@lv, "ромски"@mk, "Zingaru"@mt, "Romani"@nl, "romani"@no, "romski"@pl, "romani"@pt, "romani"@ro, "цыга́нский"@ru, "romski"@sh, "rómčina"@sk, "romščina"@sl, "ромски"@sr, "romani"@sv, "romani"@tr, "циганська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/ron> ccmm_props:ISO_639_1 "ro"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "rum"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "ron"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "ron"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ro"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:definition "Romanian is a Romance language spoken principally in Romania and Moldova. Much of the total Romanian vocabulary is derived from Latin.Romanian has four varieties: Daco-Romanian, Istro-Romanian, Aromanian and Megleno-Romanian."@en, "Le roumain est une langue romane parlée principalement en Roumanie et en Moldavie. Une grande partie du vocabulaire roumain total est dérivée du latin.Le roumain possède quatre dialectes: le daco-roumain, l’istro-roumain, l’aroumain et le mégléno-roumain."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/RON>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "румънски"@bg, "rumunština"@cs, "rumænsk"@da, "Rumänisch"@de, "ρουμανικά"@el, "Romanian"@en, "rumano"@es, "rumeenia keel"@et, "romania"@fi, "roumain"@fr, "Rómáinis"@ga, "rumunjski"@hr, "rumunšćina"@hsb, "román"@hu, "rúmenska"@is, "rumeno"@it, "rumunų kalba"@lt, "rumāņu valoda"@lv, "романски"@mk, "Rumen"@mt, "Roemeens"@nl, "rumensk"@no, "rumuński"@pl, "romeno"@pt, "română"@ro, "румынский"@ru, "rumunski"@sh, "rumunčina"@sk, "romunščina"@sl, "румунски"@sr, "rumänska"@sv, "rumence"@tr, "румунська мова"@uk .

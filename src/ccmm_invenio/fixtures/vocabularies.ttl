<http://publications.europa.eu/resource/authority/language/MEL> ccmm_props:ISO_639_3 "mel"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mel"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Central Melanau"@mel; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "central Melanau"@mel .
<http://publications.europa.eu/resource/authority/language/MEM> ccmm_props:ISO_639_3 "mem"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mem"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Mangarla"@en, "Mangala"@mem; skos:definition "Mangala, also know as Mangarla, is a critically endangered Australian Aboriginal language spoken by the Mangala people in the north-western area of the Great Sandy Desert, inland from the coast. Together with its closest relative, Karajarri (gbd), it belongs to the Marrngu subgroup of the Pama-Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Mangala"@en .
<http://publications.europa.eu/resource/authority/language/MEN> ccmm_props:ISO_639_2B "men"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "men"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "men"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "men"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Mende (Sierra Leone)"@men; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "mende (Sierra Leone)"@men .

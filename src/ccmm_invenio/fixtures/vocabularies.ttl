<https://nma.eosc.cz/vocabularies/languages/bam> ccmm_props:ISO_639_1 "bm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "bam"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "bam"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "bam"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "bm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "bamana"@bm, "bamanankan"@bm, "ߡߊߣߊ߲"@bm, "Bamana"@en, "bamana"@fi; skos:definition "Bambara, also known as Bamana, is a lingua franca and national language of Mali spoken natively by 4.2 million Bambara people and about 10 million second-language users. Bambara is a variety of a group of closely related languages called Manding, whose native speakers trace their cultural history to the medieval Mali Empire. It has a subject–object–verb clause structure and two lexical tones. Manding languages are a sub-branch of Mande languages that are part of the hypothetical Niger-Congo language family. However, as the Mande languages lack the noun-class morphology, linguists increasingly treat Mande and Atlantic–Congo as independent language families and reject the Niger-Congo hypothesis."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/BAM>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "бамана"@bg, "bambara"@bm, "bambarština"@cs, "bambara"@da, "Bambara"@de, "Μπαμπάρα"@el, "Bambara"@en, "bambara"@es, "bambara keel"@et, "bambara"@fi, "bambara"@fr, "Bambairis"@ga, "bambara"@hr, "bambara"@hu, "bambara"@it, "bambarų kalba"@lt, "bambaru valoda"@lv, "Bambara"@mt, "Bambara"@nl, "bambara"@pl, "bambara"@pt, "bambara"@ro, "bambarčina"@sk, "bambarščina"@sl, "bambara"@sv .

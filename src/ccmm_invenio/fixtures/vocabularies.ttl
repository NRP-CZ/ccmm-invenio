<http://publications.europa.eu/resource/authority/language/EST> ccmm_props:ISO_639_1 "et"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "est"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "est"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "est"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "et"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Estlands"@nl, "Ests"@nl; skos:definition "Estonian belongs (with Finnish) to the Baltic-Finnic subgroup of the Finno-Ugrian languages from the Uralic family. It is the official language of Estonia.Estonian represents a transitional form from an agglutinating language to a fusional language."@en, "L’estonien appartient, avec le finnois, au sous-groupe balto-finnois des langues finno-ougriennes de la famille ouralienne. Il est la langue officielle de l’Estonie.L’estonien représente une forme de transition d’une langue agglutinante à une langue fusionnelle."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "естонски"@bg, "estonština"@cs, "estisk"@da, "Estnisch"@de, "εσθονικά"@el, "Estonian"@en, "estonio"@es, "eesti keel"@et, "viro"@fi, "estonien"@fr, "Eastóinis"@ga, "estonski"@hr, "estišćina"@hsb, "észt"@hu, "eistneska"@is, "estone"@it, "estų kalba"@lt, "igauņu valoda"@lv, "естонски"@mk, "Eston"@mt, "Estisch"@nl, "estisk"@no, "estoński"@pl, "estónio"@pt, "estonă"@ro, "эстонский"@ru, "estonski"@sh, "estónčina"@sk, "estonščina"@sl, "естонски"@sr, "estniska"@sv, "estonca"@tr, "естонська мова"@uk .

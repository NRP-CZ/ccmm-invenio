<http://publications.europa.eu/resource/authority/language/IND> ccmm_props:ISO_639_1 "id"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "ind"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "ind"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "ind"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "id"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Bahasa Indonesia"@id; skos:definition "Indonesian is the official language of Indonesia. It is a standardised register of Malay, an Austronesian language which has been used as a lingua franca in the Indonesian archipelago for centuries. Most Indonesians also speak one of more than 700 indigenous languages. Most formal education, and nearly all national media and other forms of communication, are conducted in Indonesian. The Indonesian name for the language is Bahasa Indonesia (literally ‘the language of Indonesia’)."@en, "L’indonésien (bahasa Indonesia, littéralement «langue de l’Indonésie») est la langue officielle de la République d’Indonésie. C’est aussi l’une des langues d’usage dans la République démocratique du Timor-Oriental. L’indonésien est l’une des formes du malais (bahasa Melayu). Pour une majorité d’Indonésiens, ce n’est pas leur langue maternelle. Ils ne l’apprennent à l’école que vers l’âge de 5 ans."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "индонезийски"@bg, "indonéština"@cs, "indonesisk"@da, "Indonesisch"@de, "ινδονησιακά"@el, "Indonesian"@en, "indonesio"@es, "indoneesia keel"@et, "indonesia"@fi, "indonésien"@fr, "Indonesis"@ga, "indonezijski"@hr, "indoneska"@hsb, "indonéz"@hu, "indónesíska"@is, "indonesiano"@it, "indoneziečių kalba"@lt, "indonēziešu valoda"@lv, "индонезийски"@mk, "Indoneż"@mt, "Indonesisch"@nl, "indonesisk"@no, "indonezyjski"@pl, "indonésia"@pt, "indoneziană"@ro, "индонезийский"@ru, "indonežanski"@sh, "indonézština"@sk, "indonezijščina"@sl, "индонежански"@sr, "indonesiska"@sv, "endonezce"@tr, "індонезійська мова"@uk .

<http://publications.europa.eu/resource/authority/language/HUN> ccmm_props:ISO_639_1 "hu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "hun"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "hun"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "hun"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:definition "Hungarian (Magyar), like Finnish and Estonian, belongs to the Finno-Ugric branch of the Uralic language family. It is the official language of Hungary and is also spoken by communities of Hungarian people in neighbouring countries.In Hungarian, surnames precede Christian names."@en, "Le hongrois (magyar), comme l’estonien et le finnois, appartient à la branche finno-ougrienne de la famille des langues ouraliennes. Il est la langue officielle de la Hongrie et est également parlé par les communautés hongroises dans les pays voisins.En hongrois, les noms de famille précèdent les prénoms."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "унгарски"@bg, "maďarština"@cs, "ungarsk"@da, "Ungarisch"@de, "ουγγρικά"@el, "Hungarian"@en, "húngaro"@es, "ungari keel"@et, "unkari"@fi, "hongrois"@fr, "Ungáiris"@ga, "mađarski"@hr, "madźaršćina"@hsb, "magyar"@hu, "ungverska"@is, "ungherese"@it, "vengrų kalba"@lt, "ungāru valoda"@lv, "унгарски"@mk, "Ungeriż"@mt, "Hongaars"@nl, "ungarsk"@no, "węgierski"@pl, "húngaro"@pt, "maghiară"@ro, "венгерский"@ru, "mađarski"@sh, "maďarčina"@sk, "madžarščina"@sl, "мађарски"@sr, "ungerska"@sv, "macarca"@tr, "угорська мова"@uk .

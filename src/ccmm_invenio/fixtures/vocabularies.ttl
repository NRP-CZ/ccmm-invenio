<https://nma.eosc.cz/vocabularies/languages/gla> ccmm_props:ISO_639_1 "gd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "gla"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "gla"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "gla"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "gd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "écossais"@fr, "Gàidhlig"@gd; skos:definition "Scottish Gaelic, sometimes also called Gaelic, is a Celtic language native to Scotland.Gaelic is an official language in Scotland and it is a recognised minority language of the United Kingdom, protected under the European Charter for Regional or Minority Languages."@en, "Le gaélique écossais ou écossais est une langue celtique parlée en Écosse.Le gaélique écossais est reconnu par le Royaume-Uni comme langue régionale de l’Écosse, selon la charte européenne des langues régionales ou minoritaires."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/GLA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "шотландски"@bg, "skotská gaelština"@cs, "skotsk-gælisk"@da, "Schottisch-Gälisch"@de, "σκωτικά γαελικά"@el, "Scottish Gaelic"@en, "gaélico escocés"@es, "gaeli keel"@et, "gaeli"@fi, "gaélique écossais"@fr, "Gàidhlig"@ga, "škotski gaelski"@hr, "škotska gelščina"@hsb, "skót"@hu, "gelíska"@is, "gaelico scozzese"@it, "škotų gėlų kalba"@lt, "skotu gēlu valoda"@lv, "шкотски гаелски"@mk, "Gejlik Skoċċiż"@mt, "Schots-Gaelisch"@nl, "skotsk gælisk"@no, "gaelicki szkocki"@pl, "gaélico escocês"@pt, "scoţiană"@ro, "шотландский гэльский"@ru, "škotska galski"@sh, "škótska gaelčina"@sk, "škotska gelščina"@sl, "шкотски гелски"@sr, "skotsk gaeliska"@sv, "ıskoçça"@tr, "шотландська (гельська) мова"@uk .

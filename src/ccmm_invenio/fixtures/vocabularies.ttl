<http://publications.europa.eu/resource/authority/language/CSD> ccmm_props:ISO_639_3 "csd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "csd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Chiangmai Sign Language"@csd; skos:definition "Chiangmai Sign Language is a sign language used in Chiang Mai city in Thailand. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "чиангмайски жестомимичен език"@bg, "chiangmaiský znakový jazyk"@cs, "Chiangmai-tegnsprog"@da, "Chiangmai-Gebärdensprache"@de, "νοηματική γλώσσα του Chiangmai"@el, "Chiangmai Sign Language"@en, "lengua de signos de Chiangmai"@es, "chiangmai viipekeel"@et, "chiangmailainen viittomakieli"@fi, "langue des signes de Chiang Mai"@fr, "Teanga Chomharthaíochta Chiangmai"@ga, "čiangmajski znakovni jezik"@hr, "csiangmaji jelnyelv"@hu, "lingua dei segni di Chiang Mai"@it, "Čiang Majaus gestų kalba"@lt, "čhīanmai zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Chiangmai"@mt, "Chiangmai-gebarentaal"@nl, "język migowy Ching Mai"@pl, "língua gestual de Chiang Mai"@pt, "limbajul prin semne Chiangmai"@ro, "chiangmaiský posunkový jazyk"@sk, "chiangmai znakovni jezik"@sl, "Chiang Mai-teckenspråk"@sv .
<http://publications.europa.eu/resource/authority/language/CSE> ccmm_props:ISO_639_3 "cse"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cse"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Czech Sign Language"@cse; skos:definition "Czech Sign Language is a sign language used in the Czech Republic. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "чешки жестомимичен език"@bg, "český znakový jazyk"@cs, "tjekkisk tegnsprog"@da, "Tschechische Gebärdensprache"@de, "τσεχική νοηματική γλώσσα"@el, "Czech Sign Language"@en, "lengua de signos checa"@es, "tšehhi viipekeel"@et, "tšekkiläinen viittomakieli"@fi, "langue des signes tchèque"@fr, "Teanga Chomharthaíochta na Seice"@ga, "češki znakovni jezik"@hr, "cseh jelnyelv"@hu, "lingua dei segni ceca"@it, "čekų gestų kalba"@lt, "čehu zīmju valoda"@lv, "Lingwa tas-Sinjali Ċeka"@mt, "Tsjechische Gebarentaal"@nl, "czeski język migowy"@pl, "língua gestual checa"@pt, "limbajul prin semne din Cehia"@ro, "český posunkový jazyk"@sk, "češki znakovni jezik"@sl, "tjeckiskt teckenspråk"@sv .

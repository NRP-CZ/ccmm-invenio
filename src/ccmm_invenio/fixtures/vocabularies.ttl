<https://nma.eosc.cz/vocabularies/languages/cyb> ccmm_props:ISO_639_3 "cyb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cyb"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Cayuvava"@cyb, "Cayuwaba"@en; skos:definition "Cayubaba is an indigenous language isolate. It is one of the official languages of Bolivia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CYB>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "каювава"@bg, "kajuvavština"@cs, "cayubaba"@da, "Cayubaba"@de, "καγιουμπάμπα"@el, "Cayubaba"@en, "cayubaba"@es, "cayubaba keel"@et, "cayubaba"@fi, "cayubaba"@fr, "Cadhúbaibis"@ga, "cayubaba"@hr, "cayubaba"@hu, "cayubaba"@it, "kajubabų"@lt, "cayubaba"@lv, "Cayubaba"@mt, "Cayubaba"@nl, "cayubaba"@pl, "caiubaba"@pt, "cayubaba"@ro, "kajuvavčina"@sk, "cayubaba"@sl, "cayubaba"@sv, "каюбаба"@uk .
<https://nma.eosc.cz/vocabularies/languages/cym> ccmm_props:ISO_639_1 "cy"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "wel"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "cym"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "cym"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cy"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Cymraeg"@cy; skos:definition "Welsh (Cymraeg) is a member of the Brittonic subgroup of the Celtic languages. It has the status of official language in Wales.Modern standard literary Welsh is a conservative form of the language: this makes it more difficult to learn but those who can read it can also read the early classics."@en, "Le gallois est une langue du sous-groupe brittonique des langues celtiques, parlée principalement au pays de Galles. Il a le statut de langue officielle au pays de Galles.Le gallois littéraire moderne standard est une forme conservatrice de la langue: cela le rend plus difficile à apprendre, mais ceux qui savent le lire peuvent également lire les premiers classiques."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CYM>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "уелски"@bg, "velština"@cs, "walisisk"@da, "Walisisch"@de, "ουαλικά"@el, "Welsh"@en, "galés"@es, "kõmri keel"@et, "kymri"@fi, "gallois"@fr, "Breatnais"@ga, "velški"@hr, "walizišćina"@hsb, "walesi"@hu, "velska"@is, "gallese"@it, "valų kalba"@lt, "velsiešu valoda"@lv, "велшки"@mk, "Galliż"@mt, "Welsh"@nl, "walisisk"@no, "walijski"@pl, "galês"@pt, "galeză"@ro, "валлийский"@ru, "velški"@sh, "waleština"@sk, "valižanščina"@sl, "велшки"@sr, "kymriska"@sv, "galler"@tr, "валлійська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/cyo> ccmm_props:ISO_639_3 "cyo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cyo"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Cuyonon"@cyo; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CYO>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "cuyonon"@cyo .
<https://nma.eosc.cz/vocabularies/languages/czh> ccmm_props:ISO_639_3 "czh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "czh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "徽州话"@czh; skos:definition "Huizhou Chinese is a group of closely related Sinitic languages spoken over a small area in and around the historical region of Huizhou, plus in southern Anhui and in neighbouring Zhejiang and Jiangxi. Its classification is disputed, with some linguists classifying it as Wu Chinese, others as Gan, and still others setting it apart as a primary branch of Chinese."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CZH>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "хуейджоу китайски"@bg, "chuejčouské dialekty čínštiny"@cs, "Huizhou-kinesisk"@da, "Hui-Chinesisch"@de, "Κινεζικά Χουιζού"@el, "Huizhou Chinese"@en, "chino huizhou"@es, "Huizhou hiina"@et, "huizhounkiina"@fi, "chinois huizhou"@fr, "Sínis Huizhou"@ga, "huizhou kineski"@hr, "hujcsou kínai"@hu, "cinese huizhou"@it, "Huidžou kinų"@lt, "Huidžou ķīniešu valoda"@lv, "Ċiniż Huizhou"@mt, "Hui"@nl, "chiński hui"@pl, "chinês de Huizhou"@pt, "Chineză de Huizhou"@ro, "chuejčou čínština"@sk, "huizhou kitajščina"@sl, "huizhoukinesiska"@sv .

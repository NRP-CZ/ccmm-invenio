<http://publications.europa.eu/resource/authority/language/CLS> ccmm_props:ISO_639_3 "cls"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cls"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Śuddhasaṃskṛtam"@cls; skos:definition "Classical Sanskrit is a refined and standardized grammatical form that emerged in the mid-1st millennium BCE and was codified in the most comprehensive of ancient grammars, the Aṣṭādhyāyī ('Eight chapters') of Pāṇini."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "класически санскрит"@bg, "klasický sanskrt"@cs, "klassisk sanskrit"@da, "klassisches Sanskrit"@de, "Κλασικά Σανσκριτικά"@el, "Classical Sanskrit"@en, "sánscrito clásico"@es, "klassikaline sanskrit"@et, "klassinen sanskrit"@fi, "sanskrit classique"@fr, "Sanscrait Chlasaiceach"@ga, "klasični sanskrt"@hr, "klasszikus szanszkrit"@hu, "sanscrito classico"@it, "klasikinis sanskritas"@lt, "klasiskais sanskrits"@lv, "Sanskritu Klassiku"@mt, "Klassiek Sanskriet"@nl, "sanskryt klasyczny"@pl, "sânscrito paniniano"@pt, "sanscrită clasică"@ro, "klasický sanskrit"@sk, "klasični sanskrt"@sl, "klassisk sanskrit"@sv .

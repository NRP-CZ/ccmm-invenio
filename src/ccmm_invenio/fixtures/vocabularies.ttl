<http://publications.europa.eu/resource/authority/language/VIE> ccmm_props:ISO_639_1 "vi"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "vie"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "vie"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "vie"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "vi"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "tiếng Việt"@vi; skos:definition "Vietnamese is the native language of Vietnamese people. It is part of the Austroasiatic language family of which it has, by far, the most speakers.The Vietnamese alphabet (quốc ngữ) in use today is a Latin alphabet with additional diacritics for tones, and certain letters."@en, "Le vietnamien appartient à la branche môn-khmère des langues austro-asiatiques. Il est la langue austro-asiatique qui possède le plus de locuteurs. C’est une langue isolante et monosyllabique, dotée d’un système de 6 tons.Dans l’écriture latinisée utilisée actuellement, le Quốc ngữ, les mots figurent comme une succession de monosyllabes."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "виетнамски"@bg, "vietnamština"@cs, "vietnamesisk"@da, "Vietnamesisch"@de, "βιετναμικά"@el, "Vietnamese"@en, "vietnamita"@es, "vietnami keel"@et, "vietnam"@fi, "vietnamien"@fr, "Vítneaimis"@ga, "vijetnamski"@hr, "vietnamšćina"@hsb, "vietnámi"@hu, "víetnamska"@is, "vietnamita"@it, "vietnamiečių kalba"@lt, "vjetnamiešu valoda"@lv, "виетнамски"@mk, "Vietnamese"@mt, "Vietnamees"@nl, "vietnamesisk"@no, "wietnamski"@pl, "vietnamita"@pt, "vietnameză"@ro, "вьетнамский"@ru, "vijetnamski"@sh, "vietnamčina"@sk, "vietnamščina"@sl, "вијетнамски"@sr, "vietnamesiska"@sv, "vietnamca"@tr, "в'єтнамська мова"@uk .

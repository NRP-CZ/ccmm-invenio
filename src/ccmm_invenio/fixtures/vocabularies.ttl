<http://publications.europa.eu/resource/authority/language/NYR> ccmm_props:ISO_639_3 "nyr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nyr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nyiha (Malawi)"@nyr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "nyiha (Malawi)"@nyr .
<http://publications.europa.eu/resource/authority/language/NYS> ccmm_props:ISO_639_3 "nys"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nys"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nyungar"@nys; skos:definition "Nyungar is a dormant Australian Aboriginal language spoken in the south-west corner of Western Australia, from Geraldton on the west coast to Esperance on the south coast. There are 14 different groups in the Nyungar cultural bloc. They descend from people who spoke several languages and dialects that were often mutually intelligible. What is now classified as the Nyungar language is a member of the large Pama–Nyungan language family. Contemporary Nyungar speak Australian Aboriginal English laced with Nyungar words and occasionally inflected by its grammar."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Nyungar"@en .

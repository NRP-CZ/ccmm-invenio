<https://nma.eosc.cz/vocabularies/languages/sqs> ccmm_props:ISO_639_3 "sqs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sqs"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Sri Lankan Sign Language"@sqs; skos:definition "Sri Lankan Sign Language is a sign language used in Sri Lanka. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SQS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Шри Ланка"@bg, "šrílanský znakový jazyk"@cs, "srilankansk tegnsprog"@da, "Sri-lankische Gebärdensprache"@de, "σριλανκέζικη νοηματική γλώσσα"@el, "Sri Lankan Sign Language"@en, "lengua de signos de Sri Lanka"@es, "sri lanka viipekeel"@et, "srilankalainen viittomakieli"@fi, "langue des signes sri-lankaise"@fr, "Teanga Chomharthaíochta Shrí Lanca"@ga, "šrilanški znakovni jezik"@hr, "Srí Lanka-i jelnyelv"@hu, "lingua dei segni dello Sri Lanka"@it, "šrilankiečių gestų kalba"@lt, "Šrilankas zīmju valoda"@lv, "Lingwa tas-Sinjali tas-Sri Lanka"@mt, "Sri Lankaanse Gebarentaal"@nl, "język migowy Sri Lanki"@pl, "língua gestual cingalesa"@pt, "limbajul prin semne din Sri Lanka"@ro, "srílanský posunkový jazyk"@sk, "šrilanški znakovni jezik"@sl, "srilankesiskt teckenspråk"@sv .

<https://nma.eosc.cz/vocabularies/languages/tha> ccmm_props:ISO_639_1 "th"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "tha"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "tha"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "tha"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "th"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "phasa thai"@th, "ภาษาไทย"@th; skos:definition "Thai, or more precisely Siamese or Central Thai, is a member of the Tai group of the Tai–Kadai language family. It is a tonal and analytic language. Thai also has a complex orthography and relational markers. Thai is mutually intelligible with Lao.The Thais adopted and modified the Khmer script to create their own writing system. It is an abugida script."@en, "Le thaï ou siamois ou Thai-An est une langue du groupe taï de la famille des langues taï-kadaï.Le thaï utilise un alphasyllabaire particulier (alphabet thaï) dérivé de l’alphabet khmer issu de l’alphabet pâli, adapté pour pouvoir transcrire le système tonal de la langue."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/THA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "таи"@bg, "thajština"@cs, "thai"@da, "Thailändisch"@de, "ταϊλανδικά"@el, "Thai"@en, "tailandés"@es, "tai keel"@et, "thai"@fi, "thaï"@fr, "Téalainnis"@ga, "tajski"@hr, "thajšćina"@hsb, "thai"@hu, "taílenska"@is, "thai"@it, "tajų kalba"@lt, "taizemiešu valoda"@lv, "Tajlandiż"@mt, "Thai"@nl, "thai"@no, "tajski"@pl, "tailandês"@pt, "thailandeză"@ro, "тайский"@ru, "tajlandski"@sh, "thajčina"@sk, "tajščina"@sl, "тајландски"@sr, "thai"@sv, "tayca"@tr, "тайська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/thc> ccmm_props:ISO_639_3 "thc"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "thc"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Tai Hang Tong"@thc; skos:exactMatch <http://publications.europa.eu/resource/authority/language/THC>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Tai Hang Tong"@en .
<https://nma.eosc.cz/vocabularies/languages/thd> ccmm_props:ISO_639_3 "thd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "thd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Thayore"@en, "Kuuk Thayorre"@thd; skos:definition "Kuuk Thayorre, also known as Thayore, is a stable Pama-Nyungan language spoken in the settlement Pormpuraaw on the western part of the Cape York Peninsula in Queensland, Australia. It is thought to be related to the extinct Kuuk-Yak language. Kuuk Thayorre is classified within the Paman branch and more specifically within the Southwest Pama sub-branch. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/THD>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Kuuk Thayorre"@en .

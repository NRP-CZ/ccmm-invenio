<http://publications.europa.eu/resource/authority/language/MZC> ccmm_props:ISO_639_3 "mzc"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mzc"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Madagascar Sign Language"@mzc; skos:definition "Madagascar Sign Language is a sign language used in Madagascar. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Мадагаскар"@bg, "madagaskarský znakový jazyk"@cs, "Madagaskar tegnsprog"@da, "Madagassische Gebärdensprache"@de, "μαδαγασκαριανή νοηματική γλώσσα"@el, "Madagascar Sign Language"@en, "lengua de signos de Madagascar"@es, "madagaskari viipekeel"@et, "madagaskarilainen viittomakieli"@fi, "langue des signes malgache"@fr, "Teanga Chomharthaíochta Mhadagascar"@ga, "madagaskarski znakovni jezik"@hr, "madagaszkári jelnyelv"@hu, "lingua dei segni del Madagascar"@it, "madagaskariečių gestų kalba"@lt, "Madagaskaras zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Madagascar"@mt, "Malagassische Gebarentaal"@nl, "gassisk tegnspråk"@no, "madagarskarski język migowy"@pl, "língua gestual malgaxe"@pt, "limbajul prin semne din Madagascar"@ro, "madagaskarský posunkový jazyk"@sk, "malgaški znakovni jezik"@sl, "madagasgiskt teckenspråk"@sv .
<http://publications.europa.eu/resource/authority/language/MZD> ccmm_props:ISO_639_3 "mzd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mzd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Limba"@en, "Malimba"@mzd; skos:definition "Malimba is an Southern Bantoid language spoken in Cameroon. Together with Bengaic languages (BNG, BNM, NUI, YKO) and other Dualaic languages (DUA, KME, ISU, OLB), it belongs to the Sawabantu group, which is classified within the Volta-Congo primary branch. Like other Bantu languages, Malimba has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Malimba"@en .

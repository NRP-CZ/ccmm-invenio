<http://publications.europa.eu/resource/authority/language/DZO> ccmm_props:ISO_639_1 "dz"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "dzo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "dzo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "dzo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dz"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "rdzong-kha"@dz, "རྫོང་ཁ"@dz, "bhotijų"@lt; skos:definition "Dzongkha is a Sino-Tibetan language. It is the official language of Bhutan."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "дзонгкха"@bg, "dzongkä"@cs, "dzongkha"@da, "Dzongkha"@de, "ντζόνγκχα"@el, "Dzongkha"@en, "dzongka"@es, "dongkha keel"@et, "dzongkha"@fi, "dzongkha"@fr, "Seoinicis"@ga, "dzongkha"@hr, "dzonkha"@hu, "dzongkha"@it, "dzongkha"@lt, "dzongke"@lv, "Dzongkha"@mt, "Dzongkha"@nl, "dzongkha"@pl, "butanês"@pt, "dzongkha"@ro, "dzongkä"@sk, "dzonka"@sl, "dzongkha"@sv, "дзонгха мова"@uk .
<http://publications.europa.eu/resource/authority/language/EAA> ccmm_props:ISO_639_3 "eaa"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "eaa"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Karenggapa"@en .
<http://publications.europa.eu/resource/authority/language/EBC> ccmm_props:ISO_639_3 "ebc"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ebc"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Beginci"@ebc; skos:definition "Beginci is a Malayo-Polynesian language spoken in Kalimantan, the Indonesian part of Borneo. The Malayo-Polynesian languages are a subgroup of the Austronesian languages encompassing approximately 390 million speakers. All major Austronesian languages belong to the Malayo-Polynesian subgroup. Together with closely related Gerai, Beginci belongs to the Malayic Dayak sub-branch. Austronesian languages often possess phoneme inventories smaller than the world average. Two salient morphological characteristics are a system of affixation and reduplication to form new words."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Beginci"@en .

<http://publications.europa.eu/resource/authority/language/CXH> ccmm_props:ISO_639_3 "cxh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cxh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Cha'ari"@cxh; skos:definition "Cha'ari is an Afro-Asiatic language spoken in Nigeria. It belongs to the endangered Western Chadic sub-branch whose speakers are shifting to Hausa. Together with Tulai and Zeem, it forms the Nuclear Zeemic group."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "чаари"@bg, "ča'ari"@cs, "cha'ari"@da, "Chaari"@de, "Τσα’άρι"@el, "Cha'ari"@en, "Cha'ari"@es, "chaari"@fi, "cha’ari"@fr, "Sea-áiris"@ga, "čahari"@hr, "csári"@hu, "Cha'ari"@it, "čarių"@lt, "haāri"@lv, "Cha'ari"@mt, "Cha’ari"@nl, "cza’ari"@pl, "chari"@pt, "cha’ari"@ro, "cha'ari"@sk, "cha’ari"@sl, "chaari"@sv .

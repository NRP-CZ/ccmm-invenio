<https://nma.eosc.cz/vocabularies/languages/gan> ccmm_props:ISO_639_3 "gan"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "gan"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Gànyǔ"@gan, "赣语"@gan; skos:definition "Gan is a member of the Sinitic languages of the Sino-Tibetan language family, and Hakka is the closest Chinese variety to Gan in terms of phonetics. It is spoken in the Jiangxi province and the neighbouring provinces."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/GAN>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "ган китайски"@bg, "ťiangsiské dialekty čínštiny"@cs, "Gan-kinesisk"@da, "Gan-Chinesisch"@de, "Κινεζικά Γκαν"@el, "Gan Chinese"@en, "chino gan"@es, "Gani hiina"@et, "gan-kiina"@fi, "chinois gan"@fr, "Sínis Gan"@ga, "gan kineski"@hr, "kan kínai"@hu, "cinese gan"@it, "Gano kinų"@lt, "Gaņ ķīniešu valoda"@lv, "Ċiniż Gan"@mt, "Gan"@nl, "chiński gan"@pl, "chinês gan"@pt, "chineză Gan"@ro, "kan čínština"@sk, "gan kitajščina"@sl, "gankinesiska"@sv .

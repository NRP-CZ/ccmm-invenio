<http://publications.europa.eu/resource/authority/language/CNR> ccmm_props:ISO_639_2B "cnr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "cnr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "cnr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cnr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "crnogorski jezik"@cnr, "црногорски језик"@cnr; skos:definition "Montenegrin is the standardised variety of the Serbo-Croatian used by Montenegrins. It is based on the Shtokavian dialect of Serbo-Croatian.Montenegrin uses more the Latin alphabet than the Cyrillic. In both alphabets there are two additional letters."@en, "Le monténégrin est la variante normalisée du serbo-croate utilisé par les Monténégrins. Il est basé sur le dialecte chtokavien du serbo-croate.Le monténégrin emploie plus l’alphabet latin que cyrillique. Dans les deux alphabets, il y a deux lettres supplémentaires."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "чарнагорская мова"@be, "черногорски"@bg, "crnogorski jezik"@bs, "montenegrí"@ca, "černohorština"@cs, "montenegrinsk"@da, "Montenegrinisch"@de, "μαυροβουνιακά"@el, "Montenegrin"@en, "montenegrino"@es, "montenegro keel"@et, "montenegro"@fi, "monténégrin"@fr, "Montainéigris"@ga, "crnogorski"@hr, "montenegrói"@hu, "svartfellska"@is, "montenegrino"@it, "juodkalniečių kalba"@lt, "melnkalniešu valoda"@lv, "црногорски јазик"@mk, "Montenegrin"@mt, "Montenegrijns"@nl, "montenegrinsk"@no, "czarnogórski"@pl, "montenegrino"@pt, "muntenegreană"@ro, "черногорский язык"@ru, "crnogorski"@sh, "čiernohorčina"@sk, "črnogorščina"@sl, "malazishtja"@sq, "црногорски језик"@sr, "montenegrinska"@sv, "karadağca"@tr, "чорногорська мова"@uk .

<https://nma.eosc.cz/vocabularies/languages/zlq> ccmm_props:ISO_639_3 "zlq"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "zlq"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "柳黔壮語"@zlq; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ZLQ>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Liuqian Zhuang"@en .
<https://nma.eosc.cz/vocabularies/languages/zlu> ccmm_props:ISO_639_3 "zlu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "zlu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Zul"@zlu; skos:definition "Zul is an Afro-Asiatic language of Bauchi State, Nigeria. It is part of the Barawa cluster, which is in turn part of the West Chadic branch. Its closes language varieties are Pesse, Buli, Dir-Nyamzak-Mbarimi and the extinct Luri. Together, they form the Polci-Luri group."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ZLU>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Zul"@en .

<https://nma.eosc.cz/vocabularies/languages/zgh> ccmm_props:ISO_639_2B "zgh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "zgh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "zgh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "zgh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Standard Moroccan Amazigh"@en, "amazighe standard marocain"@fr, "Al-amazighiat al-miʿyaria"@zgh, "Tamaziɣt"@zgh, "الأمازيغية المعيارية"@zgh; skos:definition "Standard Moroccan Tamazight is a Berber language of the Afroasiatic language family spoken in Morocco. It is a standardized language developed by the Royal Institute of Amazigh Culture (IRCAM) in Morocco by combining features of Tashelhit, Central Atlas Tamazight and Tarifit, the three major Amazigh languages in Morocco. It has been an official language of Morocco since 2011."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ZGH>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "стандартен марокански език тамазигт"@bg, "standardní marocký tamazight"@cs, "standardtamazight (Marokko)"@da, "Marokkanisches Tamazight"@de, "πρότυπα μαροκινά ταμαζίγτ (Tamazight)"@el, "Standard Moroccan Tamazight"@en, "amazig estándar marroquí"@es, "standardne Maroko tamasikti keel"@et, "standarditamazight (Marokko)"@fi, "tamazight marocain normalisé"@fr, "Tamaisis Chaighdeánach Mharacó"@ga, "standardni marokanski tamazight"@hr, "standard marokkói tamazight"@hu, "tamazight standard del Marocco"@it, "Standartinė Maroko amazigų kalba"@lt, "Marokas tamazigtu standarts"@lv, "Norma Marokkina Tamazight"@mt, "Standaard Marokkaans Tamazight"@nl, "standardowy marokański tamazight"@pl, "amazigue marroquino padrão"@pt, "Tamazigtă standard marocană"@ro, "štandardný marocký tamašek"@sk, "standardni maroški jezik Tamašek"@sl, "marockansk standard-tamazight"@sv .

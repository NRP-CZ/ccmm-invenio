<http://publications.europa.eu/resource/authority/language/SRP> ccmm_props:ISO_639_1 "sr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "srp"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "srp"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "srp"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "srpski"@sr; skos:definition "Serbian is the standardised variety of the Serbo-Croatian language, spoken mainly in Serbia, Montenegro, Bosnia and Herzegovina. Standard Serbian is based on the Shtokavian dialect of Serbo-Croatian.Serbian uses both Cyrillic and Latin alphabets."@en, "Le serbe est la variante standard de la langue serbo-croate, parlée principalement en Serbie, en Bosnie-Herzégovine et au Monténégro. Sa norme est basée sur le dialecte chtokavien du serbo-croate.Le serbe utilise les alphabets cyrillique et latin."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "сръбски"@bg, "srbština"@cs, "serbisk"@da, "Serbisch"@de, "σερβικά"@el, "Serbian"@en, "serbio"@es, "serbia keel"@et, "serbia"@fi, "serbe"@fr, "Seirbis"@ga, "srpski"@hr, "serbišćina"@hsb, "szerb"@hu, "serbneska"@is, "serbo"@it, "serbų kalba"@lt, "serbu valoda"@lv, "српски"@mk, "Serb"@mt, "Servisch"@nl, "serbisk"@no, "serbski"@pl, "sérvio"@pt, "sârbă"@ro, "сербский"@ru, "srpski"@sh, "srbčina"@sk, "srbščina"@sl, "српски"@sr, "serbiska"@sv, "sırpça"@tr, "сербська мова"@uk .
<http://publications.europa.eu/resource/authority/language/SRQ> ccmm_props:ISO_639_3 "srq"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "srq"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Mbya"@en, "mbya"@es, "mbia chee"@srq; skos:definition "Sirionó is a Tupian indigenous language. It is one of the official languages of Bolivia."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "сирионо"@bg, "sirionó"@cs, "sirionó"@da, "Sirionó"@de, "σιριονό"@el, "Sirionó"@en, "sirionó"@es, "siriono keel"@et, "sirionó"@fi, "sirionó"@fr, "Sirianóis"@ga, "sirionó"@hr, "sirionó"@hu, "sirionó"@it, "sirionų"@lt, "sirionó"@lv, "Sirionó"@mt, "Sirionó"@nl, "sirionó"@pl, "sirionó"@pt, "sirionó"@ro, "sirionó"@sk, "sirionó"@sl, "sirionó"@sv, "сирионо"@uk .

<http://publications.europa.eu/resource/authority/language/FUL> ccmm_props:ISO_639_1 "ff"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "ful"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "ful"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "ful"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ff"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Fulah"@en, "Fulfulde"@ff, "اللغة الفولانية"@ff, "poular"@fr; skos:definition "Fula – also known as Fulah – is a Senegambian language spoken across some 20 countries in West and Central Africa. Along with other related languages such as Serer and Wolof, it belongs to the Senegambian branch within the Niger–Congo family, which does not have tones. It is spoken as a first language by the Fula people. The language mainly uses a version of the Latin alphabet but Arabic script is also used and there was a plan to use a special Adlam script."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "фула"@bg, "fulbština"@cs, "fulah"@da, "Fula"@de, "φούλα"@el, "Fula"@en, "fula"@es, "fulbe"@et, "fulani"@fi, "fula"@fr, "Fuláinis"@ga, "fula"@hr, "fula"@hu, "fula"@it, "fulų"@lt, "fulu valoda"@lv, "Fula"@mt, "Fula"@nl, "fula"@pl, "fula"@pt, "fula"@ro, "fula"@sk, "fulščina"@sl, "fula"@sv, "фула"@uk .

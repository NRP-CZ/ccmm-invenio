<https://nma.eosc.cz/vocabularies/languages/ase> ccmm_props:ISO_639_3 "ase"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ase"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "American Sign Language"@ase; skos:definition "American Sign Language is a sign language used in the United States and most of anglophone Canada. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ASE>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "амэрыка́нская жэставая мова"@be, "американски жестомимичен език"@bg, "llengua de signes americana"@ca, "americký znakový jazyk"@cs, "amerikansk tegnsprog"@da, "Amerikanische Gebärdensprache"@de, "αμερικανική νοηματική γλώσσα"@el, "American Sign Language"@en, "lengua de signos americana"@es, "ameerika viipekeel"@et, "amerikkalainen viittomakieli"@fi, "langue des signes américaine"@fr, "Teanga Chomharthaíochta Mheiriceá"@ga, "američki znakovni jezik"@hr, "amerikai jelnyelv"@hu, "lingua dei segni americana"@it, "amerikiečių gestų kalba"@lt, "amerikāņu zīmju valoda"@lv, "Lingwa tas-Sinjali Amerikana"@mt, "Amerikaanse Gebarentaal"@nl, "amerikansk tegnspråk"@no, "amerykański język migowy"@pl, "língua gestual americana"@pt, "limbajul prin semne american"@ro, "американский жестовый язык"@ru, "americký posunkový jazyk"@sk, "ameriški znakovni jezik"@sl, "amerikanskt teckenspråk"@sv, "amerikan işaret dili"@tr, "американська жестова мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/asf> ccmm_props:ISO_639_3 "asf"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "asf"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Australian Sign Language"@asf; skos:definition "Australian Sign Language is a sign language used in Australia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ASF>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "австралийски жестомимичен език"@bg, "australský znakový jazyk"@cs, "australsk tegnsprog"@da, "Australische Gebärdensprache"@de, "αυστραλιανή νοηματική γλώσσα"@el, "Australian Sign Language"@en, "lengua de signos australiana"@es, "austraalia viipekeel"@et, "australialainen viittomakieli"@fi, "langue des signes australienne"@fr, "Teanga Chomharthaíochta na hAstráile"@ga, "australski znakovni jezik"@hr, "ausztrál jelnyelv"@hu, "lingua dei segni australiana"@it, "australų gestų kalba"@lt, "austrāliešu zīmju valoda"@lv, "Lingwa tas-Sinjali Awstraljana"@mt, "Australische Gebarentaal"@nl, "australsk tegnspråk"@no, "australijski język migowy"@pl, "língua gestual australiana"@pt, "limbajul prin semne din Australia"@ro, "австралийский жестовый язык"@ru, "austrálsky posunkový jazyk"@sk, "avstralski znakovni jezik"@sl, "australiskt teckenspråk"@sv, "avustralya işaret dili"@tr, "австралійська мова жестів"@uk .

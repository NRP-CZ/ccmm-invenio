<http://publications.europa.eu/resource/authority/language/XPK> ccmm_props:ISO_639_3 "xpk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpk"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Kulina Pano"@xpk; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "kulina Pano"@xpk .
<http://publications.europa.eu/resource/authority/language/XPL> ccmm_props:ISO_639_3 "xpl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xpl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Port Sorell"@en, "Port Sorell"@xpl; skos:definition "Port Sorell is an extinct aboriginal language of Tasmania in the reconstruction of Claire Bowern. It was spoken near Port Sorell, in the center of the north coast, just east of Northern Tasmanian proper. Dixon & Crowley agree that there is unlikely to be a close connection to other varieties of Tasmanian. Port Sorell Tasmanian is attested from two word lists."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Port Sorell Tasmanian"@en .

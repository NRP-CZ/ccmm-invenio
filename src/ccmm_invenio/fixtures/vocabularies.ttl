<http://publications.europa.eu/resource/authority/language/FCS> ccmm_props:ISO_639_3 "fcs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fcs"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Quebec Sign Language"@fcs; skos:definition "Quebec Sign Language is a sign language used in francophone Canada. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Квебек"@bg, "quebecký znakový jazyk"@cs, "Quebec tegnsprog"@da, "Québec-Gebärdensprache"@de, "νοηματική γλώσσα Κεμπέκ"@el, "Quebec Sign Language"@en, "lengua de signos de Quebec"@es, "quebeci viipekeel"@et, "quebeciläinen viittomakieli"@fi, "langue des signes québécoise"@fr, "Teanga Chomharthaíochta Québec"@ga, "kvebečki znakovni jezik"@hr, "québeci jelnyelv"@hu, "lingua dei segni del Quebec"@it, "kvebekiečių gestų kalba"@lt, "Kvebekas zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Quebec"@mt, "Gebarentaal van Quebec"@nl, "quebecki język migowy"@pl, "língua gestual quebequense"@pt, "limbajul prin semne din Quebec"@ro, "квебекский жестовый язык"@ru, "quebecký posunkový jazyk"@sk, "znakovni jezik Quebeca"@sl, "Quebec-teckenspråk"@sv .

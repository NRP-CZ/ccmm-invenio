<https://nma.eosc.cz/vocabularies/languages/sjc> ccmm_props:ISO_639_3 "sjc"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sjc"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Shàojiāng"@sjc, "邵将"@sjc; skos:definition "Shaojiang Chinese is a Min Chinese language centered on Western Nanping in Northwest Fujian. The classification of Shao–Jiang is disputed. It is frequently classified as a variety of Northern Min, but sometimes it is excluded from Min and classified as Gan Chinese instead. But it is mutually intelligible with neither other Northern Min nor other Gan."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SJC>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "шаодзянски китайски"@bg, "šaoťiangská čínština"@cs, "Shaojiangkinesisk"@da, "Shaojiang"@de, "Κινεζικά Σαοτζιάνγκ"@el, "Shaojiang Chinese"@en, "Chino shaojiang"@es, "Shao–Jiangi hiina keel"@et, "shaojiang -kiina"@fi, "chinois de Shaojiang"@fr, "Sínis Sheaibhsianach"@ga, "šaođjanski kineski"@hr, "saocsiang kínai"@hu, "Cinese shaojiang"@it, "Šaodziango kinų"@lt, "Šanhajas ķīniešu"@lv, "Ċiniż Shaojiang"@mt, "Shaojiang"@nl, "chiński shaojiang"@pl, "chinês xauquião"@pt, "chineză din Shaojiang"@ro, "šao-ťiangská čínština"@sk, "Šaojiang kitajščina"@sl, "Shaojiangkinesiska"@sv .

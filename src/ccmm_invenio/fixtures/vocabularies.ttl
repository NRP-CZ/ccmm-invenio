<http://publications.europa.eu/resource/authority/language/ISR> ccmm_props:ISO_639_3 "isr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "isr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Israeli Sign Language"@isr; skos:definition "Israeli Sign Language is a sign language used in Israel. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "израелски жестомимичен език"@bg, "izraelský znakový jazyk"@cs, "israelsk tegnsprog"@da, "Israelische Gebärdensprache"@de, "ισραηλινή νοηματική γλώσσα"@el, "Israeli Sign Language"@en, "lengua de signos israelí"@es, "iisraeli viipekeel"@et, "israelilainen viittomakieli"@fi, "langue des signes israélienne"@fr, "Teanga Chomharthaíochta Iosrael"@ga, "izraelski znakovni jezik"@hr, "izraeli jelnyelv"@hu, "lingua dei segni israeliana"@it, "izraeliečių gestų kalba"@lt, "izraēliešu zīmju valoda"@lv, "Lingwa tas-Sinjali Iżraeljana"@mt, "Israëlische Gebarentaal"@nl, "izraelski język migowy"@pl, "língua gestual israelita"@pt, "limbajul prin semne din Israel"@ro, "izraelský posunkový jazyk"@sk, "izraelski znakovni jezik"@sl, "israeliskt teckenspråk"@sv .
<http://publications.europa.eu/resource/authority/language/IST> ccmm_props:ISO_639_3 "ist"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ist"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Istriot"@ist; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "istriot"@ist .
<http://publications.europa.eu/resource/authority/language/ISU> ccmm_props:ISO_639_3 "isu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "isu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Isu"@isu; skos:definition "Isu (Menchum Division) is an Southern Bantoid language spoken in Cameroon. Together with Bengaic languages (BNG, BNM, NUI, YKO) and other Dualaic languages (DUA, MZD, KME, OLB), it belongs to the Sawabantu group, which is classified within the Volta-Congo primary branch. Like other Bantu languages, Isu has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Isu (Menchum Division)"@en .
<http://publications.europa.eu/resource/authority/language/ITA> ccmm_props:ISO_639_1 "it"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "ita"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "ita"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "ita"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "it"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:definition "Italian is a member of the Romance language group, spoken mainly in south Europe. Among the Romance languages, Italian is the closest to Latin in terms of vocabulary. The Italian language adopted by the state after the unification of Italy is based on Tuscan.Many Italian speakers are native bilinguals of both standardised Italian and other regional variants."@en, "L’italien est une langue appartenant au groupe des langues romanes, parlée principalement en Europe du Sud. Parmi les langues romanes, l’italien est très proche du latin en termes de vocabulaire. La langue italienne adoptée par l’État après l’unification de l’Italie est fondée sur le dialecte de la Toscane.De nombreux locuteurs italiens sont bilingues et parlent aussi bien l’italien standard que les autres variantes régionales."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "италиански"@bg, "italština"@cs, "italiensk"@da, "Italienisch"@de, "ιταλικά"@el, "Italian"@en, "italiano"@es, "itaalia keel"@et, "italia"@fi, "italien"@fr, "Iodáilis"@ga, "talijanski"@hr, "italšćina"@hsb, "olasz"@hu, "ítalska"@is, "italiano"@it, "italų kalba"@lt, "itāļu valoda"@lv, "италијански"@mk, "Taljan"@mt, "Italiaans"@nl, "italiensk"@no, "włoski"@pl, "italiano"@pt, "italiană"@ro, "итальянский"@ru, "italijanski"@sh, "taliančina"@sk, "italijanščina"@sl, "италијански"@sr, "italienska"@sv, "ıtalyanca"@tr, "італійська мова"@uk .

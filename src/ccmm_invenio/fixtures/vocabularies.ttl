<http://publications.europa.eu/resource/authority/language/KIN> ccmm_props:ISO_639_1 "rw"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "kin"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "kin"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "kin"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rw"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Rwandan"@en, "Kinyarwanda"@rw; skos:definition "Kinyarwanda is a Bantu language. It is one of the official languages of Rwanda."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "киняруанда"@bg, "rwandština"@cs, "kinyarwanda"@da, "Kinyarwanda"@de, "κινυαρουάντα"@el, "Kinyarwanda"@en, "kinyarwanda"@es, "ruanda keel"@et, "ruanda"@fi, "kinyarwanda"@fr, "Ciniaruaindis"@ga, "kinyarwanda"@hr, "ruandai"@hu, "kinyarwanda"@it, "kinjaruandų"@lt, "kiņaruanda"@lv, "Kinyarwandiż"@mt, "Kinyarwanda"@nl, "rundi"@pl, "ruanda"@pt, "kinyarwanda"@ro, "rwandčina"@sk, "ruandščina"@sl, "rwanda"@sv, "кіньяруанда"@uk .

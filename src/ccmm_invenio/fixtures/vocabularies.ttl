<http://publications.europa.eu/resource/authority/language/FIE> ccmm_props:ISO_639_3 "fie"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fie"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Fyer"@fie; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "fyer"@fie .
<http://publications.europa.eu/resource/authority/language/FIF> ccmm_props:ISO_639_3 "fif"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fif"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Al-Fayfiyah"@fif; skos:definition "Faifi is a possible descendant of Ancient South Arabian and is spoken by about 50 000 people in the vicinity of the Fifa Mountains in the southwestern corner of Saudi Arabia and across the border in Jebel Minabbih, Yemen. Along with the Razihi and Rijal Alma languages, it is possibly one of the few surviving descendants of the Sayhadic branch and the Ancient South Arabian languages Hadrami, Minaean, Sabaic and Qatrabanian. Along with Berber, Chadic, Cushitic and Egyptian branches, Arabic and other Semitic languages belong to the Afro-Asiatic language family, constituting the fourth-largest language family after Indo-European, Sino-Tibetan, and Niger–Congo."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Faifi"@en .
<http://publications.europa.eu/resource/authority/language/FIJ> ccmm_props:ISO_639_1 "fj"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "fij"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "fij"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "fij"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fj"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Na Vosa Vakaviti"@fj; skos:definition "Fijian is a Malayo-Polynesian language. It is one of the official languages of Fiji."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "фиджийски"@bg, "fidžijština"@cs, "fijiansk"@da, "Fidschianisch"@de, "φιτζιανά"@el, "Fijian"@en, "fiyiano"@es, "fidži keel"@et, "fidži"@fi, "fidjien"@fr, "Fidsis"@ga, "fidžijski"@hr, "fidzsi"@hu, "figiano"@it, "fidžių"@lt, "fidžiešu valoda"@lv, "Fiġjan"@mt, "Fijisch"@nl, "fidżi"@pl, "fijiano"@pt, "fijiană"@ro, "fidžijčina"@sk, "fidžijščina"@sl, "fiji"@sv, "фіджі"@uk .
<http://publications.europa.eu/resource/authority/language/FIL> ccmm_props:ISO_639_2B "fil"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "fil"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "fil"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fil"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Pilipino"@fil; skos:definition "Filipino is a Malayo-Polynesian language. It is one of the official languages of the Philippines."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "филипински"@bg, "filipínština"@cs, "filippinsk"@da, "Filipino"@de, "φιλιππινέζικα"@el, "Filipino"@en, "filipino"@es, "filipiini keel"@et, "filipino"@fi, "philippin"@fr, "Filipínis"@ga, "filipinski"@hr, "filippínó"@hu, "filippino"@it, "filipinų"@lt, "filipīniešu valoda"@lv, "Filippin"@mt, "Filipijns"@nl, "filipiński"@pl, "filipino"@pt, "filipineză"@ro, "filipínčina"@sk, "filipinščina"@sl, "pilipino"@sv, "філіпська мова"@uk .
<http://publications.europa.eu/resource/authority/language/FIN> ccmm_props:ISO_639_1 "fi"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "fin"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "fin"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "fin"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fi"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:definition "Finnish belongs (with Estonian) to the Baltic-Finnic subgroup of the Finno-Ugrian languages from the Uralic family. Finnish is one of two official languages of Finland (the other being Swedish).Finnish is typologically between fusional and agglutinative languages."@en, "Le finnois appartient, avec l’estonien, au sous-groupe balto-finnois des langues finno-ougriennes de la famille ouralienne. Le finnois est l’une des deux langues officielles de la Finlande (l’autre étant le suédois).Typologiquement, le finnois se situe entre les langues fusionnelles et agglutinantes."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "фински"@bg, "finština"@cs, "finsk"@da, "Finnisch"@de, "φινλανδικά"@el, "Finnish"@en, "finés"@es, "soome keel"@et, "suomi"@fi, "finnois"@fr, "Fionlainnis"@ga, "finski"@hr, "finšćina"@hsb, "finn"@hu, "finnska"@is, "finlandese"@it, "suomių kalba"@lt, "somu valoda"@lv, "фински"@mk, "Finlandiż"@mt, "Fins"@nl, "finsk"@no, "fiński"@pl, "finlandês"@pt, "finlandeză"@ro, "финский"@ru, "finski"@sh, "fínčina"@sk, "finščina"@sl, "фински"@sr, "finska"@sv, "fince"@tr, "фінська мова"@uk .
<http://publications.europa.eu/resource/authority/language/FIP> ccmm_props:ISO_639_3 "fip"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fip"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Fipa"@fip; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "fipa"@fip .
<http://publications.europa.eu/resource/authority/language/FIR> ccmm_props:ISO_639_3 "fir"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fir"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Firan"@fir; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "firan"@fir .
<http://publications.europa.eu/resource/authority/language/FIT> ccmm_props:ISO_639_3 "fit"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fit"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Meänkieli"@en, "Meänkieli"@fit; skos:definition "Tornedalen Finnish is a group of distinct Finnish dialects spoken in the northernmost part of Sweden, particularly along the Torne River Valley. It is officially recognized as one of Sweden's five minority languages and is treated as a separate language from Finnish. Its status as an independent language is sometimes disputed due to this high degree of mutual intelligibility. However, Meänkieli contains strong influences from Swedish and has preserved some archaic features that even the Northern Finnish dialects have lost. Together with Finnish, it belongs to the Finnic languages of the Uralic language family."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Tornedalen Finnish"@en, "Tornedalsfinska"@sv .

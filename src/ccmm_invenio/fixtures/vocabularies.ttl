<https://nma.eosc.cz/vocabularies/languages/niu> ccmm_props:ISO_639_2B "niu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "niu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "niu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "niu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "niujiečių"@lt, "ko e vagahau Niuē"@niu; skos:definition "Niuean is a Malayo-Polynesian language. It is one of the official languages of Niue."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/NIU>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "ниуеански"@bg, "niueština"@cs, "niuean"@da, "Niueanisch"@de, "νιουεϊκή"@el, "Niuean"@en, "niuano"@es, "niue keel"@et, "niue"@fi, "niuéen"@fr, "Níobhais"@ga, "niujski"@hr, "niuei"@hu, "niueano"@it, "niujų"@lt, "niuāņu valoda"@lv, "Niuean"@mt, "Niuean"@nl, "niueński"@pl, "niueiano"@pt, "niueană"@ro, "niueština"@sk, "jezik niue"@sl, "niueanska"@sv, "ніуе"@uk .

<https://nma.eosc.cz/vocabularies/languages/jos> ccmm_props:ISO_639_3 "jos"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "jos"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Jordanian Sign Language"@jos; skos:definition "Jordanian Sign Language is a sign language used in Jordania. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/JOS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "йордански жестомимичен език"@bg, "jordánský znakový jazyk"@cs, "jordansk tegnsprog"@da, "Jordanische Gebärdensprache"@de, "ιορδανική νοηματική γλώσσα"@el, "Jordanian Sign Language"@en, "lengua de signos jordana"@es, "jordaania viipekeel"@et, "jordanialainen viittomakieli"@fi, "langue des signes jordanienne"@fr, "Teanga Chomharthaíochta na hIordáine"@ga, "jordanski znakovni jezik"@hr, "jordániai jelnyelv"@hu, "lingua dei segni giordana"@it, "jordaniečių gestų kalba"@lt, "Jordānas zīmju valoda"@lv, "Lingwa tas-Sinjali Ġordanjana"@mt, "Jordaanse Gebarentaal"@nl, "jordański język migowy"@pl, "língua gestual jordana"@pt, "limbajul prin semne din Iordania"@ro, "jordánsky posunkový jazyk"@sk, "jordanski znakovni jezik"@sl, "jordanskt teckenspråk"@sv .

<http://publications.europa.eu/resource/authority/language/DOQ> ccmm_props:ISO_639_3 "doq"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "doq"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Dominican Sign Language"@doq; skos:definition "Dominican Sign Language is a sign language used in Dominican Republic. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Доминиканската република"@bg, "dominikánský znakový jazyk"@cs, "dominikansk tegnsprog"@da, "Dominikanische Gebärdensprache"@de, "δομινικανή νοηματική γλώσσα"@el, "Dominican Sign Language"@en, "lengua de signos dominicana"@es, "dominikaani viipekeel"@et, "dominikaaninen viittomakieli"@fi, "langue des signes dominicaine"@fr, "Teanga Chomharthaíochta na Poblachta Doiminicí"@ga, "dominikanski znakovni jezik"@hr, "dominikai jelnyelv"@hu, "lingua dei segni della Repubblica dominicana"@it, "dominikiečių gestų kalba"@lt, "Dominikānas zīmju valoda"@lv, "Lingwa tas-Sinjali Dominikana"@mt, "Dominicaanse Gebarentaal"@nl, "dominikański język migowy"@pl, "língua gestual dominicana"@pt, "limbajul prin semne dominican"@ro, "dominikánsky posunkový jazyk"@sk, "dominikanski znakovni jezik"@sl, "dominikanskt teckenspråk"@sv .

<http://publications.europa.eu/resource/authority/language/DYM> ccmm_props:ISO_639_3 "dym"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dym"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Yanda Dom Dogon"@dym; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "yanda Dom Dogon"@dym .
<http://publications.europa.eu/resource/authority/language/DYN> ccmm_props:ISO_639_3 "dyn"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dyn"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Dhanggatti"@dyn, "Dhanggatti"@en; skos:definition "Dyangadi, also known as Dhanggatti, is a Pama-Nyungan language, once spoken by the Djangadi of the Macleay Valley and surrounding high country of the Great Dividing Range in New South Wales, Australia. There is an ongoing program of language-revival. Dyangadi is related to the extinct Nganyaywana language. Both have been called the Macleay Valley languages. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Dyangadi"@en .
<http://publications.europa.eu/resource/authority/language/DYO> ccmm_props:ISO_639_3 "dyo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dyo"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Jola-Fonyi"@dyo; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "jola-Fonyi"@dyo .
<http://publications.europa.eu/resource/authority/language/DYR> ccmm_props:ISO_639_3 "dyr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dyr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Dyarim"@dyr; skos:definition "Dyarim is an Afro-Asiatic language spoken in Nigeria. It belongs to the endangered Western Chadic sub-branch whose speakers are shifting to Hausa. One of its closest relatives is the Zeemic language group."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "диарим"@bg, "dyarim"@cs, "dyarim"@da, "Dyarim"@de, "Ντιαρίμ"@el, "Dyarim"@en, "Dyarim"@es, "dyarim"@fi, "dyarim"@fr, "Diairimis"@ga, "djarim"@hr, "diarim"@hu, "Dyarim"@it, "djarimų"@lt, "djarimu"@lv, "Dyarim"@mt, "Dyarim"@nl, "diarim"@pl, "diarim"@pt, "dyarim"@ro, "dyarim"@sk, "djarimščina"@sl, "dyarim"@sv .
<http://publications.europa.eu/resource/authority/language/DYU> ccmm_props:ISO_639_2B "dyu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "dyu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "dyu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dyu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Dyula"@dyu; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "dyula"@dyu .
<http://publications.europa.eu/resource/authority/language/DYY> ccmm_props:ISO_639_3 "dyy"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dyy"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Djabugay"@dyy, "Dyaabugay"@en; skos:definition "Yidiny is an endangered Australian Aboriginal language spoken in the northeast of Queensland by the Yidinji people. It is closely related to Djabugay, and both are sometimes placed in a separate Yidinyic branch of the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Djabugay"@en .
<http://publications.europa.eu/resource/authority/language/DZA> ccmm_props:ISO_639_3 "dza"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dza"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Tunzu"@dza; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "tunzu"@dza .
<http://publications.europa.eu/resource/authority/language/DZD> ccmm_props:ISO_639_3 "dzd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dzd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Daza"@dzd; skos:definition "Daza or (in Hausa) Dazawa is listed by Blench (2006) as a Chadic language within the Bole group, spoken in a few villages of Darazo LGA, Bauchi State, Nigeria. It was confirmed to exist in 2021. The language is nearly extinct with only elderly speakers speaking the language. Native speakers have shifted to Hausa."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Daza"@en .
<http://publications.europa.eu/resource/authority/language/DZE> ccmm_props:ISO_639_3 "dze"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dze"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Djiwarli"@dze, "Jiwarli"@en; skos:definition "Djiwarli, also known as Jiwarli, is a Mantharta language spoken in the Pilbara region of Western Australia. It is closely related to Thiin (iin). Together with other Mantharta languages it belongs to the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Djiwarli"@en .
<http://publications.europa.eu/resource/authority/language/DZG> ccmm_props:ISO_639_3 "dzg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dzg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Daza"@dzg; skos:definition "Dazaga (also known as Daza) belongs to the Saharan primary branch of the putative Nilo-Saharan language family. It is spoken by the Daza people in northern Chad and eastern Niger. Within the Saharan branch – which also includes the Kanuri, Kanembu, and Tebu languages – Dazaga is classified as part of the Western Saharan subgroup. The constituent families of Nilo-Saharan are quite diverse. One characteristic feature is a tripartite singulative-collective-plurative number system."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Dazaga"@en .

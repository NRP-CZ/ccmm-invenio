<http://publications.europa.eu/resource/authority/language/MLT> ccmm_props:ISO_639_1 "mt"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "mlt"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "mlt"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "mlt"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mt"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:definition "Maltese is a Semitic language, historically a dialect of Arabic, spoken in Malta. About half of the vocabulary is derived from standard Italian and Sicilian; English words also make up an important part of the Maltese vocabulary.It is the only Semitic language written in the Latin script in its standard form."@en, "Le maltais est une langue sémitique, historiquement un dialecte de l’arabe, parlé à Malte. Environ la moitié du vocabulaire est dérivé de l’italien standard et de Sicile; les mots anglais constituent également une partie importante du vocabulaire maltais.Il est la seule langue sémitique écrite en alphabet latin dans sa forme standard."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "малтийски"@bg, "maltština"@cs, "maltesisk"@da, "Maltesisch"@de, "μαλτέζικα"@el, "Maltese"@en, "maltés"@es, "malta keel"@et, "malta"@fi, "maltais"@fr, "Máltais"@ga, "malteški"@hr, "maltašćina"@hsb, "máltai"@hu, "maltneska"@is, "maltese"@it, "maltiečių kalba"@lt, "maltiešu valoda"@lv, "малтешки"@mk, "Malti"@mt, "Maltees"@nl, "maltesisk"@no, "maltański"@pl, "maltês"@pt, "malteză"@ro, "мальтийский"@ru, "malteški"@sh, "maltčina"@sk, "malteščina"@sl, "малтешки"@sr, "maltesiska"@sv, "maltaca"@tr, "мальтійська мова"@uk .

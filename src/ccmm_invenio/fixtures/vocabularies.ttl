<https://nma.eosc.cz/vocabularies/languages/rma> ccmm_props:ISO_639_3 "rma"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rma"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Rama"@rma; skos:exactMatch <http://publications.europa.eu/resource/authority/language/RMA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "rama"@rma .
<https://nma.eosc.cz/vocabularies/languages/rmb> ccmm_props:ISO_639_3 "rmb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rmb"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Rembarrnga"@rmb; skos:definition "Rembarrnga is an endangered Australian Aboriginal language spoken in the Roper River region of the Northern Territory. The children of Rembarrnga speakers are now learning neighbouring languages such as Kriol in south central Arnhem Land, and Kunwinjku. It is one of the Northern Non-Pama–Nyungan languages, and closely related to to Ngalakgan (NIG). Both are classified within the Gunwinyguan language family."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/RMB>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Rembarrnga"@en .

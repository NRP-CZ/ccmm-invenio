<https://nma.eosc.cz/vocabularies/languages/nbr> ccmm_props:ISO_639_3 "nbr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nbr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Gbantu"@nbr, "Janda"@nbr, "Numana"@nbr, "Numbu"@nbr, "Ningye"@nns; skos:definition "Numana is a Plateau language of Nigeria. It is a dialect cluster comprising the main dialects Gbantu, Janda, Numbu and Ningye. Numana is classified within the Volta-Congo primary branch of the Atlantic–Congo lineage, the largest demonstrated language family in Africa. Like related Bantu and Bantoid languages, Numana has a noun class system, a characteristic feature of languages belonging to this lineage."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/NBR>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Numana"@en .
<https://nma.eosc.cz/vocabularies/languages/nbs> ccmm_props:ISO_639_3 "nbs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nbs"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Namibian Sign Language"@nbs; skos:definition "Namibian Sign Language is a sign language used in Namibia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/NBS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Намибия"@bg, "namibijský znakový jazyk"@cs, "namibisk tegnsprog"@da, "Namibische Gebärdensprache"@de, "ναμιμπιανή νοηματική γλώσσα"@el, "Namibian Sign Language"@en, "lengua de signos de Namibia"@es, "namiibia viipekeel"@et, "namibialainen viittomakieli"@fi, "langue des signes namibienne"@fr, "Teanga Chomharthaíochta na Namaibe"@ga, "namibijski znakovni jezik"@hr, "namíbiai jelnyelv"@hu, "lingua dei segni della Namibia"@it, "namibiečių gestų kalba"@lt, "namībiešu zīmju valoda"@lv, "Lingwa tas-Sinjali Namibjana"@mt, "Namibische Gebarentaal"@nl, "namibiański język migowy"@pl, "língua gestual namibiana"@pt, "limbajul prin semne din Namibia"@ro, "namíbijský posunkový jazyk"@sk, "namibijski znakovni jezik"@sl, "namibiskt teckenspråk"@sv .

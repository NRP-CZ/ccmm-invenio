<http://publications.europa.eu/resource/authority/language/NDE> ccmm_props:ISO_639_1 "nd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "nde"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "nde"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "nde"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "isiNdebele"@en, "sindebele"@fr, "isiNdebele"@nd, "isiNdebele saseNyakatho"@nd; skos:definition "North Ndebele is the language spoken by the Zimbabwe Ndebele, also known as Matabele, in the Matabeleland region around the city of Bulawayo. It's a Bantu language of the Nguni group, closely related to Zulu. The Ndebele people of Zimbabwe are descendants of the followers of the Zulu military leader Mzilikazi, who left his home region in the early 19th century. North Ndebele is one of Zimbabwe‘s 16 official languages."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "севернондебелейски език"@bg, "severní ndebelština"@cs, "nord-ndebele"@da, "Nord-Ndebele"@de, "ντέμπελε του βορρά"@el, "North Ndebele"@en, "ndebele septentrional"@es, "ndebele"@et, "pohjois-ndebele"@fi, "ndébélé du Nord"@fr, "N-deibéilis an Tuaiscirt"@ga, "sjeverni ndebele"@hr, "északi ndebele"@hu, "ndebele del Nord"@it, "šiaurės ndebelių"@lt, "sindebele"@lv, "Ndebele tat-Tramuntana"@mt, "Noord-Ndebele"@nl, "ndebele północny"@pl, "sindebele"@pt, "Ndebele de nord"@ro, "severná ndebelčina"@sk, "severna ndebelščina"@sl, "nordndebele"@sv .

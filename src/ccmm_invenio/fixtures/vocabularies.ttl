<https://nma.eosc.cz/vocabularies/languages/lat> ccmm_props:ISO_639_1 "la"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "lat"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "lat"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "lat"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "la"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Latina"@la; skos:definition "Latin is an extinct Indo-European language which was spoken in the ancient city of Rome and its empire. Modern Romance languages are continuations of dialectal forms (vulgar Latin) of the language.Additionally many students, scholars, and some members of the Christian clergy speak it fluently, and it is still taught in some educational institutions around the world. Latin is still used in the creation of new words in modern languages of many different families, and largely in biological taxonomy."@en, "Le latin est une langue indo-européenne, souvent considérée comme une langue morte, qui a été parlée dans la Rome antique et son empire. Les langues romanes modernes sont des continuations des formes dialectales (latin vulgaire) de la langue.De nombreux étudiants, des chercheurs et des membres du clergé chrétien parlent encore couramment le latin, et il est toujours enseigné dans certains établissements d’enseignement à travers le monde. Le latin est encore utilisé dans la création de nouveaux mots dans les langues modernes de nombreuses familles, en particulier dans la taxonomie biologique."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/LAT>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "латински"@bg, "latina"@cs, "latin"@da, "Latein"@de, "λατινικά"@el, "Latin"@en, "latín"@es, "ladina keel"@et, "latina"@fi, "latin"@fr, "Laidin"@ga, "latinski"@hr, "latinščina"@hsb, "latin"@hu, "latína"@is, "latino"@it, "lotynų kalba"@lt, "latīņu valoda"@lv, "латински"@mk, "Latin"@mt, "Latijn"@nl, "latin"@no, "łacina"@pl, "latim"@pt, "latină"@ro, "латинский"@ru, "latinski"@sh, "latinčina"@sk, "latinščina"@sl, "латински"@sr, "latin"@sv, "latince"@tr, "латинська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/lau> ccmm_props:ISO_639_3 "lau"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lau"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Laba"@lau; skos:exactMatch <http://publications.europa.eu/resource/authority/language/LAU>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "laba"@lau .
<https://nma.eosc.cz/vocabularies/languages/lav> ccmm_props:ISO_639_1 "lv"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "lav"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "lav"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "lav"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lv"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "lette"@fr, "Letlands"@nl; skos:definition "Latvian is one of the two living members of the Baltic languages, the other being Lithuanian. It is the official language of Latvia.Latvian is more innovative, especially in morphology than Lithuanian."@en, "Le letton ou lette est l’un des deux membres vivants des langues baltes, l’autre étant le lituanien. C’est la langue officielle de la Lettonie.Le letton est plus novateur, en particulier dans la morphologie, que le lituanien."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/LAV>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "латвийски"@bg, "lotyština"@cs, "lettisk"@da, "Lettisch"@de, "λετονικά"@el, "Latvian"@en, "letón"@es, "läti keel"@et, "latvia"@fi, "letton"@fr, "Laitvis"@ga, "latvijski"@hr, "letišćina"@hsb, "lett"@hu, "lettneska"@is, "lettone"@it, "latvių kalba"@lt, "latviešu valoda"@lv, "латвиски"@mk, "Latvjan"@mt, "Lets"@nl, "latvisk"@no, "łotewski"@pl, "letão"@pt, "letonă"@ro, "латышский"@ru, "letonski"@sh, "lotyština"@sk, "latvijščina"@sl, "летонски"@sr, "lettiska"@sv, "letonca"@tr, "латиська мова"@uk .

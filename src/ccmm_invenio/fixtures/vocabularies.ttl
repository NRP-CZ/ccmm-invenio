<http://publications.europa.eu/resource/authority/language/MDL> ccmm_props:ISO_639_3 "mdl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mdl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Maltese Sign Language"@mdl; skos:definition "Maltese Sign Language is a sign language used in Malta. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "малтийски жестомимичен език"@bg, "maltský znakový jazyk"@cs, "maltesisk tegnsprog"@da, "Maltesische Gebärdensprache"@de, "μαλτεζική νοηματική γλώσσα"@el, "Maltese Sign Language"@en, "lengua de signos maltesa"@es, "malta viipekeel"@et, "maltalainen viittomakieli"@fi, "langue des signes maltaise"@fr, "Teanga Chomharthaíochta Mhálta"@ga, "malteški znakovni jezik"@hr, "máltai jelnyelv"@hu, "lingua dei segni maltese"@it, "maltiečių gestų kalba"@lt, "maltiešu zīmju valoda"@lv, "Lingwa tas-Sinjali Maltija"@mt, "Maltese Gebarentaal"@nl, "maltański język migowy"@pl, "língua gestual maltesa"@pt, "limbajul prin semne din Malta"@ro, "maltský posunkový jazyk"@sk, "malteški znakovni jezik"@sl, "maltesiskt teckenspråk"@sv .

<https://nma.eosc.cz/vocabularies/languages/rms> ccmm_props:ISO_639_3 "rms"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rms"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Romanian Sign Language"@rms; skos:definition "Romanian Sign Language is a sign language used in Romania. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/RMS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "румънски жестомимичен език"@bg, "rumunský znakový jazyk"@cs, "rumænsk tegnsprog"@da, "Rumänische Gebärdensprache"@de, "ρουμανική νοηματική γλώσσα"@el, "Romanian Sign Language"@en, "lengua de signos rumana"@es, "rumeenia viipekeel"@et, "romanialainen viittomakieli"@fi, "langue des signes roumaine"@fr, "Teanga Chomharthaíochta na Rómáine"@ga, "rumunjski znakovni jezik"@hr, "román jelnyelv"@hu, "lingua dei segni rumena"@it, "rumunų gestų kalba"@lt, "rumāņu zīmju valoda"@lv, "Lingwa tas-Sinjali Rumena"@mt, "Roemeense Gebarentaal"@nl, "rumuński język migowy"@pl, "língua gestual romena"@pt, "limbajul prin semne din România"@ro, "rumunský posunkový jazyk"@sk, "romunski znakovni jezik"@sl, "rumänskt teckenspråk"@sv .

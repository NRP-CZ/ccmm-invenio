<https://nma.eosc.cz/vocabularies/languages/mpa> ccmm_props:ISO_639_3 "mpa"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mpa"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Mpoto"@mpa; skos:exactMatch <http://publications.europa.eu/resource/authority/language/MPA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "mpoto"@mpa .
<https://nma.eosc.cz/vocabularies/languages/mpb> ccmm_props:ISO_639_3 "mpb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mpb"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Mullukmulluk"@en, "Malak Malak"@mpb; skos:definition "Malak Malak, also known as Mullukmulluk, is a moribund Australian Aboriginal language traditionally spoken on the northern side of the Daly River in the Northern Territory. By 2002 it was estimated to have less than 10 speakers. Malak Malak is related to Kuwema, or Tyaraity. They were formerly classified as independent members of the Northern Daly languages, but are now considered a language isolate."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/MPB>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Malak Malak"@en .
<https://nma.eosc.cz/vocabularies/languages/mpc> ccmm_props:ISO_639_3 "mpc"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mpc"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Mangarrayi"@mpc; skos:definition "Mangarrayi is an endangered Australian Aboriginal language spoken in the Northern Territory. It has been tentatively classified within the small Mangarrayi-Maran language family, which in turn has been grouped within the proposed Arnhem, or Macro-Gunwinyguan family, the second-largest Australian language family after Pama–Nyungan, though this higher-level classification is not universally accepted."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/MPC>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Mangarrayi"@en .
<https://nma.eosc.cz/vocabularies/languages/mpd> ccmm_props:ISO_639_3 "mpd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mpd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Manitenére"@en, "Machinere"@mpd; skos:definition "Machinere is an Arawakan indigenous language. It is one of the official languages of Bolivia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/MPD>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "мачинере"@bg, "mašinerština"@cs, "machinere"@da, "Machinere"@de, "μασινέρε"@el, "Machinere"@en, "machinere"@es, "machinere"@et, "machinere"@fi, "machinere"@fr, "Meaitsineiris"@ga, "machinere"@hr, "machinere"@hu, "machineri"@it, "mačinerių"@lt, "machinere"@lv, "Machinere"@mt, "Machinere"@nl, "machineri"@pl, "machinere"@pt, "machinere"@ro, "mašinerčina"@sk, "mačineri"@sl, "machineri"@sv, "мачинере"@uk .

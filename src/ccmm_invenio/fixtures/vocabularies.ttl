<http://publications.europa.eu/resource/authority/language/XRU> ccmm_props:ISO_639_3 "xru"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xru"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Marriammu"@xru; skos:definition "Marriammu is an endangered Australian Aboriginal language traditionally spoken in the Daly River area of the Northern Territory. It belongs to the small family of Western Daly languages, and more specifically to its Marithielic sub-branch."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Marriammu"@en .

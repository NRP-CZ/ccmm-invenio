<https://nma.eosc.cz/vocabularies/languages/tup> ccmm_props:ISO_639_2B "tup"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "tup"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:XML_LNG "tup"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:exactMatch <http://publications.europa.eu/resource/authority/language/TUP>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Tupi languages"@en .
<https://nma.eosc.cz/vocabularies/languages/tuq> ccmm_props:ISO_639_3 "tuq"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "tuq"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Teda"@en, "Tedaga"@tuq; skos:definition "Tedaqa (also known as Teda) belongs to the Saharan primary branch of the disputed Nilo-Saharan language family. It is spoken by the Teda, a northern subgroup of the Toubou people, in Libya, Chad and eastern Niger. Within the Saharan branch – which also includes the Kanuri, Kanembu, and Tebu languages – Tedaqa is classified as part of the Western Saharan subgroup. The constituent families of the putative Nilo-Saharan family are quite diverse, but one characteristic feature is a tripartite singulative-collective-plurative number system."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/TUQ>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Tedaga"@en .
<https://nma.eosc.cz/vocabularies/languages/tur> ccmm_props:ISO_639_1 "tr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "tur"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "tur"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "tur"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "tr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Türkçe"@tr; skos:definition "Turkish is the most widely spoken of the Turkic languages in south-eastern Europe and western Asia. It is closely related to Azeri and Turkmen.In 1928, as one of Atatürk’s Reforms, the Arabic script was replaced with a Latin alphabet."@en, "Le turc est la plus parlée des langues turques en Europe du Sud et en Asie occidentale. Il est très proche de l’azéri et du turkmène.En 1928, l’une des réformes d’Atatürk fut de remplacer l’écriture arabe par l’alphabet latin."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/TUR>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "турски"@bg, "turečtina"@cs, "tyrkisk"@da, "Türkisch"@de, "τουρκικά"@el, "Turkish"@en, "turco"@es, "türgi keel"@et, "turkki"@fi, "turc"@fr, "Tuircis"@ga, "turski"@hr, "turkowšćina"@hsb, "török"@hu, "tyrkneska"@is, "turco"@it, "turkų kalba"@lt, "turku valoda"@lv, "турски"@mk, "Tork"@mt, "Turks"@nl, "tyrkisk"@no, "turecki"@pl, "turco"@pt, "turcă"@ro, "турецкий"@ru, "turski"@sh, "turečtina"@sk, "turščina"@sl, "турски"@sr, "turkiska"@sv, "türkçe"@tr, "турецька мова"@uk .

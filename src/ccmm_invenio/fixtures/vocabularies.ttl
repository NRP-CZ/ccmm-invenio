<http://publications.europa.eu/resource/authority/language/IHW> ccmm_props:ISO_639_3 "ihw"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ihw"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Bidawal"@en, "mŭk-dhang"@ihw; skos:definition "Bidhawal was an Australian Aboriginal language, either a dialect of or closely related to the Kurnai language. The Bidawal called their own dialect mŭk-dhang (‘good speech’), and that of the neighbouring Kurnai gūnggala-dhang 'strangers' language'. Both languages are classified within the Ganaic branch of the Pama-Nyungan languages, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Bidhawal"@en .
<http://publications.europa.eu/resource/authority/language/III> ccmm_props:ISO_639_1 "ii"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "iii"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "iii"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "iii"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ii"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Sichuan Yi"@ii; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "sichuan Yi"@ii .
<http://publications.europa.eu/resource/authority/language/IIN> ccmm_props:ISO_639_3 "iin"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "iin"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Thiin"@iin; skos:definition "Thiin is a nearly extinct Mantharta language of the Pilbara region in Western Australia. It is closely related to Djiwarli (dze). Together with other Mantharta languages it belongs to the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Thiin"@en .

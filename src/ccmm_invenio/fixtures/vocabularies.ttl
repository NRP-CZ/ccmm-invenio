<http://publications.europa.eu/resource/authority/language/MZG> ccmm_props:ISO_639_3 "mzg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mzg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Monastic Sign Language"@mzg; skos:definition "Monastic Sign Language is a sign language used by Christian monks, mainly in Europe. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "монашески жестомимичен език"@bg, "mnišský znakový jazyk"@cs, "klostertegnsprog"@da, "Mönchische Gebärdensprachen"@de, "μοναστηριακή νοηματική γλώσσα"@el, "Monastic Sign Language"@en, "lengua de signos monacal"@es, "munkade viipekeel"@et, "munkkien viittomakieli"@fi, "langue des signes monastique"@fr, "Teanga Chomharthaíochta Mhainistreach"@ga, "samostanski znakovni jezik"@hr, "szerzetesi jelnyelv"@hu, "lingua dei segni monastica"@it, "vienuolių gestų kalba"@lt, "mūku zīmju valoda"@lv, "Lingwa tas-Sinjali Monastika"@mt, "Monastieke Gebarentaal"@nl, "monastyczny język migowy"@pl, "linguagens gestuadas monásticas"@pt, "limbajul prin semne monastic"@ro, "posunkový jazyk Monastic"@sk, "samostanski znakovni jezik"@sl, "klosterteckenspråk"@sv, "монастирські жестові мови"@uk .

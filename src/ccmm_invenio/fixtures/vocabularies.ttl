<https://nma.eosc.cz/vocabularies/languages/hsb> ccmm_props:ISO_639_2B "hsb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "hsb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "hsb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hsb"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Alto sorabo"@it, "Alto sórbio"@pt, "Sorabă superioară"@ro; skos:definition "Upper Sorbian is a minority language spoken by Sorbs in Germany in the historical province of Upper Lusatia, which is today part of Saxony. It is grouped in the West Slavic language branch."@en, "Le haut-sorabe est une langue parlée en Allemagne, dans la province historique de Lusace, aujourd’hui en Saxe. Il appartient à la famille occidentale des langues slaves."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/HSB>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "горнолужишки"@bg, "hornolužická srbština"@cs, "øvresorbisk"@da, "Obersorbisch"@de, "άνω Σορβικά"@el, "Upper Sorbian"@en, "alto sorabo"@es, "ülemsorbi"@et, "yläsorbi"@fi, "haut-sorabe"@fr, "Soirbis Uachtarach"@ga, "gornjolužičkosrpski"@hr, "hornjoserbšćina"@hsb, "felsőszorb"@hu, "sorabo superiore"@it, "aukštutinių sorbų kalba"@lt, "augšsorbu valoda"@lv, "Sorbjan ta’ Fuq"@mt, "Oppersorbisch"@nl, "górnołużycki"@pl, "alto sorábio"@pt, "sorabă de sus"@ro, "hornolužická"@sk, "gornjelužiška srbščina"@sl, "högsorbiska"@sv, "верхньолужицька мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/hsh> ccmm_props:ISO_639_3 "hsh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hsh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Hungarian Sign Language"@hsh; skos:definition "Hungarian Sign Language is a sign language used in Hungary. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/HSH>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "унгарски жестомимичен език"@bg, "maďarský znakový jazyk"@cs, "ungarsk tegnsprog"@da, "Ungarische Gebärdensprache"@de, "ουγγρική νοηματική γλώσσα"@el, "Hungarian Sign Language"@en, "lengua de signos húngara"@es, "ungari viipekeel"@et, "unkarilainen viittomakieli"@fi, "langue des signes hongroise"@fr, "Teanga Chomharthaíochta na hUngáire"@ga, "mađarski znakovni jezik"@hr, "magyar jelnyelv"@hu, "lingua dei segni ungherese"@it, "vengrų gestų kalba"@lt, "ungāru zīmju valoda"@lv, "Lingwa tas-Sinjali Ungeriża"@mt, "Hongaarse Gebarentaal"@nl, "węgierski język migowy"@pl, "língua gestual húngara"@pt, "limbajul prin semne din Ungaria"@ro, "венгерский жестовый язык"@ru, "maďarský posunkový jazyk"@sk, "madžarski znakovni jezik"@sl, "ungerskt teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/hsl> ccmm_props:ISO_639_3 "hsl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hsl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Hausa Sign Language"@hsl; skos:definition "Hausa Sign Language is a sign language used in Kano city in Nigeria. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/HSL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език Хауса"@bg, "hauský znakový jazyk"@cs, "hausa tegnsprog"@da, "Hausa-Gebärdensprache"@de, "νοηματική γλώσσα Χαούσα"@el, "Hausa Sign Language"@en, "lengua de signos hausa"@es, "hausa viipekeel"@et, "hausalainen viittomakieli"@fi, "langue des signes haoussa"@fr, "Teanga Chomharthaíochta na Hásaise"@ga, "hausa znakovni jezik"@hr, "hausza jelnyelv"@hu, "lingua dei segni Hausa"@it, "hausų gestų kalba"@lt, "hausu zīmju valoda"@lv, "Lingwa tas-Sinjali tal-Hausa"@mt, "Hausa-gebarentaal"@nl, "język migowy hausa"@pl, "língua gestual hauçá"@pt, "limbajul prin semne Hausa"@ro, "posunkový jazyk Hausa"@sk, "hausa znakovni jezik"@sl, "hausa-teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/hsn> ccmm_props:ISO_639_3 "hsn"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hsn"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Hsiang Chinese"@en, "Xiāng Yǔ"@hsn, "湘语"@hsn; skos:definition "Xiang or Hsiang also known as Hunanese, is a group of linguistically similar and historically related Sinitic languages, spoken mainly in Hunan province but also in northern Guangxi and parts of neighboring Guizhou, Guangdong, Sichuan, Jiangxi and Hubei provinces."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/HSN>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "сян китайски"@bg, "chunanské dialekty čínštiny"@cs, "Xiang-kinesisk"@da, "Xiang-Chinesisch"@de, "Κινεζικά Ζιάνγκ"@el, "Xiang Chinese"@en, "chino xiang"@es, "Xiangi hiina"@et, "xiang-kiina"@fi, "chinois xiang"@fr, "Sínis Xiang"@ga, "xiang kineski"@hr, "hsziang kínai"@hu, "cinese xiang"@it, "Siango kinų"@lt, "Sjan ķīniešu valoda"@lv, "Ċiniż Xiang"@mt, "Xiang"@nl, "chiński xiang"@pl, "chinês de Hunão"@pt, "chineză Xiang"@ro, "siang čínština"@sk, "xiang kitajščina"@sl, "xiangkinesiska"@sv .

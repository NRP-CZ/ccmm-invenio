<https://nma.eosc.cz/vocabularies/languages/wra> ccmm_props:ISO_639_3 "wra"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "wra"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Warapu"@wra; skos:exactMatch <http://publications.europa.eu/resource/authority/language/WRA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Warapu"@en .
<https://nma.eosc.cz/vocabularies/languages/wrb> ccmm_props:ISO_639_3 "wrb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "wrb"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Warluwara"@en, "Waluwarra"@wrb; skos:definition "Warluwara, also known as Warluwara, is an extinct Australian Aboriginal language of Queensland. It had a developed signed form of their language. It is related to the Ngarru group of languages within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/WRB>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Waluwarra"@en .
<https://nma.eosc.cz/vocabularies/languages/wrd> ccmm_props:ISO_639_3 "wrd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "wrd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Warduji"@wrd; skos:exactMatch <http://publications.europa.eu/resource/authority/language/WRD>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Warduji"@en .
<https://nma.eosc.cz/vocabularies/languages/wrg> ccmm_props:ISO_639_3 "wrg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "wrg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Gudjal"@en, "Warungu"@wrg; skos:definition "Warungu, also known as Gudjal, is a dormant Australian Aboriginal language that was spoken by the Warungu people in the area around Townsville, Queensland. Its last native speaker was Alf Palmer, who died in 1981. One of the notable feature of the language is its syntactic ergativity. Warungu is closely related to Gugu Badhun (gdc), and both belong to the Maric group of languages within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/WRG>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Warungu"@en .
<https://nma.eosc.cz/vocabularies/languages/wrh> ccmm_props:ISO_639_3 "wrh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "wrh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Wiradjuri"@wrh; skos:definition "Wiradjuri is an endangered Australian Aboriginal language traditionally spoken by the Wiradjuri people of New South Wales. A revival is under way, with the language being taught in schools, TAFE college, and at Charles Sturt University. Wiradjuri is closely related to Wangaaybuwan-Ngiyambaa (wyb). Together, they form the Wiradhuric sub-group within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/WRH>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Wiradjuri"@en .
<https://nma.eosc.cz/vocabularies/languages/wri> ccmm_props:ISO_639_3 "wri"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "wri"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Wariyangga"@wri; skos:exactMatch <http://publications.europa.eu/resource/authority/language/WRI>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "wariyangga"@wri .
<https://nma.eosc.cz/vocabularies/languages/wrk> ccmm_props:ISO_639_3 "wrk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "wrk"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Karawa"@en, "Garrwa"@wrk; skos:definition "Garrwa, also spelt Karawa, is an endangered Australian Aboriginal language spoken by the Garrwa people in the Northern Territory, whose traditional lands extended from east of the McArthur River at Borroloola to Doomadgee and the Nicholson River in Queensland. Together with the closely related Wanyi language, Garrwa and Wanyi are not currently classified within any larger Aboriginal language family; instead they form their own Garrwan language family."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/WRK>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Garrwa"@en .

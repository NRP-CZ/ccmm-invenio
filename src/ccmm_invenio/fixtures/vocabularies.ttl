<https://nma.eosc.cz/vocabularies/languages/bqy> ccmm_props:ISO_639_3 "bqy"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "bqy"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Bengkala Sign Language"@bqy; skos:definition "Bengkala Sign Language is a sign language used in Bengkala and Kata Kolok villages in Bali. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/BQY>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "балийски жестомимичен език"@bg, "bengkalský znakový jazyk"@cs, "Bengkala-tegnsprog"@da, "Benkala-Gebärdensprache"@de, "νοηματική γλώσσα του Bengkala"@el, "Bengkala Sign Language"@en, "lengua de signos bengalí"@es, "bengkala viipekeel"@et, "bengkalalainen viittomakieli"@fi, "langue des signes de Bengkala"@fr, "Teanga Chomharthaíochta Bengkala"@ga, "bengkalski znakovni jezik"@hr, "bengkalai jelnyelv"@hu, "lingua dei segni di Bengkala"@it, "Benkulu gestų kalba"@lt, "Bengkalas zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Bengkala"@mt, "Bengkala-gebarentaal"@nl, "język migowy Bengkala"@pl, "língua gestual de Báli"@pt, "limbajul prin semne Bengkala"@ro, "балийский жестовый язык"@ru, "bengkalský posunkový jazyk"@sk, "benkala znakovni jezik"@sl, "Bengkala-teckenspråk"@sv .

<https://nma.eosc.cz/vocabularies/languages/spa> ccmm_props:ISO_639_1 "es"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "spa"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "spa"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "spa"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "es"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "castillan"@fr; skos:definition "Spanish is a member of the Romance language family. It is spoken in Spain and in the continents of North and South America.Spanish is second after Mandarin in terms of its number of native speakers worldwide. From the last decades of the 20th century, the study of Spanish as a foreign language has grown significantly."@en, "L’espagnol fait partie de la famille des langues romanes. Il est parlé en Espagne et en Amérique du Nord et du Sud.L’espagnol est la deuxième langue après le mandarin en termes de nombre de locuteurs natifs dans le monde entier. Depuis les dernières décennies du XXe siècle, l’étude de l’espagnol comme langue étrangère a augmenté de façon significative."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SPA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "испански"@bg, "španělština"@cs, "spansk"@da, "Spanisch"@de, "ισπανικά"@el, "Spanish"@en, "español"@es, "hispaania keel"@et, "espanja"@fi, "espagnol"@fr, "Spáinnis"@ga, "španjolski"@hr, "španišćina"@hsb, "spanyol"@hu, "spænska"@is, "spagnolo"@it, "ispanų kalba"@lt, "spāņu valoda"@lv, "шпански"@mk, "Spanjol"@mt, "Spaans"@nl, "spansk"@no, "hiszpański"@pl, "espanhol"@pt, "spaniolă"@ro, "испанский"@ru, "španski"@sh, "španielčina"@sk, "španščina"@sl, "шпански"@sr, "spanska"@sv, "ıspanyolca"@tr, "іспанська мова"@uk .

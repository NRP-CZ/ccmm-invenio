<http://publications.europa.eu/resource/authority/language/BZS> ccmm_props:ISO_639_3 "bzs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "bzs"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Brazilian Sign Language"@bzs; skos:definition "Brazilian Sign Language is a sign language used in Brazil. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "бразилски жестомимичен език"@bg, "brazilský znakový jazyk"@cs, "brasiliansk tegnsprog"@da, "Brasilianische Gebärdensprache"@de, "βραζιλιάνικη νοηματική γλώσσα"@el, "Brazilian Sign Language"@en, "lengua de signos brasileña"@es, "brasiilia viipekeel"@et, "brasilialainen viittomakieli"@fi, "langue des signes brésilienne"@fr, "Teanga Chomharthaíochta na Brasaíle"@ga, "brazilski znakovni jezik"@hr, "brazil jelnyelv"@hu, "lingua dei segni brasiliana"@it, "brazilų gestų kalba"@lt, "brazīliešu zīmju valoda"@lv, "Lingwa tas-Sinjali Brażiljana"@mt, "Braziliaanse Gebarentaal"@nl, "brasiliansk tegnspråk"@no, "brazylijski język migowy"@pl, "língua brasileira de sinais"@pt, "limbajul prin semne din Brazilia"@ro, "brazílsky posunkový jazyk"@sk, "brazilski znakovni jezik"@sl, "brasilianskt teckenspråk"@sv .

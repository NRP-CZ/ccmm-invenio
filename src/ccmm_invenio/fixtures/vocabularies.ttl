<http://publications.europa.eu/resource/authority/language/NUF> ccmm_props:ISO_639_3 "nuf"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nuf"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nusu"@nuf; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "nusu"@nuf .
<http://publications.europa.eu/resource/authority/language/NUG> ccmm_props:ISO_639_3 "nug"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nug"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Yilngali"@en, "Nungali"@nug; skos:definition "Nungali, or Yilngali, is an Australian Aboriginal language within the Yirram sub-branch, which is believed to be extinct. It was spoken in the Northern Territory of Australia, around the upper Daly River. Nungali is not related to the Pama-Nyungan language family that spans the majority of Australia; however, it is a relative of Djamindjung. Both belong to the Mirndi language family."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Nungali"@en .
<http://publications.europa.eu/resource/authority/language/NUH> ccmm_props:ISO_639_3 "nuh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nuh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Ndunda"@nuh; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "ndunda"@nuh .
<http://publications.europa.eu/resource/authority/language/NUI> ccmm_props:ISO_639_3 "nui"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nui"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Kombe"@en, "Ngumbi"@nui; skos:definition "Ngumbi is a Southern Bantoid language spoken in Cameroon and Equatorial Guinea. Together with other Bengaic languages (BNM, BNG, NUI) and Dualaic languages (DUA, MZD, KME, ISU, OLB), it belongs to the Sawabantu group, which is classified within the Volta-Congo primary branch. Like other Bantu languages, Ngumbi has a noun class system, a characteristic feature of languages belonging to the Atlantic–Congo lineage, the largest demonstrated language family in Africa."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Ngumbi"@en .

<https://nma.eosc.cz/vocabularies/languages/csc> ccmm_props:ISO_639_3 "csc"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "csc"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Catalan Sign Language"@csc; skos:definition "Catalan Sign Language is a sign language used in Catalonia and Valencia communities in Spain. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CSC>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "каталонски жестомимичен език"@bg, "llengua de signes catalana"@ca, "katalánský znakový jazyk"@cs, "catalansk tegnsprog"@da, "Katalanische Gebärdensprache"@de, "καταλανική νοηματική γλώσσα"@el, "Catalan Sign Language"@en, "lengua de signos catalana"@es, "katalaani viipekeel"@et, "katalonialainen viittomakieli"@fi, "langue des signes catalane"@fr, "Teanga Chomharthaíochta na Catalóine"@ga, "katalonski znakovni jezik"@hr, "katalán jelnyelv"@hu, "lingua dei segni catalana"@it, "katalonų gestų kalba"@lt, "katalāņu zīmju valoda"@lv, "Lingwa tas-Sinjali Katalana"@mt, "Catalaanse Gebarentaal"@nl, "kataloński język migowy"@pl, "língua gestual catalã"@pt, "limbajul prin semne catalan"@ro, "katalánsky posunkový jazyk"@sk, "katalonski znakovni jezik"@sl, "katalanskt teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/csd> ccmm_props:ISO_639_3 "csd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "csd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Chiangmai Sign Language"@csd; skos:definition "Chiangmai Sign Language is a sign language used in Chiang Mai city in Thailand. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CSD>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "чиангмайски жестомимичен език"@bg, "chiangmaiský znakový jazyk"@cs, "Chiangmai-tegnsprog"@da, "Chiangmai-Gebärdensprache"@de, "νοηματική γλώσσα του Chiangmai"@el, "Chiangmai Sign Language"@en, "lengua de signos de Chiangmai"@es, "chiangmai viipekeel"@et, "chiangmailainen viittomakieli"@fi, "langue des signes de Chiang Mai"@fr, "Teanga Chomharthaíochta Chiangmai"@ga, "čiangmajski znakovni jezik"@hr, "csiangmaji jelnyelv"@hu, "lingua dei segni di Chiang Mai"@it, "Čiang Majaus gestų kalba"@lt, "čhīanmai zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Chiangmai"@mt, "Chiangmai-gebarentaal"@nl, "język migowy Ching Mai"@pl, "língua gestual de Chiang Mai"@pt, "limbajul prin semne Chiangmai"@ro, "chiangmaiský posunkový jazyk"@sk, "chiangmai znakovni jezik"@sl, "Chiang Mai-teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/cse> ccmm_props:ISO_639_3 "cse"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "cse"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Czech Sign Language"@cse; skos:definition "Czech Sign Language is a sign language used in the Czech Republic. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CSE>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "чешки жестомимичен език"@bg, "český znakový jazyk"@cs, "tjekkisk tegnsprog"@da, "Tschechische Gebärdensprache"@de, "τσεχική νοηματική γλώσσα"@el, "Czech Sign Language"@en, "lengua de signos checa"@es, "tšehhi viipekeel"@et, "tšekkiläinen viittomakieli"@fi, "langue des signes tchèque"@fr, "Teanga Chomharthaíochta na Seice"@ga, "češki znakovni jezik"@hr, "cseh jelnyelv"@hu, "lingua dei segni ceca"@it, "čekų gestų kalba"@lt, "čehu zīmju valoda"@lv, "Lingwa tas-Sinjali Ċeka"@mt, "Tsjechische Gebarentaal"@nl, "czeski język migowy"@pl, "língua gestual checa"@pt, "limbajul prin semne din Cehia"@ro, "český posunkový jazyk"@sk, "češki znakovni jezik"@sl, "tjeckiskt teckenspråk"@sv .

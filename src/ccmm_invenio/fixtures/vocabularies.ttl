<https://nma.eosc.cz/vocabularies/languages/yid> ccmm_props:ISO_639_1 "yi"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "yid"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "yid"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "yid"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "yi"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "yidish"@yi, "ייִדיש"@yi; skos:definition "Yiddish is a Germanic language, the historical language of the Ashkenazi Jews in central and east Europe.Yiddish is traditionally written in a fully vocalised variety of Hebrew script. A transliteration into the Latin alphabet is quite often used."@en, "Le yiddish est une langue germanique, la langue historique des Juifs ashkénazes d’Europe centrale et orientale.Il est traditionnellement écrit dans une variante entièrement vocalisée de l’écriture hébraïque. Une transcription en alphabet latin est très souvent utilisée."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/YID>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "идиш"@bg, "jidiš"@cs, "jiddisch"@da, "Jiddisch"@de, "γίντις"@el, "Yiddish"@en, "yidis"@es, "jidiši keel"@et, "jiddiš"@fi, "yiddish"@fr, "Giúdais"@ga, "jidiš"@hr, "jidiš"@hsb, "jiddis"@hu, "jiddíska"@is, "yiddish"@it, "jidiš kalba"@lt, "jidišs"@lv, "Јидиш"@mk, "Jiddixx"@mt, "Jiddisch"@nl, "jiddisk"@no, "jidysz"@pl, "yiddish"@pt, "idiş"@ro, "и́диш"@ru, "jidiš"@sk, "jidiš"@sl, "Јидиш"@sr, "jiddisch"@sv, "yidiş"@tr, "їдиш"@uk .

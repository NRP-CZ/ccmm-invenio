<http://publications.europa.eu/resource/authority/language/LST> ccmm_props:ISO_639_3 "lst"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lst"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Trinidad and Tobago Sign Language"@lst; skos:definition "Trinidad and Tobago Sign Language is a sign language used in Trinidad and Tobago. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език на Тринидад и Тобаго"@bg, "znakový jazyk Trinidadu a Tobaga"@cs, "Trinidad og Tobago tegnsprog"@da, "Trinidadadische Gebärdensprache"@de, "νοηματική γλώσσα Τρίνινταντ και Τομπέιγκο"@el, "Trinidad and Tobago Sign Language"@en, "lengua de signos de Trinidad y Tobago"@es, "trinidad ja tobago viipekeel"@et, "trinidadtobagolainen viittomakieli"@fi, "langue des signes trinidadienne"@fr, "Teanga Chomharthaíochta Oileán na Tríonóide agus Thobága"@ga, "znakovni jezik Trinidada i Tobaga"@hr, "Trinidad és Tobagó-i jelnyelv"@hu, "lingua dei segni di Trinidad e Tobago"@it, "Trinidado ir Tobago gyventojų gestų kalba"@lt, "Trinidādas un Tobāgo zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Trinidad u Tobago"@mt, "Gebarentaal van Trinidad en Tobago"@nl, "język migowy Trynidadu i Tobago"@pl, "língua gestual trinitária"@pt, "limbajul prin semne din Trinidad și Tobago"@ro, "posunkový jazyk Trinidadu a Tobaga"@sk, "znakovni jezik Trinidad in Tobaga"@sl, "Trinidad och Tobago-teckenspråk"@sv .
<http://publications.europa.eu/resource/authority/language/LSV> ccmm_props:ISO_639_3 "lsv"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lsv"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Sivia Sign Language"@lsv; skos:definition "Sivia Sign Language is the deaf sign language of the Quechua town of Sivia in Peru. It is not related to Peruvian Sign Language."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Sivia Sign Language"@en .

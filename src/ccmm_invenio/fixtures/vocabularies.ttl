<http://publications.europa.eu/resource/authority/language/ZIB> ccmm_props:ISO_639_3 "zib"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "zib"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Zimbabwe Sign Language"@zib; skos:definition "Zimbabwe Sign Language is a sign language used in Zimbabwe. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Зимбабве"@bg, "zimbabwský znakový jazyk"@cs, "zimbabwisk tegnsprog"@da, "Simbabwische Gebärdensprache"@de, "ζιμπαμπουανή νοηματική γλώσσα"@el, "Zimbabwean Sign Language"@en, "lengua de signos de Zimbawe"@es, "zimbabwe viipekeel"@et, "zimbabwelainen viittomakieli"@fi, "langue des signes zimbabwéenne"@fr, "Teanga Chomharthaíochta na Siombáibe"@ga, "zimbabveanski znakovni jezik"@hr, "zimbabwei jelnyelv"@hu, "lingua dei segni dello Zimbabwe"@it, "zimbabviečių gestų kalba"@lt, "zimbabviešu zīmju valoda"@lv, "Lingwa tas-Sinjali taż-Żimbabwe"@mt, "Zimbabwaanse Gebarentaal"@nl, "zimbabweński język migowy"@pl, "língua gestual zimbabuense"@pt, "limbajul prin semne din Zimbabwe"@ro, "зимбабвийский жестовый язык"@ru, "zimbabwiansky posunkový jazyk"@sk, "zimbabvejski znakovni jezik"@sl, "zimbabwiskt teckenspråk"@sv .

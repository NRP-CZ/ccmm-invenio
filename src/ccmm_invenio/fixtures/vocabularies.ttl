<http://publications.europa.eu/resource/authority/language/XMU> ccmm_props:ISO_639_3 "xmu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xmu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Kamu"@xmu; skos:definition "Kamu is an extinct Australian Aboriginal language formerly spoken by the Kamu people along the Daly River in the Northern Territory. It is often grouped with Matngala in the small Eastern Daly group, unrelated to the larger Australian Aboriginal language families."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Kamu"@en .

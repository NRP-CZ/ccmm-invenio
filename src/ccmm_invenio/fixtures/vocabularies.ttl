<https://nma.eosc.cz/vocabularies/languages/fra> ccmm_props:ISO_639_1 "fr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "fre"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "fra"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "fra"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:definition "French is the most northerly of the Romance languages and is an official language in 29 countries. It is an official language of all United Nations agencies and of a large number of international organisations. Outside of France, the highest numbers of French speakers are found in Canada, Belgium, Switzerland and Luxembourg."@en, "Le français est la plus septentrionale des langues romanes et est une langue officielle dans 29 pays. Il est aussi une langue officielle de tous les organismes des Nations unies et d’un grand nombre d’organisations internationales. Hors de France, le plus grand nombre de francophones se trouvent au Canada, en Belgique, en Suisse et au Luxembourg."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/FRA>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "френски"@bg, "francouzština"@cs, "fransk"@da, "Französisch"@de, "γαλλικά"@el, "French"@en, "francés"@es, "prantsuse keel"@et, "ranska"@fi, "français"@fr, "Fraincis"@ga, "francuski"@hr, "francošćina"@hsb, "francia"@hu, "franska"@is, "francese"@it, "prancūzų kalba"@lt, "franču valoda"@lv, "француски"@mk, "Franċiż"@mt, "Frans"@nl, "fransk"@no, "francuski"@pl, "francês"@pt, "franceză"@ro, "французский"@ru, "francuski"@sh, "francúzština"@sk, "francoščina"@sl, "француски"@sr, "franska"@sv, "fransızca"@tr, "французька мова"@uk .

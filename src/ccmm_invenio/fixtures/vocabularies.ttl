<https://nma.eosc.cz/vocabularies/languages/amh> ccmm_props:ISO_639_1 "am"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "amh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "amh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "amh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "am"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Amarəñña"@am, "አማርኛ"@am; skos:definition "Amharic is a Semitic language spoken in Ethiopia. The Amharic script is an abugida."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/AMH>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "амхарски"@bg, "amharština"@cs, "amharisk"@da, "Amharisch"@de, "αμχαρική"@el, "Amharic"@en, "amárico"@es, "amhara keel"@et, "amhara"@fi, "amharique"@fr, "Amáiris"@ga, "amharski"@hr, "amhara"@hu, "amarico"@it, "amharų"@lt, "amharu valoda"@lv, "Amariku"@mt, "Amhaars"@nl, "ahmarski"@pl, "amárico"@pt, "amharică"@ro, "amharski"@sk, "amharščina"@sl, "amhariska"@sv, "амхарська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/ami> ccmm_props:ISO_639_3 "ami"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ami"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Amis"@ami; skos:definition "Amis is a Formosan language spoken on the east coast of Taiwan by the Amis people. It belongs to the East Formosan primary branch of the Austronesian language family. Like many Austronesian languages, Amis is characterised by voice alternations in its clause structure and productive morphology, including affixation and reduplication to form new words."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/AMI>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Amis"@en .

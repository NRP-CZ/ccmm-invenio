<https://nma.eosc.cz/vocabularies/languages/sde> ccmm_props:ISO_639_3 "sde"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sde"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Surubu"@sde; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SDE>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "surubu"@sde .
<https://nma.eosc.cz/vocabularies/languages/sdf> ccmm_props:ISO_639_3 "sdf"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sdf"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Sarlî"@sdf, "Şarlî"@sdf; skos:definition "Sarli is an Indo-Iranian language that belongs to the Gorani group of Northwestern Iranian languages. It is spoken in northern Iraq by a cluster of villages north of the Little Zab river, on the confluence of the Khazir River and the Great Zab river, just west-northwest of the city of Kirkuk. It has fewer than 20,000 speakers. Many speakers have been displaced by conflicts in the region. It is reportedly most similar to Bajelani but is also similar to Shabaki."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SDF>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "сарли"@bg, "sárlijština"@cs, "sarli"@da, "Sarli"@de, "Σαρλί"@el, "Sarli"@en, "Sarli"@es, "sarli"@fi, "sarli"@fr, "Sáirlis"@ga, "sarli"@hr, "szarli"@hu, "Sarli"@it, "sarlių"@lt, "sarli"@lv, "Sarli"@mt, "Sarli"@nl, "sarli"@pl, "sárli"@pt, "sarli"@ro, "sarlí"@sk, "sarlijščina"@sl, "sarli"@sv .
<https://nma.eosc.cz/vocabularies/languages/sdg> ccmm_props:ISO_639_3 "sdg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sdg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Savi"@sdg; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SDG>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "savi"@sdg .
<https://nma.eosc.cz/vocabularies/languages/sdh> ccmm_props:ISO_639_3 "sdh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sdh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Pehlewani"@en, "Pehlewani"@sdh, "کوردیی باشووری"@sdh; skos:definition "Southern Kurdish (Pehlewani) is a Kurdish dialect predominantly spoken in western Iran and eastern Iraq. Native speakers use various different alphabets to write Southern Kurdish, the most common ones are extensions of the standard Kurdish alphabets (Latin or Perso-Arabic script). This language is part of the Kurdish group within the northwestern branch of the Indo-Iranian languages."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SDH>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "южнокюрдски"@bg, "jižní kurdština"@cs, "sydkurdisk"@da, "Südkurdisch"@de, "νότια κουρδική"@el, "Southern Kurdish"@en, "kurdo meridional"@es, "lõuna kurdi keel"@et, "eteläkurdi"@fi, "kurde méridional"@fr, "Coirdis an Deiscirt"@ga, "južnokurdski"@hr, "délkurd"@hu, "curdo meridionale"@it, "pietų kurdų"@lt, "dienvidkurdu valoda"@lv, "Kurd tan-Nofsinhar"@mt, "Southern Kurdish"@nl, "południowokurdyjski"@pl, "curdo meridional"@pt, "kurdă de sud"@ro, "južná kurdčina"@sk, "južna kurdščina"@sl, "sydkurdiska"@sv, "південнокурдська мова"@uk .

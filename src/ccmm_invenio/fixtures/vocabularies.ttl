<https://nma.eosc.cz/vocabularies/languages/wol> ccmm_props:ISO_639_1 "wo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "wol"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "wol"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "wol"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "wo"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Wolof"@wo; skos:definition "Wolof belongs to the Senegambian branch of the Niger–Congo language family. It is the native language of the Wolof people and is spoken in Senegal, the Gambia and Mauritania."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/WOL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "волоф"@bg, "wòlof"@ca, "wolofština"@cs, "wolof"@da, "Wolof"@de, "ουόλοφ"@el, "Wolof"@en, "wolof"@es, "volofi keel"@et, "wolof"@fi, "wolof"@fo, "wolof"@fr, "Volaifis"@ga, "volof"@hr, "volof"@hu, "wolof"@it, "volofų kalba"@lt, "volofu valoda"@lv, "Wolof"@mt, "Wolof"@nl, "wolof"@no, "wolof"@pl, "uolofe"@pt, "wolof"@ro, "волоф"@ru, "wolofski"@sh, "wolofčina"@sk, "volofščina"@sl, "gjuha volof"@sq, "wolof"@sv, "wolof dili"@tr, "волоф"@uk .

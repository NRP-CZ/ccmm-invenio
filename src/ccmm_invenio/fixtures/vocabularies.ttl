<http://publications.europa.eu/resource/authority/language/YUE> ccmm_props:ISO_639_3 "yue"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "yue"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Cantonese"@en, "cantonese"@it, "Yue"@sk, "yue"@yue, "粤语"@yue; skos:definition "Yue Chinese, often referred as Cantonese, is a Chinese language. It is one of the official languages of Hong Kong and Macau. Yue Chinese is written in Chinese characters."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "китайски юе"@bg, "čínský jazyk jüe"@cs, "yue-kinesisk"@da, "Kantonesisch"@de, "κινεζικά γουέ"@el, "Yue Chinese"@en, "chino yue"@es, "kantoni keel"@et, "kantoninkiina"@fi, "cantonais"@fr, "Sínis Yúé"@ga, "yue kineski"@hr, "kínai yue nyelv"@hu, "lingua yuè"@it, "Kantono kinų kalba"@lt, "jue ķīniešu valoda"@lv, "Ċiniż ta’ Yue"@mt, "Kantonees"@nl, "yue"@pl, "cantonês"@pt, "chineza Yue"@ro, "kantončina"@sk, "kitajščina"@sl, "kantonesiska"@sv, "юе"@uk .

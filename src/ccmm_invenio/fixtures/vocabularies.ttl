<https://nma.eosc.cz/vocabularies/languages/psd> ccmm_props:ISO_639_3 "psd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "psd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Plains Indian Sign Language"@psd; skos:definition "Plains Indian Sign Language is a trade language (or international auxiliary language) that was once the lingua franca across central Canada, central and western United States and northern Mexico, used among the various Plains Nations. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/PSD>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "мова жэстаў паўночнаамерыканскіх індзейцаў"@be, "жестомимичен език от индийските равнини"@bg, "znakový jazyk prérijních Indiánů"@cs, "prærieindiansk tegnsprog"@da, "Plains Indian-Gebärdensprache"@de, "νοηματική γλώσσα Πλέινς Ίντιαν"@el, "Plains Indian Sign Language"@en, "lengua de signos de las Grandes Llanuras"@es, "Plains Indian viipekeel"@et, "tasankointiaanien viittomakieli"@fi, "langue des signes des Indiens des Plaines"@fr, "Teanga Chomharthaíochta na nIndiach Má"@ga, "znakovni jezik sjevernoameričkih Indijanaca"@hr, "síksági indiánok jelnyelve"@hu, "lingua dei segni delle pianure indiane"@it, "prerijų indėnų gestų kalba"@lt, "Ziemeļamerikas indiāņu zīmju valoda"@lv, "Lingwa tas-Sinjali tal-Pjanuri Indjani"@mt, "Gebarentaal van de Prairie-indianen"@nl, "język migowy"@pl, "língua gestual das Grandes Planícies"@pt, "limbajul prin semne al amerindienilor de câmpie"@ro, "язык жестов североамериканских индейцев"@ru, "posunkový jazyk Indiánov z plání"@sk, "znakovni jezik ravninskih Ameriških staroselcev"@sl, "prärieindianskt teckenspråk"@sv .

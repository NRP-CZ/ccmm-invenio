<http://publications.europa.eu/resource/authority/language/UGN> ccmm_props:ISO_639_3 "ugn"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ugn"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Ugandan Sign Language"@ugn; skos:definition "Ugandan Sign Language is a sign language used in Uganda. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "угандийски жестомимичен език"@bg, "ugandský znakový jazyk"@cs, "ugandisk tegnsprog"@da, "Ugandische Gebärdensprache"@de, "ουγκαντέζικη νοηματική γλώσσα"@el, "Ugandan Sign Language"@en, "lengua de signos de Uganda"@es, "uganda viipekeel"@et, "ugandalainen viittomakieli"@fi, "langue des signes ougandaise"@fr, "Teanga Chomharthaíochta Uganda"@ga, "ugandski znakovni jezik"@hr, "ugandai jelnyelv"@hu, "lingua dei segni ugandese"@it, "ugandiečių gestų kalba"@lt, "ugandiešu zīmju valoda"@lv, "Lingwa tas-Sinjali Ugandiża"@mt, "Ugandese Gebarentaal"@nl, "ugandzki język migowy"@pl, "língua gestual ugandesa"@pt, "limbajul prin semne din Uganda"@ro, "ugandský posunkový jazyk"@sk, "ugandski znakovni jezik"@sl, "ugandiskt teckenspråk"@sv .

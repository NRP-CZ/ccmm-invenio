<http://publications.europa.eu/resource/authority/language/LKH> ccmm_props:ISO_639_3 "lkh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lkh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Lakha"@lkh; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "lakha"@lkh .
<http://publications.europa.eu/resource/authority/language/LKI> ccmm_props:ISO_639_3 "lki"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lki"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "laki"@hr, "Lekî"@lki, "له‌کی"@lki; skos:definition "Laki is a vernacular that consists of two dialects; Pish-e Kuh Laki and Posht-e Kuh Laki. Laki has a disputed identity and is considered to be a dialect of Kurdish or of Luri, or a transitional dialect between them. It is considered a Kurdish dialect by most linguists and is spoken chiefly in the area between Khorramabad and Kermanshah in Iran by about 680 000 native speakers. Laki is part of the Kurdish group within the northwestern branch of the Indo-Iranian languages."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "лаки"@bg, "lakí"@cs, "laki"@da, "Leki"@de, "Λάκι"@el, "Laki"@en, "Laki"@es, "laki"@et, "laki"@fi, "laki"@fr, "Lacais"@ga, "lački"@hr, "laki"@hu, "Laki"@it, "lakių"@lt, "laki"@lv, "Laki"@mt, "Laki"@nl, "laki"@pl, "laki"@pt, "laki"@ro, "lakí"@sk, "lakijščina"@sl, "lakki"@sv .

<http://publications.europa.eu/resource/authority/language/SZL> ccmm_props:ISO_639_3 "szl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "szl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Upper Silesian"@en, "sziléz"@hu, "silezijos"@lt, "silēziešu"@lv, "Silesian"@szl, "ślůnski"@szl, "ślůnsko godka"@szl; skos:definition "Silesian or Upper Silesian is a West Slavic ethnolect of the Lechitic group spoken by a small percentage of people in Upper Silesia. Its vocabulary was significantly influenced by Central German due to the existence of numerous Silesian German speakers in the area prior to World War II and after. Some regard it as one of the four major dialects of Polish, while others classify it as a separate regional language, distinct from Polish."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "силезийски език"@bg, "slezština"@cs, "schlesisk"@da, "Schlesisch"@de, "Σιλεσιανά"@el, "Silesian"@en, "silesio"@es, "sileesia keel"@et, "sleesia"@fi, "silésien"@fr, "siléisis"@ga, "šleski"@hr, "sziléziai"@hu, "slesiano"@it, "sileziečių kalba"@lt, "silēziešu valoda"@lv, "Sileżjan"@mt, "Silezisch"@nl, "śląski"@pl, "silesiano"@pt, "sileziană"@ro, "sliezština"@sk, "šlezijščina"@sl, "silesiska"@sv .

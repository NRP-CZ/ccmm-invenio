<http://publications.europa.eu/resource/authority/language/SLS> ccmm_props:ISO_639_3 "sls"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sls"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Singapore Sign Language"@sls; skos:definition "Singapore Sign Language is a sign language used in Singapore. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Сингапур"@bg, "singapurský znakový jazyk"@cs, "Singapore tegnsprog"@da, "Singapurianische Gebärdensprache"@de, "σιγκαπουριανή νοηματική γλώσσα"@el, "Singapore Sign Language"@en, "lengua de signos de Singapur"@es, "singapuri viipekeel"@et, "singaporelainen viittomakieli"@fi, "langue des signes de Singapour"@fr, "Teanga Chomharthaíochta Shingeapór"@ga, "singapurski znakovni jezik"@hr, "szingapúri jelnyelv"@hu, "lingua dei segni di Singapore"@it, "singapūriečių gestų kalba"@lt, "Singapūras zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Singapore"@mt, "Singaporese Gebarentaal"@nl, "singapurski język migowy"@pl, "língua gestual singapurense"@pt, "limbajul prin semne din Singapore"@ro, "singapurský posunkový jazyk"@sk, "singapurski znakovni jezik"@sl, "singaporianskt teckenspråk"@sv .

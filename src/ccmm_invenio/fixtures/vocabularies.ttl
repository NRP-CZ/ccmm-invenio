<http://publications.europa.eu/resource/authority/language/HAZ> ccmm_props:ISO_639_3 "haz"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "haz"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "həzārəgi"@haz, "هزارگی"@haz; skos:definition "Hazaragi is a member of the Western Iranian branch of the Indo-European language family. It is an eastern variety of Persian and closely related to Dari, one of the two official Languages of Afghanistan. The primary differences between Dari and Hazaragi are the accents and Hazaragi's greater array of many Turkic and Mongolic words and loanwords."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "хазараги"@bg, "hazaragí"@cs, "hazaragi"@da, "Hazaragi"@de, "Χαζαράγκι"@el, "Hazaragi"@en, "Hazaragi"@es, "hazara"@et, "hazara"@fi, "hazâragi"@fr, "Hasáraigis"@ga, "hazarski"@hr, "hazaragi"@hu, "Hazaragi"@it, "hazaragių"@lt, "hazaragi"@lv, "Hazaragi"@mt, "Hazaragi"@nl, "hazaragi"@pl, "hazara"@pt, "hazaragi"@ro, "hazárčina"@sk, "hazaraščina"@sl, "hazaragi"@sv .

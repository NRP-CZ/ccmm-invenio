<http://publications.europa.eu/resource/authority/language/HDS> ccmm_props:ISO_639_3 "hds"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hds"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Honduras Sign Language"@hds; skos:definition "Honduras Sign Language is a sign language used in Honduras. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Хондурас"@bg, "honduraský znakový jazyk"@cs, "honduransk tegnsprog"@da, "Honduranische Gebärdensprache"@de, "ονδουρανή νοηματική γλώσσα"@el, "Honduran Sign Language"@en, "lengua de signos hondureña"@es, "hondurase viipekeel"@et, "hondurasilainen viittomakieli"@fi, "langue des signes hondurienne"@fr, "Teanga Chomharthaíochta Hondúras"@ga, "honduraški znakovni jezik"@hr, "hondurasi jelnyelv"@hu, "lingua dei segni dell’Honduras"@it, "hondūriečių gestų kalba"@lt, "hondurasiešu zīmju valoda"@lv, "Lingwa tas-Sinjali tal-Honduras"@mt, "Hondurese Gebarentaal"@nl, "honduraski język migowy"@pl, "língua gestual hondurenha"@pt, "limbajul prin semne din Honduras"@ro, "гондурасский жестовый язык"@ru, "honduraský posunkový jazyk"@sk, "znakovni jezik Hondurasa"@sl, "honduranskt teckenspråk"@sv .

<https://nma.eosc.cz/vocabularies/languages/nsi> ccmm_props:ISO_639_3 "nsi"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nsi"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nigerian Sign Language"@nsi; skos:definition "Nigerian Sign Language is a sign language used in Nigeria. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/NSI>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Нигерия"@bg, "nigerijský znakový jazyk"@cs, "nigeriansk tegnsprog"@da, "Nigerianische Gebärdensprache"@de, "νιγηριανή νοηματική γλώσσα"@el, "Nigerian Sign Language"@en, "lengua de signos nigeriana"@es, "nigeeria viipekeel"@et, "nigerialainen viittomakieli"@fi, "langue des signes nigériane"@fr, "Teanga Chomharthaíochta na Nigéire"@ga, "nigerijski znakovni jezik"@hr, "nigériai jelnyelv"@hu, "lingua dei segni nigeriana"@it, "nigeriečių gestų kalba"@lt, "nigēriešu zīmju valoda"@lv, "Lingwa tas-Sinjali Niġerjana"@mt, "Nigeriaanse Gebarentaal"@nl, "nigeryjski język migowy"@pl, "língua gestual nigeriana"@pt, "limbajul prin semne din Nigeria"@ro, "nigerský posunkový jazyk"@sk, "nigerijski znakovni jezik"@sl, "nigerianskt teckenspråk"@sv .
<https://nma.eosc.cz/vocabularies/languages/nsk> ccmm_props:ISO_639_3 "nsk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nsk"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Iyuw Iyimuun"@nsk; skos:definition "Naskapi (also known as Iyuw Iyimuun in the Naskapi language) is an Algonquian language spoken by the Naskapi in Quebec and Labrador, Canada. It is written in Eastern Cree syllabics. Naskapi is a language belonging to the Cree–Montagnais–Naskapi linguistic continuum, which is part of the Central branch of the Algonquian languages of the Algic family of languages. Naskapi remains unique and distinct from all other language varieties in the Quebec-Labrador peninsula."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/NSK>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Naskapi"@en .
<https://nma.eosc.cz/vocabularies/languages/nsl> ccmm_props:ISO_639_3 "nsl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nsl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Norwegian Sign Language"@nsl; skos:definition "Norwegian Sign Language is a sign language used in Norway. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/NSL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "норвежки жестомимичен език"@bg, "norský znakový jazyk"@cs, "norsk tegnsprog"@da, "Norwegische Gebärdensprache"@de, "νορβηγική νοηματική γλώσσα"@el, "Norwegian Sign Language"@en, "lengua de signos noruega"@es, "norra viipekeel"@et, "norjalainen viittomakieli"@fi, "langue des signes norvégienne"@fr, "Teanga Chomharthaíochta na hIorua"@ga, "norveški znakovni jezik"@hr, "norvég jelnyelv"@hu, "lingua dei segni norvegese"@it, "norvegų gestų kalba"@lt, "norvēģu zīmju valoda"@lv, "Lingwa tas-Sinjali Norveġiża"@mt, "Noorse Gebarentaal"@nl, "norsk tegnspråk"@no, "norweski język migowy"@pl, "língua gestual norueguesa"@pt, "limbajul prin semne din Norvegia"@ro, "nórsky posunkový jazyk"@sk, "norveški znakovni jezik"@sl, "norskt teckenspråk"@sv .

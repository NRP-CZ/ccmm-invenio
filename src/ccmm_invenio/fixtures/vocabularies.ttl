<http://publications.europa.eu/resource/authority/language/BRB> ccmm_props:ISO_639_3 "brb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "brb"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Brao"@brb, "Lave"@en; skos:definition "Brao (Brou, Palaw, Preou) is a Mon–Khmer language spoken in and around the town of Taveng in Ratanakiri Province, Cambodia. Brao falls under the Bahnaric sub-branch of the Austroasiatic language family."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Brao"@en .

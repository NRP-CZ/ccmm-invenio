<https://nma.eosc.cz/vocabularies/languages/ecs> ccmm_props:ISO_639_3 "ecs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ecs"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Ecuadorian Sign Language"@ecs; skos:definition "Ecuadorian Sign Language is a sign language used in Ecuador. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ECS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "жестомимичен език от Еквадор"@bg, "ekvádorský znakový jazyk"@cs, "ecuadoriansk tegnsprog"@da, "Ecuadorianische Gebärdensprache"@de, "εκουαδοριανή νοηματική γλώσσα"@el, "Ecuadorian Sign Language"@en, "lengua de signos ecuatoriana"@es, "ecuadori viipekeel"@et, "ecuadorilainen viittomakieli"@fi, "langue des signes équatorienne"@fr, "Teanga Chomharthaíochta Eacuadór"@ga, "ekvadorski znakovni jezik"@hr, "ecuadori jelnyelv"@hu, "lingua dei segni dell’Ecuador"@it, "ekvadoriečių gestų kalba"@lt, "ekvadoriešu zīmju valoda"@lv, "Lingwa tas-Sinjali Ekwadorjana"@mt, "Ecuadoraanse Gebarentaal"@nl, "ekwadorski język migowy"@pl, "língua gestual equatoriana"@pt, "limbajul prin semne din Ecuador"@ro, "ekvádorský posunkový jazyk"@sk, "ekvadorski znakovni jezik"@sl, "ecuadorianskt teckenspråk"@sv .

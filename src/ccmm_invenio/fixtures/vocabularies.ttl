<https://nma.eosc.cz/vocabularies/languages/mah> ccmm_props:ISO_639_1 "mh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "mah"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "mah"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "mah"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Ebon"@en, "Kajin M̧ajeļ"@mh; skos:definition "Marshallese is a Malayo-Polynesian language. It is one of the official languages of the Marshall Islands."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/MAH>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "маршалски"@bg, "maršalština"@cs, "marshallesisk"@da, "Marshallesisch"@de, "μαρσαλέζικα"@el, "Marshallese"@en, "marshalés"@es, "maršalli keel"@et, "marshall"@fi, "marshallais"@fr, "Mairsillis"@ga, "maršalski"@hr, "marshalli"@hu, "marshallese"@it, "maršaliečių"@lt, "māršaliešu valoda"@lv, "Marshalljan"@mt, "Marshalleilands"@nl, "marszalski"@pl, "marshallino"@pt, "marshalleză"@ro, "marshallčina"@sk, "marshallovščina"@sl, "marshallesiska"@sv, "маршальська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/mai> ccmm_props:ISO_639_2B "mai"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "mai"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "mai"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "mai"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Maithili"@mai; skos:definition "Maithili is an Indo-Aryan language variety in the broader Indo-European language family. It is spoken in the Mithila region in north-eastern India and Nepal. It is one of the 22 scheduled languages of India. In the 1960s and the 1970s, when the Maithili speakers demanded a separate Mithila state, the speakers of the closely related varieties, Angika and Bajjika, made counter-demands for recognition of their languages."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/MAI>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Maithili"@en .

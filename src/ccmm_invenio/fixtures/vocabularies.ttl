<http://publications.europa.eu/resource/authority/language/RIF> ccmm_props:ISO_639_3 "rif"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rif"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Tarifit"@rif; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "tarifit"@rif .
<http://publications.europa.eu/resource/authority/language/RIL> ccmm_props:ISO_639_3 "ril"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ril"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Yinnet"@en, "Riang Lang"@ril; skos:definition "Riang Lang is a Palaungic language of Myanmar. It belongs to the Austro-Asiatic language family. Speakers are culturally assimilated with the Karen, but are Palaung by ancestry and their language is unrelated. Riang Lang (Yinnet) and Riang Lai (Yinchia) are sometimes considered distinct languages, sometimes the same language. Like many Austroasiatic languages, Palaungic languages are characterised by prefixation in its clause structure and larger than average vowel inventories."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Riang Lang"@en .
<http://publications.europa.eu/resource/authority/language/RIM> ccmm_props:ISO_639_3 "rim"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rim"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nyaturu"@rim; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "nyaturu"@rim .
<http://publications.europa.eu/resource/authority/language/RIN> ccmm_props:ISO_639_3 "rin"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rin"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nungu"@rin; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "nungu"@rin .
<http://publications.europa.eu/resource/authority/language/RIR> ccmm_props:ISO_639_3 "rir"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rir"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Ribun"@rir; skos:definition "Ribun is a Malayo-Polynesian language spoken in Kalimantan, the Indonesian part of Borneo. The Malayo-Polynesian languages are a subgroup of the Austronesian languages encompassing approximately 390 million speakers. All major Austronesian languages belong to the Malayo-Polynesian subgroup. Together with closely related Jangkang (djo), Semandang (sdq), Sanggau (scg) and Kembayan (xem) languages, Ribun belongs to the Southern Land Dayak sub-branch. Austronesian languages often possess phoneme inventories smaller than the world average. Two salient morphological characteristics are a system of affixation and reduplication to form new words."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Ribun"@en .
<http://publications.europa.eu/resource/authority/language/RIT> ccmm_props:ISO_639_3 "rit"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rit"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Ritharrngu"@rit; skos:definition "Ritharrngu is a Pama-Nyungan language within the Yolngu sub-branch. It is spoken by the Ritharrngu people, also known as the Diakui, in Arnhem Land in Australia's Northern Territory. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Ritharrngu"@en .

<https://nma.eosc.cz/vocabularies/languages/bqn> ccmm_props:ISO_639_3 "bqn"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "bqn"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Bulgarian Sign Language"@bqn; skos:definition "Bulgarian Sign Language is a sign language used in Bulgaria. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/BQN>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "български жестомимичен език"@bg, "bulharský znakový jazyk"@cs, "bulgarsk tegnsprog"@da, "Bulgarische Gebärdensprache"@de, "βουλγαρική νοηματική γλώσσα"@el, "Bulgarian Sign Language"@en, "lengua de signos búlgara"@es, "bulgaaria viipekeel"@et, "bulgarialainen viittomakieli"@fi, "langue des signes bulgare"@fr, "Teanga Chomharthaíochta na Bulgáire"@ga, "bugarski znakovni jezik"@hr, "bolgár jelnyelv"@hu, "lingua dei segni bulgara"@it, "bulgarų gestų kalba"@lt, "bulgāru zīmju valoda"@lv, "Lingwa tas-Sinjali Bulgara"@mt, "Bulgaarse Gebarentaal"@nl, "bułgarski język migowy"@pl, "língua gestual búlgara"@pt, "limbajul prin semne din Bulgaria"@ro, "bulharský posunkový jazyk"@sk, "bolgarski znakovni jezik"@sl, "bulgariskt teckenspråk"@sv .

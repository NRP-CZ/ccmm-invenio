<https://nma.eosc.cz/vocabularies/languages/hks> ccmm_props:ISO_639_3 "hks"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hks"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Hong Kong Sign Language"@hks; skos:definition "Hong Kong Sign Language is a sign language used in Hong Kong. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/HKS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "хонконгски жестомимичен език"@bg, "hongkongský znakový jazyk"@cs, "hongkongkinesisk tegnsprog"@da, "Hongkong-Gebärdensprache"@de, "νοηματική γλώσσα του Χονγκ Κονγκ"@el, "Hong Kong Sign Language"@en, "lengua de signos de Hong Kong"@es, "hong kongi viipekeel"@et, "hongkongilainen viittomakieli"@fi, "langue des signes de Hong Kong"@fr, "Teanga Chomharthaíochta Hong Cong"@ga, "hongkonški znakovni jezik"@hr, "hongkongi jelnyelv"@hu, "lingua dei segni di Hong Kong"@it, "Honkongo gestų kalba"@lt, "Hong Kongas zīmju valoda"@lv, "Ligwa tas-Sinjali ta’ Hong Kong"@mt, "Hongkong-gebarentaal"@nl, "język migowy Hong Kongu"@pl, "língua gestual de Hong Kong"@pt, "limbajul prin semne din Hong Kong"@ro, "гонконгский жестовый язык"@ru, "hongkonský posunkový jazyk"@sk, "znakovni jezik, ki se uporablja v Hongkongu"@sl, "Hongkong-teckenspråk"@sv .

<https://nma.eosc.cz/vocabularies/languages/olo> ccmm_props:ISO_639_3 "olo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "olo"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Livvi-Karelian"@en, "livviko keel"@et, "livvinkarjala"@fi, "livvi"@olo, "ливвиковское наречие"@ru; skos:definition "Livvi-Karelian (or Liygi, Livvi, Livvikovian, Olonets, Southern Olonetsian) is a supradialect of Karelian, which is a Finnic language of the Uralic family, spoken by Olonets Karelians (self-appellation livvi, livgilaizet), traditionally inhabiting the area between Ladoga and Onega lakes, northward of Svir River."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/OLO>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Livvi"@en .

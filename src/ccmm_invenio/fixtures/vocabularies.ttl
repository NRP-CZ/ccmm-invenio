<http://publications.europa.eu/resource/authority/language/HAK> ccmm_props:ISO_639_3 "hak"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "hak"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Kèjiāhuà"@hak, "客家话"@hak; skos:definition "Hakka is a member of the Sinitic languages of the Sino-Tibetan language family. It is most closely related to Gan and is sometimes classified as a variety of Gan. It is spoken natively by the Hakka people in parts of Southern China, Taiwan, some diaspora areas of Southeast Asia and in overseas Chinese communities around the world."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "хакка китайски"@bg, "hakkština"@cs, "Hakka-kinesisk"@da, "Hakka-Chinesisch"@de, "Κινεζικά Χάκκα"@el, "Hakka Chinese"@en, "chino hakka"@es, "Hakka hiina"@et, "hakka-kiina"@fi, "chinois hakka"@fr, "Sínis Hakka"@ga, "hakka kineski"@hr, "hakka kínai"@hu, "cinese hakka"@it, "hakų kinų"@lt, "hakka ķīniešu valoda"@lv, "Ċiniżi Hakka"@mt, "Hakka"@nl, "chiński hakka"@pl, "chinês hacá"@pt, "chineză Hakka"@ro, "hakka čínština"@sk, "hakka kitajščina"@sl, "hakkakinesiska"@sv .

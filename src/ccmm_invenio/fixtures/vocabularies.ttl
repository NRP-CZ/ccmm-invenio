<http://publications.europa.eu/resource/authority/language/SKQ> ccmm_props:ISO_639_3 "skq"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "skq"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "silanke"@hr, "sininkere"@skq; skos:definition "Sininkere (Silinkere) is a language that belongs to the Soninke group of the Mande languages. It is a dialect of Soninke spoken in Burkina Faso. It is part of the hypothetical Niger-Congo language family."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "сининкере"@bg, "sininkere"@cs, "sininkere"@da, "Sininkere"@de, "Σινινκερέ"@el, "Sininkere"@en, "Sininkere"@es, "sininkere"@fi, "sininkéré"@fr, "Sinincéiris"@ga, "sininkere"@hr, "soninke"@hu, "Sininkere"@it, "sininkerių"@lt, "sininkere"@lv, "Sininkere"@mt, "Sininkere"@nl, "sininkere"@pl, "sininqueré"@pt, "sininkere"@ro, "sininkere"@sk, "sininkerščina"@sl, "sininkere"@sv .

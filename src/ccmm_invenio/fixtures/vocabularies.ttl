<http://publications.europa.eu/resource/authority/language/NZK> ccmm_props:ISO_639_3 "nzk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nzk"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nzakara"@nzk; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "nzakara"@nzk .
<http://publications.europa.eu/resource/authority/language/NZM> ccmm_props:ISO_639_3 "nzm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nzm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Zeme Naga"@nzm; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "zeme Naga"@nzm .
<http://publications.europa.eu/resource/authority/language/NZR> ccmm_props:ISO_639_3 "nzr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nzr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Dir"@nzr, "Mbarimi"@nzr, "Nyamzak"@nzr; skos:definition "Dir-Nyamzak-Mbarimi, consisting of Dir, Nyamzak (or Langas) and Mbarimi (or Baram), is an Afro-Asiatic language group of Bauchi State, Nigeria. It is part of the Barawa cluster, which is in turn part of the West Chadic branch. Its closest related language varieties are Pesse, Zul, Buli and the extinct Luri. Together, they form the Polci-Luri group."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Dir-Nyamzak-Mbarimi"@en .
<http://publications.europa.eu/resource/authority/language/NZS> ccmm_props:ISO_639_3 "nzs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nzs"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "New Zealand Sign Language"@nzs; skos:definition "New Zealand Sign Language is a sign language used in New Zealand. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Нова Зеландия"@bg, "novozélandský znakový jazyk"@cs, "new zealandsk tegnsprog"@da, "Neuseeländische Gebärdensprache"@de, "νεοζηλανδική νοηματική γλώσσα"@el, "New Zealand Sign Language"@en, "lengua de signos neozenlandesa"@es, "uus-meremaa viipekeel"@et, "uusiseelantilainen viittomakieli"@fi, "langue des signes néo-zélandaise"@fr, "Teanga Chomharthaíochta na Nua-Shéalainne"@ga, "novozelandski znakovni jezik"@hr, "új-zélandi jelnyelv"@hu, "nýsjálenskt táknmál"@is, "lingua dei segni della Nuova Zelanda"@it, "naujazelandiečių gestų kalba"@lt, "Jaunzēlandes zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ New Zealand"@mt, "Nieuw-Zeelandse Gebarentaal"@nl, "nyzealandsk tegnspråk"@no, "nowozelandzki język migowy"@pl, "língua gestual neozelandesa"@pt, "limbajul prin semne din Noua Zeelandă"@ro, "новозеландский жестовый язык"@ru, "novozélandský posunkový jazyk"@sk, "novozelandski znakovni jezik"@sl, "новозеландски знаковни језик"@sr, "nyzeeländskt teckenspråk"@sv, "новозеландська мова жестів"@uk .

<http://publications.europa.eu/resource/authority/language/NSO> ccmm_props:ISO_639_2B "nso"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "nso"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "nso"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nso"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Sesotho sa Leboa"@nso; skos:definition "Northern Sotho is a Bantu language. It is one of the official languages of South Africa."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "северен сото"@bg, "severní sotština"@cs, "nord-sotho"@da, "Nord-Sotho"@de, "βόρεια σότο"@el, "Northern Sotho"@en, "sotho septentrional"@es, "pedi keel"@et, "pohjoissotho"@fi, "sotho du nord"@fr, "Sútúis an Tuaiscirt"@ga, "sjeverni soto"@hr, "északi szotó"@hu, "sotho del Nord"@it, "šiaurės sotų"@lt, "ziemeļsotu valoda"@lv, "Sotho tat-Tramuntana"@mt, "Northern Sotho"@nl, "pedi"@pl, "soto setentrional"@pt, "sotho de nord"@ro, "južná sothčina"@sk, "severni sotho"@sl, "nordsotho"@sv, "північна сото"@uk .
<http://publications.europa.eu/resource/authority/language/NSP> ccmm_props:ISO_639_3 "nsp"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "nsp"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nepalese Sign Language"@nsp; skos:definition "Nepalese Sign Language is a sign language used in Nepal. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "жестомимичен език от Непал"@bg, "nepálský znakový jazyk"@cs, "nepalesisk tegnsprog"@da, "Nepalesische Gebärdensprache"@de, "νεπαλεζική νοηματική γλώσσα"@el, "Nepalese Sign Language"@en, "lengua de signos nepalesa"@es, "nepali viipekeel"@et, "nepalilainen viittomakieli"@fi, "langue des signes népalaise"@fr, "Teanga Chomharthaíochta Neipeal"@ga, "nepalski znakovni jezik"@hr, "nepáli jelnyelv"@hu, "lingua dei segni del Nepal"@it, "nepaliečių gestų kalba"@lt, "nepāliešu zīmju valoda"@lv, "Lingwa tas-Sinjali Nepaliża"@mt, "Nepalese Gebarentaal"@nl, "nepalski język migowy"@pl, "língua gestual nepalesa"@pt, "limbajul prin semne din Nepal"@ro, "nepálsky posunkový jazyk"@sk, "nepalski znakovni jezik"@sl, "nepalesiskt teckenspråk"@sv .

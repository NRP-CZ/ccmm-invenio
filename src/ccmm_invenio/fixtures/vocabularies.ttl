<http://publications.europa.eu/resource/authority/language/XMS> ccmm_props:ISO_639_3 "xms"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xms"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Moroccan Sign Language"@xms; skos:definition "Moroccan Sign Language is a sign language used in Morocco. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "марокански жестомимичен език"@bg, "marocký znakový jazyk"@cs, "marokkansk tegnsprog"@da, "Marokkanische Gebärdensprache"@de, "μαροκινή νοηματική γλώσσα"@el, "Moroccan Sign Language"@en, "lengua de signos marroquí"@es, "maroko viipekeel"@et, "marokkolainen viittomakieli"@fi, "langue des signes marocaine"@fr, "Teanga Chomharthaíochta Mharacó"@ga, "marokanski znakovni jezik"@hr, "marokkói jelnyelv"@hu, "lingua dei segni marocchina"@it, "marokiečių gestų kalba"@lt, "marokāņu zīmju valoda"@lv, "Lingwa tas-Sinjali Marokkina"@mt, "Marokkaanse Gebarentaal"@nl, "marokański język migowy"@pl, "língua gestual marroquina"@pt, "limbajul prin semne din Maroc"@ro, "марокканский жестовый язык"@ru, "marocký posunkový jazyk"@sk, "maroški znakovni jezik"@sl, "marockanskt teckenspråk"@sv .

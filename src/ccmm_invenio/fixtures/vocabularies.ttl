<http://publications.europa.eu/resource/authority/language/BOS> ccmm_props:ISO_639_1 "bs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "bos"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "bos"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "bos"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "bs"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "bosanski"@bs, "bosniaque"@fr; skos:definition "Bosnian is a South Slavic language, the standardised variety of the ‘Serbo-Croatian’ used by Bosniaks, based on the Shtokavian dialect.Bosnian is written in both the Latin and the Cyrillic alphabet."@en, "Le bosnien, parfois appelé «bosniaque», est une langue indo-européenne de la branche des langues slaves, groupe méridional de ces langues; il a pour base le dialecte chtokavien de l’entité linguistique appelée «langue serbo-croate».Le bosnien est écrit avec l’alphabet latin mais aussi avec l’alphabet cyrillique."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "босненски"@bg, "bosenština"@cs, "bosnisk"@da, "Bosnisch"@de, "βοσνιακά"@el, "Bosnian"@en, "bosnio"@es, "bosnia keel"@et, "bosnia"@fi, "bosnien"@fr, "Bosnis"@ga, "bošnjački"@hr, "bosnišćina"@hsb, "bosnyák"@hu, "bosníska"@is, "bosniaco"@it, "bosnių kalba"@lt, "bosniešu valoda"@lv, "бошњачки"@mk, "Bożnjan"@mt, "Bosnisch"@nl, "bosnik"@no, "bośniacki"@pl, "bósnio"@pt, "bosniacă"@ro, "боснийский"@ru, "bošnjački"@sh, "bosniačtina"@sk, "bosanščina"@sl, "бошњачки"@sr, "bosniska"@sv, "boşnakça"@tr, "боснійська мова"@uk .

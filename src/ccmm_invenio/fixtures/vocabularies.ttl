<http://publications.europa.eu/resource/authority/language/XML> ccmm_props:ISO_639_3 "xml"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xml"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Malaysian Sign Language"@xml; skos:definition "Malaysian Sign Language is a sign language used in Malaysia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "малайзийски жестомимичен език"@bg, "malajsijský znakový jazyk"@cs, "malaysisk tegnsprog"@da, "Malaysische Gebärdensprache"@de, "μαλαισιανή νοηματική γλώσσα"@el, "Malaysian Sign Language"@en, "lengua de signos malasia"@es, "malaisia viipekeel"@et, "malesialainen viittomakieli"@fi, "langue des signes malaisienne"@fr, "Teanga Chomharthaíochta na Malaeisia"@ga, "malajski znakovni jezik"@hr, "malajziai jelnyelv"@hu, "lingua dei segni malese"@it, "malajiečių gestų kalba"@lt, "malaiziešu zīmju valoda"@lv, "Lingwa tas-Sinjali Malasjana"@mt, "Maleisische Gebarentaal"@nl, "malezyjski język migowy"@pl, "língua gestual malaia"@pt, "limbajul prin semne din Malaysia"@ro, "малайский жестовый язык"@ru, "malajský posunkový jazyk"@sk, "malezijski znakovni jezik"@sl, "malaysiskt teckenspråk"@sv .
<http://publications.europa.eu/resource/authority/language/XMM> ccmm_props:ISO_639_3 "xmm"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xmm"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Manado Malay"@xmm; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "manado Malay"@xmm .
<http://publications.europa.eu/resource/authority/language/XMN> ccmm_props:ISO_639_3 "xmn"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xmn"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Pārsīg"@xmn, "Pārsīk"@xmn; skos:definition "Middle Persian written in the Manichaean script is a Western Middle Iranian language which became the literary language of the Sasanian Empire. It is the linguistic ancestor of Modern Persian, the official language of Iran (also known as Farsi), Afghanistan (Dari) and Tajikistan (Tajik)."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "манихейски средноперсийски"@bg, "manichejská střední perština"@cs, "manikæisk middelpersisk"@da, "Mittelpersisch"@de, "Μέσα περσικά"@el, "Manichaean Middle Persian"@en, "persa medio manicheo"@es, "mani keskpärsia"@et, "manikeankeskipersia"@fi, "moyen persan manichéen"@fr, "Meán-Pheirsis Mhanaicéach"@ga, "manihejski srednjeperzijski"@hr, "manicheista középperzsa"@hu, "medio persiano manicheo"@it, "manichėjų vidurinė persų"@lt, "maniheju persiešu valoda"@lv, "Persjan Nofsani Maniċean"@mt, "Manichees Middelperzisch"@nl, "średnioperski"@pl, "persa médio (escrita maniqueia)"@pt, "persană mijlocie maniheistă"@ro, "manichejská stredoperzština"@sk, "maničejska srednja perzijščina"@sl, "manikeisk medelpersiska"@sv .
<http://publications.europa.eu/resource/authority/language/XMO> ccmm_props:ISO_639_3 "xmo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xmo"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Morerebi"@xmo; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "morerebi"@xmo .
<http://publications.europa.eu/resource/authority/language/XMP> ccmm_props:ISO_639_3 "xmp"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xmp"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Kuku-Mu'inh"@xmp; skos:definition "Kuku-Mu'inh is an extinct Australian Aboriginal language traditionally spoken by Wik peoples on the Cape York Peninsula of Queensland. Kuku-Mu'inh is closely related to Kuku-Muminh (xmh) and Kuku-Uwanh (uwa). All belong to the Paman sub-branch within the Pama–Nyungan language family, the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Kuku-Mu'inh"@en .

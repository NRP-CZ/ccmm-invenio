<http://publications.europa.eu/resource/authority/language/ISE> ccmm_props:ISO_639_3 "ise"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ise"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Italian Sign Language"@ise; skos:definition "Italian Sign Language is a sign language used in Italia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "италиански жестомимичен език"@bg, "italský znakový jazyk"@cs, "italiensk tegnsprog"@da, "Italienische Gebärdensprache"@de, "ιταλική νοηματική γλώσσα"@el, "Italian Sign Language"@en, "lengua de signos italiana"@es, "itaalia viipekeel"@et, "italialainen viittomakieli"@fi, "langue des signes italienne"@fr, "Teanga Chomharthaíochta na hIodáile"@ga, "talijanski znakovni jezik"@hr, "olasz jelnyelv"@hu, "ítalskt táknmál"@is, "lingua dei segni italiana"@it, "italų gestų kalba"@lt, "itāļu zīmju valoda"@lv, "Lingwa tas-Sinjali Taljana"@mt, "Italiaanse Gebarentaal"@nl, "italiensk tegnspråk"@no, "włoski język migowy"@pl, "língua gestual italiana"@pt, "limbajul prin semne din Italia"@ro, "taliansky posunkový jazyk"@sk, "italijanski znakovni jezik"@sl, "italienskt teckenspråk"@sv, "italyanca işaret dili"@tr, "італійська мова жестів"@uk .
<http://publications.europa.eu/resource/authority/language/ISG> ccmm_props:ISO_639_3 "isg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "isg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Irish Sign Language"@isg; skos:definition "Irish Sign Language is a sign language used in Ireland and in Northern Ireland. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "ирландски жестомимичен език"@bg, "irský znakový jazyk"@cs, "irsk tegnsprog"@da, "Irische Gebärdensprache"@de, "ιρλανδική νοηματική γλώσσα"@el, "Irish Sign Language"@en, "lengua de signos irlandesa"@es, "iiri viipekeel"@et, "irlantilainen viittomakieli"@fi, "langue des signes irlandaise"@fr, "Teanga Chomharthaíochta na hÉireann"@ga, "irski znakovni jezik"@hr, "ír jelnyelv"@hu, "lingua dei segni irlandese"@it, "airių gestų kalba"@lt, "īru zīmju valoda"@lv, "Lingwa tas-Sinjali Irlandiża"@mt, "Ierse Gebarentaal"@nl, "irlandzki język migowy"@pl, "língua gestual irlandesa"@pt, "limbajul prin semne din Irlanda"@ro, "írsky posunkový jazyk"@sk, "irski znakovni jezik"@sl, "iriskt teckenspråk"@sv, "irlandaca işaret dili"@tr .
<http://publications.europa.eu/resource/authority/language/ISH> ccmm_props:ISO_639_3 "ish"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ish"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Esan"@ish; skos:definition "Esan is an Edoid language spoken in Edo State in Nigeria. With its dialects, Ẹkpoma (or Ekpon) and Iguepen, it forms the Esan subgroup. Similar to the more well-known Bantu languages, Esan also features noun class systems, which are a key characteristic used to identify the broader Atlantic–Congo language family, to which Esan belongs as part of the Volta–Congo primary branch."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Esan"@en .
<http://publications.europa.eu/resource/authority/language/ISI> ccmm_props:ISO_639_3 "isi"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "isi"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Nkem-Nkum"@isi; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "nkem-Nkum"@isi .
<http://publications.europa.eu/resource/authority/language/ISK> ccmm_props:ISO_639_3 "isk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "isk"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Ishkashimi"@en .
<http://publications.europa.eu/resource/authority/language/ISL> ccmm_props:ISO_639_1 "is"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "ice"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "isl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "isl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "is"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:definition "Icelandic is an Indo-European language belonging to the North Germanic or Nordic branch of the Germanic languages. The vast majority of Icelandic speakers live in Iceland. Most Icelanders do not have surnames but patronymics. Forenames are followed by the genitive form of the father’s (or the mother’s) Christian name completed by son (son of …) or dóttir (daughter of …), e.g. Jónsson, Jónsdóttir if the name of the father is Jón."@en, "L’islandais est une langue indo-européenne appartenant à la branche nord germanique des langues germaniques. La grande majorité des locuteurs islandais vivent en Islande. La plupart des Islandais n’ont pas de noms de famille mais des patronymes. Les prénoms sont suivis par la forme au génitif du prénom du père (ou de la mère), complétée par «son» (fils de …) ou «dóttir» (fille de …), par exemple les enfants de Jón s’appellent ainsi Jónsson et Jónsdóttir."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "исландски"@bg, "islandština"@cs, "islandsk"@da, "Isländisch"@de, "ισλανδικά"@el, "Icelandic"@en, "islandés"@es, "islandi keel"@et, "islanti"@fi, "islandais"@fr, "Íoslainnis"@ga, "islandski"@hr, "islandščina"@hsb, "izlandi"@hu, "íslenska"@is, "islandese"@it, "islandų kalba"@lt, "islandiešu valoda"@lv, "исландски"@mk, "Islandiż"@mt, "IJslands"@nl, "islandsk"@no, "islandzki"@pl, "islandês"@pt, "islandeză"@ro, "исландский"@ru, "islandski"@sh, "islandčina"@sk, "islandščina"@sl, "исландски"@sr, "isländska"@sv, "ızlandaca"@tr, "ісландська мова"@uk .

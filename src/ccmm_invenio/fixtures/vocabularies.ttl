<https://nma.eosc.cz/vocabularies/languages/kgi> ccmm_props:ISO_639_3 "kgi"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "kgi"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Selangor Sign Language"@kgi; skos:definition "Selangor Sign Language is a sign language used in Malaysia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/KGI>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "селангорски жестомимичен език"@bg, "selangorský znakový jazyk"@cs, "Selangor-tegnsprog"@da, "Selangor-Gebärdensprache"@de, "νοηματική γλώσσα του Selangor"@el, "Selangor Sign Language"@en, "lengua de signos de Selangor"@es, "selangori viipekeel"@et, "selangorilainen viittomakieli"@fi, "langue des signes de Selangor"@fr, "Teanga Chomharthaíochta Selangor"@ga, "selangorski znakovni jezik"@hr, "selangori jelnyelv"@hu, "lingua dei segni di Selangor"@it, "Selangoro gestų kalba"@lt, "Selangoras zīmju valoda"@lv, "Lingwa tas-Sinjali ta’ Selangor"@mt, "Selangor-gebarentaal"@nl, "język migowy Selangor"@pl, "língua gestual de Selângor"@pt, "limbajul prin semne Selangor"@ro, "selangorský posunkový jazyk"@sk, "selangor znakovni jezik"@sl, "Selangor-teckenspråk"@sv .

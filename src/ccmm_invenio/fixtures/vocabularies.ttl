<https://nma.eosc.cz/vocabularies/languages/rsi> ccmm_props:ISO_639_3 "rsi"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rsi"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "langue des signes de Rennellese"@rsi; skos:definition "Rennellese Sign Language is an extinct sign language used Rennell Island, in Solomon Islands. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/RSI>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "ренелски жестомимичен език"@bg, "rennellský znakový jazyk"@cs, "Rennellese-tegnsprog"@da, "Rennellese-Gebärdensprache"@de, "νοηματική γλώσσα του Rennell"@el, "Rennellese Sign Language"@en, "lengua de signos de Rennell"@es, "Rennelli saare viipekeel"@et, "rennellinsaarelainen viittomakieli"@fi, "langue des signes de Rennellese"@fr, "Teanga Chomharthaíochta Oileán Rennell"@ga, "rennellski znakovni jezik"@hr, "rennell-bellona jelnyelv"@hu, "lingua dei segni rennellese"@it, "Renelio gestų kalba"@lt, "Renela salas zīmju valoda"@lv, "Lingwa tas-Sinjali Rennelliża"@mt, "Rennellese-gebarentaal"@nl, "język migowy Rennellese"@pl, "língua gestual de Rennell"@pt, "limbajul prin semne din Insula Rennell"@ro, "реннеллский жестовый язык"@ru, "rennellský posunkový jazyk"@sk, "rennellese znakovni jezik"@sl, "Rennellese-teckenspråk"@sv .

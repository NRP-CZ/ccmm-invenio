<https://nma.eosc.cz/vocabularies/languages/ell> ccmm_props:ISO_639_1 "el"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "gre"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "ell"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "ell"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "el"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "elliniká"@el; skos:definition "Greek is an independent branch of the Indo-European family of languages, native to the southern Balkans, the Aegean Islands, western Asia Minor and Cyprus. It has the longest continuous recorded history of any European language.Its writing system has been the Greek alphabet for the majority of its history.Greek roots are often used to coin new words for other languages; Greek and Latin are the predominant sources of international scientific vocabulary."@en, "Le grec fait partie de la branche indépendante de la famille indo-européenne des langues, principalement parlé dans le sud des Balkans, sur les îles de la mer Égée, en Asie Mineure occidentale et à Chypre. Il a la plus longue histoire enregistrée en continu de toutes les langues européennes.Son système d’écriture a été l’alphabet grec pour la majorité de son histoire.Les racines grecques sont souvent utilisées pour créer de nouveaux mots dans d’autres langues; le grec et le latin sont les principales sources de vocabulaire scientifique international."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/ELL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "гръцки"@bg, "řečtina"@cs, "græsk"@da, "Griechisch"@de, "ελληνικά"@el, "Greek"@en, "griego"@es, "kreeka keel"@et, "kreikka"@fi, "grec"@fr, "Gréigis"@ga, "grčki"@hr, "grjekšćina"@hsb, "görög"@hu, "gríska"@is, "greco"@it, "graikų kalba"@lt, "grieķu valoda"@lv, "грчки"@mk, "Grieg"@mt, "Grieks"@nl, "gresk"@no, "grecki"@pl, "grego"@pt, "greacă"@ro, "греческий"@ru, "grčki"@sh, "gréčtina"@sk, "grščina"@sl, "грчки"@sr, "grekiska"@sv, "yunanca"@tr, "грецька мова"@uk .

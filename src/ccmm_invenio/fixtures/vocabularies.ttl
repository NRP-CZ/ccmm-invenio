<http://publications.europa.eu/resource/authority/language/KRL> ccmm_props:ISO_639_2B "krl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "krl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "krl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "krl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "kard'al"@krl, "kariela"@krl; skos:definition "Karelian (Livvi: karjala, Ludian: kard'al; Tver: kariela) is a Finnic language spoken mainly by the Karelian people in the Russian Republic of Karelia. Karelian is closely related to the Finnish dialects spoken in eastern Finland. Karelian is a group of two supradialects: Karelian Proper (which comprises Northern Karelian and Southern Karelian (including the Tver enclave dialects)) and Olonets Karelian (Livvi Karelian). The Ludic language is sometimes considered one more dialect of Karelian, sometimes a separate language. All variants are written with the Latin-based Karelian alphabet. Like all Finnic languages, Karelian belongs to the Uralic language family."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "карелски"@bg, "karelština"@cs, "karelsk"@da, "Karelisch"@de, "καρελικά"@el, "Karelian"@en, "carelio"@es, "karjala keel"@et, "karjala"@fi, "carélien"@fr, "Cairéilis"@ga, "karelijski"@hr, "karjalai"@hu, "careliano"@it, "karelų"@lt, "karēļu valoda"@lv, "Kareljan"@mt, "Karelisch"@nl, "karelski"@pl, "carélio"@pt, "careliană"@ro, "karelčina"@sk, "karelščina"@sl, "karelska"@sv .

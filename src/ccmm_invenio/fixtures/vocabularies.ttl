<https://nma.eosc.cz/vocabularies/languages/bel> ccmm_props:ISO_639_1 "be"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "bel"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "bel"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "bel"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "be"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "belaruskaja mova"@be, "белоруският"@bg, "fehérorosz"@hu; skos:definition "Belarusian is one of the East Slavic languages and shares many grammatical and lexical features with other members of the branch, Russian and Ukrainian. It is spoken mainly in Belarus.Belorusian is written with the Cyrillic alphabet."@en, "Le biélorusse fait partie de la famille des langues slaves et partage de nombreuses caractéristiques grammaticales et lexicales avec d’autres langues de cette famille, le russe et l’ukrainien. Il est parlé principalement en Biélorussie.Le biélorusse s’écrit avec l’alphabet cyrillique."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/BEL>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "беларуская мова"@be, "белоруски"@bg, "běloruština"@cs, "hviderussisk"@da, "Weißrussisch"@de, "λευκορωσικά"@el, "Belarusian"@en, "bielorruso"@es, "valgevene keel"@et, "valkovenäjä"@fi, "biélorusse"@fr, "Bealarúisis"@ga, "bjeloruski"@hr, "běłorušćina"@hsb, "belarusz"@hu, "hvítrússneska"@is, "bielorusso"@it, "baltarusių kalba"@lt, "baltkrievu valoda"@lv, "белоруски"@mk, "Bjelorussu"@mt, "Wit-Russisch"@nl, "hviterussisk"@no, "białoruski"@pl, "bielorrusso"@pt, "bielorusă"@ro, "белорусский"@ru, "bjeloruski"@sh, "bieloruština"@sk, "beloruščina"@sl, "vitryska"@sv, "beyaz Rusça"@tr, "білоруська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/bem> ccmm_props:ISO_639_2B "bem"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "bem"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "bem"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "bem"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Bemba (Zambia)"@bem; skos:exactMatch <http://publications.europa.eu/resource/authority/language/BEM>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "bemba (Zambia)"@bem .
<https://nma.eosc.cz/vocabularies/languages/ben> ccmm_props:ISO_639_1 "bn"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "ben"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "ben"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "ben"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "bn"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "bangla"@bn, "বাংলা"@bn, "Bangla"@en, "bangla"@fr; skos:definition "Bengali is the language native to the region of Bengal, which comprises present-day Bangladesh and some east-north Indian states. It is written using the Bengali script. Bengali presents a strong case of diglossia, with the literary and standard form differing greatly from the colloquial speech of the regions.On 21 February 1952 several students and political activists were killed during protests. The day was proclaimed the International Mother Language Day by Unesco in 1999 making the Bengali language the only language in the world to be also known for its language movements and people sacrificing their life for their mother language, Bengali."@en, "Le bengali ou bangla est une langue indo-iranienne (sous-branche indo-aryenne) de la famille des langues indo-européennes. Originaire de la région du Bengale à l’est du sous-continent indien, le bengali est la langue nationale du Bangladesh et la langue officielle dans certains États indiens. Le bengali, par sa grande diversité de variantes régionales, forme un continuum linguistique.Le 21 février 1952, plusieurs personnes furent tuées lors de manifestations pour le bengali. Pour cette raison, en 1999, l’Unesco a décidé de commémorer tous les 21 février comme la Journée internationale de la langue maternelle."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/BEN>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "бенгали"@bg, "bengálština"@cs, "bengali"@da, "Bengalisch"@de, "βενγκαλικά"@el, "Bengali"@en, "bengalí"@es, "bengali keel"@et, "bengali"@fi, "bengalî"@fr, "Bengali"@ga, "bengalski"@hr, "bengalšćina"@hsb, "bengáli"@hu, "bengalska"@is, "bengalese"@it, "bengalų kalba"@lt, "bengāļu valoda"@lv, "бенгалски"@mk, "Bengaliża"@mt, "Bengaals"@nl, "bengali"@no, "bengalski"@pl, "bengali"@pt, "bengaleză"@ro, "бенгальский"@ru, "bengalski"@sh, "bengálčina"@sk, "bengalščina"@sl, "бенгалски"@sr, "bengali"@sv, "bengali"@tr, "бенгальська мова"@uk .

<https://nma.eosc.cz/vocabularies/languages/gsg> ccmm_props:ISO_639_3 "gsg"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "gsg"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "German Sign Language"@gsg; skos:definition "German Sign Language is a sign language used in German and in the German-speaking community of Belgium. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/GSG>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "немски жестомимичен език"@bg, "německý znakový jazyk"@cs, "tysk tegnsprog"@da, "Deutsche Gebärdensprache"@de, "γερμανική νοηματική γλώσσα"@el, "German Sign Language"@en, "lengua de signos alemana"@es, "saksa viipekeel"@et, "saksalainen viittomakieli"@fi, "langue des signes allemande"@fr, "Teanga Chomharthaíochta na Gearmáine"@ga, "njemački znakovni jezik"@hr, "német jelnyelv"@hu, "lingua dei segni tedesca"@it, "vokiečių gestų kalba"@lt, "vācu zīmju valoda"@lv, "Lingwa tas-Sinjali Ġermaniża"@mt, "Duitse Gebarentaal"@nl, "tysk tegnspråk"@no, "niemiecki język migowy"@pl, "língua gestual alemã"@pt, "limbajul prin semne din Germania"@ro, "nemecký posunkový jazyk"@sk, "nemški znakovni jezik"@sl, "tyskt teckenspråk"@sv, "almanca işaret dili"@tr, "німецька жестова мова"@uk .

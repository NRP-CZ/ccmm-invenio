<http://publications.europa.eu/resource/authority/language/RXW> ccmm_props:ISO_639_3 "rxw"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rxw"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Garuwali"@en, "Karuwali"@rxw; skos:definition "Karuwali is a dormant Pama-Nyungan language, tentatively classified within the Karnic sub-branch. It was spoken by the Mithaka people in Queensland, Australia. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising over 300 of the approximately 400 Aboriginal languages of Australia."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Karuwali"@en .

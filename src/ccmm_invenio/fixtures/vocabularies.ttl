<http://publications.europa.eu/resource/authority/language/KAA> ccmm_props:ISO_639_2B "kaa"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "kaa"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "kaa"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "kaa"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Karakalpak"@en, "Qaraqalpaq tili"@kaa; skos:definition "Karakalpak is a Turkic language spoken by Karakalpaks in Karakalpakstan. It is divided into two dialects, Northeastern Karakalpak and Southwestern Karakalpak. It developed alongside Nogai and neighbouring Kazakh languages, being markedly influenced by both. Typologically, Karakalpak belongs to the Kipchak branch of the Turkic languages, thus being closely related to and highly mutually intelligible with Kazakh and Nogai."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Kara-Kalpak"@en .

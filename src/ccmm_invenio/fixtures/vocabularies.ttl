<https://nma.eosc.cz/vocabularies/languages/xmx> ccmm_props:ISO_639_3 "xmx"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "xmx"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Maden"@en, "Butlih"@xmx, "Fiat"@xmx, "Kawit"@xmx, "Rajau"@xmx, "Tepin"@xmx, "Wail"@xmx; skos:definition "Salawati, also known as Maden, belongs to the Malayo-Polynesian primary branch of the Austronesian language family. It is spoken on Salawati Island, in the Raja Ampat Islands in Indonesian New Guinea. There is some uncertainty as to whether the dialects comprise a single language or two separate ones (divided geographically between the west and east sides of the island)."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/XMX>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Salawati"@en .

<https://nma.eosc.cz/vocabularies/languages/slk> ccmm_props:ISO_639_1 "sk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "slo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "slk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "slk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "sk"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "slovenský"@sk; skos:definition "Slovak is a member of the western subgroup of Slavic languages, mainly spoken in Slovakia where it is protected by a language law.Slovak is very close to the Czech."@en, "Le slovaque est une langue appartenant au sous-groupe des langues slaves occidentales, principalement parlée en Slovaquie, où elle est protégée par une loi linguistique.Le slovaque est très proche du tchèque."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SLK>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "словашки"@bg, "slovenština"@cs, "slovakisk"@da, "Slowakisch"@de, "σλοβακικά"@el, "Slovak"@en, "eslovaco"@es, "slovaki keel"@et, "slovakki"@fi, "slovaque"@fr, "Slóvaicis"@ga, "slovački"@hr, "słowakšćina"@hsb, "szlovák"@hu, "slóvakíska"@is, "slovacco"@it, "slovakų kalba"@lt, "slovāku valoda"@lv, "словачки"@mk, "Slovakk"@mt, "Slowaaks"@nl, "slovakisk"@no, "słowacki"@pl, "eslovaco"@pt, "slovacă"@ro, "словацкий"@ru, "slovački"@sh, "slovenčina"@sk, "slovaščina"@sl, "словачки"@sr, "slovakiska"@sv, "slovakça"@tr, "словацька мова"@uk .

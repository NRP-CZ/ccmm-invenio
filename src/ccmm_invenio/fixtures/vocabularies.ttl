<https://nma.eosc.cz/vocabularies/languages/svk> ccmm_props:ISO_639_3 "svk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "svk"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Slovakian Sign Language"@svk; skos:definition "Slovakian Sign Language is a sign language used in Slovakia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/SVK>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "словашки жестомимичен език"@bg, "slovenský znakový jazyk"@cs, "slovakisk tegnsprog"@da, "Slowakische Gebärdensprache"@de, "σλοβακική νοηματική γλώσσα"@el, "Slovakian Sign Language"@en, "lengua de signos eslovaca"@es, "slovaki viipekeel"@et, "slovakialainen viittomakieli"@fi, "langue des signes slovaque"@fr, "Teanga Chomharthaíochta na Slóvaice"@ga, "slovački znakovni jezik"@hr, "szlovák jelnyelv"@hu, "lingua dei segni slovacca"@it, "slovakų gestų kalba"@lt, "slovāku zīmju valoda"@lv, "Lingwa tas-Sinjali Slovakka"@mt, "Slowaakse Gebarentaal"@nl, "słowacki język migowy"@pl, "língua gestual eslovaca"@pt, "limbajul prin semne din Slovacia"@ro, "slovenský posunkový jazyk"@sk, "slovaški znakovni jezik"@sl, "slovakiskt teckenspråk"@sv .

<https://nma.eosc.cz/vocabularies/languages/pus> ccmm_props:ISO_639_1 "ps"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "pus"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "pus"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "pus"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ps"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Afghanisch"@de, "Paschto"@de, "Paschtu"@de, "Pathaans"@nl, "pax̌tō"@ps, "پښتو"@ps; skos:definition "Pashto, also known historically as Afghani and Pathani, is the native language of the Pashtun people of south-central Asia. Pashto is a member of the Eastern Iranian languages group.Pashto employs the Pashto alphabet, a modified form of the Persian alphabet, which in part is derived from the Arabic alphabet. It has extra letters for Pashto-specific sounds."@en, "Le pachto est une langue appartenant au groupe indo-iranien de la famille des langues indo-européennes. Les locuteurs du pachto sont les Pachtounes.Cette langue s’écrit au moyen d’un alphabet arabe modifié.Le pachto est composé de deux dialectes principaux, celui de Kandahar et celui de Paktiyâ (ou de Peshawar)."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/PUS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "пущу"@bg, "paštština"@cs, "pashto"@da, "Paschtunisch"@de, "παστού"@el, "Pashto"@en, "pasto"@es, "puštu keel"@et, "paštu"@fi, "pachto"@fr, "Phaistis"@ga, "paštunski"@hr, "pastu"@hu, "pashtu"@it, "puštūnų kalba"@lt, "puštu valoda"@lv, "Paxto"@mt, "Pasjtoe"@nl, "paszto"@pl, "pachto"@pt, "paştună"@ro, "paštčina"@sk, "paštunščina"@sl, "pashto"@sv, "пушту"@uk .

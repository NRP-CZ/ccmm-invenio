<http://publications.europa.eu/resource/authority/language/SWL> ccmm_props:ISO_639_3 "swl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "swl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Swedish Sign Language"@swl; skos:definition "Swedish Sign Language is a sign language used in Sweden. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "шведски жестомимичен език"@bg, "švédský znakový jazyk"@cs, "svensk tegnsprog"@da, "Schwedische Gebärdensprache"@de, "σουηδική νοηματική γλώσσα"@el, "Swedish Sign Language"@en, "lengua de signos sueca"@es, "rootsi viipekeel"@et, "ruotsalainen viittomakieli"@fi, "langue des signes suédoise"@fr, "Teanga Chomharthaíochta na Sualainne"@ga, "švedski znakovni jezik"@hr, "svéd jelnyelv"@hu, "lingua dei segni svedese"@it, "švedų gestų kalba"@lt, "zviedru zīmju valoda"@lv, "Lingwa tas-Sinjali Żvediża"@mt, "Zweedse Gebarentaal"@nl, "svensk tegnspråk"@no, "szwedzki język migowy"@pl, "língua gestual sueca"@pt, "limbajul prin semne din Suedia"@ro, "švédsky posunkový jazyk"@sk, "švedski znakovni jezik"@sl, "svenskt teckenspråk"@sv .

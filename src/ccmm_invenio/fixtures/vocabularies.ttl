<http://publications.europa.eu/resource/authority/language/WND> ccmm_props:ISO_639_3 "wnd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "wnd"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Wandarang"@wnd; skos:definition "Wandarang is an extinct Australian Aboriginal language once spoken in the Northern Territory. Wandarang is a member of the Arnhem, or Macro-Gunwinyguan family, the second-largest Australian language family after Pama–Nyungan, but this language family is not universally accepted."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Wandarang"@en .

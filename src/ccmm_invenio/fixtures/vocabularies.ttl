<http://publications.europa.eu/resource/authority/language/MIN> ccmm_props:ISO_639_2B "min"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "min"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "min"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "min"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Baso Minang"@min; skos:definition "Minangkabau is an Austronesian language spoken by the Minangkabau of West Sumatra. The language is also a lingua franca along the western coastal region of the province of North Sumatra, and is even used in parts of Aceh, where the language is called Aneuk Jamee. It is also spoken in some parts of Malaysia.There are great grammatical similarities between the Minangkabau language and Malay."@en, "Le minangkabau est une langue austronésienne parlée en Indonésie, dans le nord de l’île de Sumatra.Il fait partie des langues malaïques qui représentent un des sous-groupes du malayo-polynésien occidental."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "минангкабау"@bg, "minangkabauština"@cs, "minangkabau"@da, "Minangkabau"@de, "μινανγκαμπάου"@el, "Minangkabau"@en, "minangkabau"@es, "minangkabau keel"@et, "minangkabau"@fi, "minangkabau"@fr, "Minangkabau"@ga, "minangkabau"@hr, "minangkabau"@hu, "minangkabau"@it, "minangkabau kalba"@lt, "minangkabavu valoda"@lv, "Minangkabau"@mt, "Minangkabaus"@nl, "minangkabau"@no, "minangkabau"@pl, "minangkabau"@pt, "minangkabau"@ro, "индонезийский"@ru, "minangkabau"@sh, "minangkabaučina"@sk, "minangkabau"@sl, "minangkabau"@sv, "мінангкабау"@uk .

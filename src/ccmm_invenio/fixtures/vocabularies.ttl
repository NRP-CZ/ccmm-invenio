<http://publications.europa.eu/resource/authority/language/KVK> ccmm_props:ISO_639_3 "kvk"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "kvk"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Korean Sign Language"@kvk; skos:definition "Korean Sign Language is a sign language used in South Korea. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "корейски жестомимичен език"@bg, "korejský znakový jazyk"@cs, "koreansk tegnsprog"@da, "Koreanische Gebärdensprache"@de, "κορεατική νοηματική γλώσσα"@el, "Korean Sign Language"@en, "lengua de signos coreana"@es, "korea viipekeel"@et, "korealainen viittomakieli"@fi, "langue des signes coréenne"@fr, "Teanga Chomharthaíochta na Cóiré"@ga, "korejski znakovni jezik"@hr, "koreai jelnyelv"@hu, "lingua dei segni coreana"@it, "korėjiečių gestų kalba"@lt, "korejiešu zīmju valoda"@lv, "Lingwa tas-Sinjali Koreana"@mt, "Koreaanse Gebarentaal"@nl, "koreański język migowy"@pl, "língua gestual coreana"@pt, "limbajul prin semne coreean"@ro, "kórejský posunkový jazyk"@sk, "korejski znakovni jezik"@sl, "koreanskt teckenspråk"@sv .

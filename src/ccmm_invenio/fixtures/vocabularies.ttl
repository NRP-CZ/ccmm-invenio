<http://publications.europa.eu/resource/authority/language/MAN> ccmm_props:ISO_639_2B "man"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "man"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "man"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "man"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "мандинго"@bg, "μαντέν"@el, "Mandingo"@en, "Manding"@man; skos:definition "The Manding languages are mutually intelligible dialects or languages in West Africa of the Mande family. Their best-known members are Bambara (bam), the most widely spoken language in Mali; Mandinka (mnk), the main language of Gambia; Maninka or Malinké, a major language of Guinea; and Dyula (dyu), a trade language of the northern Ivory Coast and western Burkina Faso. There is debate over whether Mande languages are part of the larger Niger-Kongo language family."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "мандинг"@bg, "mandingo"@cs, "manding"@da, "Manding"@de, "μαντίνγκ"@el, "Manding"@en, "mandenká"@es, "mandingo"@et, "manding"@fi, "mandingue"@fr, "Mandais"@ga, "manding"@hr, "manding"@hu, "mandingo"@it, "mandingų"@lt, "mandingu"@lv, "Manding"@mt, "Manding"@nl, "manding"@pl, "línguas mandingas"@pt, "manding"@ro, "manding"@sk, "manding jeziki"@sl, "manding"@sv, "манден"@uk .

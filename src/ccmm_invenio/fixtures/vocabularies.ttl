<https://nma.eosc.cz/vocabularies/languages/urd> ccmm_props:ISO_639_1 "ur"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "urd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "urd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "urd"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ur"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "urdu"@fr, "urdū"@ur, "اُردُو"@ur; skos:definition "Urdu is a standardised register of the Hindustani language. Urdu is historically associated with the Muslims of the region of Hindustan.Urdu is written right-to-left in an extension of the Persian alphabet, which is itself an extension of the Arabic alphabet. Urdu is associated with the Nastaʿlīq style of Persian calligraphy."@en, "L’ourdou ou urdu est une langue appartenant au groupe indo-iranien de la famille des langues indo-européennes.En Inde, il est connu sous le nom de «hindi» et s’écrit en caractères sanskrits, mais ses locuteurs musulmans le nomment «ourdou» et l’écrivent en caractères arabes, comme au Pakistan."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/URD>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "урду"@bg, "urdština"@cs, "urdu"@da, "Urdu"@de, "ούρντου"@el, "Urdu"@en, "urdu"@es, "urdu keel"@et, "urdu"@fi, "ourdou"@fr, "Urdais"@ga, "urdski"@hr, "urdušćina"@hsb, "urdu"@hu, "úrdú"@is, "urdu"@it, "urdu kalba"@lt, "urdu"@lv, "урду"@mk, "Urdu"@mt, "Urdu"@nl, "urdu"@no, "urdu"@pl, "urdu"@pt, "urdu"@ro, "урду"@ru, "urdu"@sh, "urdčina"@sk, "urdu"@sl, "урду"@sr, "urdu"@sv, "urduca"@tr, "урду"@uk .
<https://nma.eosc.cz/vocabularies/languages/ure> ccmm_props:ISO_639_3 "ure"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ure"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Uchumataqu"@en, "uruquilla"@es, "Iru Itu"@ure; skos:definition "Uru is an Uru-Chipaya indigenous language. It is one of the official languages of Bolivia."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/URE>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "уру"@bg, "uru"@cs, "uru"@da, "Uruquilla"@de, "uru"@el, "Uru"@en, "uru"@es, "uru keel"@et, "uru"@fi, "uru"@fr, "Úrúis"@ga, "uru"@hr, "uru"@hu, "uru"@it, "urų"@lt, "uru"@lv, "Uru"@mt, "Uru"@nl, "uru-chipaya"@pl, "uro"@pt, "uru"@ro, "uru"@sk, "uru"@sl, "uru"@sv, "уру"@uk .

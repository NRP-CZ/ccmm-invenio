<http://publications.europa.eu/resource/authority/language/APC> ccmm_props:ISO_639_3 "apc"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "apc"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "šāmi"@apc, "شامي"@ar; skos:definition "Levantine Arabic, also called Shami, is an Arabic variety spoken in the Levant, namely in Syria, Jordan, Lebanon, Palestine, Israel and southern Turkey. With over 60 million speakers, Levantine Arabic is, alongside Egyptian, one of the two prestige varieties of spoken Arabic comprehensible all over the Arab world. Levantine Arabic falls under the Semitic sub-branch of the Afro-Asiatic language family."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "левантински арабски"@bg, "levantská arabština"@cs, "levantinsk arabisk"@da, "levantinisches Arabisch"@de, "λεβαντίνικα αραβικά"@el, "Levantine Arabic"@en, "árabe levantino"@es, "Levandi araabia keel"@et, "levantinarabia"@fi, "arabe levantin"@fr, "Araibis Leiveantach"@ga, "istočni arapski"@hr, "levantei arab"@hu, "arabo levantino"@it, "Levanto arabų"@lt, "arābu valoda (levantiešu)"@lv, "Għarbi Levantin"@mt, "Levantijns-Arabisch"@nl, "arabski syryjsko-palestyński"@pl, "árabe levantino"@pt, "arabă levantină"@ro, "levantská arabčina"@sk, "levantinska arabščina"@sl, "levantinsk arabiska"@sv .

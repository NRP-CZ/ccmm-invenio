<http://publications.europa.eu/resource/authority/language/CZO> ccmm_props:ISO_639_3 "czo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "czo"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Mǐnzhōngyǔ"@czo, "闽中语"@czo, "Central Min"@en; skos:definition "Central Min, or Min Zhong is a part of the Min group of varieties of Chinese. It is spoken in the valley of the Sha River in Sanming prefecture in the central mountain areas of Fujian."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "мин джун китайски"@bg, "středofuťienské dialekty čínštiny"@cs, "Min Zhong-kinesisk"@da, "Min-Zhong-Chinesisch"@de, "Κινεζικά Μιν Ζονγκ"@el, "Min Zhong Chinese"@en, "chino minzhong"@es, "Min Zhongi hiina"@et, "min zhong -kiina"@fi, "chinois minzhong"@fr, "Sínis Min Zhong"@ga, "min zhong kineski"@hr, "min csung kínai"@hu, "cinese min zhong"@it, "Mindžongo kinų"@lt, "Miņdžou ķīniešu valoda"@lv, "Ċiniż Min Zhong"@mt, "Centraal Min"@nl, "chiński minzhong"@pl, "chinês min central"@pt, "chineză Min Zhong"@ro, "min čung čínština"@sk, "min zhong kitajščina"@sl, "minzhongkinesiska"@sv .

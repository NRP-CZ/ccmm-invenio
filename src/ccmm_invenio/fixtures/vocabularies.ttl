<https://nma.eosc.cz/vocabularies/languages/wrz> ccmm_props:ISO_639_3 "wrz"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "wrz"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Waray"@wrz; skos:definition "Waray is an extinct Australian Aboriginal language spoken in the Adelaide River area of the Northern Territory. Waray is not related to the Pama-Nyungan language family that spans the majority of Australia. It belongs to the smaller Gunwinyguan language family and is related to Jawoyn."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/WRZ>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Waray (Australia)"@en .

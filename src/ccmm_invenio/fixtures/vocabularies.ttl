<https://nma.eosc.cz/vocabularies/languages/fao> ccmm_props:ISO_639_1 "fo"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "fao"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "fao"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "fao"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fo"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Φεροέζικα"@el, "føroyskt"@fo, "féroïen"@fr; skos:definition "Faroese is a North Germanic language spoken in the Faroe Islands.Faroese grammar is related and very similar to that of modern Icelandic and Old Norse."@en, "Le féroïen ou féringien est une langue germanique du Nord parlée dans les Îles Féroé.La grammaire des Îles Féroé est très proche de celles de l’islandais moderne et du vieux norrois."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/FAO>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "фарьорски"@bg, "faerština"@cs, "færøsk"@da, "Färöisch"@de, "φεροϊκά"@el, "Faroese"@en, "feroés"@es, "fääri keel"@et, "fääri"@fi, "féringien"@fr, "Faróis"@ga, "ferojski"@hr, "färöšćina"@hsb, "feröeri"@hu, "færeyska"@is, "faroese"@it, "farerų kalba"@lt, "fēru valoda"@lv, "фарски"@mk, "Faroeż"@mt, "Faeröers"@nl, "færøysk"@no, "farerski"@pl, "feroês"@pt, "feroeză"@ro, "фарерский"@ru, "farerski"@sh, "faerčina"@sk, "ferščina"@sl, "фарски"@sr, "färöiska"@sv, "faroe"@tr, "фарерська мова"@uk .
<https://nma.eosc.cz/vocabularies/languages/fap> ccmm_props:ISO_639_3 "fap"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fap"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Palor"@fap; skos:exactMatch <http://publications.europa.eu/resource/authority/language/FAP>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "palor"@fap .
<https://nma.eosc.cz/vocabularies/languages/far> ccmm_props:ISO_639_3 "far"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "far"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Fataleka"@far; skos:exactMatch <http://publications.europa.eu/resource/authority/language/FAR>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "fataleka"@far .
<https://nma.eosc.cz/vocabularies/languages/fas> ccmm_props:ISO_639_1 "fa"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "per"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "fas"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "fas"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "fa"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "fārsi"@fa, "فارسی"@fa; skos:definition "Persian is an Iranian language within the Indo-Iranian branch of the Indo-European languages and the only South-Western Iranian language. Apart from being the majority language and the national language in Iran (Persia), a different dialect is spoken in Afghanistan (officially known as Dari since 1958 for political reasons) and in Tajikistan (officially known as Tajiki Persian since the Soviet era for political reasons), and in some other regions. Persian is a pluricentric language and its grammar is similar to that of many contemporary European languages. Modern Iranian Persian and Afghan Persian are written using a modified variant of the Arabic alphabet. Tajik Persian is typically written in a modified version of the Cyrillic alphabet."@en, "Le persan est une langue iranienne de la branche indo-iranienne des langues indo-européennes et la seule langue iranienne du Sud-Ouest. Outre le fait qu’il s’agit de la langue majoritaire et de la langue nationale en Iran (Perse), un dialecte différent est parlé en Afghanistan (officiellement connu sous le nom de dari depuis 1958 pour des raisons politiques) et au Tadjikistan (officiellement connu sous le nom de tadjik depuis l’ère soviétique pour des raisons politiques), ainsi que dans d’autres régions. Le persan est une langue pluricentrique et sa grammaire est similaire à celle de nombreuses langues européennes contemporaines. Le persan iranien moderne et le persan afghan s’écrivent dans une variante modifiée de l’alphabet arabe. Le tadjik s’écrit généralement dans une version modifiée de l’alphabet cyrillique."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/FAS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "персийски"@bg, "perština"@cs, "farsi"@da, "Persisch"@de, "περσικά"@el, "Persian"@en, "persa"@es, "pärsia keel"@et, "persia"@fi, "persan"@fr, "Peirsis"@ga, "perzijski"@hr, "persišćina"@hsb, "perzsa"@hu, "persneska"@is, "persiano"@it, "persų kalba"@lt, "persiešu valoda"@lv, "персиски"@mk, "Persjan"@mt, "Perzisch"@nl, "persisk"@no, "perski"@pl, "perso"@pt, "persană"@ro, "персидский"@ru, "perzijski"@sh, "perzština"@sk, "perzijščina"@sl, "персијски"@sr, "persiska"@sv, "farsça"@tr, "фарсі"@uk .

<https://nma.eosc.cz/vocabularies/languages/lls> ccmm_props:ISO_639_3 "lls"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "lls"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Lithuanian Sign Language"@lls; skos:definition "Lithuanian Sign Language is a sign language used in Lithunia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/LLS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "литовски жестомимичен език"@bg, "litevský znakový jazyk"@cs, "litauisk tegnsprog"@da, "Litauische Gebärdensprache"@de, "λιθουανική νοηματική γλώσσα"@el, "Lithuanian Sign Language"@en, "lengua de signos lituana"@es, "leedu viipekeel"@et, "liettualainen viittomakieli"@fi, "langue des signes lituanienne"@fr, "Teanga Chomharthaíochta na Liotuáine"@ga, "litavski znakovni jezik"@hr, "litván jelnyelv"@hu, "lingua dei segni lituana"@it, "lietuvių gestų kalba"@lt, "lietuviešu zīmju valoda"@lv, "Lingwa tas-Sinjali Litwana"@mt, "Litouwse Gebarentaal"@nl, "litewski język migowy"@pl, "língua gestual lituana"@pt, "limbajul prin semne din Lituania"@ro, "litovský posunkový jazyk"@sk, "litovski znakovni jezik"@sl, "litauiskt teckenspråk"@sv .

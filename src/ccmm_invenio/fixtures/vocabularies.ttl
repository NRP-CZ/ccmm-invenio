<http://publications.europa.eu/resource/authority/language/DEH> ccmm_props:ISO_639_3 "deh"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "deh"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Dehwārī"@deh, "دهواری"@deh; skos:definition "Dehwari is a southwestern Persian language spoken by 19 000 Dehwar people in Balochistan, Pakistan as of 2018. Dehwari was introduced to the Brahui in the seventeenth century and Brahui has heavily influenced Dehwari. Dehwari is a member of the Western Iranian branch of the Indo-European language family."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "дехвари"@bg, "dehwarí"@cs, "dehwari"@da, "Dehwari"@de, "Ντεχβάρι"@el, "Dehwari"@en, "Dehwari"@es, "dehwari"@fi, "dehwari"@fr, "Déamhairis"@ga, "dehvarski"@hr, "dehwari"@hu, "Dehwari"@it, "dehvarių"@lt, "devari"@lv, "Dehwari"@mt, "Dehwari"@nl, "dehwari"@pl, "dehwari"@pt, "dehwari"@ro, "dehwárčina"@sk, "dehvarščina"@sl, "dehwari"@sv .

<http://publications.europa.eu/resource/authority/language/ASE> ccmm_props:ISO_639_3 "ase"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ase"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "American Sign Language"@ase; skos:definition "American Sign Language is a sign language used in the United States and most of anglophone Canada. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "амэрыка́нская жэставая мова"@be, "американски жестомимичен език"@bg, "llengua de signes americana"@ca, "americký znakový jazyk"@cs, "amerikansk tegnsprog"@da, "Amerikanische Gebärdensprache"@de, "αμερικανική νοηματική γλώσσα"@el, "American Sign Language"@en, "lengua de signos americana"@es, "ameerika viipekeel"@et, "amerikkalainen viittomakieli"@fi, "langue des signes américaine"@fr, "Teanga Chomharthaíochta Mheiriceá"@ga, "američki znakovni jezik"@hr, "amerikai jelnyelv"@hu, "lingua dei segni americana"@it, "amerikiečių gestų kalba"@lt, "amerikāņu zīmju valoda"@lv, "Lingwa tas-Sinjali Amerikana"@mt, "Amerikaanse Gebarentaal"@nl, "amerikansk tegnspråk"@no, "amerykański język migowy"@pl, "língua gestual americana"@pt, "limbajul prin semne american"@ro, "американский жестовый язык"@ru, "americký posunkový jazyk"@sk, "ameriški znakovni jezik"@sl, "amerikanskt teckenspråk"@sv, "amerikan işaret dili"@tr, "американська жестова мова"@uk .

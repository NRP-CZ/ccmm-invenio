<http://publications.europa.eu/resource/authority/language/EUD> ccmm_props:ISO_639_3 "eud"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "eud"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Dóhmenerít"@eud; skos:definition "Eudeve is a Southern Uto-Aztecan language formerly spoken in Mexico, in the north of Sonora. The language, which is part of the putative Taracahitic branch, is known in colonial-era manuscripts. It has been extinct since the 1930s."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "Eudeve"@en .
<http://publications.europa.eu/resource/authority/language/EUS> ccmm_props:ISO_639_1 "eu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "baq"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "eus"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "eus"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "eu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "euskara"@eu; skos:definition "Basque (euskara) is a non Indo-European language of uncertain origin; the only living language of Europe that has no known linguistic relatives. It is spoken by the Basque people, indigenous to and mainly inhabiting the Basque Country, a region spanning an area in north-eastern Spain and south-western France."@en, "Le basque (euskara) est une langue non indo-européenne d’origine incertaine et la seule langue vivante de l’Europe qui n’a pas de parents linguistiques connus. Il s’agit de la langue parlée par le peuple basque, qui est indigène et habite principalement au Pays basque, région couvrant une zone dans le nord-ouest de l’Espagne et le sud-ouest de la France."@fr; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "баскски"@bg, "baskičtina"@cs, "baskisk"@da, "Baskisch"@de, "βασκικά"@el, "Basque"@en, "vasco"@es, "baski keel"@et, "baski"@fi, "basque"@fr, "Bascais"@ga, "baskijski"@hr, "baskovščina"@hsb, "baszk"@hu, "baskneska"@is, "basco"@it, "baskų kalba"@lt, "basku valoda"@lv, "баскијски"@mk, "Bask"@mt, "Baskisch"@nl, "baskisk"@no, "baskijski"@pl, "basco"@pt, "bască"@ro, "баскский"@ru, "baskijski"@sh, "baskičtina"@sk, "baskovščina"@sl, "баскијски"@sr, "baskiska"@sv, "baskça"@tr, "баскська мова"@uk .

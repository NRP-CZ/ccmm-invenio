<https://nma.eosc.cz/vocabularies/languages/dji> ccmm_props:ISO_639_3 "dji"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dji"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Djinang"@dji; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DJI>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "djinang"@dji .
<https://nma.eosc.cz/vocabularies/languages/djj> ccmm_props:ISO_639_3 "djj"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "djj"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Djeebbana"@djj, "Ndjébbana"@en; skos:definition "Djeebbana, also spelled Ndjébbana, is an endangered Australian Aboriginal language spoken by the Gunavidji (Ndjebbana) people of North-central Arnhem Land in the Northern Territory of Australia. It is closely related to Na-kara (nck), and both belong to the Maningrida group of languages. This group is sometimes classified with the Gunwinyguan languages in a proposed Macro-Gunwinyguan family, which is distinct from the Pama–Nyungan language family."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DJJ>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Djeebbana"@en .

<http://publications.europa.eu/resource/authority/language/RSL> ccmm_props:ISO_639_3 "rsl"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "rsl"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Russian Sign Language"@rsl; skos:definition "Russian Sign Language is a sign language used in Russia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "руски жестомимичен език"@bg, "ruský znakový jazyk"@cs, "russisk tegnsprog"@da, "Russische Gebärdensprache"@de, "ρωσική νοηματική γλώσσα"@el, "Russian Sign Language"@en, "lengua de signos rusa"@es, "vene viipekeel"@et, "venäläinen viittomakieli"@fi, "langue des signes russe"@fr, "Teanga Chomharthaíochta na Rúise"@ga, "ruski znakovni jezik"@hr, "orosz jelnyelv"@hu, "lingua dei segni russa"@it, "rusų gestų kalba"@lt, "krievu zīmju valoda"@lv, "Lingwa tas-Sinjali Russa"@mt, "Russische Gebarentaal"@nl, "russisk tegnspråk"@no, "rosyjski język migowy"@pl, "língua gestual russa"@pt, "limbajul prin semne din Rusia"@ro, "русский жестовый язык"@ru, "ruský posunkový jazyk"@sk, "ruski znakovni jezik"@sl, "ryskt teckenspråk"@sv .

<https://nma.eosc.cz/vocabularies/languages/gmn> ccmm_props:ISO_639_3 "gmn"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "gmn"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Gimnime"@gmn; skos:exactMatch <http://publications.europa.eu/resource/authority/language/GMN>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "gimnime"@gmn .
<https://nma.eosc.cz/vocabularies/languages/gmr> ccmm_props:ISO_639_3 "gmr"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "gmr"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Mirniny"@en, "Mirning"@gmr; skos:definition "Mirning (Mirniny) is a Pama–Nyungan language of Western Australia. Murunitja was apparently a dialect of either Mirning or of its sister language Ngadjunmaya. The Pama–Nyungan languages are the most widespread family of Australian Aboriginal languages, comprising 306 of the 400 Aboriginal languages of Australia. Like the vast majority of Australian languages, also Mirning is morphologically ergative, with the nominal in the agent role marked with an ergative suffix and the subject and object unmarked."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/GMR>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "Mirning"@en .

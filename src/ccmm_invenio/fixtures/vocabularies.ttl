<https://nma.eosc.cz/vocabularies/languages/div> ccmm_props:ISO_639_1 "dv"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_1>; ccmm_props:ISO_639_2B "div"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2B>; ccmm_props:ISO_639_2T "div"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_2T>; ccmm_props:ISO_639_3 "div"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "dv"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "dhivehi"@dv, "ދިވެހި"@dv, "Divehi"@en, "Maldivian"@en, "maldivien"@fr; skos:definition "Dhivehi or Maldivian is an Indo-Aryan language predominantly spoken in the Maldives, where it is the national language. Maldivian is a descendent of Maharashtri Prakrit and is closely related to Marathi, Konkani and Sinhalese languages, but not mutually intelligible with them. Maldivian is written in the Thaana script. Like other Indo-Iranian languages, Dhivehi belongs to the Indo-European languages, the world’s largest language family by number of native speakers."@en, "Le dhivehi ou maldivien est une langue indo-aryenne principalement parlée aux Maldives, où il s’agit de la langue nationale. Le maldivien descend du prâkrit maharashtri et est étroitement apparenté aux langues marathi, konkani et singhalaise, mais sans intelligibilité mutuelle. Le maldivien est écrit en alphabet thaana. À l’instar d’autres langues indo-iraniennes, le dhivehi fait partie des langues indo-européennes, la plus grande famille de langues au monde en nombre de locuteurs natifs."@fr; skos:exactMatch <http://publications.europa.eu/resource/authority/language/DIV>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "дхивехи"@bg, "divehi"@cs, "dhivedi"@da, "Dhivehi"@de, "ντιβέχι"@el, "Dhivehi"@en, "divehi"@es, "maldiivi keel"@et, "divehi"@fi, "divehi"@fr, "Divéihis"@ga, "divehi"@hr, "maldív"@hu, "dívehí"@is, "maldiviano"@it, "maldyvų kalba"@lt, "maldīviešu valoda"@lv, "дивехи"@mk, "Diveli"@mt, "Divehi"@nl, "dhivehi"@no, "malediwski"@pl, "divehi"@pt, "divehi"@ro, "дивехи"@ru, "divehi"@sh, "maldivčina"@sk, "divehi"@sl, "дивехи"@sr, "divehi"@sv, "dhivehi"@tr, "дівехі мова"@uk .

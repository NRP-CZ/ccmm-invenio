<https://nma.eosc.cz/vocabularies/languages/toi> ccmm_props:ISO_639_3 "toi"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "toi"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Chitonga"@en, "chitonga"@fr, "ChiTonga"@toi; skos:definition "Tonga is a Bantu language spoken in Zambia, where it has the status of a regional language, and in Zimbabwe, where it is one of the 16 official languages. It is spoken around Lake Kariba in Zambia by almost a million people and in Zimbabwe around 140 000 people. It is also spoken in northern Zimbabwe, with a few in Mozambique. Tonga is the mother tongue of the Tonga people. In Zambia Tonga is taught in schools as first language in the whole of Southern Province, Lusaka and Central Provinces."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/TOI>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "език тонга (Замбия)"@bg, "tongština (Zambie)"@cs, "tonga (Zambia)"@da, "Chitonga"@de, "τόνγκα (Ζάμπια)"@el, "Tonga (Zambia)"@en, "tonga (Zambia)"@es, "tonga (Sambia)"@et, "tonga (Sambia)"@fi, "tonga (Zambie)"@fr, "Tongais (an tSaimbia)"@ga, "tonga (Zambija)"@hr, "tonga (Zambia)"@hu, "tonga (Zambia)"@it, "čitonga (Zambija)"@lt, "tonga (Zambija)"@lv, "Tonga (iż-Żambja)"@mt, "Tonga (Zambia)"@nl, "tonga (Zambia)"@pl, "tonga (Zâmbia)"@pt, "tonga (Zambia)"@ro, "tongčina (Zambia)"@sk, "tonga (Zambija)"@sl, "tonga (Zambia)"@sv .

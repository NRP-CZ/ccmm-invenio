<https://nma.eosc.cz/vocabularies/languages/csp> ccmm_props:ISO_639_3 "csp"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "csp"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Guìnán"@en, "Southern Pinghua"@en, "桂南平话"@en; skos:definition "Southern Ping Chinese is a member of a pair of Sinitic languages spoken mainly in southern Guangxi, around the city of Nanning. Pinghua is a trade language spoken as a second language by speakers of Zhuang languages. Some speakers are officially classified as Zhuang, and many are genetically distinct from most other Han Chinese."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CSP>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "южен пин китайски"@bg, "jihopchingské dialekty čínštiny"@cs, "sydlig Ping-kinesisk"@da, "südliches Pinghua-Chinesisch"@de, "Κινεζικά νότια Πινγκ"@el, "Southern Ping Chinese"@en, "chino ping del sur"@es, "lõuna pinghua hiina"@et, "eteläpinghuaninkiina"@fi, "chinois ping du Sud"@fr, "Sínis Ping an Deiscirt"@ga, "južni ping kineski"@hr, "déli ping kínai"@hu, "cinese pinghua meridionale"@it, "pietų pinghua kinų"@lt, "dienvidpin ķīniešu valoda"@lv, "Ċiniż Ping tan-Nofsinhar"@mt, "Zuidelijk Pinghua"@nl, "chiński południowy ping"@pl, "chinês ping meridional"@pt, "chineză Ping sudică"@ro, "južná pinq čínština"@sk, "južna ping kitajščina"@sl, "sydlig pinghuakinesiska"@sv .

<https://nma.eosc.cz/vocabularies/languages/crs> ccmm_props:ISO_639_3 "crs"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "crs"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "seselwa"@crs, "seychelská kreolská francouzština"@cs, "Seychellois Creole"@en; skos:definition "Seselwa Creole French is a French-based creol language. It is one of the official languages of the Seychelles."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/CRS>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "креолски френски сеселва"@bg, "seselwa"@cs, "seselwa kreolsk"@da, "Seychellenkreol"@de, "γαλλικά κρεολικά σεσέλουα"@el, "Seselwa Creole French"@en, "criollo seselwa"@es, "seišelli keel"@et, "ranskaan perustuva seychellienkreoli"@fi, "créole seychellois"@fr, "Criól Fraincise na Séiséal"@ga, "seselwa kreolski francuski"@hr, "seychelle-i kreol"@hu, "creolo francese seselwa"@it, "seišeliečių kreolų ir prancūzų kalba"@lt, "seselva kreolu franču valoda"@lv, "Kreol Seselwa Franċiż"@mt, "Seychellencreools"@nl, "kreolski seszelski"@pl, "seichelense"@pt, "creolă franceză Seselwa"@ro, "francúzsky kreolský jazyk seselwa"@sk, "seselwa kreolska francoščina"@sl, "seselwa fransk kreol"@sv, "сесельва креольська французька мова"@uk .

<http://publications.europa.eu/resource/authority/language/YNB> ccmm_props:ISO_639_3 "ynb"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "ynb"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Yamben"@ynb; skos:definition "Yamben, also spelled Yaben, is a Trans–New Guinea language of Madang Province, Papua New Guinea. It was first documented by Andrew Pick in the 2010s and classified by Pick (2019) as a probable primary branch of Madang, though its precise classification is still pending further research."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "ямбен"@bg, "yamben"@cs, "yamben"@da, "Yamben"@de, "Γιάμπεν"@el, "Yamben"@en, "Yamben"@es, "yamben"@fi, "yamben"@fr, "Iaimbis"@ga, "jamben"@hr, "jamben"@hu, "Yamben"@it, "jambenų"@lt, "jambenu"@lv, "Yamben"@mt, "Yamben"@nl, "jamben"@pl, "iambém"@pt, "yamben"@ro, "yamben"@sk, "jambenščina"@sl, "yamben"@sv .

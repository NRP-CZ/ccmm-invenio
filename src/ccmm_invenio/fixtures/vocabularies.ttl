<http://publications.europa.eu/resource/authority/language/CSN> ccmm_props:ISO_639_3 "csn"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "csn"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Colombian Sign Language"@csn; skos:definition "Colombian Sign Language is a sign language used in Colombia. Sign languages are languages which mainly use signs made with the hands, the arms or the body and facial expressions."@en; skos:inScheme <http://publications.europa.eu/resource/authority/language>; skos:prefLabel "колумбийски жестомимичен език"@bg, "kolumbijský znakový jazyk"@cs, "colombiansk tegnsprog"@da, "Kolumbianische Gebärdensprache"@de, "κολομβιανή νοηματική γλώσσα"@el, "Colombian Sign Language"@en, "lengua de signos colombiana"@es, "kolumbia viipekeel"@et, "kolumbialainen viittomakieli"@fi, "langue des signes colombienne"@fr, "Teanga Chomharthaíochta na Colóime"@ga, "kolumbijski znakovni jezik"@hr, "kolumbiai jelnyelv"@hu, "lingua dei segni colombiana"@it, "kolumbiečių gestų kalba"@lt, "kolumbiešu zīmju valoda"@lv, "Lingwa tas-Sinjali Kolombjana"@mt, "Colombiaanse Gebarentaal"@nl, "kolumbijski język migowy"@pl, "língua gestual colombiana"@pt, "limbajul prin semne din Columbia"@ro, "kolumbijský posunkový jazyk"@sk, "kolumbijski znakovni jezik"@sl, "colombianskt teckenspråk"@sv .

<https://nma.eosc.cz/vocabularies/languages/wuu> ccmm_props:ISO_639_3 "wuu"^^<http://publications.europa.eu/ontology/euvoc#ISO_639_3>; ccmm_props:XML_LNG "wuu"^^<http://publications.europa.eu/ontology/euvoc#XML_LNG>; a skos:Concept; skos:altLabel "Wú"@wuu, "吴语"@wuu; skos:definition "Wu is a major group of Sinitic languages spoken primarily in Shanghai, Zhejiang Province and the part of Jiangsu Province south of the Yangtze River, which makes up the cultural region of Wu."@en; skos:exactMatch <http://publications.europa.eu/resource/authority/language/WUU>; skos:inScheme <https://nma.eosc.cz/vocabularies/languages>; skos:prefLabel "у китайски"@bg, "wuské dialekty čínštiny"@cs, "Wu-kinesisk"@da, "Wu-Chinesisch"@de, "Κινεζικά Γου"@el, "Wu Chinese"@en, "chino wu"@es, "Wu hiina"@et, "wu-kiina"@fi, "chinois wu"@fr, "Sínis Wu"@ga, "wu kineski"@hr, "vu kínai"@hu, "cinese wu"@it, "vu kinų"@lt, "vu ķīniešu valoda"@lv, "Ċiniż Wu"@mt, "Wu"@nl, "chiński wu"@pl, "chinês wu"@pt, "chineză Wu"@ro, "wu čínština"@sk, "wu kitajščina"@sl, "wukinesiska"@sv .
